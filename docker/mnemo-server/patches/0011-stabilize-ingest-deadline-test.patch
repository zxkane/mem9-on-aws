+
+func assertDatabaseDeadlineAtOrAfter(
+	t *testing.T,
+	db *sql.DB,
+	jobID string,
+	column string,
+	earliest time.Time,
+) {
+	t.Helper()
+	var actual time.Time
+	query := fmt.Sprintf(
+		`SELECT %s FROM ingest_jobs WHERE job_id = $1`,
+		column,
+	)
+	if err := db.QueryRow(query, jobID).Scan(&actual); err != nil {
+		t.Fatal(err)
+	}
+	if actual.Before(earliest) {
+		t.Fatalf("%s = %v, want at or after %v", column, actual, earliest)
+	}
+}
