+// Materializing exact distances before sorting prevents approximate-index
+// candidate selection. Full records are read only for the selected IDs; ordinary
+// B-tree scans stay available for that namespace-fenced hydration.
+func namespaceVectorQuery(conds []string, vectorParameter, limitParameter int) string {
+	where := strings.Join(conds, " AND ")
+	return fmt.Sprintf(`
+		WITH namespace_distances AS MATERIALIZED (
+			SELECT id, embedding <=> $%d AS distance
+			FROM memories
+			WHERE %s
+		), namespace_top_k AS MATERIALIZED (
+			SELECT id, distance FROM namespace_distances
+			ORDER BY distance LIMIT $%d
+		)
+		SELECT %s, namespace_top_k.distance
+		FROM memories JOIN namespace_top_k USING (id)
+		WHERE %s
+		ORDER BY namespace_top_k.distance`,
+		vectorParameter, where, limitParameter, allColumns, where,
+	)
+}
