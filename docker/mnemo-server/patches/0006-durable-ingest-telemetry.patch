+		records[1]["PlanDurationMs"] != float64(2000) ||
+		records[1]["ApplyDurationMs"] != float64(30) ||
+		records[1]["TotalProcessingDurationMs"] != float64(3000) ||
+		records[1]["RetryCount"] != float64(1) ||
+		records[1]["error_class"] != "mantle_transient" {
