+func (r *IngestJobRepo) OldestQueuedAge(
+	ctx context.Context,
+	tenantID string,
+) (time.Duration, bool, error) {
+	var seconds sql.NullFloat64
+	err := r.db.QueryRowContext(ctx, `
+		SELECT EXTRACT(EPOCH FROM (statement_timestamp() - MIN(created_at)))
+		FROM ingest_jobs
+		WHERE tenant_id = $1 AND state IN ('queued', 'retry_wait')`,
+		tenantID,
+	).Scan(&seconds)
+	if err != nil {
+		return 0, false, fmt.Errorf("select oldest queued ingest age: %w", err)
+	}
+	if !seconds.Valid {
+		return 0, false, nil
+	}
+	age := time.Duration(seconds.Float64 * float64(time.Second))
+	if age < 0 {
+		age = 0
+	}
+	return age, true, nil
+}
