+func TestEMFTelemetryBoundsClassesAndDurations(t *testing.T) {
+	for class := range boundedErrorClasses {
+		if got := boundedErrorClass(class); got != class {
+			t.Fatalf("bounded class %q = %q", class, got)
+		}
+	}
+	if got := boundedErrorClass("PRIVATE-UNBOUNDED-MARKER"); got != "other" {
+		t.Fatalf("unknown class = %q, want other", got)
+	}
+
+	var output bytes.Buffer
+	telemetry := NewEMFTelemetry("prod", &output, nil)
+	telemetry.Result(ResultMetrics{
+		ResultClass:   string(StateDead),
+		ErrorClass:    "PRIVATE-UNBOUNDED-MARKER",
+		QueueWait:     -time.Second,
+		PlanDuration:  -time.Second,
+		ApplyDuration: -time.Second,
+		TotalDuration: -time.Second,
+	})
+	record := telemetryRecords(t, output.String())[0]
+	for _, metric := range []string{
+		"QueueWaitMs",
+		"PlanDurationMs",
+		"ApplyDurationMs",
+		"TotalProcessingDurationMs",
+	} {
+		if record[metric] != float64(0) {
+			t.Fatalf("%s = %#v, want zero", metric, record[metric])
+		}
+	}
+	if record["error_class"] != "other" ||
+		strings.Contains(output.String(), "PRIVATE-UNBOUNDED-MARKER") {
+		t.Fatalf("unbounded class leaked: %s", output.String())
+	}
+}
