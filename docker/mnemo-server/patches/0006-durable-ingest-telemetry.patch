diff --git a/server/internal/ingestqueue/telemetry.go b/server/internal/ingestqueue/telemetry.go
new file mode 100644
index 0000000000000000000000000000000000000000..32ec348477295ae023e17dc549a89481aedaadbb
--- /dev/null
+++ b/server/internal/ingestqueue/telemetry.go
@@ -0,0 +1,307 @@
+package ingestqueue
+
+import (
+	"encoding/json"
+	"io"
+	"sync"
+	"time"
+)
+
+const DurableMetricNamespace = "mem9-on-aws/DurableIngest"
+
+type Telemetry interface {
+	Accepted()
+	Result(ResultMetrics)
+	SamplerHeartbeat()
+	QueueAge(time.Duration)
+}
+
+type ResultMetrics struct {
+	ResultClass        string
+	ErrorClass         string
+	QueueWait          time.Duration
+	IncludeQueueWait   bool
+	PlanDuration       time.Duration
+	ApplyDuration      time.Duration
+	TotalDuration      time.Duration
+	RetryCount         int
+	WarningCount       int
+	TruncatedFactCount int
+	ZeroFactSuccess    bool
+}
+
+type emfTelemetry struct {
+	stage  string
+	output io.Writer
+	now    func() time.Time
+	mu     sync.Mutex
+}
+
+type emfMetric struct {
+	Name string `json:"Name"`
+	Unit string `json:"Unit"`
+}
+
+type emfDirective struct {
+	Namespace  string      `json:"Namespace"`
+	Dimensions [][]string  `json:"Dimensions"`
+	Metrics    []emfMetric `json:"Metrics"`
+}
+
+type emfMetadata struct {
+	Timestamp         int64          `json:"Timestamp"`
+	CloudWatchMetrics []emfDirective `json:"CloudWatchMetrics"`
+}
+
+type emfEnvelope struct {
+	Metadata                          emfMetadata `json:"_aws"`
+	Stage                             string      `json:"stage"`
+	ResultClass                       string      `json:"result_class,omitempty"`
+	ErrorClass                        string      `json:"error_class,omitempty"`
+	JobsAccepted                      *int        `json:"JobsAccepted,omitempty"`
+	JobsSucceeded                     *int        `json:"JobsSucceeded,omitempty"`
+	JobsRetrying                      *int        `json:"JobsRetrying,omitempty"`
+	JobsDead                          *int        `json:"JobsDead,omitempty"`
+	JobsTerminated                    *int        `json:"JobsTerminated,omitempty"`
+	DeadlineTransientTerminalFailures *int        `json:"DeadlineTransientTerminalFailures,omitempty"`
+	QueueWaitMs                       *int64      `json:"QueueWaitMs,omitempty"`
+	PlanDurationMs                    *int64      `json:"PlanDurationMs,omitempty"`
+	ApplyDurationMs                   *int64      `json:"ApplyDurationMs,omitempty"`
+	TotalProcessingDurationMs         *int64      `json:"TotalProcessingDurationMs,omitempty"`
+	RetryCount                        *int        `json:"RetryCount,omitempty"`
+	Warnings                          *int        `json:"Warnings,omitempty"`
+	TruncatedFacts                    *int        `json:"TruncatedFacts,omitempty"`
+	ZeroFactSuccess                   *int        `json:"ZeroFactSuccess,omitempty"`
+	SamplerHeartbeat                  *int        `json:"SamplerHeartbeat,omitempty"`
+	OldestQueuedAgeMs                 *int64      `json:"OldestQueuedAgeMs,omitempty"`
+}
+
+var boundedErrorClasses = map[string]struct{}{
+	errorClassProxyValidationPermanent:   {},
+	errorClassMantle4xxPermanent:         {},
+	errorClassMantleTransient:            {},
+	errorClassDeadline:                   {},
+	errorClassOptimisticConflict:         {},
+	errorClassDatabaseContention:         {},
+	errorClassRuntimeUsageTransient:      {},
+	errorClassRuntimeReservationTooShort: {},
+	errorClassRuntimeQuotaDenied:         {},
+	errorClassCommitAmbiguous:            {},
+	errorClassPermanentUnknown:           {},
+	errorClassAttemptsExhausted:          {},
+}
+
+func NewEMFTelemetry(stage string, output io.Writer, now func() time.Time) Telemetry {
+	if now == nil {
+		now = time.Now
+	}
+	return &emfTelemetry{
+		stage:  stage,
+		output: output,
+		now:    now,
+	}
+}
+
+func (t *emfTelemetry) Accepted() {
+	t.write(
+		emfEnvelope{
+			Stage:        t.stage,
+			ResultClass:  "accepted",
+			JobsAccepted: metricValue(1),
+		},
+		[]emfDirective{metricDirective(
+			[]string{"stage", "result_class"},
+			countMetric("JobsAccepted"),
+		)},
+	)
+}
+
+func (t *emfTelemetry) Result(metrics ResultMetrics) {
+	resultClass := boundedResultClass(metrics.ResultClass)
+	record := emfEnvelope{
+		Stage:                     t.stage,
+		ResultClass:               resultClass,
+		PlanDurationMs:            metricValue(durationMilliseconds(metrics.PlanDuration)),
+		ApplyDurationMs:           metricValue(durationMilliseconds(metrics.ApplyDuration)),
+		TotalProcessingDurationMs: metricValue(durationMilliseconds(metrics.TotalDuration)),
+		RetryCount:                metricValue(nonNegative(metrics.RetryCount)),
+	}
+	directives := []emfDirective{metricDirective(
+		[]string{"stage", "result_class"},
+		millisecondMetric("PlanDurationMs"),
+		millisecondMetric("ApplyDurationMs"),
+		millisecondMetric("TotalProcessingDurationMs"),
+		countMetric("RetryCount"),
+	)}
+	if metrics.IncludeQueueWait || metrics.QueueWait != 0 {
+		record.QueueWaitMs = metricValue(durationMilliseconds(metrics.QueueWait))
+		directives[0].Metrics = append(
+			directives[0].Metrics,
+			millisecondMetric("QueueWaitMs"),
+		)
+	}
+
+	switch resultClass {
+	case "retrying":
+		record.ErrorClass = boundedErrorClass(metrics.ErrorClass)
+		record.JobsRetrying = metricValue(1)
+		directives = append(
+			directives,
+			metricDirective(
+				[]string{"stage", "result_class", "error_class"},
+				countMetric("JobsRetrying"),
+			),
+			metricDirective(
+				[]string{"stage"},
+				countMetric("JobsRetrying"),
+			),
+		)
+	case string(StateSucceeded):
+		record.JobsSucceeded = metricValue(1)
+		record.JobsTerminated = metricValue(1)
+		record.DeadlineTransientTerminalFailures = metricValue(0)
+		record.Warnings = metricValue(nonNegative(metrics.WarningCount))
+		record.TruncatedFacts = metricValue(nonNegative(metrics.TruncatedFactCount))
+		record.ZeroFactSuccess = metricValue(boolCount(metrics.ZeroFactSuccess))
+		directives = append(
+			directives,
+			metricDirective(
+				[]string{"stage", "result_class"},
+				countMetric("JobsSucceeded"),
+			),
+			metricDirective(
+				[]string{"stage"},
+				countMetric("JobsTerminated"),
+				countMetric("DeadlineTransientTerminalFailures"),
+				countMetric("Warnings"),
+				countMetric("TruncatedFacts"),
+				countMetric("ZeroFactSuccess"),
+			),
+		)
+	case string(StateDead):
+		errorClass := boundedErrorClass(metrics.ErrorClass)
+		record.ErrorClass = errorClass
+		record.JobsDead = metricValue(1)
+		record.JobsTerminated = metricValue(1)
+		record.DeadlineTransientTerminalFailures = metricValue(boolCount(
+			errorClass == errorClassDeadline || errorClass == errorClassMantleTransient,
+		))
+		directives = append(
+			directives,
+			metricDirective(
+				[]string{"stage", "result_class", "error_class"},
+				countMetric("JobsDead"),
+			),
+			metricDirective(
+				[]string{"stage"},
+				countMetric("JobsDead"),
+			),
+			metricDirective(
+				[]string{"stage"},
+				countMetric("JobsTerminated"),
+				countMetric("DeadlineTransientTerminalFailures"),
+			),
+		)
+	default:
+		return
+	}
+	t.write(record, directives)
+}
+
+func (t *emfTelemetry) SamplerHeartbeat() {
+	t.write(
+		emfEnvelope{
+			Stage:            t.stage,
+			SamplerHeartbeat: metricValue(1),
+		},
+		[]emfDirective{metricDirective(
+			[]string{"stage"},
+			countMetric("SamplerHeartbeat"),
+		)},
+	)
+}
+
+func (t *emfTelemetry) QueueAge(age time.Duration) {
+	t.write(
+		emfEnvelope{
+			Stage:             t.stage,
+			OldestQueuedAgeMs: metricValue(durationMilliseconds(age)),
+		},
+		[]emfDirective{metricDirective(
+			[]string{"stage"},
+			millisecondMetric("OldestQueuedAgeMs"),
+		)},
+	)
+}
+
+func (t *emfTelemetry) write(record emfEnvelope, directives []emfDirective) {
+	if t == nil || t.output == nil {
+		return
+	}
+	record.Metadata = emfMetadata{
+		Timestamp:         t.now().UnixMilli(),
+		CloudWatchMetrics: directives,
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	_ = json.NewEncoder(t.output).Encode(record)
+}
+
+func metricDirective(dimensions []string, metrics ...emfMetric) emfDirective {
+	return emfDirective{
+		Namespace:  DurableMetricNamespace,
+		Dimensions: [][]string{dimensions},
+		Metrics:    metrics,
+	}
+}
+
+func countMetric(name string) emfMetric {
+	return emfMetric{Name: name, Unit: "Count"}
+}
+
+func millisecondMetric(name string) emfMetric {
+	return emfMetric{Name: name, Unit: "Milliseconds"}
+}
+
+func boundedResultClass(class string) string {
+	switch class {
+	case string(StateRetryWait), "retrying":
+		return "retrying"
+	case string(StateSucceeded), string(StateDead):
+		return class
+	default:
+		return "other"
+	}
+}
+
+func boundedErrorClass(class string) string {
+	if _, ok := boundedErrorClasses[class]; ok {
+		return class
+	}
+	return "other"
+}
+
+func durationMilliseconds(duration time.Duration) int64 {
+	if duration < 0 {
+		return 0
+	}
+	return duration.Milliseconds()
+}
+
+func nonNegative(value int) int {
+	if value < 0 {
+		return 0
+	}
+	return value
+}
+
+func boolCount(value bool) int {
+	if value {
+		return 1
+	}
+	return 0
+}
+
+func metricValue[T any](value T) *T {
+	return &value
+}
