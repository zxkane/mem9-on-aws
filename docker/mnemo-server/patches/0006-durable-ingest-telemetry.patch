+func TestEMFTelemetryConcurrentWritersDoNotInterleave(t *testing.T) {
+	const writesPerKind = 20
+	var output bytes.Buffer
+	telemetry := NewEMFTelemetry("prod", &output, nil)
+	var writers sync.WaitGroup
+	for index := range writesPerKind * 4 {
+		writers.Add(1)
+		go func() {
+			defer writers.Done()
+			switch index % 4 {
+			case 0:
+				telemetry.Accepted()
+			case 1:
+				telemetry.Result(ResultMetrics{ResultClass: string(StateSucceeded)})
+			case 2:
+				telemetry.SamplerHeartbeat()
+			default:
+				telemetry.QueueAge(time.Duration(index) * time.Millisecond)
+			}
+		}()
+	}
+	writers.Wait()
+
+	records := telemetryRecords(t, output.String())
+	if len(records) != writesPerKind*4 {
+		t.Fatalf("EMF records = %d, want %d", len(records), writesPerKind*4)
+	}
+	counts := map[string]int{}
+	for _, record := range records {
+		switch {
+		case record["JobsAccepted"] == float64(1):
+			counts["accepted"]++
+		case record["JobsSucceeded"] == float64(1):
+			counts["result"]++
+		case record["SamplerHeartbeat"] == float64(1):
+			counts["heartbeat"]++
+		case record["OldestQueuedAgeMs"] != nil:
+			counts["queue_age"]++
+		}
+	}
+	for _, kind := range []string{"accepted", "result", "heartbeat", "queue_age"} {
+		if counts[kind] != writesPerKind {
+			t.Fatalf("%s records = %d, want %d", kind, counts[kind], writesPerKind)
+		}
+	}
+	assertBoundedMetricDimensions(t, records)
+}
