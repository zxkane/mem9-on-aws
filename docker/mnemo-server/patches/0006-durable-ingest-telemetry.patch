+	if records[2]["JobsSucceeded"] != float64(1) ||
+		records[2]["JobsTerminated"] != float64(1) ||
+		records[2]["DeadlineTransientTerminalFailures"] != float64(0) ||
+		records[2]["Warnings"] != float64(2) ||
+		records[2]["TruncatedFacts"] != float64(17) ||
+		records[2]["ZeroFactSuccess"] != float64(1) {
+		t.Fatalf("success record = %#v", records[2])
+	}
+	if records[3]["JobsDead"] != float64(1) ||
+		records[3]["JobsTerminated"] != float64(1) ||
+		records[3]["DeadlineTransientTerminalFailures"] != float64(1) ||
+		records[3]["error_class"] != "deadline" {
+		t.Fatalf("dead record = %#v", records[3])
+	}
+	if records[4]["SamplerHeartbeat"] != float64(1) ||
+		records[4]["stage"] != "prod" ||
+		!hasMetricDirective(records[4], []string{"stage"}, "SamplerHeartbeat") {
+		t.Fatalf("sampler heartbeat record = %#v", records[4])
+	}
+	if records[5]["OldestQueuedAgeMs"] != float64(660000) {
+		t.Fatalf("queue age record = %#v", records[5])
+	}
+	if !hasMetricDirective(
+		records[1],
+		[]string{"stage", "result_class", "error_class"},
+		"JobsRetrying",
