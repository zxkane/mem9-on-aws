+func (w *Worker) emitResult(
+	job *Job,
+	state State,
+	errorClass string,
+	attempt attemptTelemetry,
+	plan *AtomicPlan,
+) {
+	if w.config.Telemetry == nil {
+		return
+	}
+	retryCount := max(job.AttemptCount-1, 0)
+	if state == StateRetryWait {
+		retryCount = job.AttemptCount
+	}
+	metrics := ResultMetrics{
+		ResultClass:      string(state),
+		ErrorClass:       errorClass,
+		QueueWait:        attempt.queueWait,
+		IncludeQueueWait: attempt.includeQueueWait,
+		PlanDuration:     attempt.planDuration,
+		ApplyDuration:    attempt.applyDuration,
+		TotalDuration:    elapsed(w.now(), attempt.startedAt),
+		RetryCount:       retryCount,
+	}
+	if state == StateSucceeded && plan != nil {
+		metrics.WarningCount = plan.WarningCount
+		metrics.TruncatedFactCount = plan.TruncatedFactCount
+		metrics.ZeroFactSuccess = plan.ZeroFact
+	}
+	w.config.Telemetry.Result(metrics)
+}
+
+func (w *Worker) emitClaimedTerminal(job *Job) {
+	if w.config.Telemetry == nil || !job.TerminalTransition {
+		return
+	}
+	w.config.Telemetry.Result(ResultMetrics{
+		ResultClass:   string(job.State),
+		ErrorClass:    job.ErrorClass,
+		TotalDuration: elapsed(w.now(), job.ClaimedAt),
+		RetryCount:    max(job.AttemptCount-1, 0),
+	})
+}
+
+func (w *Worker) now() time.Time {
+	return w.config.Now()
+}
+
+func elapsed(end, start time.Time) time.Duration {
+	duration := end.Sub(start)
+	if duration < 0 {
+		return 0
+	}
+	return duration
+}
