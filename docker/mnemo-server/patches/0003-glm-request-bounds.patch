+		Content: strings.Repeat("\U0001F600", defaultMaxExtractionConversationRunes+100),
+	}}
+	formatted := prepareExtractionInput(input, defaultMaxExtractionConversationRunes).formatted
+	if !utf8.ValidString(formatted) {
