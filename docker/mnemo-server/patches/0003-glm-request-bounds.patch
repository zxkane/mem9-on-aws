+	if err != nil {
+		t.Fatalf("ExtractPhase1: %v", err)
+	}
+	if len(captured) == 0 {
+		t.Fatal("LLM request was not captured")
+	}
+
+	var rewritten map[string]any
+	if err := json.Unmarshal(captured, &rewritten); err != nil {
+		t.Fatalf("decode captured request: %v", err)
+	}
+	rewritten["max_tokens"] = 4096
+	finalBody, err := json.Marshal(rewritten)
+	if err != nil {
+		t.Fatalf("serialize rewritten request: %v", err)
+	}
+	const proxyLimitBytes = 1048576
+	if len(finalBody) >= proxyLimitBytes {
+		t.Fatalf("serialized request = %d bytes, must be below %d", len(finalBody), proxyLimitBytes)
+	}
