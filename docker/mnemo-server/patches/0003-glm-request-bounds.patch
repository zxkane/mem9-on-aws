+func TestMaxExtractionConversationRunesConfig(t *testing.T) {
+	if defaultMaxExtractionConversationRunes != 200000 {
+		t.Fatalf("default cap = %d, want 200000", defaultMaxExtractionConversationRunes)
+	}
+	t.Setenv("MNEMO_MAX_EXTRACTION_CONVERSATION_RUNES_TEST", "1234")
+	if got := envIngestPositiveInt("MNEMO_MAX_EXTRACTION_CONVERSATION_RUNES_TEST", 200000); got != 1234 {
+		t.Fatalf("valid override = %d, want 1234", got)
+	}
+	for _, raw := range []string{"", "0", "-1", "1.5", "not-a-number"} {
+		t.Setenv("MNEMO_MAX_EXTRACTION_CONVERSATION_RUNES_TEST", raw)
+		if got := envIngestPositiveInt("MNEMO_MAX_EXTRACTION_CONVERSATION_RUNES_TEST", 200000); got != 200000 {
+			t.Fatalf("raw %q: got %d, want fallback 200000", raw, got)
