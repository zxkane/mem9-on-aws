+	if got := utf8.RuneCountInString(formatted); got != defaultMaxExtractionConversationRunes {
+		t.Fatalf("formatted runes = %d, want %d", got, defaultMaxExtractionConversationRunes)
+	}
+	if !strings.HasSuffix(formatted, "...") {
+		t.Fatal("truncated conversation is missing ellipsis")
+	}
+}
