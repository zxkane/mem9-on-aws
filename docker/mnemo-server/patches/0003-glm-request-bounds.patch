+func TestWorstCaseExtractionRequestFitsProxyLimit(t *testing.T) {
+	restoreCap := maxExtractionConversationRunes
+	restoreDurable := ingestDurableOnly
+	maxExtractionConversationRunes = defaultMaxExtractionConversationRunes
+	ingestDurableOnly = true
+	defer func() {
+		maxExtractionConversationRunes = restoreCap
+		ingestDurableOnly = restoreDurable
+	}()
+
+	var captured []byte
+	mock := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var err error
+		captured, err = io.ReadAll(r.Body)
+		if err != nil {
+			t.Errorf("read request: %v", err)
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"choices":[{"message":{"content":"{\"facts\":[],\"message_tags\":[[]]}"}}]}`))
+	}))
+	defer mock.Close()
