+// truncateConversationRunes keeps the ellipsis inside maxRunes so the formatted
+// conversation's configured cap is a true upper bound.
+func truncateConversationRunes(s string, maxRunes int) string {
+	runes := []rune(s)
+	if len(runes) <= maxRunes {
+		return s
+	}
+	if maxRunes <= 0 {
+		return ""
+	}
+	if maxRunes <= 3 {
+		return string(runes[:maxRunes])
+	}
+	return string(runes[:maxRunes-3]) + "..."
+}
