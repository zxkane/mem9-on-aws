+// parseVec preserves client-computed embeddings during GetByID/read-modify-write.
+// Backport of mem9-ai/mem9 PR #470, scoped to the PostgreSQL backend.
+func parseVec(s sql.NullString) []float32 {
+	if !s.Valid || len(s.String) < 2 {
+		return nil
+	}
+	var vector pgvector.Vector
+	if err := vector.Parse(s.String); err != nil {
+		return nil
+	}
+	return vector.Slice()
+}
