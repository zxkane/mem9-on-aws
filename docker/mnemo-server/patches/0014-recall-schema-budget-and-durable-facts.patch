diff --git a/server/internal/handler/recall_schema_budget_integration_test.go b/server/internal/handler/recall_schema_budget_integration_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..58b80246477f8b5c9d39825ec990117d15e72efe
--- /dev/null
+++ b/server/internal/handler/recall_schema_budget_integration_test.go
@@ -0,0 +1,56 @@
+package handler
+
+import (
+	"context"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/qiffang/mnemos/server/internal/service"
+	"github.com/qiffang/mnemos/server/internal/tenant"
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+func TestRecallColdSchemaRespectsRequestBudget(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	db := testutil.OpenIsolatedPostgres(t, dsn)
+	db.SetMaxOpenConns(1)
+	held, err := db.Conn(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer held.Close()
+	// Let a regressed implementation finish without waiting for its 30s timeout.
+	release := time.AfterFunc(time.Second, func() { held.Close() })
+	defer release.Stop()
+	pool := tenant.NewPool(tenant.PoolConfig{Backend: "postgres"})
+	defer pool.Close()
+	tenantSvc := service.NewTenantService(nil, nil, pool, nil, "", 0, 0, false, nil)
+	srv := NewServer(tenantSvc, nil, "", nil, nil, "", false, service.ModeSmart, "postgres", slog.Default()).WithRecallRequestBudget(100*time.Millisecond, 20*time.Millisecond)
+	pass := func(next http.Handler) http.Handler { return next }
+	router := srv.Router(pass, pass, pass, pass)
+	req := postgresSessionDeleteRequest(t, http.MethodGet, "/v1alpha2/mem9s/memories?q=configuration", nil, "tenant-a", db)
+	rr := httptest.NewRecorder()
+	start := time.Now()
+	router.ServeHTTP(rr, req)
+	if elapsed := time.Since(start); elapsed > 750*time.Millisecond {
+		t.Fatalf("cold schema ignored Recall budget: %s", elapsed)
+	}
+	if rr.Code != http.StatusGatewayTimeout {
+		t.Fatalf("status=%d, want 504: %s", rr.Code, rr.Body.String())
+	}
+	if db.Stats().WaitCount == 0 {
+		t.Fatal("test never waited for the schema connection")
+	}
+	cached := false
+	srv.svcCache.Range(func(_, _ any) bool { cached = true; return false })
+	if cached {
+		t.Fatal("failed schema check cached services")
+	}
+}
