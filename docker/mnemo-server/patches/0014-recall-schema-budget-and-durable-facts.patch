@@ -0,0 +1,28 @@
+package service
+
+import "testing"
+
+func TestDurableOperationalFactsKeepConfigurationAndLessons(t *testing.T) {
+	old := ingestDurableOnly
+	ingestDurableOnly = true
+	defer func() { ingestDurableOnly = old }()
+	for _, text := range []string{
+		"The default temporary workspace for every CI job is /tmp/builds",
+		"The smoke test failed because the deploy role lacked permission; the bootstrap role policy must be updated before deployment",
+		"默认临时工作区固定为 /tmp/builds",
+		"调试日志不能记录凭据，原因是日志被长期保留",
+	} {
+		if reason, _ := longTermFactDropReason(ExtractedFact{Text: text, FactType: "fact"}); reason != "" {
+			t.Errorf("durable fact dropped as %s: %s", reason, text)
+		}
+	}
+	for _, fact := range []ExtractedFact{
+		{Text: "Smoke test failed today", FactType: "fact"},
+		{Text: "临时工作区是 /tmp/mem9", FactType: "fact"},
+		{Text: "The default temporary workspace is /tmp/builds", FactType: factTypeOperationalLog},
+	} {
+		if reason, _ := longTermFactDropReason(fact); reason == "" {
+			t.Errorf("transient fact was retained: %s", fact.Text)
+		}
+	}
+}
