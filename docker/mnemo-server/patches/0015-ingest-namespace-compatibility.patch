+package postgres
+
+import (
+	"context"
+	"os"
+	"testing"
+
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+func TestIngestSchemaScopeMismatchNeverFallsBack(t *testing.T) {
+	for _, tc := range []struct {
+		name, env string
+		scoped    bool
+	}{
+		{"scoped request before cutover", "MNEMO_TEST_POSTGRES_COMPAT_DSN", true},
+		{"unscoped request after cutover", "MNEMO_TEST_POSTGRES_DSN", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			dsn := os.Getenv(tc.env)
+			if dsn == "" {
+				t.Skip(tc.env + " is not set")
+			}
+			db := testutil.OpenIsolatedPostgres(t, dsn)
+			repo := NewIngestJobRepo(db)
+			input := enqueueInput("tenant", "session", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
+			if !tc.scoped {
+				input.NamespaceID = ""
+				input.PrincipalID = ""
+			}
+			if _, err := repo.Enqueue(context.Background(), input); err == nil {
+				t.Fatal("mismatched schema/scope was accepted")
+			}
+			var count int
+			if err := db.QueryRow(`SELECT count(*) FROM ingest_jobs`).Scan(&count); err != nil {
+				t.Fatal(err)
+			}
+			if count != 0 {
+				t.Fatal("mismatched enqueue persisted a job")
+			}
+		})
+	}
+}
+
+func TestIngestPartialCutoverDoesNotReturnForeignNamespaceJob(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_COMPAT_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_COMPAT_DSN is not set")
+	}
+	db := testutil.OpenIsolatedPostgres(t, dsn)
+	if _, err := db.Exec(`CREATE UNIQUE INDEX compat_namespace_key ON ingest_jobs (tenant_id, namespace_id, idempotency_key)`); err != nil {
+		t.Fatal(err)
+	}
+	repo := NewIngestJobRepo(db)
+	scoped := enqueueInput("tenant", "session", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
+	if _, err := repo.Enqueue(context.Background(), scoped); err != nil {
+		t.Fatal(err)
+	}
+	legacy := scoped
+	legacy.ID = "00000000-0000-4000-8000-000000000002"
+	legacy.NamespaceID = ""
+	legacy.PrincipalID = ""
+	if job, err := repo.Enqueue(context.Background(), legacy); err == nil || job != nil {
+		t.Fatalf("legacy conflict exposed a scoped job: %+v %v", job, err)
+	}
+	var count int
+	if err := db.QueryRow(`SELECT count(*) FROM ingest_jobs`).Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 1 {
+		t.Fatalf("row count=%d, want unchanged 1", count)
+	}
+}
