+	"github.com/qiffang/mnemos/server/internal/embed"
+	"github.com/qiffang/mnemos/server/internal/ingestqueue"
+	"github.com/qiffang/mnemos/server/internal/llm"
+	"github.com/qiffang/mnemos/server/internal/middleware"
+	"github.com/qiffang/mnemos/server/internal/repository/postgres"
+	"github.com/qiffang/mnemos/server/internal/service"
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+// TC-COMPAT-001..003: use the real additive schema, before namespace enforcement.
+func TestCompatibilityTranscriptCompletesBeforeNamespaceCutover(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_COMPAT_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_COMPAT_DSN is not set")
+	}
+	db := testutil.OpenIsolatedPostgres(t, dsn)
+	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
+	srv := NewServer(nil, nil, "", nil, nil, "", false, service.ModeSmart, "postgres", logger).WithDurableIngest(true)
+	body := map[string]any{"messages": []map[string]string{{"role": "user", "content": "Compatibility fixture uses PostgreSQL"}}, "session_id": "compat-session", "appId": "compat-app"}
+	var id string
+	for range 2 {
+		req := makeRequest(t, http.MethodPost, "/memories", body)
+		req = req.WithContext(middleware.WithAuthContext(req.Context(), &domain.AuthInfo{TenantID: "compat-tenant", TenantDB: db, AgentName: "compat-agent"}))
+		rr := httptest.NewRecorder()
+		srv.createMemory(rr, req)
+		if rr.Code != http.StatusAccepted {
+			t.Fatalf("enqueue got %d, want 202: %s", rr.Code, rr.Body.String())
+		}
+		var response map[string]string
+		if err := json.NewDecoder(rr.Body).Decode(&response); err != nil {
+			t.Fatalf("decode enqueue response: %v", err)
+		}
+		if id != "" && id != response["job_id"] {
+			t.Fatal("duplicate request returned another job")
+		}
+		id = response["job_id"]
+	}
+	repo := postgres.NewIngestJobRepo(db)
+	job, err := repo.Get(context.Background(), "compat-tenant", "", id)
+	if err != nil || job.State != ingestqueue.StateQueued {
+		t.Fatalf("202 did not commit a queued job: %v %v", job, err)
+	}
+	for _, scope := range [][2]string{{"other-tenant", ""}, {"compat-tenant", testutil.TestNamespaceID}} {
+		if _, err := repo.Get(context.Background(), scope[0], scope[1], id); !errors.Is(err, sql.ErrNoRows) {
+			t.Fatalf("foreign job read: %v", err)
+		}
+	}
+	vector := make([]float32, 1024)
+	vector[0] = 1
+	var llmCalls atomic.Int32
+	endpoint := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/embeddings" {
+			json.NewEncoder(w).Encode(map[string]any{"data": []map[string]any{{"embedding": vector}}})
+			return
+		}
+		llmCalls.Add(1)
+		json.NewEncoder(w).Encode(map[string]any{"choices": []map[string]any{{"message": map[string]string{"content": `{"facts":[{"text":"Compatibility fixture uses PostgreSQL","tags":["configuration"]}],"message_tags":[["configuration"]]}`}}}})
+	}))
+	defer endpoint.Close()
+	memoryRepo := postgres.NewMemoryRepo(db, false, "")
+	embedder := embed.New(embed.Config{BaseURL: endpoint.URL, Model: "test", Dims: 1024})
+	client := llm.New(llm.Config{APIKey: "local", BaseURL: endpoint.URL, Model: "test"})
+	processor := service.NewDurableProcessor(service.NewIngestService(memoryRepo, client, embedder, "", service.ModeSmart), nil, nil, "", nil, logger)
+	cfg := ingestqueue.DefaultWorkerConfig()
+	cfg.Enabled = true
+	cfg.PollInterval = time.Millisecond
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		done <- ingestqueue.NewWorker(repo, processor, "compat-tenant", "compat-worker", cfg, logger).Run(ctx)
+	}()
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		job, err = repo.Get(context.Background(), "compat-tenant", "", id)
+		if err != nil || job.State == ingestqueue.StateSucceeded || job.State == ingestqueue.StateDead {
+			break
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	cancel()
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if err != nil || job.State != ingestqueue.StateSucceeded {
+		t.Fatalf("compatibility job did not succeed: %+v %v", job, err)
+	}
+	if llmCalls.Load() == 0 {
+		t.Fatal("smart worker bypassed extraction")
+	}
+	var sessions, memories int
+	if err := db.QueryRow(`SELECT count(*) FROM sessions WHERE namespace_id IS NULL`).Scan(&sessions); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.QueryRow(`SELECT count(*) FROM memories WHERE namespace_id IS NULL`).Scan(&memories); err != nil {
+		t.Fatal(err)
+	}
+	if sessions != 1 || memories != 1 {
+		t.Fatalf("sessions=%d memories=%d, want one atomic result", sessions, memories)
+	}
+	found, err := memoryRepo.VectorSearch(context.Background(), vector, domain.MemoryFilter{}, 5)
+	if err != nil || len(found) != 1 {
+		t.Fatalf("compat recall: %v %v", found, err)
+	}
+}
