+package ingestqueue
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestCanonicalNamespaceAndActorAreImmutableInputs(t *testing.T) {
+	input := CanonicalInput{TenantID: "tenant-a", NamespaceID: "namespace-a", PrincipalID: "principal-a", SessionID: "shared-session", Mode: "smart", Messages: []Message{{Role: "user", Content: "synthetic team fact"}}}
+	original, err := Canonicalize(input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	replay, err := Canonicalize(input)
+	if err != nil || !bytes.Equal(original.Payload, replay.Payload) || original.IdempotencyKey != replay.IdempotencyKey {
+		t.Fatalf("unstable canonical replay: %v", err)
+	}
+	for _, field := range []string{"namespace", "principal"} {
+		changed := input
+		if field == "namespace" {
+			changed.NamespaceID = "namespace-b"
+		} else {
+			changed.PrincipalID = "principal-b"
+		}
+		canonical, err := Canonicalize(changed)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if bytes.Equal(original.Payload, canonical.Payload) || original.IdempotencyKey == canonical.IdempotencyKey {
+			t.Fatalf("%s absent from canonical identity", field)
+		}
+	}
+	input.PrincipalID = ""
+	if _, err := Canonicalize(input); err == nil {
+		t.Fatal("partial namespace identity accepted")
+	}
+}
