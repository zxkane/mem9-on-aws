+func TestEnqueueDisableAdmissionRace(t *testing.T)  { testDisableAdmissionRace(t, false) }
+func TestEmergencyRevokeAdmissionRace(t *testing.T) { testDisableAdmissionRace(t, true) }
+func testDisableAdmissionRace(t *testing.T, emergency bool) {
+	for _, enqueueFirst := range []bool{true, false} {
+		t.Run(fmt.Sprint(enqueueFirst), func(t *testing.T) {
+			db := ingestTestDB(t)
+			if emergency {
+				digest := sha256.Sum256([]byte("mem9-principal-v2\x00https://identity.example.com/pool\x00human\x00fixture-human"))
+				if _, err := db.Exec("UPDATE memory_principals SET principal_type='human', principal_key=$1 WHERE principal_id=$2", hex.EncodeToString(digest[:]), testutil.TestPrincipalID); err != nil {
+					t.Fatal(err)
+				}
+			}
+			operator := func(t *testing.T, db *sql.DB, disabled bool, lock string) (<-chan error, string) {
+				if emergency {
+					return testutil.NamespaceOperator(t, db, map[string]any{"command": "revoke-user", "emergency": true, "desired": lifecycleDesired(false)}, lock)
+				}
+				return lifecycleOperator(t, db, disabled, lock)
+			}
+			repo := NewIngestJobRepo(db)
+			input := enqueueInput("tenant-a", "session-a", strings.Repeat("d", 64))
+			if enqueueFirst {
+				reached, release := make(chan struct{}), make(chan struct{})
+				repo.enqueueHook = func(point string) error {
+					if point == "before_commit" {
+						close(reached)
+						<-release
+					}
+					return nil
+				}
+				done := make(chan error, 1)
+				go func() { _, err := repo.Enqueue(context.Background(), input); done <- err }()
+				select {
+				case <-reached:
+				case <-time.After(3 * time.Second):
+					close(release)
+					t.Fatal("enqueue did not reach pre-commit barrier")
+				}
+				pending, tag := operator(t, db, true, "")
+				func() { defer close(release); waitLifecycleOperator(t, db, tag) }()
+				if err := <-done; err != nil {
+					t.Fatal(err)
+				}
+				if err := <-pending; err != nil {
+					t.Fatal(err)
+				}
+				job, err := repo.Get(context.Background(), input.TenantID, input.NamespaceID, input.ID)
+				if err != nil || job.State != ingestqueue.StateDead {
+					t.Fatalf("job=%v err=%v", job, err)
+				}
+			} else {
+				conn, err := db.Conn(context.Background())
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer conn.Close()
+				_, err = conn.ExecContext(context.Background(), "SELECT pg_advisory_lock(hashtext('disable-first'))")
+				if err != nil {
+					t.Fatal(err)
+				}
+				pending, tag := operator(t, db, true, "disable-first")
+				waitLifecycleOperator(t, db, tag)
+				done := make(chan error, 1)
+				go func() { _, err := repo.Enqueue(context.Background(), input); done <- err }()
+				// Admission must remain pending while disabled status is uncommitted.
+				var waiting bool
+				deadline := time.Now().Add(3 * time.Second)
+				for time.Now().Before(deadline) {
+					_ = db.QueryRow("SELECT EXISTS(SELECT 1 FROM pg_stat_activity WHERE datname=current_database() AND application_name<>$1 AND wait_event_type='Lock')", tag).Scan(&waiting)
+					if waiting {
+						break
+					}
+					time.Sleep(5 * time.Millisecond)
+				}
+				_, _ = conn.ExecContext(context.Background(), "SELECT pg_advisory_unlock(hashtext('disable-first'))")
+				if err := <-pending; err != nil {
+					t.Fatal(err)
+				}
+				if err := <-done; err == nil {
+					t.Fatal("enqueue admitted after disable")
+				}
+				if !waiting {
+					t.Fatal("enqueue did not wait on disable")
+				}
+			}
+		})
+	}
+}
