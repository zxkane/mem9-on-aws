+			db := ingestTestDB(t)
+			repo := NewIngestJobRepo(db)
+			job, plan := prepareAtomicIntegrationPlan(t, repo, strings.Repeat("7", 64))
+			switch field {
+			case "tenant":
+				plan.TenantID = "foreign-tenant"
+			case "namespace":
+				plan.NamespaceID = testutil.TestOtherNamespaceID
+			case "principal":
+				plan.PrincipalID = testutil.TestOtherPrincipalID
+			}
+			plan, err := ingestqueue.FinalizePlan(plan)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := repo.SavePlan(context.Background(), job.LeaseRef(), plan); !errors.Is(err, ingestqueue.ErrPlanInvalid) {
+				t.Fatalf("save mismatch: %v", err)
+			}
+			if _, err := repo.ApplyPlan(context.Background(), job.LeaseRef(), plan); !errors.Is(err, ingestqueue.ErrPlanInvalid) {
+				t.Fatalf("apply mismatch: %v", err)
+			}
+			assertAtomicMutationCounts(t, repo, job, 0, 0, ingestqueue.StateApplying)
+		})
+	}
+}
+
+func TestEnqueueLifecycleRollbackReleasesAdmissionLocks(t *testing.T) {
+	db := ingestTestDB(t)
+	repo := NewIngestJobRepo(db)
+	input := enqueueInput("rollback-tenant", "session-a", strings.Repeat("8", 64))
+	repo.enqueueHook = func(point string) error {
+		if point == "before_commit" {
+			return errors.New("injected enqueue rollback")
+		}
+		return nil
+	}
+	if _, err := repo.Enqueue(context.Background(), input); err == nil {
+		t.Fatal("enqueue survived injected rollback")
+	}
+	var count int
+	if err := db.QueryRow("SELECT count(*) FROM ingest_jobs WHERE job_id=$1", input.ID).Scan(&count); err != nil || count != 0 {
+		t.Fatalf("partial queue admission %d %v", count, err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	job, err := NewIngestJobRepo(db).Enqueue(ctx, input)
+	if err != nil || !job.NewlyEnqueued {
+		t.Fatalf("rollback left locks or a replay row: %v %v", job, err)
+	}
+}
