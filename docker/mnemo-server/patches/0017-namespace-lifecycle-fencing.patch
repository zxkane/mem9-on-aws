@@ -0,0 +1,88 @@
+package testutil
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// NamespaceOperator runs the real Node operator against a migrated test clone.
+// Configuration stays in an owner-only file; credentials are environment-only.
+func NamespaceOperator(t testing.TB, db *sql.DB, request map[string]any, beforeCommitLock string) (<-chan error, string) {
+	t.Helper()
+	root := os.Getenv("MEM9_NAMESPACE_OPERATOR_ROOT")
+	if root == "" {
+		t.Fatal("MEM9_NAMESPACE_OPERATOR_ROOT is required for operator acceptance")
+	}
+	var database string
+	if err := db.QueryRow("SELECT current_database()").Scan(&database); err != nil {
+		t.Fatal(err)
+	}
+	u, err := url.Parse(os.Getenv("MNEMO_TEST_POSTGRES_DSN"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	u.Path = "/" + database
+	tag := "namespace-operator-" + database
+	q := u.Query()
+	q.Set("application_name", tag)
+	u.RawQuery = q.Encode()
+	data, err := json.Marshal(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	file := filepath.Join(t.TempDir(), "request.json")
+	if err := os.WriteFile(file, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	script := `import pg from './node_modules/pg/lib/index.js';
+import { readFile } from 'node:fs/promises';
+import { reconcileNamespaces } from './scripts/reconcile-memory-namespaces.mjs';
+import { manageAccess } from './scripts/manage-memory-access.mjs';
+const request=JSON.parse(await readFile(process.env.FIXTURE_CONFIG,'utf8'));
+const db=new pg.Client({connectionString:process.env.MNEMO_DSN});await db.connect();
+const query=db.query.bind(db);
+if(process.env.FIXTURE_COMMIT_LOCK) db.query=async(sql,args)=>{if(sql==='COMMIT') await query('SELECT pg_advisory_xact_lock(hashtext($1))',[process.env.FIXTURE_COMMIT_LOCK]);return query(sql,args)};
+const issuer='https://identity.example.com/pool';
+try {
+ if(request.command==='reconcile') await reconcileNamespaces({db,issuer,manageCognitoGroups:false,...request});
+ else await manageAccess({db,issuer,authMode:'oidc',externalIdentity:{issuer,sub:'fixture-human'},...request});
+} finally { await db.end(); }`
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	t.Cleanup(cancel)
+	cmd := exec.CommandContext(ctx, "node", "--input-type=module", "-e", script)
+	cmd.Dir = root
+	cmd.Env = []string{"PATH=" + os.Getenv("PATH"), "MNEMO_DSN=" + u.String(), "FIXTURE_CONFIG=" + file, "FIXTURE_COMMIT_LOCK=" + beforeCommitLock, "AWS_EC2_METADATA_DISABLED=true"}
+	done := make(chan error, 1)
+	go func() {
+		out, err := cmd.CombinedOutput()
+		if err != nil {
+			err = fmt.Errorf("operator: %w: %s", err, out)
+		}
+		done <- err
+	}()
+	return done, tag
+}
+
+func WaitForNamespaceOperator(t testing.TB, db *sql.DB, tag string) {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		var waiting bool
+		if err := db.QueryRow("SELECT EXISTS(SELECT 1 FROM pg_stat_activity WHERE application_name=$1 AND wait_event_type='Lock')", tag).Scan(&waiting); err != nil {
+			t.Fatal(err)
+		}
+		if waiting {
+			return
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatal("operator did not reach a database lock wait")
+}
