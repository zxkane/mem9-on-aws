+}
+
+func TestNamespaceDisableLinearizesBeforeFirstApplyForeignKey(t *testing.T) {
+	for _, applyFirst := range []bool{true, false} {
+		t.Run(fmt.Sprint(applyFirst), func(t *testing.T) {
+			db := ingestTestDB(t)
+			repo := NewIngestJobRepo(db)
+			job, plan := prepareAtomicIntegrationPlan(t, repo, strings.Repeat("c", 64))
+			if applyFirst {
+				reached, release := make(chan struct{}), make(chan struct{})
+				repo.applyHook = func(point string) error {
+					if point == "after_job_lock" {
+						close(reached)
+						<-release
+					}
+					return nil
+				}
+				applied := make(chan error, 1)
+				go func() { _, err := repo.ApplyPlan(context.Background(), job.LeaseRef(), plan); applied <- err }()
+				select {
+				case <-reached:
+				case <-time.After(3 * time.Second):
+					close(release)
+					t.Fatal("apply did not reach pre-FK barrier")
+				}
+				pending, tag := lifecycleOperator(t, db, true, "")
+				func() { defer close(release); waitLifecycleOperator(t, db, tag) }()
+				if err := <-applied; err != nil {
+					t.Fatal(err)
+				}
+				if err := <-pending; err != nil {
+					t.Fatal(err)
+				}
+				assertAtomicMutationCounts(t, repo, job, 1, 2, ingestqueue.StateSucceeded)
+			} else {
+				conn, err := db.Conn(context.Background())
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer conn.Close()
+				key := "cancel-before-commit"
+				if _, err = conn.ExecContext(context.Background(), "SELECT pg_advisory_lock(hashtext($1))", key); err != nil {
+					t.Fatal(err)
+				}
+				pending, tag := lifecycleOperator(t, db, true, key)
+				waitLifecycleOperator(t, db, tag)
+				applied := make(chan error, 1)
+				go func() { _, err := repo.ApplyPlan(context.Background(), job.LeaseRef(), plan); applied <- err }()
+				// The operator owns the job until its pending cancellation commits.
+				var waits int
+				deadline := time.Now().Add(3 * time.Second)
+				for time.Now().Before(deadline) {
+					_ = db.QueryRow("SELECT count(*) FROM pg_stat_activity WHERE datname=current_database() AND application_name<>$1 AND wait_event_type='Lock'", tag).Scan(&waits)
+					if waits > 0 {
+						break
+					}
+					time.Sleep(5 * time.Millisecond)
+				}
+				_, err = conn.ExecContext(context.Background(), "SELECT pg_advisory_unlock(hashtext($1))", key)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if waits == 0 {
+					t.Fatal("apply did not wait on uncommitted cancellation")
+				}
+				if err := <-pending; err != nil {
+					t.Fatal(err)
+				}
+				if err := <-applied; !errors.Is(err, ingestqueue.ErrLeaseLost) {
+					t.Fatalf("apply err=%v", err)
+				}
+				assertAtomicMutationCounts(t, repo, job, 0, 0, ingestqueue.StateDead)
+				if err := repo.Heartbeat(context.Background(), job.LeaseRef(), time.Minute); !errors.Is(err, ingestqueue.ErrLeaseLost) {
+					t.Fatalf("heartbeat: %v", err)
+				}
+				if err := repo.SavePlan(context.Background(), job.LeaseRef(), plan); !errors.Is(err, ingestqueue.ErrLeaseLost) {
+					t.Fatalf("save: %v", err)
+				}
+				if err := repo.ResumePlan(context.Background(), job.LeaseRef(), plan); !errors.Is(err, ingestqueue.ErrLeaseLost) {
+					t.Fatalf("start apply: %v", err)
+				}
+				active, _ := lifecycleOperator(t, db, false, "")
+				if err := <-active; err != nil {
+					t.Fatal(err)
+				}
+				input := enqueueInput(job.TenantID, job.SessionID, job.IdempotencyKey)
+				input.ID = "00000000-0000-4000-8000-000000000099"
+				replay := enqueueJob(t, repo, input)
+				if replay.ID != job.ID || replay.State != ingestqueue.StateDead {
+					t.Fatalf("cancelled replay resurrected: %s %s", replay.ID, replay.State)
+				}
+			}
+		})
+	}
+}
