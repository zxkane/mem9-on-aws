+	return map[string]any{"namespaces": []any{map[string]any{"slug": "test-team", "display_name": "Test Team", "cognito_group": "mem9-test-team", "default_role": "member", "jit_enabled": true, "status": state}}, "m2m_bindings": []any{}}
