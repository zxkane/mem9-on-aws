index 0000000..64a7fc1
--- /dev/null
+++ b/server/internal/middleware/namespace_concurrency_test.go
@@ -0,0 +1,214 @@
+package middleware
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+func waitAuthorizationLocks(t *testing.T, db *sql.DB, count int) {
+	t.Helper()
+	deadline := time.Now().Add(3 * time.Second)
+	for time.Now().Before(deadline) {
+		var n int
+		if err := db.QueryRow(`SELECT count(*) FROM pg_locks l JOIN pg_stat_activity a ON a.pid=l.pid WHERE a.datname=current_database() AND l.locktype='advisory' AND NOT l.granted`).Scan(&n); err != nil {
+			t.Fatal(err)
+		}
+		if n >= count {
+			return
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatal("authorizations did not contend on principal advisory lock")
+}
+
+func TestConcurrentHumanJITAndRevokedTombstones(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	for _, mode := range []string{"same-group", "different-groups", "revoked-before-first-use", "disabled"} {
+		t.Run(mode, func(t *testing.T) {
+			db := testutil.OpenIsolatedPostgres(t, dsn)
+			authorizer, _ := testNamespaceAuthorizer(t)
+			groupA, groupB, principalKey := bytesToHex(13), bytesToHex(14), bytesToHex(15)
+			for i, ns := range []string{testutil.TestNamespaceID, testutil.TestOtherNamespaceID} {
+				group := groupA
+				if i == 1 {
+					group = groupB
+				}
+				if _, err := db.Exec(`INSERT INTO memory_cognito_group_bindings(group_key,namespace_id,default_role,jit_enabled,status) VALUES($1,$2,'member',true,'active')`, group, ns); err != nil {
+					t.Fatal(err)
+				}
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			barrier, err := db.Conn(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer barrier.Close()
+			if _, err = barrier.ExecContext(ctx, "SELECT pg_advisory_lock(hashtext($1))", principalKey); err != nil {
+				t.Fatal(err)
+			}
+			const workers = 12
+			results := make(chan error, workers)
+			for i := 0; i < workers; i++ {
+				group := groupA
+				if mode == "different-groups" && i%2 == 1 {
+					group = groupB
+				}
+				go func() {
+					_, err := authorizer.resolveScope(ctx, db, "tenant-a", transportEnvelope{PrincipalType: "human", PrincipalKey: principalKey, GroupKeys: []string{group}})
+					results <- err
+				}()
+			}
+			func() {
+				defer barrier.ExecContext(ctx, "SELECT pg_advisory_unlock(hashtext($1))", principalKey)
+				waitAuthorizationLocks(t, db, workers)
+				if mode == "revoked-before-first-use" || mode == "disabled" {
+					status := "active"
+					if mode == "disabled" {
+						status = "disabled"
+					}
+					if _, err := barrier.ExecContext(ctx, `INSERT INTO memory_principals(principal_id,principal_key,principal_type,status) VALUES('jit-fixture',$1,'human',$2)`, principalKey, status); err != nil {
+						t.Fatal(err)
+					}
+					if mode == "revoked-before-first-use" {
+						if _, err := barrier.ExecContext(ctx, `INSERT INTO memory_namespace_memberships(namespace_id,principal_id,role,status,source_type,revoked_at) VALUES($1,'jit-fixture','member','revoked','operator',NOW())`, testutil.TestNamespaceID); err != nil {
+							t.Fatal(err)
+						}
+					}
+				}
+			}()
+			success := 0
+			for i := 0; i < workers; i++ {
+				err := <-results
+				if err == nil {
+					success++
+					continue
+				}
+				var denied *namespaceAuthError
+				if !errors.As(err, &denied) || (denied.status != http.StatusForbidden && denied.status != http.StatusConflict) {
+					t.Fatalf("unexpected authorization error: %v", err)
+				}
+			}
+			expected := workers
+			if mode == "different-groups" {
+				expected = workers / 2
+			}
+			if mode == "revoked-before-first-use" || mode == "disabled" {
+				expected = 0
+			}
+			if success != expected {
+				t.Fatalf("success=%d want %d", success, expected)
+			}
+			var principals, active int
+			if err := db.QueryRow("SELECT count(*) FROM memory_principals WHERE principal_key=$1", principalKey).Scan(&principals); err != nil {
+				t.Fatal(err)
+			}
+			if err := db.QueryRow(`SELECT count(*) FROM memory_namespace_memberships m JOIN memory_principals p USING(principal_id) WHERE p.principal_key=$1 AND m.status='active'`, principalKey).Scan(&active); err != nil {
+				t.Fatal(err)
+			}
+			wantActive := 1
+			if expected == 0 {
+				wantActive = 0
+			}
+			if principals != 1 || active != wantActive {
+				t.Fatalf("principals=%d active=%d", principals, active)
+			}
+			if mode == "revoked-before-first-use" {
+				var status string
+				if err := db.QueryRow("SELECT status FROM memory_namespace_memberships WHERE principal_id='jit-fixture'").Scan(&status); err != nil || status != "revoked" {
+					t.Fatalf("tombstone %s %v", status, err)
+				}
+			}
+		})
+	}
+}
+
+func TestHumanJITFailureRollsBackPrincipal(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	db := testutil.OpenIsolatedPostgres(t, dsn)
+	authorizer, _ := testNamespaceAuthorizer(t)
+	key, group := bytesToHex(25), bytesToHex(26)
+	if _, err := db.Exec(`INSERT INTO memory_cognito_group_bindings(group_key,namespace_id,default_role,jit_enabled,status) VALUES($1,$2,'member',true,'active')`, group, testutil.TestNamespaceID); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`CREATE FUNCTION reject_jit_fixture() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'fixture membership failure'; END $$; CREATE TRIGGER reject_jit_fixture BEFORE INSERT ON memory_namespace_memberships FOR EACH ROW EXECUTE FUNCTION reject_jit_fixture()`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := authorizer.resolveScope(context.Background(), db, "tenant-a", transportEnvelope{PrincipalType: "human", PrincipalKey: key, GroupKeys: []string{group}}); err == nil {
+		t.Fatal("expected membership failure")
+	}
+	var count int
+	if err := db.QueryRow("SELECT count(*) FROM memory_principals WHERE principal_key=$1", key).Scan(&count); err != nil || count != 0 {
+		t.Fatal(fmt.Sprintf("partial principal: %d %v", count, err))
+	}
+}
+
+func TestHumanJITRechecksAmbiguityAfterNamespaceLockWait(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	db := testutil.OpenIsolatedPostgres(t, dsn)
+	authorizer, _ := testNamespaceAuthorizer(t)
+	groupA, groupB, key := bytesToHex(31), bytesToHex(32), bytesToHex(33)
+	if _, err := db.Exec(`INSERT INTO memory_cognito_group_bindings(group_key,namespace_id,default_role,jit_enabled,status) VALUES($1,$2,'member',true,'active'),($3,$4,'member',true,'disabled')`, groupA, testutil.TestNamespaceID, groupB, testutil.TestOtherNamespaceID); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	operator, err := db.BeginTx(ctx, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer operator.Rollback()
+	if _, err := operator.ExecContext(ctx, "SELECT 1 FROM memory_namespaces WHERE namespace_id=$1 FOR NO KEY UPDATE", testutil.TestNamespaceID); err != nil {
+		t.Fatal(err)
+	}
+	result := make(chan error, 1)
+	go func() {
+		_, err := authorizer.resolveScope(ctx, db, "tenant-a", transportEnvelope{PrincipalType: "human", PrincipalKey: key, GroupKeys: []string{groupA, groupB}})
+		result <- err
+	}()
+	waited := false
+	deadline := time.Now().Add(3 * time.Second)
+	for time.Now().Before(deadline) {
+		if err := db.QueryRow("SELECT EXISTS(SELECT 1 FROM pg_stat_activity WHERE datname=current_database() AND wait_event_type='Lock')").Scan(&waited); err != nil {
+			t.Fatal(err)
+		}
+		if waited {
+			break
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	if !waited {
+		t.Fatal("authorization never waited on namespace")
+	}
+	if _, err := operator.ExecContext(ctx, "UPDATE memory_cognito_group_bindings SET status='active' WHERE group_key=$1", groupB); err != nil {
+		t.Fatal(err)
+	}
+	if err := operator.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	var denied *namespaceAuthError
+	if err := <-result; !errors.As(err, &denied) || denied.status != http.StatusConflict {
+		t.Fatalf("ambiguity must conflict, got %v", err)
+	}
+	var count int
+	if err := db.QueryRow("SELECT count(*) FROM memory_principals WHERE principal_key=$1", key).Scan(&count); err != nil || count != 0 {
+		t.Fatalf("ambiguous JIT side effects: %d %v", count, err)
+	}
+}
diff --git a/server/internal/middleware/namespace_m2m_concurrency_test.go b/server/internal/middleware/namespace_m2m_concurrency_test.go
