+func TestDurableNamespacePayloadOverridesFailBeforeProcessing(t *testing.T) {
+	for _, field := range []string{"tenant_id", "namespace_id", "principal_id", "missing_namespace", "missing_principal"} {
+		t.Run(field, func(t *testing.T) {
+			job := durableTestJob(t, ModeRaw)
+			job.NamespaceID = "namespace-a"
+			job.PrincipalID = "principal-a"
+			var payload map[string]any
+			if err := json.Unmarshal(job.CanonicalPayload, &payload); err != nil {
+				t.Fatal(err)
+			}
+			payload["namespace_id"], payload["principal_id"] = job.NamespaceID, job.PrincipalID
+			switch field {
+			case "missing_namespace":
+				delete(payload, "namespace_id")
+			case "missing_principal":
+				delete(payload, "principal_id")
+			default:
+				payload[field] = "foreign-value"
+			}
+			job.CanonicalPayload, _ = json.Marshal(payload)
+			factoryCalls := 0
+			processor := NewDurableProcessor(nil, nil, nil, "", nil, nil).WithNamespaceIngestFactory(func(persisted *ingestqueue.Job) *IngestService {
+				factoryCalls++
+				if persisted.NamespaceID != job.NamespaceID || persisted.PrincipalID != job.PrincipalID {
+					t.Fatal("factory used payload identity")
+				}
+				// Empty service would panic if any model/repository processing were attempted.
+				return &IngestService{}
+			})
+			if _, err := processor.Plan(context.Background(), job, 1); !errors.Is(err, ingestqueue.ErrPlanInvalid) {
+				t.Fatalf("payload mismatch: %v", err)
+			}
+			if factoryCalls != 1 {
+				t.Fatalf("factory calls=%d", factoryCalls)
+			}
+		})
+	}
+}
+
+func TestDurableReconciliationExcludesCloserForeignVectors(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	db := testutil.OpenIsolatedPostgres(t, dsn)
+	query := make([]float32, 1024)
+	query[0] = 1
+	scopeA := testutil.TestNamespaceScope()
+	scopeB := scopeA
+	scopeB.NamespaceID = testutil.TestOtherNamespaceID
+	scopeB.PrincipalID = testutil.TestOtherPrincipalID
+	for i, scope := range []domain.NamespaceScope{scopeA, scopeB} {
+		vector := append([]float32(nil), query...)
+		marker := "ALPHA_ONLY existing guidance"
+		if i == 0 {
+			vector[0], vector[1] = 0.8, 0.6
+		} else {
+			marker = "BETA_ONLY existing guidance"
+		}
+		repo := postgres.NewMemoryRepo(db, false, "", scope)
+		if err := repo.BulkCreate(context.Background(), []*domain.Memory{{ID: fmt.Sprintf("scope-memory-%d", i), Content: marker, Embedding: vector, MemoryType: domain.TypePinned, AgentID: "agent-a", AppID: "app-a", Version: 1}}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	embedServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_ = json.NewEncoder(w).Encode(map[string]any{"data": []any{map[string]any{"embedding": query}}})
+	}))
+	defer embedServer.Close()
+	var reconciliations atomic.Int32
+	model := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Error(err)
+		}
+		content := `{"facts":[{"text":"Uses scoped guidance","tags":[]}],"message_tags":[[]]}`
+		if strings.Contains(string(body), "Existing memories:") {
+			reconciliations.Add(1)
+			if !strings.Contains(string(body), "ALPHA_ONLY") || strings.Contains(string(body), "BETA_ONLY") {
+				t.Error("reconciliation received wrong namespace candidates")
+			}
+			content = `{"memory":[{"id":"0","text":"ALPHA_ONLY existing guidance","event":"NOOP"}]}`
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{"choices": []any{map[string]any{"message": map[string]any{"content": content}}}})
+	}))
+	defer model.Close()
+	processor := NewDurableProcessor(nil, nil, nil, "", nil, nil).WithNamespaceIngestFactory(func(job *ingestqueue.Job) *IngestService {
+		repo := postgres.NewMemoryRepo(db, false, "", domain.NamespaceScope{NamespaceID: job.NamespaceID, PrincipalID: job.PrincipalID})
+		return NewIngestService(repo, llm.New(llm.Config{APIKey: "local", BaseURL: model.URL, Model: "fixture"}), embed.New(embed.Config{APIKey: "local", BaseURL: embedServer.URL, Model: "fixture", Dims: 1024}), "", ModeSmart)
+	})
+	job := durableTestJob(t, ModeSmart)
+	job.NamespaceID = scopeA.NamespaceID
+	job.PrincipalID = scopeA.PrincipalID
+	var payload map[string]any
+	_ = json.Unmarshal(job.CanonicalPayload, &payload)
+	payload["namespace_id"] = job.NamespaceID
+	payload["principal_id"] = job.PrincipalID
+	job.CanonicalPayload, _ = json.Marshal(payload)
+	plan, err := processor.Plan(context.Background(), job, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if reconciliations.Load() != 1 || len(plan.Actions) != 0 {
+		t.Fatalf("reconciliations=%d actions=%d", reconciliations.Load(), len(plan.Actions))
+	}
+}
diff --git a/server/internal/testutil/namespace_operator.go b/server/internal/testutil/namespace_operator.go
