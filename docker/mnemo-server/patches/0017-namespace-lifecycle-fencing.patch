--- /dev/null
+++ b/server/internal/middleware/namespace_m2m_concurrency_test.go
@@ -0,0 +1,151 @@
+package middleware
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/qiffang/mnemos/server/internal/domain"
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+func m2mOperatorRequest(mode string) map[string]any {
+	ns := func(slug string) map[string]any {
+		return map[string]any{"slug": slug, "display_name": slug, "cognito_group": "mem9-" + slug, "default_role": "member", "jit_enabled": true, "status": "active"}
+	}
+	namespaces := []any{ns("test-team"), ns("other-team")}
+	binding := map[string]any{"client_key": bytesToHex(72), "principal_key": bytesToHex(71), "namespace_slug": "test-team", "role": "member", "status": "active"}
+	bindings := []any{binding}
+	request := map[string]any{"command": "reconcile"}
+	switch mode {
+	case "remap":
+		binding["namespace_slug"] = "other-team"
+		namespaces = []any{ns("other-team")}
+	case "replacement":
+		binding["principal_key"] = bytesToHex(73)
+	case "prune":
+		bindings = []any{}
+		request["authoritativeM2MNamespaceSlugs"] = []string{"test-team"}
+	}
+	request["desired"] = map[string]any{"namespaces": namespaces, "m2m_bindings": bindings}
+	return request
+}
+
+func waitAnyNamespaceLock(t *testing.T, db *sql.DB, excludedTag string) {
+	t.Helper()
+	deadline := time.Now().Add(3 * time.Second)
+	for time.Now().Before(deadline) {
+		var waiting bool
+		if err := db.QueryRow("SELECT EXISTS(SELECT 1 FROM pg_stat_activity WHERE datname=current_database() AND ($1='' OR application_name<>$1) AND wait_event_type='Lock')", excludedTag).Scan(&waiting); err != nil {
+			t.Fatal(err)
+		}
+		if waiting {
+			return
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatal("authorization did not reach its deterministic lock barrier")
+}
+
+func TestM2MAuthorizationSerializesWithReconciliation(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	for _, mode := range []string{"remap", "replacement", "prune"} {
+		for _, authFirst := range []bool{true, false} {
+			t.Run(fmt.Sprintf("%s/auth-first=%v", mode, authFirst), func(t *testing.T) {
+				db := testutil.OpenIsolatedPostgres(t, dsn)
+				authorizer, _ := testNamespaceAuthorizer(t)
+				initial, _ := testutil.NamespaceOperator(t, db, m2mOperatorRequest("initial"), "")
+				if err := <-initial; err != nil {
+					t.Fatal(err)
+				}
+				ctx, cancel := context.WithTimeout(context.Background(), 12*time.Second)
+				defer cancel()
+				identity := transportEnvelope{PrincipalType: "m2m", PrincipalKey: bytesToHex(71), ClientKey: bytesToHex(72)}
+				type authorization struct {
+					scope *domain.NamespaceScope
+					err   error
+				}
+				auth := make(chan authorization, 1)
+				startAuth := func() {
+					go func() {
+						scope, err := authorizer.resolveScope(ctx, db, "tenant-a", identity)
+						auth <- authorization{scope, err}
+					}()
+				}
+				barrier, err := db.Conn(ctx)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer barrier.Close()
+				const lock = "m2m-lifecycle-barrier"
+				if _, err := barrier.ExecContext(ctx, "SELECT pg_advisory_lock(hashtext($1))", lock); err != nil {
+					t.Fatal(err)
+				}
+				defer barrier.ExecContext(context.Background(), "SELECT pg_advisory_unlock(hashtext($1))", lock)
+				release := func() {
+					if _, err := barrier.ExecContext(ctx, "SELECT pg_advisory_unlock(hashtext($1))", lock); err != nil {
+						t.Fatal(err)
+					}
+				}
+				if authFirst {
+					// Pause the real authorizer after both parent locks, before it commits.
+					if _, err := db.Exec(`CREATE FUNCTION pause_auth_fixture() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN
+    IF current_setting('application_name') NOT LIKE 'namespace-operator-%' THEN PERFORM pg_advisory_xact_lock(hashtext('m2m-lifecycle-barrier')); END IF;
+    RETURN NEW; END $$;
+    CREATE TRIGGER pause_auth_fixture BEFORE UPDATE ON memory_principals FOR EACH ROW EXECUTE FUNCTION pause_auth_fixture()`); err != nil {
+						t.Fatal(err)
+					}
+					startAuth()
+					waitAnyNamespaceLock(t, db, "")
+					operator, tag := testutil.NamespaceOperator(t, db, m2mOperatorRequest(mode), "")
+					testutil.WaitForNamespaceOperator(t, db, tag)
+					release()
+					result := <-auth
+					if result.err != nil || result.scope.NamespaceID != testutil.TestNamespaceID {
+						t.Fatalf("accepted auth: %v %v", result.scope, result.err)
+					}
+					if err := <-operator; err != nil {
+						t.Fatal(err)
+					}
+				} else {
+					operator, tag := testutil.NamespaceOperator(t, db, m2mOperatorRequest(mode), lock)
+					testutil.WaitForNamespaceOperator(t, db, tag)
+					startAuth()
+					waitAnyNamespaceLock(t, db, tag)
+					release()
+					if err := <-operator; err != nil {
+						t.Fatal(err)
+					}
+					result := <-auth
+					if result.err == nil {
+						t.Fatalf("stale auth admitted: %+v", result.scope)
+					}
+				}
+				// A new request must see the final binding, never a partial membership.
+				if mode == "replacement" {
+					identity.PrincipalKey = bytesToHex(73)
+				}
+				scope, err := authorizer.resolveScope(ctx, db, "tenant-a", identity)
+				if mode == "prune" {
+					if err == nil {
+						t.Fatal("pruned client was admitted")
+					}
+				} else {
+					expected := testutil.TestNamespaceID
+					if mode == "remap" {
+						expected = testutil.TestOtherNamespaceID
+					}
+					if err != nil || scope.NamespaceID != expected {
+						t.Fatalf("final auth=%v err=%v", scope, err)
+					}
+				}
+			})
+		}
+	}
+}
