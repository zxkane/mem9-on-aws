+func lifecycleOperator(t *testing.T, db *sql.DB, disabled bool, beforeCommitLock string) (<-chan error, string) {
+	return testutil.NamespaceOperator(t, db, map[string]any{"command": "reconcile", "desired": lifecycleDesired(disabled)}, beforeCommitLock)
+}
+
+func waitLifecycleOperator(t *testing.T, db *sql.DB, tag string) {
