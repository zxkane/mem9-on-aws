@@ -0,0 +1,66 @@
+package postgres
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+func requireConstraint(t *testing.T, err error, code, name string) {
+	t.Helper()
+	var pgErr *pgconn.PgError
+	if !errors.As(err, &pgErr) || pgErr.Code != code || pgErr.ConstraintName != name {
+		t.Fatalf("expected %s/%s, got %v", code, name, err)
+	}
+}
+
+func TestNamespaceSessionAndPlanCompositeConstraints(t *testing.T) {
+	db := ingestTestDB(t)
+	nsA, nsB, p := testutil.TestNamespaceID, testutil.TestOtherNamespaceID, testutil.TestPrincipalID
+	session := `INSERT INTO sessions(id,namespace_id,principal_id,app_id,session_id,content_hash,role,content) VALUES($1,$2,$3,'app','shared-session',repeat('d',64),'user','synthetic')`
+	for i, ns := range []string{nsA, nsB} {
+		if _, err := db.Exec(session, fmt.Sprint("session-", i), ns, p); err != nil {
+			t.Fatal(err)
+		}
+	}
+	_, err := db.Exec(session, "session-duplicate", nsA, p)
+	requireConstraint(t, err, "23505", "uq_sessions_namespace_message")
+	if _, err := db.Exec(`UPDATE sessions SET content='only-a' WHERE namespace_id=$1 AND app_id='app' AND session_id='shared-session' AND content_hash=repeat('d',64)`, nsA); err != nil {
+		t.Fatal(err)
+	}
+	var content string
+	if err := db.QueryRow("SELECT content FROM sessions WHERE namespace_id=$1", nsB).Scan(&content); err != nil || content != "synthetic" {
+		t.Fatalf("B session changed %s %v", content, err)
+	}
+	for i, ns := range []string{nsA, nsB} {
+		if _, err := db.Exec(`INSERT INTO ingest_jobs(job_id,tenant_id,namespace_id,principal_id,idempotency_key) VALUES($1,'schema-tenant',$2,$3,repeat('9',64))`, fmt.Sprint("schema-job-", i), ns, p); err != nil {
+			t.Fatal(err)
+		}
+	}
+	_, err = db.Exec(`INSERT INTO ingest_jobs(job_id,tenant_id,namespace_id,principal_id,idempotency_key) VALUES('schema-job-duplicate','schema-tenant',$1,$2,repeat('9',64))`, nsA, p)
+	requireConstraint(t, err, "23505", "uq_ingest_jobs_namespace_idempotency")
+	plan := `INSERT INTO ingest_job_plans(tenant_id,namespace_id,principal_id,job_id,plan_revision,plan_hash,plan_payload,attempt_generation) VALUES($1,$2,$3,$4,$5,$6,'{}',1)`
+	hash := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+	for _, bad := range []struct{ tenant, ns, job string }{{"schema-tenant", nsB, "schema-job-0"}, {"foreign-tenant", nsA, "schema-job-0"}, {"schema-tenant", nsA, "missing-job"}} {
+		_, err = db.Exec(plan, bad.tenant, bad.ns, p, bad.job, 1, hash)
+		requireConstraint(t, err, "23503", "fk_ingest_job_plans_job_namespace")
+	}
+	for i, ns := range []string{nsA, nsB} {
+		if _, err := db.Exec(plan, "schema-tenant", ns, p, fmt.Sprint("schema-job-", i), 1, hash); err != nil {
+			t.Fatal(err)
+		}
+	}
+	_, err = db.Exec(plan, "schema-tenant", nsA, p, "schema-job-0", 1, "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
+	requireConstraint(t, err, "23505", "ingest_job_plans_pkey")
+	_, err = db.Exec(plan, "schema-tenant", nsA, p, "schema-job-0", 2, hash)
+	requireConstraint(t, err, "23505", "uq_ingest_job_plans_namespace_hash")
+	for _, table := range []string{"sessions", "ingest_jobs", "ingest_job_plans"} {
+		var nullable string
+		if err := db.QueryRow("SELECT is_nullable FROM information_schema.columns WHERE table_schema='public' AND table_name=$1 AND column_name='namespace_id'", table).Scan(&nullable); err != nil || nullable != "NO" {
+			t.Fatalf("%s nullable=%s err=%v", table, nullable, err)
+		}
+	}
+}
