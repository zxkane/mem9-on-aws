diff --git a/server/internal/repository/postgres/namespace_claim_plan_test.go b/server/internal/repository/postgres/namespace_claim_plan_test.go
new file mode 100644
index 0000000..add99f4
--- /dev/null
+++ b/server/internal/repository/postgres/namespace_claim_plan_test.go
@@ -0,0 +1,120 @@
+package postgres
+
+import (
+	"context"
+	"encoding/json"
+	"sort"
+	"testing"
+	"time"
+
+	"github.com/qiffang/mnemos/server/internal/ingestqueue"
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+type claimExplainNode struct {
+	Type     string             `json:"Node Type"`
+	Relation string             `json:"Relation Name"`
+	Index    string             `json:"Index Name"`
+	Alias    string             `json:"Alias"`
+	Rows     float64            `json:"Actual Rows"`
+	Removed  float64            `json:"Rows Removed by Filter"`
+	Loops    float64            `json:"Actual Loops"`
+	Plans    []claimExplainNode `json:"Plans"`
+}
+
+func TestNamespaceClaimQueryPlanBounds(t *testing.T) {
+	db := ingestTestDB(t)
+	// Equal ordering keys in two teams, four queued messages per FIFO scope,
+	// plus a much larger terminal history. Never disable sequential scans.
+	if _, err := db.Exec(`INSERT INTO ingest_jobs(job_id,tenant_id,namespace_id,principal_id,idempotency_key,
+  agent_id,app_id,session_id,state,created_at,available_at,completed_at)
+ SELECT 'claim-fixture-'||i,'claim-benchmark',CASE WHEN i%2=0 THEN $1 ELSE $2 END,$3,
+  md5(i::text)||md5(i::text),'agent','app',('session-'||(i/8)::text),
+  CASE WHEN i<=4096 THEN 'queued' ELSE 'succeeded' END,
+  TIMESTAMPTZ '2001-01-01Z'+i*INTERVAL '1 second',TIMESTAMPTZ '2001-01-01Z',
+  CASE WHEN i>4096 THEN TIMESTAMPTZ '2001-02-01Z' END
+ FROM generate_series(1,24096) i`, testutil.TestNamespaceID, testutil.TestOtherNamespaceID, testutil.TestPrincipalID); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec("ANALYZE ingest_jobs"); err != nil {
+		t.Fatal(err)
+	}
+	ctx := context.Background()
+	tx, err := db.BeginTx(ctx, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tx.Rollback()
+	repo := NewIngestJobRepo(db)
+	cursor, ok, err := repo.claimCursor(ctx, tx, "claim-benchmark")
+	if err != nil || !ok {
+		t.Fatalf("cursor %v %v", ok, err)
+	}
+	var raw []byte
+	if err := tx.QueryRowContext(ctx, "EXPLAIN (ANALYZE, BUFFERS, FORMAT JSON) "+claimableIngestJobScopesQuery, "claim-benchmark", nil, "", cursor.highCreatedAt, cursor.highJobID, maxClaimCandidateScopes).Scan(&raw); err != nil {
+		t.Fatal(err)
+	}
+	var explain []struct {
+		Plan      claimExplainNode
+		Execution float64 `json:"Execution Time"`
+	}
+	if err := json.Unmarshal(raw, &explain); err != nil {
+		t.Fatal(err)
+	}
+	cursorIndex := false
+	visited := float64(0)
+	var walk func(claimExplainNode)
+	walk = func(n claimExplainNode) {
+		if n.Relation == "ingest_jobs" && n.Type == "Seq Scan" {
+			t.Fatalf("queue sequential scan: %s", raw)
+		}
+		if n.Alias == "j" && n.Index == "idx_ingest_jobs_claim_cursor" {
+			cursorIndex = true
+			visited += (n.Rows + n.Removed) * n.Loops
+		}
+		for _, child := range n.Plans {
+			walk(child)
+		}
+	}
+	walk(explain[0].Plan)
+	if !cursorIndex || visited > 512 || explain[0].Plan.Rows > 32 {
+		t.Fatalf("cursor=%v visited=%.0f rows=%.0f plan=%s", cursorIndex, visited, explain[0].Plan.Rows, raw)
+	}
+	candidates, err := selectClaimableIngestJobScopes(ctx, tx, "claim-benchmark", cursor)
+	if err != nil || len(candidates) != 32 {
+		t.Fatalf("candidates=%d err=%v", len(candidates), err)
+	}
+	if err := tx.Commit(); err != nil {
+		t.Fatal(err)
+	}
+	// A locked queue head must be skipped without waiting for the row owner.
+	lock, err := db.BeginTx(ctx, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer lock.Rollback()
+	if _, err := lock.Exec("SELECT 1 FROM ingest_jobs WHERE job_id='claim-fixture-1' FOR UPDATE"); err != nil {
+		t.Fatal(err)
+	}
+	samples := make([]time.Duration, 24)
+	for i := range samples {
+		started := time.Now()
+		job, err := repo.Claim(ctx, "claim-benchmark", "benchmark-worker", time.Minute, ingestqueue.MaxAttempts)
+		samples[i] = time.Since(started)
+		if err != nil || job == nil {
+			t.Fatalf("claim %d job=%v err=%v", i, job, err)
+		}
+		if job.ID == "claim-fixture-1" || job.NamespaceID == "" || job.PrincipalID == "" {
+			t.Fatal("claim ignored lock or lost ownership")
+		}
+		if samples[i] > 250*time.Millisecond {
+			t.Fatalf("claim/lock wait exceeded 250ms: %s", samples[i])
+		}
+	}
+	sort.Slice(samples, func(i, j int) bool { return samples[i] < samples[j] })
+	p95 := samples[22]
+	if p95 > 100*time.Millisecond {
+		t.Fatalf("claim p95 %s exceeds 100ms", p95)
+	}
+	t.Logf("24,096 jobs, 2 namespaces, candidate rows=%.0f, returned=%.0f, explain=%.3fms, claim p95=%s", visited, explain[0].Plan.Rows, explain[0].Execution, p95)
+}
