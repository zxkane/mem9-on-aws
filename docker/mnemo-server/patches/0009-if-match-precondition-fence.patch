diff --git a/server/internal/handler/memory_ifmatch_test.go b/server/internal/handler/memory_ifmatch_test.go
new file mode 100644
index 0000000..ec0f078
--- /dev/null
+++ b/server/internal/handler/memory_ifmatch_test.go
@@ -0,0 +1,118 @@
+package handler
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/qiffang/mnemos/server/internal/domain"
+)
+
+// mem9-on-aws patch (issue #128): a stale `If-Match` must produce 412
+// Precondition Failed so a client can distinguish "someone else wrote" from
+// "your write landed". Previously it only logged a server-side warning and the
+// PUT succeeded, silently overwriting a concurrent ingest write.
+
+func TestUpdateMemoryStaleIfMatchReturns412(t *testing.T) {
+	memRepo := &testMemoryRepo{
+		createCalls: []*domain.Memory{
+			{ID: "mem-1", Content: "ingest wrote this", Version: 7},
+		},
+	}
+	srv := newTestServer(memRepo, &testSessionRepo{})
+
+	body := map[string]any{"content": "merged content"}
+	req := withURLParam(makeTenantRequest(t, http.MethodPut, "/memories/mem-1", body), "id", "mem-1")
+	req.Header.Set("If-Match", "3")
+	rr := httptest.NewRecorder()
+
+	srv.updateMemory(rr, req)
+
+	if rr.Code != http.StatusPreconditionFailed {
+		t.Fatalf("status = %d, want 412: %s", rr.Code, rr.Body.String())
+	}
+	if len(memRepo.updateCalls) != 0 {
+		t.Fatalf("UpdateOptimistic calls = %d, want 0 — the fence must reject before any write", len(memRepo.updateCalls))
+	}
+}
+
+func TestUpdateMemoryMatchingIfMatchStillSucceeds(t *testing.T) {
+	memRepo := &testMemoryRepo{
+		createCalls: []*domain.Memory{
+			{ID: "mem-1", Content: "fragment a", Version: 4},
+		},
+	}
+	srv := newTestServer(memRepo, &testSessionRepo{})
+
+	body := map[string]any{"content": "fragment a+b"}
+	req := withURLParam(makeTenantRequest(t, http.MethodPut, "/memories/mem-1", body), "id", "mem-1")
+	req.Header.Set("If-Match", "4")
+	rr := httptest.NewRecorder()
+
+	srv.updateMemory(rr, req)
+
+	if rr.Code != http.StatusOK {
+		t.Fatalf("status = %d, want 200: %s", rr.Code, rr.Body.String())
+	}
+	if len(memRepo.updateCalls) != 1 {
+		t.Fatalf("UpdateOptimistic calls = %d, want 1", len(memRepo.updateCalls))
+	}
+}
+
+func TestUpdateMemoryWithoutIfMatchIsUnfenced(t *testing.T) {
+	memRepo := &testMemoryRepo{
+		createCalls: []*domain.Memory{
+			{ID: "mem-1", Content: "whatever", Version: 9},
+		},
+	}
+	srv := newTestServer(memRepo, &testSessionRepo{})
+
+	body := map[string]any{"content": "overwritten"}
+	req := withURLParam(makeTenantRequest(t, http.MethodPut, "/memories/mem-1", body), "id", "mem-1")
+	rr := httptest.NewRecorder()
+
+	srv.updateMemory(rr, req)
+
+	if rr.Code != http.StatusOK {
+		t.Fatalf("status = %d, want 200 (no If-Match stays LWW): %s", rr.Code, rr.Body.String())
+	}
+}
+
+func TestUpdateMemoryUnparsableIfMatchIsRejected(t *testing.T) {
+	// `strconv.Atoi` silently yielded 0 on a garbled header, which disabled the
+	// fence exactly when a client thought it was fenced. Fail loud instead.
+	//
+	// The non-positive cases matter as much as the garbled one: `ifMatch = 0` is
+	// precisely the value that DISABLES the version predicate downstream, so
+	// accepting "0" or "-1" would leave a client believing it was fenced while
+	// the write ran unfenced. Pinning both stops a later simplification to a
+	// bare `if err != nil` from quietly reopening that hole.
+	//
+	// An absent or empty header is NOT in this table: it means "no precondition
+	// supplied", which stays last-writer-wins by design
+	// (TestUpdateMemoryWithoutIfMatchIsUnfenced).
+	for _, header := range []string{`W/"7"`, "0", "-1", "7.0", " 7"} {
+		t.Run("if-match="+header, func(t *testing.T) {
+			memRepo := &testMemoryRepo{
+				createCalls: []*domain.Memory{
+					{ID: "mem-1", Content: "ingest wrote this", Version: 7},
+				},
+			}
+			srv := newTestServer(memRepo, &testSessionRepo{})
+
+			body := map[string]any{"content": "merged content"}
+			req := withURLParam(makeTenantRequest(t, http.MethodPut, "/memories/mem-1", body), "id", "mem-1")
+			req.Header.Set("If-Match", header)
+			rr := httptest.NewRecorder()
+
+			srv.updateMemory(rr, req)
+
+			if rr.Code != http.StatusBadRequest {
+				t.Fatalf("status = %d, want 400 on If-Match %q: %s", rr.Code, header, rr.Body.String())
+			}
+			if len(memRepo.updateCalls) != 0 {
+				t.Fatalf("UpdateOptimistic calls = %d, want 0", len(memRepo.updateCalls))
+			}
+		})
+	}
+}
