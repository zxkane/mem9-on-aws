--- /dev/null
+++ b/server/internal/embed/maintenance_test.go
@@ -0,0 +1,55 @@
+package embed
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+func TestMaintenanceEmbeddingBoundary(t *testing.T) {
+	var calls atomic.Int32
+	target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		if r.Header.Get("X-Mem9-Maintenance") != "1" {
+			t.Error("missing maintenance attribution")
+		}
+		w.Header().Set("X-Mem9-Maintenance", "1")
+		vector := make([]float32, 1024)
+		vector[0] = 1
+		json.NewEncoder(w).Encode(map[string]any{"data": []any{map[string]any{"embedding": vector}}})
+	}))
+	defer target.Close()
+	e := New(Config{BaseURL: target.URL, Model: "fixture", Dims: 1024})
+	if vector, err := e.EmbedMaintenance(context.Background(), "synthetic fact"); err != nil || len(vector) != 1024 {
+		t.Fatalf("maintenance embedding: %v", err)
+	}
+	if _, err := e.EmbedMaintenance(context.Background(), strings.Repeat("x", 16385)); err == nil {
+		t.Fatal("unbounded input accepted")
+	}
+	external := New(Config{BaseURL: "https://example.com/v1", Model: "fixture", Dims: 1024})
+	if _, err := external.EmbedMaintenance(context.Background(), "private"); err == nil {
+		t.Fatal("external endpoint accepted")
+	}
+	redirect := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.Redirect(w, r, target.URL, http.StatusTemporaryRedirect)
+	}))
+	defer redirect.Close()
+	before := calls.Load()
+	e = New(Config{BaseURL: redirect.URL, Model: "fixture", Dims: 1024})
+	if _, err := e.EmbedMaintenance(context.Background(), "private"); err == nil {
+		t.Fatal("redirect accepted")
+	}
+	if calls.Load() != before {
+		t.Fatal("maintenance request followed redirect")
+	}
+	unaware := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.Write([]byte("{\"data\":[{\"embedding\":[1]}]}")) }))
+	defer unaware.Close()
+	e = New(Config{BaseURL: unaware.URL, Model: "fixture", Dims: 1024})
+	if _, err := e.EmbedMaintenance(context.Background(), "private"); err == nil {
+		t.Fatal("sidecar without maintenance admission accepted")
+	}
+}
diff --git a/server/internal/handler/consolidation.go b/server/internal/handler/consolidation.go
new file mode 100644
index 0000000..de14426
--- /dev/null
+++ b/server/internal/handler/consolidation.go
@@ -0,0 +1,238 @@
+package handler
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"io"
+	"math"
+	"net/http"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/pgvector/pgvector-go"
+	"github.com/qiffang/mnemos/server/internal/domain"
+)
+
+var consolidationID = regexp.MustCompile("^[0-9a-f]{64}$")
+
+// The early check avoids unbudgeted embedding/read work through old routes.
+// Repository writes also hold the mode lock until commit to close the race.
+func (s *Server) consolidationLegacyGuard(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		auth := authInfo(r)
+		if auth == nil || auth.Namespace == nil || auth.Namespace.PrincipalType != "service" ||
+			strings.HasPrefix(r.URL.Path, "/v1alpha2/mem9s/maintenance/consolidation-actions/") ||
+			(auth.Namespace.Service != "consolidation" && (r.Method == http.MethodGet || r.Method == http.MethodHead)) {
+			next.ServeHTTP(w, r)
+			return
+		}
+		if auth.TenantDB == nil {
+			respondError(w, http.StatusForbidden, "service route denied")
+			return
+		}
+		var control sql.NullString
+		if err := auth.TenantDB.QueryRowContext(r.Context(), "SELECT to_regclass('mem9_maintenance.execution_control')::text").Scan(&control); err != nil {
+			s.consolidationFailure(w, err)
+			return
+		}
+		if control.Valid {
+			var allowed bool
+			if err := auth.TenantDB.QueryRowContext(r.Context(), "SELECT mem9_maintenance.legacy_write_allowed()").Scan(&allowed); err != nil {
+				s.consolidationFailure(w, err)
+				return
+			}
+			if !allowed {
+				respondError(w, http.StatusForbidden, "legacy maintenance route disabled")
+				return
+			}
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+func (s *Server) WithConsolidationExecution(enabled bool) *Server {
+	s.consolidationExecution = enabled
+	return s
+}
+
+func (s *Server) consolidationAuth(w http.ResponseWriter, r *http.Request) (*domain.AuthInfo, string) {
+	auth := authInfo(r)
+	if !s.namespaceRequired || s.dbBackend != "postgres" || auth == nil || auth.TenantDB == nil ||
+		auth.Namespace == nil || auth.IsChain() || auth.Namespace.PrincipalType != "service" ||
+		auth.Namespace.Service != "consolidation" || auth.Namespace.TenantID != auth.TenantID ||
+		auth.Namespace.PrincipalID == "" || (auth.Namespace.Role != "member" && auth.Namespace.Role != "owner") {
+		respondError(w, http.StatusForbidden, "consolidation service required")
+		return nil, ""
+	}
+	id := chi.URLParam(r, "actionID")
+	if !consolidationID.MatchString(id) || r.URL.RawQuery != "" {
+		respondError(w, http.StatusBadRequest, "invalid consolidation action")
+		return nil, ""
+	}
+	return auth, id
+}
+
+func consolidationGeneration(w http.ResponseWriter, r *http.Request) (int64, error) {
+	d := json.NewDecoder(http.MaxBytesReader(w, r.Body, 256))
+	token, err := d.Token()
+	if err != nil || token != json.Delim('{') {
+		return 0, errors.New("object required")
+	}
+	token, err = d.Token()
+	if err != nil || token != "lease_generation" {
+		return 0, errors.New("lease required")
+	}
+	var generation int64
+	if err = d.Decode(&generation); err != nil || generation < 1 {
+		return 0, errors.New("invalid lease")
+	}
+	token, err = d.Token()
+	if err != nil || token != json.Delim('}') {
+		return 0, errors.New("unknown or duplicate field")
+	}
+	if err = d.Decode(new(any)); err != io.EOF {
+		return 0, errors.New("trailing data")
+	}
+	return generation, nil
+}
+
+func (s *Server) consolidationFailure(w http.ResponseWriter, err error) {
+	code := http.StatusServiceUnavailable
+	var databaseError *pgconn.PgError
+	if errors.As(err, &databaseError) {
+		switch databaseError.Code {
+		case "42501":
+			code = http.StatusForbidden
+		case "P0002":
+			code = http.StatusNotFound
+		case "55000":
+			code = http.StatusConflict
+		case "22023":
+			code = http.StatusBadRequest
+		}
+	}
+	// SQL errors and embedding error bodies can contain private material.
+	respondError(w, code, "consolidation operation unavailable")
+}
+
+func (s *Server) consolidationActionStatus(w http.ResponseWriter, r *http.Request) {
+	auth, id := s.consolidationAuth(w, r)
+	if auth == nil {
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 10*time.Second)
+	defer cancel()
+	var result json.RawMessage
+	err := auth.TenantDB.QueryRowContext(ctx, "SELECT mem9_maintenance.action_status($1,$2)", auth.Namespace.NamespaceID, id).Scan(&result)
+	if err != nil {
+		s.consolidationFailure(w, err)
+		return
+	}
+	respond(w, http.StatusOK, result)
+}
+
+func (s *Server) applyConsolidationAction(w http.ResponseWriter, r *http.Request) {
+	auth, id := s.consolidationAuth(w, r)
+	if auth == nil {
+		return
+	}
+	if !s.consolidationExecution {
+		respondError(w, http.StatusServiceUnavailable, "consolidation execution disabled")
+		return
+	}
+	generation, err := consolidationGeneration(w, r)
+	if err != nil {
+		respondError(w, http.StatusBadRequest, "body must contain one positive lease_generation")
+		return
+	}
+	// A disconnect is an ambiguous outcome. Finish the bounded operation so the
+	// client can recover from the durable receipt instead of replaying a new plan.
+	ctx, cancel := context.WithTimeout(context.WithoutCancel(r.Context()), 50*time.Second)
+	defer cancel()
+	namespace := auth.Namespace.NamespaceID
+	var raw json.RawMessage
+	err = auth.TenantDB.QueryRowContext(ctx, "SELECT mem9_maintenance.prepare_action($1,$2,$3)", namespace, id, generation).Scan(&raw)
+	if err != nil {
+		s.consolidationFailure(w, err)
+		return
+	}
+	var preparation struct {
+		Status  string `json:"status"`
+		Content string `json:"content"`
+		Hash    string `json:"content_hash"`
+		Token   string `json:"owner_token"`
+		Model   string `json:"embedding_model"`
+	}
+	if err = json.Unmarshal(raw, &preparation); err != nil {
+		s.consolidationFailure(w, err)
+		return
+	}
+	if preparation.Status == "applied" || preparation.Status == "noop" {
+		respond(w, http.StatusOK, raw)
+		return
+	}
+	if preparation.Status == "in_progress" {
+		respond(w, http.StatusAccepted, map[string]string{"status": "in_progress"})
+		return
+	}
+	if preparation.Status == "invalidated" {
+		respond(w, http.StatusConflict, map[string]string{"status": "invalidated"})
+		return
+	}
+	if preparation.Status == "embed" {
+		abandon := func() {
+			cleanup, cancel := context.WithTimeout(context.WithoutCancel(r.Context()), 5*time.Second)
+			defer cancel()
+			_, _ = auth.TenantDB.ExecContext(cleanup, "SELECT mem9_maintenance.abandon_preparation($1,$2,$3,$4)", namespace, id, generation, preparation.Token)
+		}
+		if s.embedder == nil || s.embedder.Model() != preparation.Model {
+			abandon()
+			respondError(w, http.StatusServiceUnavailable, "maintenance embedding unavailable")
+			return
+		}
+		vector, embedError := s.embedder.EmbedMaintenance(ctx, preparation.Content)
+		norm := float64(0)
+		for _, v := range vector {
+			norm += float64(v) * float64(v)
+		}
+		if embedError != nil || len(vector) != 1024 || norm < 0.99 || norm > 1.01 || math.IsNaN(norm) || math.IsInf(norm, 0) {
+			abandon()
+			respondError(w, http.StatusServiceUnavailable, "maintenance embedding unavailable")
+			return
+		}
+		_, err = auth.TenantDB.ExecContext(ctx, "SELECT mem9_maintenance.finish_preparation($1,$2,$3,$4,$5,$6::vector)",
+			namespace, id, generation, preparation.Token, preparation.Hash, pgvector.NewVector(vector))
+		if err != nil {
+			s.consolidationFailure(w, err)
+			return
+		}
+	} else if preparation.Status != "ready" {
+		respondError(w, http.StatusServiceUnavailable, "consolidation state unavailable")
+		return
+	}
+	err = auth.TenantDB.QueryRowContext(ctx, "SELECT mem9_maintenance.apply_action($1,$2,$3)", namespace, id, generation).Scan(&raw)
+	if err != nil {
+		s.consolidationFailure(w, err)
+		return
+	}
+	var result struct {
+		Status string `json:"status"`
+	}
+	if err = json.Unmarshal(raw, &result); err != nil {
+		s.consolidationFailure(w, err)
+		return
+	}
+	status := http.StatusOK
+	if result.Status == "rate_wait" || result.Status == "mutex_busy" {
+		status = http.StatusAccepted
+	}
+	if result.Status == "invalidated" {
+		status = http.StatusConflict
+	}
+	respond(w, status, raw)
+}
