+	send := func(service, method, path, body, ns string) *httptest.ResponseRecorder {
+		t.Helper()
+		request := httptest.NewRequest(method, path, strings.NewReader(body))
+		if service != "" {
+			now := time.Now().Unix()
+			hash := sha256.Sum256([]byte(body))
+			envelope, _ := json.Marshal(map[string]any{"v": 1, "kid": "a", "issuer": "maintenance:" + service, "issued_at": now, "expires_at": now + 30, "method": method, "path": path, "body_hash": hex.EncodeToString(hash[:]), "principal_type": "service", "principal_key": key(service), "client_key": key(service), "namespace_id": ns, "group_keys": []string{}})
