+		if method == "POST" {
+			path += "/batch-delete"
+		}
+		if response := send("consolidation", method, path, "", namespace); response.Code != 403 {
+			t.Fatalf("legacy HTTP route bypass: %d", response.Code)
+		}
+	}
+	if _, err := legacyRepo.SoftDelete(ctx, ids[0], "fixture"); !errors.Is(err, domain.ErrServiceMutationDenied) {
+		t.Fatalf("legacy service delete did not return the mode fence: %v", err)
+	}
+	path := "/v1alpha2/mem9s/maintenance/consolidation-actions/" + action
+	body := fmt.Sprintf(`{"lease_generation":%d}`, generation)
+	for _, service := range []string{"", "analysis", "cleanup"} {
+		if response := send(service, "POST", path+"/apply", body, namespace); response.Code != 403 {
+			t.Fatalf("non-consolidation caller got %d", response.Code)
+		}
+	}
+	if response := send("consolidation", "POST", path+"/apply", `{"lease_generation":1,"content":"injected"}`, namespace); response.Code != 400 {
+		t.Fatalf("unknown field got %d", response.Code)
+	}
+	if response := send("consolidation", "GET", path, "", testutil.TestOtherNamespaceID); response.Code != 404 {
+		t.Fatalf("foreign action got %d", response.Code)
+	}
+	server.WithConsolidationExecution(false)
+	if response := send("consolidation", "POST", path+"/apply", body, namespace); response.Code != 503 {
+		t.Fatalf("disabled execution got %d", response.Code)
+	}
+	server.WithConsolidationExecution(true)
+	response := send("consolidation", "POST", path+"/apply", body, namespace)
+	if response.Code != 200 {
+		t.Fatalf("apply got %d: %s", response.Code, response.Body.String())
+	}
+	first := response.Body.String()
+	if strings.Contains(first, "Synthetic") || strings.Contains(first, "embedding") || strings.Contains(first, "before_images") {
+		t.Fatal("private payload in receipt")
+	}
+	if response = send("consolidation", "POST", path+"/apply", body, namespace); response.Code != 200 || response.Body.String() != first {
+		t.Fatal("receipt replay differed")
+	}
+	if embeddingCalls.Load() != 1 {
+		t.Fatal("duplicate apply embedded again")
+	}
+	var active, deleted int
+	if err := db.QueryRow("SELECT count(*) FILTER(WHERE state='active'),count(*) FILTER(WHERE state='deleted') FROM memories WHERE namespace_id=$1 AND id=ANY($2)", namespace, ids).Scan(&active, &deleted); err != nil || active != 1 || deleted != 1 {
+		t.Fatalf("atomic outcome %d/%d: %v", active, deleted, err)
+	}
+	server.WithConsolidationExecution(false)
+	if response := send("consolidation", "GET", path, "", namespace); response.Code != 200 {
+		t.Fatal("paused execution hid existing receipt")
+	}
+}
