+func TestConsolidationBodyIsStrict(t *testing.T) {
+	for _, body := range []string{"null", "{}", "[]", `{"lease_generation":0}`, `{"lease_generation":"1"}`, `{"lease_generation":1,"lease_generation":2}`, `{"lease_generation":1,"budget":2000}`, `{"lease_generation":1} {}`} {
+		req := httptest.NewRequest("POST", "/", strings.NewReader(body))
+		if _, err := consolidationGeneration(httptest.NewRecorder(), req); err == nil {
+			t.Errorf("accepted malformed body %s", body)
+		}
+	}
+	req := httptest.NewRequest("POST", "/", strings.NewReader(`{"lease_generation":12}`))
+	if n, err := consolidationGeneration(httptest.NewRecorder(), req); err != nil || n != 12 {
+		t.Fatal("valid generation rejected")
+	}
+}
+
+func TestConsolidationPrivateHTTPPostgres(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	db := testutil.OpenIsolatedPostgres(t, dsn)
+	ctx := context.Background()
+	exec := func(query string, args ...any) {
+		t.Helper()
+		if _, err := db.ExecContext(ctx, query, args...); err != nil {
+			t.Fatalf("fixture SQL: %v", err)
+		}
+	}
+	key := func(s string) string {
+		return fmt.Sprintf("%x", sha256.Sum256([]byte("mem9-service-principal-v1\x00"+s)))
+	}
+	namespace := testutil.TestNamespaceID
+	exec("UPDATE memory_principals SET principal_key=$1,principal_type='service' WHERE principal_id=$2", key("consolidation"), testutil.TestPrincipalID)
+	exec("UPDATE memory_namespace_memberships SET source_type='service',role='member',status='active' WHERE principal_id=$1", testutil.TestPrincipalID)
+	exec("INSERT INTO memory_namespace_memberships(namespace_id,principal_id,role,source_type) VALUES($1,$2,'member','service') ON CONFLICT DO NOTHING", testutil.TestOtherNamespaceID, testutil.TestPrincipalID)
+	plannerID := uuid.NewString()
+	exec("INSERT INTO memory_principals(principal_id,principal_key,principal_type) VALUES($1,$2,'service')", plannerID, key("consolidation-planner"))
+	exec("INSERT INTO memory_namespace_memberships(namespace_id,principal_id,role,source_type) VALUES($1,$2,'viewer','service')", namespace, plannerID)
+	exec("SELECT mem9_maintenance.configure_namespace($1,$2,true)", namespace, strings.Repeat("a", 64))
+	policy := `{"limits":{"total":10,"rewrite":10,"delete":10,"archive":10,"mark":10},"bps":{"total":10000,"rewrite":10000,"delete":10000,"archive":10000,"mark":10000},"rate":100,"burst":100}`
+	exec("SELECT mem9_maintenance.set_budget_policy('stage',$1)", policy)
+	exec("SELECT mem9_maintenance.set_budget_policy($1,$2)", namespace, policy)
+	retired := "retired_" + strings.ReplaceAll(uuid.NewString(), "-", "")
+	exec("CREATE ROLE " + pgx.Identifier{retired}.Sanitize() + " NOLOGIN")
+	t.Cleanup(func() { db.Exec("DROP ROLE " + pgx.Identifier{retired}.Sanitize()) })
+	connect := func(capability string) *sql.DB {
+		t.Helper()
+		role := "http_" + capability + "_" + strings.ReplaceAll(uuid.NewString(), "-", "")
+		password := uuid.NewString()
+		var statement string
+		if err := db.QueryRow("SELECT format('CREATE ROLE %I LOGIN PASSWORD %L',$1::text,$2::text)", role, password).Scan(&statement); err != nil {
+			t.Fatal(err)
+		}
+		exec(statement)
+		exec("GRANT mem9_maintenance_" + capability + " TO " + pgx.Identifier{role}.Sanitize())
+		exec("INSERT INTO mem9_maintenance.database_callers(role_oid,capability) VALUES($1::regrole::oid,$2)", role, capability)
+		cfg, err := pgx.ParseConfig(dsn)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = db.QueryRow("SELECT current_database()").Scan(&cfg.Database); err != nil {
+			t.Fatal(err)
+		}
+		cfg.User = role
+		cfg.Password = password
+		connection := stdlib.OpenDB(*cfg)
+		if err = connection.Ping(); err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { connection.Close(); db.Exec("DROP ROLE " + pgx.Identifier{role}.Sanitize()) })
+		return connection
+	}
+	planner, executor, backend := connect("planner"), connect("executor"), connect("backend")
+	// The currently shipped server uses the migration-owning credential; the
+	// future dedicated server login inherits the explicit backend grant.
+	var legacyAllowed bool
+	if err := backend.QueryRow("SELECT mem9_maintenance.legacy_write_allowed()").Scan(&legacyAllowed); err != nil || !legacyAllowed {
+		t.Fatalf("backend fence grant: %v", err)
+	}
+	legacyScope := testutil.TestNamespaceScope()
+	legacyRepo := postgres.NewMemoryRepo(db, false, "", legacyScope)
+	legacyID := uuid.NewString()
+	if err := legacyRepo.Create(ctx, &domain.Memory{ID: legacyID, Content: "disabled mode compatibility", MemoryType: domain.TypeInsight, State: domain.StateActive, Version: 1}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := legacyRepo.SoftDelete(ctx, legacyID, "fixture"); err != nil {
+		t.Fatalf("disabled mode broke existing service writes: %v", err)
+	}
+	exec("SELECT mem9_maintenance.set_execution_mode('pr-http',true,ARRAY[$1::regrole::oid],'qwen3-embedding-0.6b')", retired)
+	humanID := uuid.NewString()
+	exec("INSERT INTO memory_principals(principal_id,principal_key,principal_type) VALUES($1,$2,'human')", humanID, key("human-fixture"))
+	exec("INSERT INTO memory_namespace_memberships(namespace_id,principal_id,role,source_type) VALUES($1,$2,'member','operator')", namespace, humanID)
+	humanRepo := postgres.NewMemoryRepo(db, false, "", domain.NamespaceScope{NamespaceID: namespace, PrincipalID: humanID, PrincipalType: "human", Role: "member"})
+	if err := humanRepo.Create(ctx, &domain.Memory{ID: uuid.NewString(), Content: "ordinary human write remains available", MemoryType: domain.TypeInsight, State: domain.StateActive, Version: 1}); err != nil {
+		t.Fatalf("execution mode blocked a human write: %v", err)
+	}
+	query := func(connection *sql.DB, query string, args ...any) json.RawMessage {
+		t.Helper()
+		var raw json.RawMessage
+		if err := connection.QueryRowContext(ctx, query, args...).Scan(&raw); err != nil {
+			t.Fatalf("fixture query: %v", err)
+		}
+		return raw
+	}
+	makeAction := func() (string, int64, []string) {
+		t.Helper()
+		ids := []string{uuid.NewString(), uuid.NewString()}
+		for i, id := range ids {
+			exec("INSERT INTO memories(id,namespace_id,content,tags,metadata,memory_type,state,version,embedding,created_by_principal_id,updated_by_principal_id) VALUES($1,$2,$3,'[]','{}','insight','active',1,(ARRAY[1::real]||array_fill(0::real,ARRAY[1023]))::vector,$4,$4)", id, namespace, fmt.Sprintf("Synthetic durable fact %d.", i), testutil.TestPrincipalID)
+		}
+		if _, err := planner.Exec("SELECT mem9_maintenance.consume_changes($1,1000)", namespace); err != nil {
+			t.Fatal(err)
+		}
+		var anchor string
+		var generation int64
+		if err := planner.QueryRow("SELECT memory_id,lease_generation FROM mem9_maintenance.claim_work($1,100,120) WHERE memory_id=ANY($2) LIMIT 1", namespace, ids).Scan(&anchor, &generation); err != nil {
+			t.Fatal(err)
+		}
+		var members json.RawMessage
+		if err := planner.QueryRow("SELECT jsonb_agg(jsonb_build_object('id',memory_id,'version',version,'fingerprint',fingerprint)) FROM mem9_maintenance.read_memories($1,$2)", namespace, ids).Scan(&members); err != nil {
+			t.Fatal(err)
+		}
+		payload, _ := json.Marshal(map[string]any{"context_hash": strings.Repeat("a", 64), "members": members, "result": "MERGE", "details": map[string]any{}, "valid_until": time.Now().UTC().Add(time.Hour)})
+		var classID string
+		if err := planner.QueryRow("SELECT mem9_maintenance.publish_classification($1,$2,$3,$4)", namespace, anchor, generation, string(payload)).Scan(&classID); err != nil {
+			t.Fatal(err)
+		}
+		queued := query(planner, "SELECT mem9_maintenance.queue_classification($1,$2)", namespace, classID)
+		var action struct {
+			ID string `json:"action_id"`
+		}
+		if err := json.Unmarshal(queued, &action); err != nil || action.ID == "" {
+			t.Fatal("action was not queued")
+		}
+		claimed := query(executor, "SELECT mem9_maintenance.claim_action($1,120)", namespace)
+		var lease struct {
+			Generation int64 `json:"lease_generation"`
+		}
+		if err := json.Unmarshal(claimed, &lease); err != nil || lease.Generation == 0 {
+			t.Fatal("action was not claimed")
+		}
+		return action.ID, lease.Generation, ids
+	}
+	var embeddingCalls atomic.Int32
+	embeddingEndpoint := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		embeddingCalls.Add(1)
+		if r.Header.Get("X-Mem9-Maintenance") != "1" {
+			t.Error("missing sidecar admission header")
+		}
+		w.Header().Set("X-Mem9-Maintenance", "1")
+		vector := make([]float32, 1024)
+		vector[1] = 1
+		json.NewEncoder(w).Encode(map[string]any{"data": []any{map[string]any{"embedding": vector}}})
+	}))
+	defer embeddingEndpoint.Close()
+	server := postgresSessionDeleteServer().WithNamespaceRequired(true).WithConsolidationExecution(true)
+	server.embedder = embed.New(embed.Config{BaseURL: embeddingEndpoint.URL, Model: "qwen3-embedding-0.6b", Dims: 1024})
+	encodeKey := func(b byte) string { return base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{b}, 32)) }
+	gateway, _ := json.Marshal(map[string]string{"a": encodeKey(1), "b": encodeKey(2)})
+	rings := map[string]map[string]string{}
+	for i, service := range []string{"consolidation", "cleanup", "analysis"} {
+		rings[service] = map[string]string{"active": "a", "a": encodeKey(byte(10 + i*2)), "b": encodeKey(byte(11 + i*2))}
+	}
+	serialized, _ := json.Marshal(rings)
