+			fact:         "Uses Go",
+			wantSkip:     true,
+		},
+		{
+			name:         "multi-message zero-fact",
+			messageCount: 2,
+			zeroFact:     true,
+			wantSkip:     false,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			callCount := 0
+			llmServer := httptest.NewServer(http.HandlerFunc(
+				func(w http.ResponseWriter, _ *http.Request) {
+					callCount++
+					facts := []map[string]any{}
+					if tc.fact != "" {
+						facts = append(facts, map[string]any{
+							"text": tc.fact,
+							"tags": []string{"tech"},
+						})
+					}
+					messageTags := make([][]string, tc.messageCount)
+					w.Header().Set("Content-Type", "application/json")
+					_ = json.NewEncoder(w).Encode(map[string]any{
+						"choices": []map[string]any{
+							{"message": map[string]any{
+								"content": mustJSON(t, map[string]any{
+									"facts":        facts,
+									"message_tags": messageTags,
+								}),
+							}},
+						},
+					})
+				},
+			))
+			defer llmServer.Close()
+
+			job := durableTestJob(t, ModeSmart)
+			var envelope durableCanonicalEnvelope
+			if err := json.Unmarshal(job.CanonicalPayload, &envelope); err != nil {
+				t.Fatal(err)
+			}
+			for len(envelope.Messages) < tc.messageCount {
+				envelope.Messages = append(envelope.Messages, durableMessage{
+					Role:    "assistant",
+					Content: "acknowledged",
+					Seq:     len(envelope.Messages),
+				})
+			}
+			var err error
+			job.CanonicalPayload, err = json.Marshal(envelope)
+			if err != nil {
+				t.Fatal(err)
+			}
+			job.PrescreenPolicyVersion = ingestqueue.PrescreenPolicyMessageCountV1
+			job.PrescreenWouldSkip = tc.wantSkip
+
+			processor := NewDurableProcessor(
+				NewIngestService(
+					&memoryRepoMock{},
+					llm.New(llm.Config{
+						APIKey:  "test-key",
+						BaseURL: llmServer.URL,
+						Model:   "test-model",
+					}),
+					nil,
+					"auto-model",
+					ModeSmart,
+				),
+				nil,
+				nil,
+				"",
+				nil,
+				nil,
+			)
+			plan, err := processor.Plan(context.Background(), job, 1)
+			if err != nil {
+				t.Fatalf("Plan: %v", err)
+			}
+			if callCount != 1 {
+				t.Fatalf("extraction calls = %d, want 1", callCount)
+			}
+			wantActions := 1
+			if tc.zeroFact {
+				wantActions = 0
+			}
+			if plan.ZeroFact != tc.zeroFact ||
+				len(plan.Actions) != wantActions ||
+				plan.PrescreenPolicyVersion != ingestqueue.PrescreenPolicyMessageCountV1 ||
+				plan.PrescreenWouldSkip != tc.wantSkip {
