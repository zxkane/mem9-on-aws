@@ -0,0 +1,78 @@
+package ingestqueue
+
+import "testing"
+
+func TestScorePrescreenMessageCountV1Threshold(t *testing.T) {
+	for _, tc := range []struct {
+		name         string
+		messageCount int
+		wouldSkip    bool
+	}{
+		{name: "empty boundary", messageCount: 0, wouldSkip: true},
+		{name: "one message", messageCount: 1, wouldSkip: true},
+		{name: "two messages", messageCount: 2, wouldSkip: false},
+		{name: "many messages", messageCount: 100, wouldSkip: false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got := ScorePrescreenMessageCountV1(tc.messageCount)
+			if got.PolicyVersion != PrescreenPolicyMessageCountV1 ||
+				got.WouldSkip != tc.wouldSkip {
+				t.Fatalf(
+					"score(%d) = %+v, want policy=%q wouldSkip=%v",
+					tc.messageCount,
+					got,
+					PrescreenPolicyMessageCountV1,
+					tc.wouldSkip,
+				)
+			}
+		})
+	}
+}
+
+func TestScoreJobPrescreenOnlyEvaluatesValidSmartPayloads(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		mode      string
+		payload   string
+		evaluated bool
+		wouldSkip bool
+	}{
+		{
+			name:      "one-message smart job",
+			mode:      "smart",
+			payload:   `{"messages":[{"role":"user","content":"private"}]}`,
+			evaluated: true,
+			wouldSkip: true,
+		},
+		{
+			name:      "two-message smart job",
+			mode:      "smart",
+			payload:   `{"messages":[{},{}]}`,
+			evaluated: true,
+			wouldSkip: false,
+		},
+		{
+			name:    "raw job",
+			mode:    "raw",
+			payload: `{"messages":[{}]}`,
+		},
+		{
+			name:    "malformed smart job",
+			mode:    "smart",
+			payload: `{"messages":`,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			job := &Job{Mode: tc.mode, CanonicalPayload: []byte(tc.payload)}
+			got, evaluated := scoreJobPrescreen(job)
+			if evaluated != tc.evaluated {
+				t.Fatalf("evaluated = %v, want %v", evaluated, tc.evaluated)
+			}
+			if evaluated &&
+				(got.PolicyVersion != PrescreenPolicyMessageCountV1 ||
+					got.WouldSkip != tc.wouldSkip) {
+				t.Fatalf("score = %+v, want wouldSkip=%v", got, tc.wouldSkip)
+			}
+		})
+	}
+}
