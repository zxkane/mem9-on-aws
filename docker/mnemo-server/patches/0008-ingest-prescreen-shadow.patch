+func TestPostgresDurableWorkerPrescreenShadowOutcomes(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+
+	for _, tc := range []struct {
+		name          string
+		jobID         string
+		fact          string
+		wantZeroFact  bool
+		wantMemories  int
+		wantFalseSkip float64
+	}{
+		{
+			name:          "one-message zero-fact",
+			jobID:         "10600000-0000-4000-8000-abcdef000030",
+			wantZeroFact:  true,
+			wantMemories:  0,
+			wantFalseSkip: 0,
+		},
+		{
+			name:          "one-message fact-producing",
+			jobID:         "10600000-0000-4000-8000-abcdef000031",
+			fact:          "Uses Go",
+			wantMemories:  1,
+			wantFalseSkip: 1,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			db := testutil.OpenIsolatedPostgres(t, dsn)
+			jobRepo := postgres.NewIngestJobRepo(db)
+			memoryRepo := postgres.NewMemoryRepo(db, false, "")
+
+			var llmCalls atomic.Int32
+			llmServer := httptest.NewServer(http.HandlerFunc(
+				func(w http.ResponseWriter, _ *http.Request) {
+					llmCalls.Add(1)
+					facts := []map[string]any{}
+					if tc.fact != "" {
+						facts = append(facts, map[string]any{
+							"text": tc.fact,
+							"tags": []string{"tech"},
+						})
+					}
+					w.Header().Set("Content-Type", "application/json")
+					_ = json.NewEncoder(w).Encode(map[string]any{
+						"choices": []map[string]any{
+							{"message": map[string]any{
+								"content": mustJSON(t, map[string]any{
+									"facts":        facts,
+									"message_tags": [][]string{{}},
+								}),
+							}},
+						},
+					})
+				},
+			))
+			defer llmServer.Close()
+
+			canonical, err := ingestqueue.Canonicalize(ingestqueue.CanonicalInput{
+				TenantID:  "tenant-prescreen",
+				AgentID:   "agent-prescreen",
+				AppID:     "app-prescreen",
+				SessionID: "session-prescreen",
+				Mode:      "smart",
+				Messages: []ingestqueue.Message{{
+					Role:    "user",
+					Content: "PRIVATE-INTEGRATION-CONTENT",
+				}},
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err := jobRepo.Enqueue(context.Background(), ingestqueue.EnqueueInput{
+				ID:               tc.jobID,
+				TenantID:         "tenant-prescreen",
+				IdempotencyKey:   canonical.IdempotencyKey,
+				CanonicalPayload: canonical.Payload,
+				AgentID:          "agent-prescreen",
+				AppID:            "app-prescreen",
+				SessionID:        "session-prescreen",
+				Mode:             "smart",
+			}); err != nil {
+				t.Fatalf("Enqueue: %v", err)
+			}
+
+			client := llm.New(llm.Config{
+				APIKey:  "test-key",
+				BaseURL: llmServer.URL,
+				Model:   "test-model",
+			})
+			committed := make(chan struct{})
+			processor := &prescreenIntegrationProcessor{
+				DurableProcessor: NewDurableProcessor(
+					NewIngestService(memoryRepo, client, nil, "", ModeSmart),
+					nil,
+					nil,
+					"",
+					nil,
+					nil,
+				),
+				committed: committed,
+			}
+			var output bytes.Buffer
+			cfg := ingestqueue.DefaultWorkerConfig()
+			cfg.Enabled = true
+			cfg.PollInterval = time.Millisecond
+			cfg.Telemetry = ingestqueue.NewEMFTelemetry("test", &output, nil)
+			ctx, cancel := context.WithCancel(context.Background())
+			done := make(chan error, 1)
+			go func() {
+				done <- ingestqueue.NewWorker(
+					jobRepo,
+					processor,
+					"tenant-prescreen",
+					"worker-prescreen",
+					cfg,
+					slog.New(slog.NewTextHandler(io.Discard, nil)),
+				).Run(ctx)
+			}()
+			select {
+			case <-committed:
+			case <-time.After(3 * time.Second):
+				cancel()
+				<-done
+				t.Fatal("durable worker did not reach post-commit")
+			}
+			cancel()
+			if err := <-done; err != nil {
+				t.Fatalf("worker Run: %v", err)
+			}
+
+			job, err := jobRepo.Get(
+				context.Background(),
+				"tenant-prescreen",
+				tc.jobID,
+			)
+			if err != nil {
+				t.Fatalf("Get: %v", err)
+			}
+			var sessions, memories int
+			if err := db.QueryRow(`SELECT count(*) FROM sessions`).Scan(&sessions); err != nil {
+				t.Fatal(err)
+			}
+			if err := db.QueryRow(`SELECT count(*) FROM memories`).Scan(&memories); err != nil {
+				t.Fatal(err)
+			}
+			if job.State != ingestqueue.StateSucceeded ||
+				sessions != 1 ||
+				memories != tc.wantMemories ||
+				llmCalls.Load() != 1 {
+				t.Fatalf(
+					"outcome state=%s sessions=%d memories=%d llm=%d",
+					job.State,
+					sessions,
+					memories,
+					llmCalls.Load(),
+				)
+			}
+
+			var prescreen map[string]any
+			for _, line := range strings.Split(strings.TrimSpace(output.String()), "\n") {
+				var record map[string]any
+				if err := json.Unmarshal([]byte(line), &record); err != nil {
+					t.Fatalf("decode EMF: %v", err)
+				}
+				if record["PrescreenEvaluated"] == float64(1) {
+					prescreen = record
+				}
+			}
+			if prescreen == nil ||
+				prescreen["PrescreenWouldSkip"] != float64(1) ||
+				prescreen["PrescreenFalseSkip"] != tc.wantFalseSkip ||
+				prescreen["policy_version"] !=
+					ingestqueue.PrescreenPolicyMessageCountV1 {
+				t.Fatalf("pre-screen record = %#v; output=%s", prescreen, output.String())
+			}
+			if strings.Contains(output.String(), "PRIVATE-INTEGRATION-CONTENT") {
+				t.Fatalf("EMF leaked content: %s", output.String())
+			}
+
+			var planPayload []byte
+			if err := db.QueryRow(`
+				SELECT plan_payload
+				FROM ingest_job_plans
+				WHERE tenant_id = $1 AND job_id = $2 AND state = 'applied'`,
+				"tenant-prescreen",
+				tc.jobID,
+			).Scan(&planPayload); err != nil {
+				t.Fatal(err)
+			}
+			var plan ingestqueue.AtomicPlan
+			if err := json.Unmarshal(planPayload, &plan); err != nil {
+				t.Fatal(err)
+			}
+			if plan.ZeroFact != tc.wantZeroFact ||
+				plan.PrescreenPolicyVersion !=
+					ingestqueue.PrescreenPolicyMessageCountV1 ||
+				!plan.PrescreenWouldSkip {
+				t.Fatalf("applied plan = %+v", plan)
+			}
+		})
+	}
+}
