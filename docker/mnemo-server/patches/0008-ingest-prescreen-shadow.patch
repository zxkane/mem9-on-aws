--- /dev/null
+++ b/server/internal/ingestqueue/prescreen.go
@@ -0,0 +1,35 @@
+package ingestqueue
+
+import "encoding/json"
+
+const PrescreenPolicyMessageCountV1 = "msg-count-le-1-v1"
+
+type PrescreenDecision struct {
+	PolicyVersion string
+	WouldSkip     bool
+}
+
+func ScorePrescreenMessageCountV1(messageCount int) PrescreenDecision {
+	return PrescreenDecision{
+		PolicyVersion: PrescreenPolicyMessageCountV1,
+		WouldSkip:     messageCount <= 1,
+	}
+}
+
+func scoreJobPrescreen(job *Job) (PrescreenDecision, bool) {
+	if job == nil || job.Mode != "smart" {
+		return PrescreenDecision{}, false
+	}
+	var envelope struct {
+		Messages []json.RawMessage `json:"messages"`
+	}
+	if err := json.Unmarshal(job.CanonicalPayload, &envelope); err != nil ||
+		len(envelope.Messages) == 0 {
+		return PrescreenDecision{}, false
+	}
+	return ScorePrescreenMessageCountV1(len(envelope.Messages)), true
+}
+
+func knownPrescreenPolicyVersion(version string) bool {
+	return version == PrescreenPolicyMessageCountV1
+}
