+func TestDurableProcessorOmitsPrescreenForSmartRawFallback(t *testing.T) {
+	job := durableTestJob(t, ModeSmart)
+	job.PrescreenPolicyVersion = ingestqueue.PrescreenPolicyMessageCountV1
+	job.PrescreenWouldSkip = true
+	processor := NewDurableProcessor(
+		NewIngestService(&memoryRepoMock{}, nil, nil, "auto-model", ModeSmart),
+		nil,
+		nil,
+		"",
+		nil,
+		nil,
+	)
+
+	plan, err := processor.Plan(context.Background(), job, 1)
+	if err != nil {
+		t.Fatalf("Plan: %v", err)
+	}
+	if len(plan.Actions) != 1 ||
+		plan.Actions[0].Content != "User: remember these facts" {
+		t.Fatalf("raw fallback plan = %+v", plan)
+	}
+	if plan.PrescreenPolicyVersion != "" || plan.PrescreenWouldSkip {
+		t.Fatalf("raw fallback persisted pre-screen decision: %+v", plan)
+	}
+}
