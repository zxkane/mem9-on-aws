+
+type prescreenIntegrationProcessor struct {
+	*DurableProcessor
+	committed chan struct{}
+}
+
+func (p *prescreenIntegrationProcessor) PostCommit(
+	ctx context.Context,
+	job *ingestqueue.Job,
+	plan ingestqueue.AtomicPlan,
+	result ingestqueue.ApplyResult,
+) {
+	p.DurableProcessor.PostCommit(ctx, job, plan, result)
+	close(p.committed)
+}
