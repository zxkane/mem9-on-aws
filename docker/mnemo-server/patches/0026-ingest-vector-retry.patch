+// Retry only the read before reconciliation. Reusing the embedding and scoped
+// repository avoids repeating extraction, model calls, or memory mutations.
+// Exhaustion remains an error so incomplete lookup cannot create duplicates.
+func (s *IngestService) reconciliationVectorSearch(ctx context.Context, vector []float32, filter domain.MemoryFilter, limit int) ([]domain.Memory, error) {
+	for attempt := 1; ; attempt++ {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		matches, err := s.memories.VectorSearch(ctx, vector, filter, limit)
+		if contextErr := ctx.Err(); contextErr != nil {
+			return nil, contextErr
+		}
+		if !errors.Is(err, domain.ErrNamespaceVectorTimeout) || attempt == 3 {
+			return matches, err
+		}
+		slog.Warn("reconciliation vector lookup retry", "attempt", attempt, "error_class", "namespace_vector_timeout")
+		timer := time.NewTimer(time.Duration(attempt) * 250 * time.Millisecond)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return nil, ctx.Err()
+		case <-timer.C:
+		}
+	}
+}
