+func TestNamespaceSamplerForeignOlderJobAndAuthorization(t *testing.T) {
+	db := ingestTestDB(t)
+	repo := NewIngestJobRepo(db)
+	if _, _, err := repo.OldestQueuedAge(context.Background(), "tenant-a", testutil.TestNamespaceID); !errors.Is(err, ingestqueue.ErrSamplerScopeDenied) {
+		t.Fatalf("missing sampler identity was accepted: %v", err)
+	}
+	seedSamplerAccess(t, db)
+	input := enqueueInput("tenant-a", "session-a", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
+	a := enqueueJob(t, repo, input)
+	input.ID = "00000000-0000-4000-8000-000000000002"
+	input.NamespaceID = testutil.TestOtherNamespaceID
+	input.PrincipalID = testutil.TestOtherPrincipalID
+	input.IdempotencyKey = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
+	b := enqueueJob(t, repo, input)
+	for _, item := range []struct {
+		id      string
+		minutes int
+	}{{a.ID, 3}, {b.ID, 31}} {
+		if _, err := db.Exec(`UPDATE ingest_jobs SET created_at=statement_timestamp()-make_interval(mins => $2) WHERE job_id=$1`, item.id, item.minutes); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, item := range []struct {
+		ns  string
+		age time.Duration
+	}{{testutil.TestNamespaceID, 3 * time.Minute}, {testutil.TestOtherNamespaceID, 31 * time.Minute}} {
+		age, present, err := repo.OldestQueuedAge(context.Background(), "tenant-a", item.ns)
+		if err != nil || !present || age < item.age || age > item.age+5*time.Second {
+			t.Fatalf("namespace age=%v present=%v error=%v", age, present, err)
+		}
+	}
+	if age, present, err := repo.OldestQueuedAge(context.Background(), "other-tenant", testutil.TestNamespaceID); err != nil || present || age != 0 {
+		t.Fatalf("foreign tenant age=%v present=%v err=%v", age, present, err)
+	}
+	for _, change := range []struct {
+		sql  string
+		undo string
+	}{
+		{`UPDATE memory_principals SET status='disabled' WHERE principal_id=$1`, `UPDATE memory_principals SET status='active' WHERE principal_id=$1`},
+		{`UPDATE memory_namespace_memberships SET status='revoked' WHERE principal_id=$1`, `UPDATE memory_namespace_memberships SET status='active' WHERE principal_id=$1`},
+		{`UPDATE memory_namespace_memberships SET source_type='operator' WHERE principal_id=$1`, `UPDATE memory_namespace_memberships SET source_type='service' WHERE principal_id=$1`},
+	} {
+		if _, err := db.Exec(change.sql, samplerTestPrincipalID); err != nil {
+			t.Fatal(err)
+		}
+		if _, _, err := repo.OldestQueuedAge(context.Background(), "tenant-a", testutil.TestNamespaceID); !errors.Is(err, ingestqueue.ErrSamplerScopeDenied) {
+			t.Fatal("unauthorized sampler read succeeded")
+		}
+		if _, err := db.Exec(change.undo, samplerTestPrincipalID); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := db.Exec(`UPDATE memory_namespaces SET status='disabled' WHERE namespace_id=$1`, testutil.TestNamespaceID); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := repo.OldestQueuedAge(context.Background(), "tenant-a", testutil.TestNamespaceID); !errors.Is(err, ingestqueue.ErrSamplerScopeDenied) {
+		t.Fatal("disabled namespace read succeeded")
+	}
+	namespaces, err := repo.ListActiveNamespaces(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, ns := range namespaces {
+		if ns == testutil.TestNamespaceID {
+			t.Fatal("enumerated disabled namespace")
+		}
+	}
+	if len(namespaces) == 0 {
+		t.Fatal("active namespace metadata missing")
+	}
+}
