+const samplerTestPrincipalID = "70000000-0000-4000-8000-000000000105"
+
+func seedSamplerAccess(t *testing.T, db *sql.DB) {
+	t.Helper()
+	key := fmt.Sprintf("%x", sha256.Sum256([]byte("mem9-service-principal-v1\x00sampler")))
+	if _, err := db.Exec(`INSERT INTO memory_principals (principal_id, principal_key, principal_type, status)
+		VALUES ($1, $2, 'service', 'active') ON CONFLICT DO NOTHING`, samplerTestPrincipalID, key); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`INSERT INTO memory_namespace_memberships (namespace_id, principal_id, role, status, source_type)
+		SELECT namespace_id, $1, 'viewer', 'active', 'service' FROM memory_namespaces
+		ON CONFLICT DO NOTHING`, samplerTestPrincipalID); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestNamespaceSamplerRequiresScopeBeforeDatabase(t *testing.T) {
+	if _, _, err := NewIngestJobRepo(nil).OldestQueuedAge(context.Background(), "tenant-a", ""); !errors.Is(err, ingestqueue.ErrSamplerScopeDenied) {
+		t.Fatal("missing namespace was accepted")
+	}
+}
+
+func TestNamespaceSamplerCompatibilityBacklogFailsClosed(t *testing.T) {
+	for _, activeNamespaces := range []bool{false, true} {
+		t.Run(fmt.Sprintf("active_namespaces_%v", activeNamespaces), func(t *testing.T) {
+			db := ingestTestDB(t)
+			// Recreate additive nullability only in this isolated migrated clone.
+			// The supplied fully enforced template is never modified.
+			if _, err := db.Exec(`
+				ALTER TABLE ingest_jobs DROP CONSTRAINT ingest_jobs_pkey CASCADE;
+				ALTER TABLE ingest_jobs ALTER COLUMN namespace_id DROP NOT NULL,
+				  ALTER COLUMN principal_id DROP NOT NULL;
+				ALTER TABLE ingest_jobs ADD PRIMARY KEY (job_id);
+				UPDATE memory_namespace_migration_state SET phase='additive_ready',
+				  checkpoint=NULL, legacy_namespace_id=NULL, legacy_principal_id=NULL,
+				  legacy_namespace_slug=NULL, legacy_namespace_display_name=NULL,
+				  legacy_principal_key=NULL WHERE singleton_id;
+				INSERT INTO ingest_jobs (job_id, tenant_id, idempotency_key, canonical_payload, state, created_at)
+				VALUES ('80000000-0000-4000-8000-000000000105', 'sampler-compat-fixture',
+				  repeat('c',64), convert_to('{}','UTF8'), 'queued', statement_timestamp()-interval '31 minutes');
+			`); err != nil {
+				t.Fatal(err)
+			}
+			if !activeNamespaces {
+				if _, err := db.Exec(`UPDATE memory_namespaces SET status='disabled'`); err != nil {
+					t.Fatal(err)
+				}
+			}
+			var pending int
+			if err := db.QueryRow(`SELECT count(*) FROM ingest_jobs WHERE namespace_id IS NULL AND state='queued'`).Scan(&pending); err != nil {
+				t.Fatal(err)
+			}
+			if pending != 1 {
+				t.Fatal("compatibility fixture must contain a real unscoped queued job")
+			}
+			if _, err := NewIngestJobRepo(db).ListActiveNamespaces(context.Background()); !errors.Is(err, ingestqueue.ErrSamplerNotEnforced) {
+				t.Fatalf("legacy backlog yielded an authoritative namespace sample: %v", err)
+			}
+		})
+	}
+}
