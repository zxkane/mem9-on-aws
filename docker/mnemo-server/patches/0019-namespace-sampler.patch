+func TestNamespaceSamplerInitializationPreservesRevocation(t *testing.T) {
+	db := ingestTestDB(t)
+	repo := NewIngestJobRepo(db)
+	ctx := context.Background()
+	key := fmt.Sprintf("%x", sha256.Sum256([]byte("mem9-service-principal-v1\x00sampler")))
+	// Mutate only the isolated clone. The shared migrated template is untouched.
+	if _, err := db.Exec(`DELETE FROM memory_namespace_memberships WHERE principal_id IN
+		(SELECT principal_id FROM memory_principals WHERE principal_key=$1)`, key); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`DELETE FROM memory_principals WHERE principal_key=$1`, key); err != nil {
+		t.Fatal(err)
+	}
+	if err := repo.InitializeSamplerMemberships(ctx); err != nil {
+		t.Fatal(err)
+	}
+	var principalID, principalStatus string
+	if err := db.QueryRow(`SELECT principal_id,status FROM memory_principals WHERE principal_key=$1 AND principal_type='service'`, key).Scan(&principalID, &principalStatus); err != nil {
+		t.Fatal(err)
+	}
+	if principalStatus != "active" {
+		t.Fatal("new sampler principal is not active")
+	}
+	var count, expected int
+	if err := db.QueryRow(`SELECT count(*) FROM memory_namespaces WHERE status='active'`).Scan(&expected); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.QueryRow(`SELECT count(*) FROM memory_namespace_memberships WHERE principal_id=$1 AND status='active' AND role='viewer' AND source_type='service'`, principalID).Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != expected {
+		t.Fatalf("initial sampler grants=%d want=%d", count, expected)
+	}
+	if _, err := db.Exec(`UPDATE memory_namespace_memberships SET status='revoked' WHERE principal_id=$1 AND namespace_id=$2`, principalID, testutil.TestNamespaceID); err != nil {
+		t.Fatal(err)
+	}
+	if err := repo.InitializeSamplerMemberships(ctx); err != nil {
+		t.Fatal(err)
+	}
+	var status string
+	if err := db.QueryRow(`SELECT status FROM memory_namespace_memberships WHERE principal_id=$1 AND namespace_id=$2`, principalID, testutil.TestNamespaceID).Scan(&status); err != nil {
+		t.Fatal(err)
+	}
+	if status != "revoked" {
+		t.Fatal("startup reactivated a revoked membership")
+	}
+	if _, err := db.Exec(`UPDATE memory_principals SET status='disabled' WHERE principal_id=$1`, principalID); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`DELETE FROM memory_namespace_memberships WHERE principal_id=$1 AND namespace_id=$2`, principalID, testutil.TestOtherNamespaceID); err != nil {
+		t.Fatal(err)
+	}
+	if err := repo.InitializeSamplerMemberships(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.QueryRow(`SELECT status FROM memory_principals WHERE principal_id=$1`, principalID).Scan(&status); err != nil {
+		t.Fatal(err)
+	}
+	if status != "disabled" {
+		t.Fatal("startup reactivated a disabled principal")
+	}
+	if err := db.QueryRow(`SELECT count(*) FROM memory_namespace_memberships WHERE principal_id=$1 AND namespace_id=$2`, principalID, testutil.TestOtherNamespaceID).Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 0 {
+		t.Fatal("startup granted membership to a disabled sampler")
+	}
+}
