@@ -0,0 +1,93 @@
+package ingestqueue
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"log/slog"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestNamespaceSamplerAggregateRequiresEverySample(t *testing.T) {
+	for _, scenario := range []string{"maximum", "empty", "partial", "enumeration", "compatibility", "all-empty"} {
+		t.Run(scenario, func(t *testing.T) {
+			var output, logs bytes.Buffer
+			calls := 0
+			repo := &fakeRepo{
+				listNamespaces: func(context.Context) ([]string, error) {
+					if scenario == "compatibility" {
+						return nil, ErrSamplerNotEnforced
+					}
+					if scenario == "enumeration" {
+						return nil, errors.New("private-enumeration-error")
+					}
+					if scenario == "empty" {
+						return nil, nil
+					}
+					return []string{"private-namespace-a", "private-namespace-b"}, nil
+				},
+				oldestAge: func(ctx context.Context, tenant, namespace string) (time.Duration, bool, error) {
+					calls++
+					if tenant != "private-tenant" {
+						t.Fatalf("wrong tenant: %s", tenant)
+					}
+					if _, ok := ctx.Deadline(); !ok {
+						t.Fatal("missing sample deadline")
+					}
+					if scenario == "all-empty" {
+						return 0, false, nil
+					}
+					if namespace == "private-namespace-a" {
+						return 3 * time.Minute, true, nil
+					}
+					if namespace != "private-namespace-b" {
+						t.Fatalf("wrong namespace: %s", namespace)
+					}
+					if scenario == "partial" {
+						return 0, false, errors.New("private-database-error")
+					}
+					return 11 * time.Minute, true, nil
+				},
+			}
+			cfg := DefaultWorkerConfig()
+			cfg.Telemetry = NewEMFTelemetry("prod", &output, nil)
+			worker := NewWorker(repo, fakeProcessor{}, "private-tenant", "worker-a", cfg, slog.New(slog.NewTextHandler(&logs, nil)))
+			worker.sampleOldestQueuedAge(context.Background())
+			records := telemetryRecords(t, output.String())
+			if len(records) == 0 || records[0]["SamplerHeartbeat"] != float64(1) {
+				t.Fatal("missing heartbeat")
+			}
+			failed := scenario == "partial" || scenario == "enumeration" || scenario == "compatibility"
+			if failed {
+				if len(records) != 1 {
+					t.Fatalf("partial sample emitted authoritative age: %s", output.String())
+				}
+				if logs.Len() == 0 {
+					t.Fatal("failure was not reported")
+				}
+				if scenario == "compatibility" && !strings.Contains(logs.String(), "namespace_not_enforced") {
+					t.Fatal("compatibility sampling failure lacks its bounded error class")
+				}
+			} else {
+				want := float64(0)
+				if scenario == "maximum" {
+					want = float64((11 * time.Minute).Milliseconds())
+				}
+				if len(records) != 2 || records[1]["OldestQueuedAgeMs"] != want {
+					t.Fatalf("bad aggregate: %s", output.String())
+				}
+				if !hasMetricDirective(records[1], []string{"stage"}, "OldestQueuedAgeMs") {
+					t.Fatal("age dimension is not stage-only")
+				}
+			}
+			if (scenario == "maximum" || scenario == "partial" || scenario == "all-empty") && calls != 2 {
+				t.Fatalf("only %d namespace samples", calls)
+			}
+			if strings.Contains(output.String()+logs.String(), "private-") {
+				t.Fatal("sampler exposed private identifiers or error text")
+			}
+		})
+	}
+}
diff --git a/server/internal/repository/postgres/namespace_sampler.go b/server/internal/repository/postgres/namespace_sampler.go
new file mode 100644
index 0000000000000000000000000000000000000000..0b3246644520881e307dcb3e786213fe3f21fe5e
--- /dev/null
+++ b/server/internal/repository/postgres/namespace_sampler.go
@@ -0,0 +1,176 @@
+package postgres
+
+import (
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/google/uuid"
+
+	"github.com/qiffang/mnemos/server/internal/ingestqueue"
+)
+
+func samplerPrincipalKey() string {
+	return fmt.Sprintf("%x", sha256.Sum256([]byte("mem9-service-principal-v1\x00sampler")))
+}
+
+// InitializeSamplerMemberships is startup/bootstrap initialization, never JIT
+// during a sample. It shares the Node reconciler's lifecycle lock and preserves
+// every pre-existing principal status and membership, including tombstones.
+func (r *IngestJobRepo) InitializeSamplerMemberships(ctx context.Context) error {
+	tx, err := r.db.BeginTx(ctx, nil)
+	if err != nil {
+		return fmt.Errorf("begin sampler initialization: %w", err)
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, `SELECT pg_advisory_xact_lock(hashtext('mem9-namespace-reconcile-v1'))`); err != nil {
+		return fmt.Errorf("lock sampler initialization: %w", err)
+	}
+	rows, err := tx.QueryContext(ctx, `SELECT namespace_id FROM memory_namespaces
+		WHERE status='active' ORDER BY namespace_id FOR NO KEY UPDATE`)
+	if err != nil {
+		return fmt.Errorf("lock sampler namespaces: %w", err)
+	}
+	var namespaceIDs []string
+	for rows.Next() {
+		var namespaceID string
+		if err := rows.Scan(&namespaceID); err != nil {
+			rows.Close()
+			return fmt.Errorf("read sampler namespace: %w", err)
+		}
+		namespaceIDs = append(namespaceIDs, namespaceID)
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return fmt.Errorf("read sampler namespaces: %w", err)
+	}
+	key := samplerPrincipalKey()
+	if _, err := tx.ExecContext(ctx, `INSERT INTO memory_principals (principal_id, principal_key, principal_type, status)
+		VALUES ($1, $2, 'service', 'active') ON CONFLICT (principal_key) DO NOTHING`, uuid.NewString(), key); err != nil {
+		return fmt.Errorf("initialize sampler principal: %w", err)
+	}
+	var principalID, principalType, status string
+	if err := tx.QueryRowContext(ctx, `SELECT principal_id, principal_type, status FROM memory_principals
+		WHERE principal_key=$1 FOR NO KEY UPDATE`, key).Scan(&principalID, &principalType, &status); err != nil {
+		return fmt.Errorf("read sampler principal: %w", err)
+	}
+	if principalType != "service" {
+		return ingestqueue.ErrSamplerScopeDenied
+	}
+	if status == "active" {
+		for _, namespaceID := range namespaceIDs {
+			if _, err := tx.ExecContext(ctx, `INSERT INTO memory_namespace_memberships
+				(namespace_id, principal_id, role, status, source_type)
+				VALUES ($1, $2, 'viewer', 'active', 'service')
+				ON CONFLICT (namespace_id, principal_id) DO NOTHING`, namespaceID, principalID); err != nil {
+				return fmt.Errorf("initialize sampler membership: %w", err)
+			}
+		}
+	}
+	if err := tx.Commit(); err != nil {
+		return fmt.Errorf("commit sampler initialization: %w", err)
+	}
+	return nil
+}
+
+// ListActiveNamespaces is metadata-only coordination. It deliberately does not
+// hide namespaces with missing/revoked sampler access: those must make the
+// aggregate fail instead of silently excluding their backlog.
+func (r *IngestJobRepo) ListActiveNamespaces(ctx context.Context) ([]string, error) {
+	// Before enforcement, legacy NULL-namespace jobs may exist outside every
+	// registered namespace. Suppress the whole aggregate rather than publish a
+	// false healthy zero or widen this sampler into a tenant-wide queue reader.
+	var phase string
+	if err := r.db.QueryRowContext(ctx, `SELECT phase FROM memory_namespace_migration_state
+		WHERE singleton_id`).Scan(&phase); err != nil {
+		return nil, fmt.Errorf("inspect sampler namespace enforcement: %w", err)
+	}
+	if phase != "constraints_complete" {
+		return nil, ingestqueue.ErrSamplerNotEnforced
+	}
+	rows, err := r.db.QueryContext(ctx, `
+		SELECT namespace_id FROM memory_namespaces
+		WHERE status = 'active' ORDER BY namespace_id`)
+	if err != nil {
+		return nil, fmt.Errorf("list sampler namespaces: %w", err)
+	}
+	defer rows.Close()
+	var namespaces []string
+	for rows.Next() {
+		var namespaceID string
+		if err := rows.Scan(&namespaceID); err != nil {
+			return nil, fmt.Errorf("read sampler namespace: %w", err)
+		}
+		namespaces = append(namespaces, namespaceID)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, fmt.Errorf("list sampler namespaces: %w", err)
+	}
+	return namespaces, nil
+}
+
+// OldestQueuedAge never accepts a caller-selected principal or an implicit
+// tenant-wide scope. The in-process sampler authenticates with its trusted DB
+// connection and binds the fixed sampler service identity, without a REST key.
+func (r *IngestJobRepo) OldestQueuedAge(ctx context.Context, tenantID, namespaceID string) (time.Duration, bool, error) {
+	if tenantID == "" || namespaceID == "" {
+		return 0, false, ingestqueue.ErrSamplerScopeDenied
+	}
+	tx, err := r.db.BeginTx(ctx, nil)
+	if err != nil {
+		return 0, false, fmt.Errorf("begin sampler read: %w", err)
+	}
+	defer tx.Rollback()
+	// Hold authorization rows in the shared lifecycle lock order through the
+	// read. Revoke/disable must wait for an already-authorized sample to finish.
+	var found string
+	if err := tx.QueryRowContext(ctx, `
+		SELECT namespace_id FROM memory_namespaces
+		WHERE namespace_id = $1 AND status = 'active' FOR SHARE`, namespaceID).Scan(&found); err != nil {
+		return 0, false, samplerAuthorizationError(err)
+	}
+	principalKey := samplerPrincipalKey()
+	var principalID string
+	if err := tx.QueryRowContext(ctx, `
+		SELECT principal_id FROM memory_principals
+		WHERE principal_key = $1 AND principal_type = 'service'
+		  AND status = 'active' FOR SHARE`, principalKey).Scan(&principalID); err != nil {
+		return 0, false, samplerAuthorizationError(err)
+	}
+	if err := tx.QueryRowContext(ctx, `
+		SELECT role FROM memory_namespace_memberships
+		WHERE namespace_id = $1 AND principal_id = $2 AND status = 'active'
+		  AND source_type = 'service' AND role IN ('viewer', 'member', 'owner')
+		FOR SHARE`, namespaceID, principalID).Scan(&found); err != nil {
+		return 0, false, samplerAuthorizationError(err)
+	}
+	var seconds sql.NullFloat64
+	if err := tx.QueryRowContext(ctx, `
+		SELECT EXTRACT(EPOCH FROM (statement_timestamp() - MIN(created_at)))
+		FROM ingest_jobs
+		WHERE tenant_id = $1 AND namespace_id = $2 AND state IN ('queued', 'retry_wait')`, tenantID, namespaceID).Scan(&seconds); err != nil {
+		return 0, false, fmt.Errorf("select namespace queued age: %w", err)
+	}
+	if err := tx.Commit(); err != nil {
+		return 0, false, fmt.Errorf("commit sampler read: %w", err)
+	}
+	if !seconds.Valid {
+		return 0, false, nil
+	}
+	age := time.Duration(seconds.Float64 * float64(time.Second))
+	if age < 0 {
+		age = 0
+	}
+	return age, true, nil
+}
+
+func samplerAuthorizationError(err error) error {
+	if errors.Is(err, sql.ErrNoRows) {
+		return ingestqueue.ErrSamplerScopeDenied
+	}
+	return fmt.Errorf("authorize sampler read: %w", err)
+}
