+// only after every authorized namespace sample succeeds: a partial maximum can
+// understate backlog just as a false zero can.
+func (w *Worker) namespaceQueueAge(ctx context.Context) (time.Duration, error) {
+	namespaces, err := w.repo.ListActiveNamespaces(ctx)
+	if err != nil {
+		return 0, err
+	}
+	var oldest time.Duration
+	for _, namespaceID := range namespaces {
+		age, present, err := w.repo.OldestQueuedAge(ctx, w.tenantID, namespaceID)
+		if err != nil {
+			return 0, err
+		}
+		if present && age > oldest {
