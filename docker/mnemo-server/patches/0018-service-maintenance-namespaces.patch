@@ -0,0 +1,103 @@
+package middleware
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"net/http/httptest"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+func TestServiceAuthorizationDoesNotSerializeNamespaces(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	for _, blocked := range []string{"namespace", "membership"} {
+		t.Run(blocked, func(t *testing.T) {
+			db := testutil.OpenIsolatedPostgres(t, dsn)
+			authorizer, _ := testNamespaceAuthorizer(t)
+			rings := serviceTestKeys()
+			raw, _ := json.Marshal(rings)
+			if err := WithServiceSigningKeys(string(raw))(authorizer); err != nil {
+				t.Fatal(err)
+			}
+			key, _ := base64.RawURLEncoding.DecodeString(rings["analysis"]["a"])
+			identity := serviceTestIdentity("analysis")
+			const principalID = "70000000-0000-4000-8000-000000000021"
+			if _, err := db.Exec(`INSERT INTO memory_principals(principal_id,principal_key,principal_type,status)
+				VALUES ($1,$2,'service','active')`, principalID, identity.PrincipalKey); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := db.Exec(`INSERT INTO memory_namespace_memberships(namespace_id,principal_id,role,status,source_type)
+				VALUES ($1,$3,'viewer','active','service'),($2,$3,'viewer','active','service')`, testutil.TestNamespaceID, testutil.TestOtherNamespaceID, principalID); err != nil {
+				t.Fatal(err)
+			}
+			var before, after string
+			if err := db.QueryRow("SELECT row_to_json(memory_principals)::text FROM memory_principals WHERE principal_id=$1", principalID).Scan(&before); err != nil {
+				t.Fatal(err)
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+			defer cancel()
+			barrier, err := db.BeginTx(ctx, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer barrier.Rollback()
+			if blocked == "namespace" {
+				_, err = barrier.ExecContext(ctx, "SELECT 1 FROM memory_namespaces WHERE namespace_id=$1 FOR UPDATE", testutil.TestNamespaceID)
+			} else {
+				_, err = barrier.ExecContext(ctx, "SELECT 1 FROM memory_namespace_memberships WHERE namespace_id=$1 AND principal_id=$2 FOR UPDATE", testutil.TestNamespaceID, principalID)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			authenticate := func(ctx context.Context, namespace string) error {
+				requestIdentity := identity
+				requestIdentity.NamespaceID = namespace
+				req := httptest.NewRequest(requestIdentity.Method, requestIdentity.Path, nil)
+				req.Header.Set(TransportHeader, signedTransport(t, key, requestIdentity))
+				scope, err := authorizer.Authorize(ctx, db, "tenant-a", req)
+				if err == nil && scope.NamespaceID != namespace {
+					t.Error("wrong namespace authorized")
+				}
+				return err
+			}
+			done := make(chan error, 1)
+			go func() { done <- authenticate(ctx, testutil.TestNamespaceID) }()
+			waitAnyNamespaceLock(t, db, "")
+			otherCtx, otherCancel := context.WithTimeout(ctx, time.Second)
+			err = authenticate(otherCtx, testutil.TestOtherNamespaceID)
+			otherCancel()
+			if err != nil {
+				t.Fatalf("namespace B waited on namespace A: %v", err)
+			}
+			select {
+			case err := <-done:
+				t.Fatalf("namespace A escaped its lock barrier: %v", err)
+			default:
+			}
+			if err := barrier.Rollback(); err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case err := <-done:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-ctx.Done():
+				t.Fatal("namespace A authorization did not finish")
+			}
+			if err := db.QueryRow("SELECT row_to_json(memory_principals)::text FROM memory_principals WHERE principal_id=$1", principalID).Scan(&after); err != nil {
+				t.Fatal(err)
+			}
+			if before != after {
+				t.Fatal("service authorization wrote the shared principal")
+			}
+		})
+	}
+}
