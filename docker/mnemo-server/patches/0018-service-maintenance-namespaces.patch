+				}
+				return repo.SoftDelete(context.Background(), id, "")
+			}
+			for _, deny := range []string{
+				"UPDATE memory_namespace_memberships SET status='revoked' WHERE principal_id=$1",
+				"UPDATE memory_namespace_memberships SET role='viewer' WHERE principal_id=$1",
+				"UPDATE memory_namespace_memberships SET source_type='operator' WHERE principal_id=$1",
+			} {
+				if _, err := db.Exec(deny, scope.PrincipalID); err != nil {
+					t.Fatal(err)
+				}
+				if _, err := mutate(); !errors.Is(err, domain.ErrServiceMutationDenied) {
+					t.Fatalf("session mutation bypassed service fence: %v", err)
+				}
+				state, timestamp := testutil.SessionRowState(t, db, id)
+				if state != beforeState || !timestamp.Equal(beforeTime) {
+					t.Fatal("denied session deletion changed rows")
+				}
+				if _, err := db.Exec("UPDATE memory_namespace_memberships SET status='active',role='owner',source_type='service' WHERE principal_id=$1", scope.PrincipalID); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if count, err := mutate(); err != nil || count != 1 {
+				t.Fatalf("active service session deletion: count=%d err=%v", count, err)
+			}
+		})
+	}
+}
