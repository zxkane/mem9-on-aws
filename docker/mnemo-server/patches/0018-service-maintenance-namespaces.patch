@@ -0,0 +1,220 @@
+package postgres
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/qiffang/mnemos/server/internal/domain"
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+func serviceMutationTestDB(t *testing.T) *sql.DB {
+	t.Helper()
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	return testutil.OpenIsolatedPostgres(t, dsn)
+}
+
+func serviceMutationSnapshot(t *testing.T, db *sql.DB) string {
+	t.Helper()
+	var snapshot string
+	if err := db.QueryRow(`SELECT COALESCE(jsonb_agg(to_jsonb(memory) ORDER BY id),'[]'::jsonb)::text FROM memories AS memory`).Scan(&snapshot); err != nil {
+		t.Fatal(err)
+	}
+	return snapshot
+}
+
+func serviceMutationMemory(id string) *domain.Memory {
+	return &domain.Memory{ID: id, Content: "service mutation fixture", MemoryType: domain.TypePinned, State: domain.StateActive, Version: 1}
+}
+
+func TestServiceMemoryMutationRejectsMissingScopeBeforeDatabase(t *testing.T) {
+	for _, scope := range []domain.NamespaceScope{
+		{PrincipalType: "service", PrincipalID: testutil.TestPrincipalID},
+		{PrincipalType: "service", NamespaceID: testutil.TestNamespaceID},
+	} {
+		repo := NewMemoryRepo(nil, false, "", scope)
+		if err := repo.Create(context.Background(), serviceMutationMemory("91000000-0000-4000-8000-000000000101")); !errors.Is(err, domain.ErrServiceMutationDenied) {
+			t.Fatalf("incomplete service scope reached database: %v", err)
+		}
+	}
+}
+
+func TestServiceMemoryMutatorsRevalidateScopeAtWrite(t *testing.T) {
+	const existingID = "91000000-0000-4000-8000-000000000101"
+	const createdID = "91000000-0000-4000-8000-000000000102"
+	ctx := context.Background()
+	for _, operation := range []struct {
+		name   string
+		mutate func(*MemoryRepo) error
+	}{
+		{"create", func(r *MemoryRepo) error { return r.Create(ctx, serviceMutationMemory(createdID)) }},
+		{"bulk-create", func(r *MemoryRepo) error {
+			return r.BulkCreate(ctx, []*domain.Memory{serviceMutationMemory(createdID)})
+		}},
+		{"update", func(r *MemoryRepo) error {
+			m := serviceMutationMemory(existingID)
+			m.Content = "changed"
+			return r.UpdateOptimistic(ctx, m, 1)
+		}},
+		{"delete", func(r *MemoryRepo) error { _, err := r.SoftDelete(ctx, existingID, ""); return err }},
+		{"batch-delete", func(r *MemoryRepo) error { _, err := r.BulkSoftDelete(ctx, []string{existingID}, ""); return err }},
+		{"archive", func(r *MemoryRepo) error { return r.ArchiveMemory(ctx, existingID, createdID) }},
+		{"archive-and-create", func(r *MemoryRepo) error {
+			return r.ArchiveAndCreate(ctx, existingID, createdID, serviceMutationMemory(createdID))
+		}},
+		{"set-state", func(r *MemoryRepo) error { return r.SetState(ctx, existingID, domain.StateArchived) }},
+	} {
+		t.Run(operation.name, func(t *testing.T) {
+			db := serviceMutationTestDB(t)
+			scope := testutil.TestNamespaceScope()
+			repo := NewMemoryRepo(db, false, "", scope)
+			if err := repo.Create(ctx, serviceMutationMemory(existingID)); err != nil {
+				t.Fatal(err)
+			}
+			before := serviceMutationSnapshot(t, db)
+			for _, guard := range []struct {
+				name, deny, restore string
+				id                  string
+			}{
+				{"revoked-membership", "UPDATE memory_namespace_memberships SET status='revoked' WHERE principal_id=$1", "UPDATE memory_namespace_memberships SET status='active' WHERE principal_id=$1", scope.PrincipalID},
+				{"viewer", "UPDATE memory_namespace_memberships SET role='viewer' WHERE principal_id=$1", "UPDATE memory_namespace_memberships SET role='owner' WHERE principal_id=$1", scope.PrincipalID},
+				{"wrong-source", "UPDATE memory_namespace_memberships SET source_type='operator' WHERE principal_id=$1", "UPDATE memory_namespace_memberships SET source_type='service' WHERE principal_id=$1", scope.PrincipalID},
+				{"disabled-principal", "UPDATE memory_principals SET status='disabled' WHERE principal_id=$1", "UPDATE memory_principals SET status='active' WHERE principal_id=$1", scope.PrincipalID},
+				{"wrong-principal-type", "UPDATE memory_principals SET principal_type='human' WHERE principal_id=$1", "UPDATE memory_principals SET principal_type='service' WHERE principal_id=$1", scope.PrincipalID},
+				{"disabled-namespace", "UPDATE memory_namespaces SET status='disabled' WHERE namespace_id=$1", "UPDATE memory_namespaces SET status='active' WHERE namespace_id=$1", scope.NamespaceID},
+			} {
+				t.Run(guard.name, func(t *testing.T) {
+					if _, err := db.Exec(guard.deny, guard.id); err != nil {
+						t.Fatal(err)
+					}
+					defer func() {
+						if _, err := db.Exec(guard.restore, guard.id); err != nil {
+							t.Error(err)
+						}
+					}()
+					if err := operation.mutate(repo); !errors.Is(err, domain.ErrServiceMutationDenied) {
+						t.Fatalf("revoked write returned %v", err)
+					}
+					if after := serviceMutationSnapshot(t, db); after != before {
+						t.Fatal("denied service mutation changed rows")
+					}
+				})
+			}
+			if err := operation.mutate(repo); err != nil {
+				t.Fatalf("active service write rejected: %v", err)
+			}
+		})
+	}
+}
+
+func TestServiceMemoryMutationRollbackAndLocalTimeouts(t *testing.T) {
+	db := serviceMutationTestDB(t)
+	ctx := context.Background()
+	scope := testutil.TestNamespaceScope()
+	repo := NewMemoryRepo(db, false, "", scope)
+	const id = "91000000-0000-4000-8000-000000000103"
+	if err := repo.Create(ctx, serviceMutationMemory(id)); err != nil {
+		t.Fatal(err)
+	}
+	before := serviceMutationSnapshot(t, db)
+	if err := repo.ArchiveAndCreate(ctx, id, id, serviceMutationMemory(id)); err == nil {
+		t.Fatal("duplicate replacement unexpectedly committed")
+	}
+	if serviceMutationSnapshot(t, db) != before {
+		t.Fatal("failed replacement left its archive committed")
+	}
+	if err := repo.BulkCreate(ctx, []*domain.Memory{serviceMutationMemory("91000000-0000-4000-8000-000000000104"), serviceMutationMemory(id)}); !errors.Is(err, domain.ErrDuplicateKey) {
+		t.Fatalf("duplicate bulk result: %v", err)
+	}
+	if serviceMutationSnapshot(t, db) != before {
+		t.Fatal("failed bulk insert partially committed")
+	}
+	deadline, cancel := context.WithTimeout(ctx, 2*time.Second)
+	defer cancel()
+	if _, err := db.ExecContext(deadline, "UPDATE memory_namespace_memberships SET role='member' WHERE principal_id=$1", scope.PrincipalID); err != nil {
+		t.Fatalf("failed transaction retained membership locks: %v", err)
+	}
+	tx, err := repo.beginMemoryMutation(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer tx.Rollback()
+	var lock, statement, idle string
+	if err := tx.QueryRow(`SELECT current_setting('lock_timeout'),current_setting('statement_timeout'),current_setting('idle_in_transaction_session_timeout')`).Scan(&lock, &statement, &idle); err != nil {
+		t.Fatal(err)
+	}
+	if lock != "5s" || statement != "30s" || idle != "35s" {
+		t.Fatalf("mutation timeouts: %s %s %s", lock, statement, idle)
+	}
+}
+
+func TestServiceMemoryFencePreservesOtherPrincipalTypes(t *testing.T) {
+	for _, principalType := range []string{"human", "m2m", ""} {
+		t.Run(principalType, func(t *testing.T) {
+			db := serviceMutationTestDB(t)
+			scope := testutil.TestNamespaceScope()
+			scope.PrincipalType = principalType
+			if _, err := db.Exec("UPDATE memory_namespace_memberships SET status='revoked' WHERE principal_id=$1", scope.PrincipalID); err != nil {
