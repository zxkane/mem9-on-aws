+			// A blank principal type is used by the accepted durable-job factory.
+			if err := NewMemoryRepo(db, false, "", scope).Create(context.Background(), serviceMutationMemory("91000000-0000-4000-8000-000000000105")); err != nil {
+				t.Fatalf("non-REST-service behavior changed: %v", err)
+			}
+		})
+	}
+}
+
+// Memory DELETE fallback and mixed batch deletion also mutate raw sessions.
+// Their second data transaction must not reuse an earlier authorization result.
+func TestServiceSessionDeleteRevalidatesScope(t *testing.T) {
+	for _, bulk := range []bool{false, true} {
+		name := "single"
+		if bulk {
+			name = "batch"
+		}
+		t.Run(name, func(t *testing.T) {
+			db := serviceMutationTestDB(t)
+			scope := testutil.TestNamespaceScope()
+			repo := NewSessionDeleteRepo(db, scope)
+			const id = "91000000-0000-4000-8000-000000000106"
