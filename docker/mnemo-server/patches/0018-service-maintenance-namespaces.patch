index 0000000000000000000000000000000000000000..67a41fd3196447b8d1c1549e21cbb3ecf8be5f34
--- /dev/null
+++ b/server/internal/middleware/namespace_service_auth.go
@@ -0,0 +1,209 @@
+package middleware
+
+import (
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/qiffang/mnemos/server/internal/domain"
+)
+
+// WithServiceSigningKeys adds independently keyed maintenance issuers. The server
+// receives the bundle; a service receives only its own ring. Both stable slots
+// verify during rotation; active selects the sender's slot, not the verifier's.
+func WithServiceSigningKeys(raw string) NamespaceAuthorizerOption {
+	return func(a *NamespaceAuthorizer) error {
+		if strings.TrimSpace(raw) == "" {
+			return nil
+		}
+		var encoded map[string]struct {
+			Active string `json:"active"`
+			A      string `json:"a"`
+			B      string `json:"b"`
+		}
+		decoder := json.NewDecoder(strings.NewReader(raw))
+		decoder.DisallowUnknownFields()
+		if err := decoder.Decode(&encoded); err != nil || encoded == nil {
+			return errors.New("MNEMO_SERVICE_TRANSPORT_SIGNING_KEYS must be a service keyring object")
+		}
+		if err := decoder.Decode(new(any)); err != io.EOF {
+			return errors.New("MNEMO_SERVICE_TRANSPORT_SIGNING_KEYS must contain one JSON object")
+		}
+		keys := make(map[string]map[string][]byte, len(encoded))
+		owners := make(map[[sha256.Size]byte]string)
+		for _, key := range a.keys {
+			owners[sha256.Sum256(key)] = "gateway"
+		}
+		for name, ring := range encoded {
+			switch name {
+			case "consolidation", "cleanup", "analysis":
+			default:
+				return errors.New("MNEMO_SERVICE_TRANSPORT_SIGNING_KEYS contains an unsupported service")
+			}
+			if ring.Active != "a" && ring.Active != "b" {
+				return fmt.Errorf("service %s active signing slot must be a or b", name)
+			}
+			keys[name] = make(map[string][]byte, 2)
+			for slot, value := range map[string]string{"a": ring.A, "b": ring.B} {
+				key, err := base64.RawURLEncoding.DecodeString(value)
+				if err != nil || len(key) < 32 {
+					return fmt.Errorf("service %s signing slot %s is invalid", name, slot)
+				}
+				fingerprint := sha256.Sum256(key)
+				if owner, exists := owners[fingerprint]; exists && owner != name {
+					return errors.New("transport signing keys must not be shared between issuers")
+				}
+				owners[fingerprint] = name
+				keys[name][slot] = key
+			}
+		}
+		a.serviceKeys = keys
+		return nil
+	}
+}
+
+func servicePrincipalKey(service string) string {
+	digest := sha256.Sum256([]byte("mem9-service-principal-v1\x00" + service))
+	return hex.EncodeToString(digest[:])
+}
+
+// Maintenance credentials do not grant transcript ingestion, job submission,
+// session APIs, or arbitrary future routes in the tenant-authenticated group.
+func approvedServiceMemoryRoute(r *http.Request) bool {
+	const memories = "/v1alpha2/mem9s/memories"
+	path := r.URL.Path
+	if r.URL.EscapedPath() != path {
+		return false
+	}
+	if r.Method == http.MethodPost {
+		return path == memories+"/batch-delete"
+	}
+	if r.Method != http.MethodGet && r.Method != http.MethodPut && r.Method != http.MethodDelete {
+		return false
+	}
+	if path == memories {
+		return r.Method == http.MethodGet
+	}
+	id, matched := strings.CutPrefix(path, memories+"/")
+	return matched && id != "" && id != "." && id != ".." && id != "batch-delete" && !strings.Contains(id, "/")
+}
+
+// Compatibility still authenticates legacy callers by the tenant key alone.
+// Parsing this header does not authenticate its claims. It only ensures service
+// or malformed envelopes cannot silently fall through to unscoped repositories
+// when no namespace verifier is installed.
+func legacyTransportMayBeIgnored(r *http.Request) bool {
+	headers := r.Header.Values(TransportHeader)
+	if len(headers) == 0 {
+		return true
+	}
+	if len(headers) != 1 {
+		return false
+	}
+	parts := strings.Split(strings.TrimSpace(headers[0]), ".")
+	if len(parts) != 2 {
+		return false
+	}
+	payload, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil {
+		return false
+	}
+	mac, err := hex.DecodeString(parts[1])
+	if err != nil || len(mac) != sha256.Size {
+		return false
+	}
+	var identity transportEnvelope
+	decoder := json.NewDecoder(strings.NewReader(string(payload)))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&identity); err != nil {
+		return false
+	}
+	if err := decoder.Decode(new(any)); err != io.EOF {
+		return false
+	}
+	now := time.Now().Unix()
+	if identity.Version != 1 || (identity.KeyID != "a" && identity.KeyID != "b") ||
+		identity.Issuer == "" || strings.HasPrefix(identity.Issuer, "maintenance:") ||
+		(identity.PrincipalType != "human" && identity.PrincipalType != "m2m") || identity.NamespaceID != "" ||
+		!hex64Pattern.MatchString(identity.PrincipalKey) || !hex64Pattern.MatchString(identity.ClientKey) ||
+		!hex64Pattern.MatchString(identity.BodyHash) || identity.Method != r.Method || identity.Path != r.URL.RequestURI() ||
+		identity.ExpiresAt < now || identity.IssuedAt > now+5 || identity.ExpiresAt-identity.IssuedAt != 30 ||
+		identity.GroupKeys == nil || len(identity.GroupKeys) > maxTransportGroups {
+		return false
+	}
+	for i, group := range identity.GroupKeys {
+		if !hex64Pattern.MatchString(group) || (i > 0 && identity.GroupKeys[i-1] >= group) {
+			return false
+		}
+	}
+	return identity.PrincipalType != "m2m" || len(identity.GroupKeys) == 0
+}
+
+func (a *NamespaceAuthorizer) transportSigningKey(identity transportEnvelope) []byte {
+	if identity.Issuer == a.issuer {
+		if identity.NamespaceID != "" || (identity.PrincipalType != "human" && identity.PrincipalType != "m2m") {
+			return nil
+		}
+		return a.keys[identity.KeyID]
+	}
+	service, maintenance := strings.CutPrefix(identity.Issuer, "maintenance:")
+	if !maintenance || a.serviceKeys[service] == nil {
+		return nil
+	}
+	principalKey := servicePrincipalKey(service)
+	namespaceID, err := uuid.Parse(identity.NamespaceID)
+	if err != nil || namespaceID == uuid.Nil || namespaceID.String() != identity.NamespaceID ||
+		identity.PrincipalType != "service" || identity.PrincipalKey != principalKey ||
+		identity.ClientKey != principalKey || identity.GroupKeys == nil || len(identity.GroupKeys) != 0 {
+		return nil
+	}
+	return a.serviceKeys[service][identity.KeyID]
+}
+
+func resolveServiceScope(ctx context.Context, tx *sql.Tx, tenantID string, identity transportEnvelope) (*domain.NamespaceScope, error) {
+	// Match the namespace -> principal -> membership lock order used by lifecycle
+	// operations. No principal or membership is created or reactivated here.
+	if err := lockActiveNamespace(ctx, tx, identity.NamespaceID); err != nil {
+		return nil, err
+	}
+	var principalID string
+	err := tx.QueryRowContext(ctx, `
+		SELECT principal_id FROM memory_principals
+		WHERE principal_key = $1 AND principal_type = 'service' AND status = 'active'
+		FOR SHARE`, identity.PrincipalKey).Scan(&principalID)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, &namespaceAuthError{status: http.StatusForbidden, msg: "namespace membership required"}
+	}
+	if err != nil {
+		return nil, &namespaceAuthError{status: http.StatusServiceUnavailable, msg: "namespace authorization unavailable", err: err}
+	}
+	var role string
+	err = tx.QueryRowContext(ctx, `
+		SELECT role FROM memory_namespace_memberships
+		WHERE namespace_id = $1 AND principal_id = $2
+		  AND source_type = 'service' AND status = 'active'
+		FOR SHARE`, identity.NamespaceID, principalID).Scan(&role)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, &namespaceAuthError{status: http.StatusForbidden, msg: "namespace membership required"}
+	}
+	if err != nil {
+		return nil, &namespaceAuthError{status: http.StatusServiceUnavailable, msg: "namespace authorization unavailable", err: err}
+	}
+	if role != "viewer" && role != "member" && role != "owner" {
+		return nil, &namespaceAuthError{status: http.StatusForbidden, msg: "memory namespace role denied"}
+	}
+	return &domain.NamespaceScope{
+		TenantID: tenantID, NamespaceID: identity.NamespaceID,
+		PrincipalID: principalID, PrincipalType: "service", Role: role,
+	}, nil
+}
