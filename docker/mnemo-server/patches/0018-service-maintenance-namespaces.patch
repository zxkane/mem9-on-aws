+)
+
+type serviceAuthorizationPause struct {
+	entered chan struct{}
+	resume  chan struct{}
+}
+
+func waitServiceBlockedPID(t *testing.T, db *sql.DB, blocker int) int {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 4*time.Second)
+	defer cancel()
+	ticker := time.NewTicker(5 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		var pid int
+		if err := db.QueryRowContext(ctx, `SELECT COALESCE((SELECT pid FROM pg_stat_activity
+			WHERE datname=current_database() AND $1=ANY(pg_blocking_pids(pid)) LIMIT 1),0)`, blocker).Scan(&pid); err != nil {
+			t.Fatalf("read lock barrier: %v", err)
+		}
+		if pid != 0 {
+			return pid
+		}
+		select {
+		case <-ctx.Done():
+			t.Fatal("mutation did not reach the expected lock barrier")
+		case <-ticker.C:
+		}
+	}
+}
+
+// TC-GROUPNS-105: real HTTP -> API-key middleware -> service authorization ->
+// namespace-bound repository, with PostgreSQL membership and memory fixtures.
+func TestServiceRESTNamespaceAuthorizationPostgresHTTP(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	db := testutil.OpenIsolatedPostgres(t, dsn)
+	connection, err := pgx.ParseConfig(dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var database string
+	if err := db.QueryRow("SELECT current_database()").Scan(&database); err != nil {
+		t.Fatal(err)
+	}
+	const tenantID = "90000000-0000-4000-8000-000000000018"
+	const principalID = "70000000-0000-4000-8000-000000000018"
+	principalKey := func(capability string) string {
+		digest := sha256.Sum256([]byte("mem9-service-principal-v1\x00" + capability))
+		return hex.EncodeToString(digest[:])
+	}
+	execSQL := func(query string, args ...any) {
+		t.Helper()
+		if _, err := db.Exec(query, args...); err != nil {
+			t.Fatal(err)
+		}
+	}
+	principal := principalKey("analysis")
+	execSQL(`INSERT INTO memory_principals (principal_id,principal_key,principal_type,status)
+		VALUES ($1,$2,'service','active')`, principalID, principal)
+	execSQL(`INSERT INTO memory_namespace_memberships (namespace_id,principal_id,role,status,source_type)
+		VALUES ($1,$2,'viewer','active','service')`, testutil.TestNamespaceID, principalID)
+	tenantRepo := postgres.NewTenantRepo(db)
+	if err := tenantRepo.Create(context.Background(), &domain.Tenant{
+		ID: tenantID, Name: "service-http-fixture", DBHost: connection.Host, DBPort: int(connection.Port),
+		DBUser: connection.User, DBPassword: connection.Password, DBName: database,
+		Provider: "self-hosted", Status: domain.TenantActive, SchemaVersion: 1,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	const ownID = "91000000-0000-4000-8000-000000000018"
+	const foreignID = "91000000-0000-4000-8000-000000000019"
+	for _, row := range []struct{ id, namespace, content string }{
+		{ownID, testutil.TestNamespaceID, "namespace-a-fixture"},
+		{foreignID, testutil.TestOtherNamespaceID, "namespace-b-fixture"},
+	} {
+		scope := testutil.TestNamespaceScope()
+		scope.NamespaceID = row.namespace
+		if row.namespace == testutil.TestOtherNamespaceID {
+			scope.PrincipalID = testutil.TestOtherPrincipalID
+		}
+		repo := postgres.NewMemoryRepo(db, false, "", scope)
+		if err := repo.Create(context.Background(), &domain.Memory{
+			ID: row.id, Content: row.content, MemoryType: domain.TypePinned, State: domain.StateActive, Version: 1,
+		}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	encodeKey := func(value byte) string {
+		return base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{value}, 32))
+	}
+	gatewayKeys, _ := json.Marshal(map[string]string{"a": encodeKey(7), "b": encodeKey(8)})
+	serviceKeys, _ := json.Marshal(map[string]map[string]string{
+		"analysis": {"active": "a", "a": encodeKey(20), "b": encodeKey(21)},
+		"cleanup":  {"active": "b", "a": encodeKey(22), "b": encodeKey(23)},
+	})
+	authorizer, err := middleware.NewNamespaceAuthorizer("gateway-target", string(gatewayKeys), middleware.WithServiceSigningKeys(string(serviceKeys)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	pool := tenant.NewPool(tenant.PoolConfig{Backend: "postgres"})
+	t.Cleanup(pool.Close)
+	auth := middleware.ResolveApiKey(tenantRepo, pool, encrypt.NewPlainEncryptor(), nil, middleware.WithNamespaceAuthorizer(authorizer))
+	var pause atomic.Pointer[serviceAuthorizationPause]
+	authWithPause := func(next http.Handler) http.Handler {
+		return auth(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if barrier := pause.Swap(nil); barrier != nil {
+				close(barrier.entered)
+				select {
+				case <-barrier.resume:
+				case <-r.Context().Done():
+					return
+				}
+			}
+			next.ServeHTTP(w, r)
+		}))
+	}
+	pass := func(next http.Handler) http.Handler { return next }
+	server := handler.NewServer(nil, nil, "", nil, nil, "", false, service.ModeRaw, "postgres", slog.New(slog.NewTextHandler(io.Discard, nil))).WithNamespaceRequired(true).WithDurableIngest(true)
+	httpServer := httptest.NewServer(server.Router(pass, pass, authWithPause, pass))
+	httpServer.Client().Timeout = 15 * time.Second
+	t.Cleanup(httpServer.Close)
+	const listPath = "/v1alpha2/mem9s/memories"
+	request := func(method, path, body string, edit func(map[string]any), signingByte byte, tamper bool) (int, string) {
+		t.Helper()
+		digest := sha256.Sum256([]byte(body))
+		now := time.Now().Unix()
+		payload := map[string]any{
+			"v": 1, "kid": "a", "issuer": "maintenance:analysis", "issued_at": now, "expires_at": now + 30,
+			"method": method, "path": path, "body_hash": hex.EncodeToString(digest[:]),
+			"principal_type": "service", "principal_key": principal, "client_key": principal,
+			"group_keys": []string{}, "namespace_id": testutil.TestNamespaceID,
+		}
+		if edit != nil {
+			edit(payload)
+		}
+		raw, err := json.Marshal(payload)
+		if err != nil {
+			t.Fatal(err)
+		}
+		mac := hmac.New(sha256.New, bytes.Repeat([]byte{signingByte}, 32))
+		_, _ = mac.Write(raw)
+		if tamper {
+			payload["namespace_id"] = testutil.TestOtherNamespaceID
+			raw, _ = json.Marshal(payload)
+		}
+		req, err := http.NewRequest(method, httpServer.URL+path, strings.NewReader(body))
+		if err != nil {
+			t.Fatal(err)
+		}
+		req.Header.Set("X-API-Key", tenantID)
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set(middleware.TransportHeader, base64.RawURLEncoding.EncodeToString(raw)+"."+hex.EncodeToString(mac.Sum(nil)))
+		response, err := httpServer.Client().Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer response.Body.Close()
+		output, err := io.ReadAll(response.Body)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return response.StatusCode, string(output)
+	}
+	assertStatus := func(want int, method, path, body string, edit func(map[string]any), signingByte byte, tamper bool) string {
+		t.Helper()
+		status, output := request(method, path, body, edit, signingByte, tamper)
+		if status != want {
+			t.Fatalf("HTTP status %d, want %d: %s", status, want, output)
+		}
+		if strings.Contains(output, "namespace-b-fixture") || strings.Contains(output, principal) || strings.Contains(output, principalID) {
+			t.Fatal("HTTP output disclosed foreign content or service identity")
+		}
+		return output
+	}
+	output := assertStatus(200, http.MethodGet, listPath, "", nil, 20, false)
+	if !strings.Contains(output, "namespace-a-fixture") {
+		t.Fatalf("own namespace result missing: %s", output)
+	}
+	assertStatus(200, http.MethodGet, listPath+"/"+ownID, "", func(e map[string]any) { e["kid"] = "b" }, 21, false)
+	assertStatus(404, http.MethodGet, listPath+"/"+foreignID, "", nil, 20, false)
+	assertStatus(403, http.MethodPost, listPath, `{"content":"viewer write"}`, nil, 20, false)
+	for _, tc := range []struct {
+		name string
+		edit func(map[string]any)
+	}{
+		{"foreign namespace", func(e map[string]any) { e["namespace_id"] = testutil.TestOtherNamespaceID }},
+		{"missing namespace", func(e map[string]any) { delete(e, "namespace_id") }},
+		{"invalid namespace", func(e map[string]any) { e["namespace_id"] = "invalid" }},
+		{"wrong principal", func(e map[string]any) { e["principal_key"] = principalKey("cleanup") }},
+		{"wrong client", func(e map[string]any) { e["client_key"] = principalKey("cleanup") }},
+		{"human impersonation", func(e map[string]any) { e["principal_type"] = "human" }},
+		{"wrong issuer", func(e map[string]any) { e["issuer"] = "maintenance:cleanup" }},
+		{"expired", func(e map[string]any) {
+			e["issued_at"] = time.Now().Unix() - 60
+			e["expires_at"] = time.Now().Unix() - 30
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) { assertStatus(403, http.MethodGet, listPath, "", tc.edit, 20, false) })
+	}
+	assertStatus(403, http.MethodGet, listPath, "", nil, 22, false)
+	assertStatus(403, http.MethodGet, listPath, "", nil, 20, true)
+	for _, tc := range []struct{ name, update, reset string }{
+		{"revoked membership", "UPDATE memory_namespace_memberships SET status='revoked' WHERE principal_id=$1", "UPDATE memory_namespace_memberships SET status='active' WHERE principal_id=$1"},
+		{"wrong membership source", "UPDATE memory_namespace_memberships SET source_type='operator' WHERE principal_id=$1", "UPDATE memory_namespace_memberships SET source_type='service' WHERE principal_id=$1"},
+		{"disabled principal", "UPDATE memory_principals SET status='disabled' WHERE principal_id=$1", "UPDATE memory_principals SET status='active' WHERE principal_id=$1"},
+		{"wrong principal type", "UPDATE memory_principals SET principal_type='human' WHERE principal_id=$1", "UPDATE memory_principals SET principal_type='service' WHERE principal_id=$1"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			execSQL(tc.update, principalID)
+			defer execSQL(tc.reset, principalID)
+			assertStatus(403, http.MethodGet, listPath, "", nil, 20, false)
+		})
+	}
+	execSQL("UPDATE memory_namespaces SET status='disabled' WHERE namespace_id=$1", testutil.TestNamespaceID)
+	assertStatus(403, http.MethodGet, listPath, "", nil, 20, false)
+	execSQL("UPDATE memory_namespaces SET status='active' WHERE namespace_id=$1", testutil.TestNamespaceID)
+	// A configured issuer does not create a principal or membership on first use.
+	assertStatus(403, http.MethodGet, listPath, "", func(e map[string]any) {
+		e["issuer"] = "maintenance:cleanup"
+		e["principal_key"] = principalKey("cleanup")
+		e["client_key"] = principalKey("cleanup")
+	}, 22, false)
+	var created int
+	if err := db.QueryRow("SELECT count(*) FROM memory_principals WHERE principal_key=$1", principalKey("cleanup")).Scan(&created); err != nil || created != 0 {
+		t.Fatal("service authorization created a principal")
+	}
+	// A member can write only its own namespace, and a later membership removal
+	// is observed despite the handler's existing service cache.
+	execSQL("UPDATE memory_namespace_memberships SET role='member' WHERE principal_id=$1", principalID)
+	for _, body := range []string{
+		`{"messages":[{"role":"user","content":"must not enqueue"}],"sync":false}`,
+		`{"messages":[{"role":"user","content":"must not ingest"}],"sync":true}`,
+	} {
+		assertStatus(403, http.MethodPost, listPath, body, nil, 20, false)
+	}
+	var jobs int
+	if err := db.QueryRow("SELECT count(*) FROM ingest_jobs").Scan(&jobs); err != nil || jobs != 0 {
+		t.Fatal("service memory POST reached the ingest queue")
+	}
+	// Pause after the real authorization transaction commits. Revocation must
+	// complete while the request is paused, and the later data write must reject.
+	for _, method := range []string{http.MethodPut, http.MethodDelete} {
+		t.Run("revocation-before-mutation/"+method, func(t *testing.T) {
+			var before, after string
+			if err := db.QueryRow("SELECT row_to_json(memories)::text FROM memories WHERE id=$1", ownID).Scan(&before); err != nil {
+				t.Fatal(err)
+			}
+			barrier := &serviceAuthorizationPause{entered: make(chan struct{}), resume: make(chan struct{})}
+			var released sync.Once
+			release := func() { released.Do(func() { close(barrier.resume) }) }
+			defer release()
+			pause.Store(barrier)
+			result := make(chan int, 1)
+			go func() {
+				status, _ := request(method, listPath+"/"+ownID, `{"tags":["must-not-commit"]}`, nil, 20, false)
+				result <- status
+			}()
+			select {
+			case <-barrier.entered:
+			case <-time.After(4 * time.Second):
+				t.Fatal("request did not finish authorization")
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			defer cancel()
+			if _, err := db.ExecContext(ctx, "UPDATE memory_namespace_memberships SET status='revoked' WHERE principal_id=$1", principalID); err != nil {
+				t.Fatalf("authorization held locks across request work: %v", err)
+			}
+			defer execSQL("UPDATE memory_namespace_memberships SET status='active' WHERE principal_id=$1", principalID)
+			release()
+			select {
+			case status := <-result:
+				if status != 403 {
+					t.Fatalf("post-authorization revoked write returned %d", status)
+				}
+			case <-time.After(4 * time.Second):
+				t.Fatal("revoked write did not finish")
+			}
+			if err := db.QueryRow("SELECT row_to_json(memories)::text FROM memories WHERE id=$1", ownID).Scan(&after); err != nil {
+				t.Fatal(err)
+			}
+			if before != after {
+				t.Fatal("revoked service changed a memory row")
+			}
+		})
+	}
+	// A PostgreSQL trigger pauses the actual mutation after its authorization
+	// locks are acquired. Revocation must wait for that same transaction's commit.
+	execSQL(`CREATE FUNCTION service_memory_write_barrier() RETURNS trigger LANGUAGE plpgsql AS $$
+		BEGIN PERFORM pg_advisory_xact_lock(hashtext('service-memory-write-barrier')); RETURN NEW; END $$`)
+	execSQL(`CREATE TRIGGER service_memory_write_barrier BEFORE UPDATE ON memories
+		FOR EACH ROW EXECUTE FUNCTION service_memory_write_barrier()`)
+	defer execSQL("DROP TRIGGER service_memory_write_barrier ON memories")
+	for _, method := range []string{http.MethodPut, http.MethodDelete} {
+		t.Run("mutation-before-revocation/"+method, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			barrier, err := db.Conn(ctx)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer barrier.Close()
+			var blocker int
+			if err := barrier.QueryRowContext(ctx, "SELECT pg_backend_pid()").Scan(&blocker); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := barrier.ExecContext(ctx, "SELECT pg_advisory_lock(hashtext('service-memory-write-barrier'))"); err != nil {
+				t.Fatal(err)
+			}
+			defer barrier.ExecContext(context.Background(), "SELECT pg_advisory_unlock(hashtext('service-memory-write-barrier'))")
+			result := make(chan int, 1)
+			go func() {
+				status, _ := request(method, listPath+"/"+ownID, `{"tags":["committed-before-revoke"]}`, nil, 20, false)
+				result <- status
+			}()
+			writer := waitServiceBlockedPID(t, db, blocker)
+			revoked := make(chan error, 1)
+			go func() {
+				_, err := db.ExecContext(ctx, "UPDATE memory_namespace_memberships SET status='revoked' WHERE principal_id=$1", principalID)
+				revoked <- err
+			}()
+			waitServiceBlockedPID(t, db, writer)
+			if _, err := barrier.ExecContext(ctx, "SELECT pg_advisory_unlock(hashtext('service-memory-write-barrier'))"); err != nil {
+				t.Fatal(err)
+			}
+			select {
+			case status := <-result:
+				want := http.StatusOK
+				if method == http.MethodDelete {
+					want = http.StatusNoContent
+				}
+				if status != want {
+					t.Fatalf("authorized write returned %d", status)
+				}
+			case <-ctx.Done():
+				t.Fatal("authorized write did not finish")
+			}
+			select {
+			case err := <-revoked:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-ctx.Done():
+				t.Fatal("revocation did not finish after commit")
+			}
+			var state string
+			if err := db.QueryRow("SELECT state FROM memories WHERE id=$1", ownID).Scan(&state); err != nil {
+				t.Fatal(err)
+			}
+			if method == http.MethodDelete && state != "deleted" {
+				t.Fatal("winning delete was not committed")
+			}
+			if method == http.MethodPut {
+				var tags string
+				if err := db.QueryRow("SELECT tags::text FROM memories WHERE id=$1", ownID).Scan(&tags); err != nil || !strings.Contains(tags, "committed-before-revoke") {
+					t.Fatal("winning update was not committed")
+				}
+			}
+			execSQL("UPDATE memory_namespace_memberships SET status='active' WHERE principal_id=$1", principalID)
+			execSQL("UPDATE memories SET state='active' WHERE id=$1", ownID)
+		})
+	}
+	assertStatus(200, http.MethodPut, listPath+"/"+ownID, `{"tags":["service-fixture"]}`, nil, 20, false)
+	assertStatus(404, http.MethodDelete, listPath+"/"+foreignID, "", nil, 20, false)
+	execSQL("DELETE FROM memory_namespace_memberships WHERE principal_id=$1", principalID)
+	assertStatus(403, http.MethodGet, listPath, "", nil, 20, false)
+	if err := db.QueryRow("SELECT count(*) FROM memory_namespace_memberships WHERE principal_id=$1", principalID).Scan(&created); err != nil || created != 0 {
+		t.Fatal("service authorization recreated a membership")
+	}
+}
