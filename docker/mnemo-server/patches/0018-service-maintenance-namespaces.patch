diff --git a/server/internal/repository/postgres/memory_service_mutation.go b/server/internal/repository/postgres/memory_service_mutation.go
new file mode 100644
index 0000000000000000000000000000000000000000..57d486515e9f10d9d7e061484ed17def0fdcb6ae
--- /dev/null
+++ b/server/internal/repository/postgres/memory_service_mutation.go
@@ -0,0 +1,94 @@
+package postgres
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+
+	"github.com/qiffang/mnemos/server/internal/domain"
+)
+
+type memoryMutationExecutor interface {
+	ExecContext(context.Context, string, ...any) (sql.Result, error)
+}
+
+// serviceMutation starts only at the repository write boundary, after embedding
+// or model work. Human/M2M and accepted durable-job writes retain their existing
+// behavior; the durable worker does not construct a REST service scope.
+func (r *MemoryRepo) serviceMutation(ctx context.Context, mutate func(memoryMutationExecutor) (sql.Result, error)) (sql.Result, error) {
+	if r.principalType != "service" {
+		return mutate(r.db)
+	}
+	tx, err := r.beginMemoryMutation(ctx)
+	if err != nil {
+		return nil, err
+	}
+	defer tx.Rollback()
+	result, err := mutate(tx)
+	if err != nil {
+		return nil, err
+	}
+	if err := tx.Commit(); err != nil {
+		return nil, err
+	}
+	return result, nil
+}
+
+// Existing multi-statement mutators use this entry point so the same locks
+// cover every statement and the final commit (including archive-and-create).
+func (r *MemoryRepo) beginMemoryMutation(ctx context.Context) (*sql.Tx, error) {
+	if r.principalType == "service" && (r.namespaceID == "" || r.principalID == "") {
+		return nil, domain.ErrServiceMutationDenied
+	}
+	tx, err := r.db.BeginTx(ctx, nil)
+	if err != nil {
+		return nil, err
+	}
+	if r.principalType == "service" {
+		if err := r.lockServiceMutationScope(ctx, tx); err != nil {
+			tx.Rollback()
+			return nil, err
+		}
+	}
+	return tx, nil
+}
+
+func serviceMutationScopeError(err error) error {
+	if errors.Is(err, sql.ErrNoRows) {
+		return domain.ErrServiceMutationDenied
+	}
+	return fmt.Errorf("service mutation authorization unavailable: %w", err)
+}
+
+func (r *MemoryRepo) lockServiceMutationScope(ctx context.Context, tx *sql.Tx) error {
+	for _, setting := range []string{
+		"SET LOCAL lock_timeout = '5s'",
+		"SET LOCAL statement_timeout = '30s'",
+		"SET LOCAL idle_in_transaction_session_timeout = '35s'",
+	} {
+		if _, err := tx.ExecContext(ctx, setting); err != nil {
+			return err
+		}
+	}
+	// Same global lock order as maintenance operators: namespace -> principal ->
+	// membership, then content rows. Revocation cannot commit until this write
+	// commits; a revocation that already committed is rechecked by these reads.
+	var allowed int
+	if err := tx.QueryRowContext(ctx, `SELECT 1 FROM memory_namespaces
+		WHERE namespace_id=$1 AND status='active' FOR SHARE`, r.namespaceID).Scan(&allowed); err != nil {
+		return serviceMutationScopeError(err)
+	}
+	if err := tx.QueryRowContext(ctx, `SELECT 1 FROM memory_principals
+		WHERE principal_id=$1 AND principal_type='service' AND status='active'
+		FOR SHARE`, r.principalID).Scan(&allowed); err != nil {
+		return serviceMutationScopeError(err)
+	}
+	if err := tx.QueryRowContext(ctx, `SELECT 1 FROM memory_namespace_memberships
+		WHERE namespace_id=$1 AND principal_id=$2 AND source_type='service'
+		  AND status='active' AND role IN ('member','owner')
+		FOR SHARE`, r.namespaceID, r.principalID).Scan(&allowed); err != nil {
+		return serviceMutationScopeError(err)
+	}
+	return nil
+}
