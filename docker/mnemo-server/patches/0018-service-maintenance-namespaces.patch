--- /dev/null
+++ b/server/cmd/mnemo-server/namespace_capabilities_test.go
@@ -0,0 +1,44 @@
+package main
+
+import (
+	"context"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestUnsupportedCapabilitiesFailBeforeDatabase(t *testing.T) {
+	// Launch the actual application artifact, not the Go test executable.
+	executable := filepath.Join(t.TempDir(), "mnemo-server")
+	buildCtx, buildCancel := context.WithTimeout(context.Background(), time.Minute)
+	defer buildCancel()
+	build := exec.CommandContext(buildCtx, "go", "build", "-o", executable, ".")
+	if output, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("build startup fixture: %v: %s", err, output)
+	}
+	for _, flag := range []string{"MNEMO_UPLOAD_WORKER_ENABLED", "MNEMO_WEBHOOKS_ENABLED", "MNEMO_SPACE_CHAINS_ENABLED"} {
+		t.Run(flag, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			command := exec.CommandContext(ctx, executable)
+			command.Env = []string{
+				"MNEMO_DSN=invalid-database-dsn",
+				"MNEMO_DB_BACKEND=postgres", "MNEMO_NAMESPACE_REQUIRED=1", flag + "=1",
+			}
+			output, err := command.CombinedOutput()
+			if err == nil || command.ProcessState.ExitCode() != 1 {
+				t.Fatalf("startup did not exit 1: %v, %s", err, output)
+			}
+			if !strings.Contains(string(output), "failed to load config") || !strings.Contains(string(output), flag) {
+				t.Fatalf("startup missed the capability guard: %s", output)
+			}
+			for _, forbidden := range []string{"database connected", "failed to connect database", "dispatcher initialized", "upload worker"} {
+				if strings.Contains(string(output), forbidden) {
+					t.Fatalf("startup reached a database or worker: %s", output)
+				}
+			}
+		})
+	}
+}
