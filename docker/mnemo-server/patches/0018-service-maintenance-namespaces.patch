+		{"invalid encoding", func(r map[string]map[string]string) { r["analysis"]["a"] = "%%%" }},
+		{"unknown field", func(r map[string]map[string]string) { r["analysis"]["other"] = "value" }},
+		{"cross-service reuse", func(r map[string]map[string]string) { r["analysis"]["a"] = r["cleanup"]["a"] }},
+		{"Gateway reuse", func(r map[string]map[string]string) {
+			r["analysis"]["a"] = base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{7}, 32))
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			a, _ := testNamespaceAuthorizer(t)
+			rings := serviceTestKeys()
+			tc.change(rings)
+			raw, _ := json.Marshal(rings)
+			if err := WithServiceSigningKeys(string(raw))(a); err == nil {
+				t.Fatal("invalid service key configuration accepted")
+			}
+		})
+	}
+	for _, raw := range []string{"null", "[]", "{", `{} {}`} {
+		a, _ := testNamespaceAuthorizer(t)
+		if err := WithServiceSigningKeys(raw)(a); err == nil {
+			t.Fatal("malformed service key configuration accepted")
+		}
+	}
+}
