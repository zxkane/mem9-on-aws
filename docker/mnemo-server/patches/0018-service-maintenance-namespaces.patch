+			called := false
+			router := ResolveApiKey(probe, nil, nil, nil)(http.HandlerFunc(func(http.ResponseWriter, *http.Request) { called = true }))
+			req := httptest.NewRequest(http.MethodGet, identity.Path, nil)
+			req.Header.Set(APIKeyHeader, "fixture-tenant")
+			req.Header.Set(TransportHeader, tc.token)
+			recorder := httptest.NewRecorder()
+			router.ServeHTTP(recorder, req)
+			if recorder.Code != 403 || probe.lookedUp || called {
+				t.Fatalf("compatibility request reached repository/content: status=%d lookup=%v handler=%v", recorder.Code, probe.lookedUp, called)
+			}
+		})
+	}
+	for _, kind := range []string{"bare", "human", "m2m"} {
+		t.Run("legacy-"+kind, func(t *testing.T) {
