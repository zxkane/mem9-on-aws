--- /dev/null
+++ b/server/internal/config/namespace_capabilities.go
@@ -0,0 +1,31 @@
+package config
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+)
+
+// These are refusal flags, not feature switches. A complete namespace contract
+// is required before any of these legacy capabilities can be enabled.
+func validateNamespaceCapabilities() error {
+	for _, name := range []string{
+		"MNEMO_UPLOAD_WORKER_ENABLED",
+		"MNEMO_WEBHOOKS_ENABLED",
+		"MNEMO_SPACE_CHAINS_ENABLED",
+	} {
+		value := strings.TrimSpace(os.Getenv(name))
+		if value == "" {
+			continue
+		}
+		enabled, err := strconv.ParseBool(value)
+		if err != nil {
+			return fmt.Errorf("%s must be a boolean and remain disabled", name)
+		}
+		if enabled {
+			return fmt.Errorf("%s is unsupported without a complete namespace contract", name)
+		}
+	}
+	return nil
+}
