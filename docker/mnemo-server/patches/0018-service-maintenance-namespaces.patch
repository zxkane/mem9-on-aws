+package handler
+
+import (
+	"bytes"
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/qiffang/mnemos/server/internal/ingestqueue"
+	"github.com/qiffang/mnemos/server/internal/middleware"
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+func TestServiceTranscriptRevokedAfterAuthorizationCannotEnqueue(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	for _, synchronous := range []bool{false, true} {
+		name := "async"
+		if synchronous {
+			name = "sync"
+		}
+		t.Run(name, func(t *testing.T) {
+			db := testutil.OpenIsolatedPostgres(t, dsn)
+			server := postgresSessionDeleteServer().WithNamespaceRequired(true).WithDurableIngest(true)
+			principal := sha256.Sum256([]byte("mem9-service-principal-v1\x00analysis"))
+			principalKey := hex.EncodeToString(principal[:])
+			if _, err := db.Exec("UPDATE memory_principals SET principal_key=$1 WHERE principal_id=$2", principalKey, testutil.TestPrincipalID); err != nil {
+				t.Fatal(err)
+			}
+			encodedKey := func(value byte) string { return base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{value}, 32)) }
+			gateway, _ := json.Marshal(map[string]string{"a": encodedKey(7), "b": encodedKey(8)})
+			services, _ := json.Marshal(map[string]map[string]string{"analysis": {"active": "a", "a": encodedKey(20), "b": encodedKey(21)}})
+			authorizer, err := middleware.NewNamespaceAuthorizer("gateway-target", string(gateway), middleware.WithServiceSigningKeys(string(services)))
+			if err != nil {
+				t.Fatal(err)
+			}
+			now := time.Now().Unix()
+			digest := sha256.Sum256(nil)
+			payload, _ := json.Marshal(map[string]any{
+				"v": 1, "kid": "a", "issuer": "maintenance:analysis", "issued_at": now, "expires_at": now + 30,
+				"method": "GET", "path": "/v1alpha2/mem9s/memories", "body_hash": hex.EncodeToString(digest[:]),
+				"principal_type": "service", "principal_key": principalKey, "client_key": principalKey,
+				"namespace_id": testutil.TestNamespaceID, "group_keys": []string{},
+			})
+			mac := hmac.New(sha256.New, bytes.Repeat([]byte{20}, 32))
+			_, _ = mac.Write(payload)
+			probe := httptest.NewRequest(http.MethodGet, "/v1alpha2/mem9s/memories", nil)
+			probe.Header.Set(middleware.TransportHeader, base64.RawURLEncoding.EncodeToString(payload)+"."+hex.EncodeToString(mac.Sum(nil)))
+			scope, err := authorizer.Authorize(context.Background(), db, "tenant-a", probe)
+			if err != nil {
+				t.Fatal(err)
+			}
+			request := durableRequest(t, "tenant-a", db, map[string]any{
+				"messages": []map[string]string{{"role": "user", "content": "service transcript must not enqueue"}},
+				"appId":    "fixture-app", "session_id": "fixture-session", "sync": synchronous,
+			})
+			// Retain the real authorization result, then commit revocation before
+			// dispatching POST directly. Even a stale/replayed handler scope cannot
+			// bypass the ingress route restriction to submit a durable job.
+			auth := middleware.AuthFromContext(request.Context())
+			auth.Namespace = scope
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			defer cancel()
+			if _, err := db.ExecContext(ctx, "UPDATE memory_namespace_memberships SET status='revoked' WHERE namespace_id=$1 AND principal_id=$2", auth.Namespace.NamespaceID, auth.Namespace.PrincipalID); err != nil {
+				t.Fatal(err)
+			}
+			factoryCalls := 0
+			original := server.ingestRepoFactory
+			server.ingestRepoFactory = func(backend string, connection *sql.DB) ingestqueue.Repository {
+				factoryCalls++
+				return original(backend, connection)
+			}
+			recorder := httptest.NewRecorder()
+			server.createMemory(recorder, request)
+			var jobs int
+			if err := db.QueryRow("SELECT count(*) FROM ingest_jobs").Scan(&jobs); err != nil {
+				t.Fatal(err)
+			}
+			if recorder.Code != 403 || jobs != 0 || factoryCalls != 0 {
+				t.Fatalf("service transcript reached ingest: status=%d jobs=%d factory=%d", recorder.Code, jobs, factoryCalls)
+			}
+		})
+	}
+}
