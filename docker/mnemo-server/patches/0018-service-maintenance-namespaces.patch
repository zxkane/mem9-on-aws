@@ -0,0 +1,51 @@
+package config
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestNamespaceUnsupportedCapabilityConfiguration(t *testing.T) {
+	for _, flag := range []string{"MNEMO_UPLOAD_WORKER_ENABLED", "MNEMO_WEBHOOKS_ENABLED", "MNEMO_SPACE_CHAINS_ENABLED"} {
+		for _, required := range []string{"0", "1"} {
+			for _, value := range []string{"1", "true", "yes", "invalid"} {
+				t.Run(flag+"/"+required+"/"+value, func(t *testing.T) {
+					t.Setenv("MNEMO_DSN", "not-a-database")
+					t.Setenv("MNEMO_NAMESPACE_REQUIRED", required)
+					t.Setenv(flag, value)
+					if _, err := Load(); err == nil || !strings.Contains(err.Error(), flag) {
+						t.Fatalf("unsupported configuration was accepted: %v", err)
+					}
+				})
+			}
+		}
+		for _, value := range []string{"", "0", "false"} {
+			t.Run(flag+"/disabled/"+value, func(t *testing.T) {
+				t.Setenv("MNEMO_DSN", "test-dsn")
+				t.Setenv(flag, value)
+				if _, err := Load(); err != nil {
+					t.Fatalf("disabled capability rejected: %v", err)
+				}
+			})
+		}
+	}
+}
+
+func TestNamespaceServiceKeysRequireEnforcementAndAreNotSerialized(t *testing.T) {
+	t.Setenv("MNEMO_DSN", "test-dsn")
+	t.Setenv("MNEMO_SERVICE_TRANSPORT_SIGNING_KEYS", `{"analysis":{"active":"a","a":"PRIVATE-KEY-MARKER","b":"OTHER-KEY-MARKER"}}`)
+	t.Setenv("MNEMO_NAMESPACE_REQUIRED", "0")
+	if _, err := Load(); err == nil || !strings.Contains(err.Error(), "MNEMO_NAMESPACE_REQUIRED") {
+		t.Fatalf("service keys accepted without enforcement: %v", err)
+	}
+	t.Setenv("MNEMO_NAMESPACE_REQUIRED", "1")
+	cfg, err := Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := json.Marshal(cfg)
+	if err != nil || strings.Contains(string(encoded), "PRIVATE-KEY-MARKER") {
+		t.Fatal("service keys leaked through configuration serialization")
+	}
+}
