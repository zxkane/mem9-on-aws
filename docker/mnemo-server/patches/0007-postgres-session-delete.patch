+func TestPostgresSessionRepoSoftDeleteObservesConcurrentDelete(t *testing.T) {
+	db := sessionDeleteTestDB(t)
+	ctx := context.Background()
+	id := "10000000-0000-4000-8000-00000000a004"
+	originalUpdatedAt := time.Date(2026, 2, 3, 4, 5, 6, 0, time.UTC)
+	blockerUpdatedAt := originalUpdatedAt.Add(time.Hour)
+	testutil.InsertSessionRow(t, db, id, domain.StateActive, originalUpdatedAt)
+
+	blocker, err := db.BeginTx(ctx, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer blocker.Rollback()
+	var state string
+	if err := blocker.QueryRow(
+		`SELECT state FROM sessions WHERE id = $1 FOR UPDATE`,
+		id,
+	).Scan(&state); err != nil {
+		t.Fatal(err)
+	}
+
+	repo := NewSessionRepo("postgres", db, "", false, "cluster-a")
+	type result struct {
+		deleted int64
+		err     error
+	}
+	resultCh := make(chan result, 1)
+	go func() {
+		deleted, err := repo.SoftDelete(ctx, id, "agent-a")
+		resultCh <- result{deleted: deleted, err: err}
+	}()
+	waitForSessionDeleteLock(t, db)
+
+	if _, err := blocker.Exec(
+		`UPDATE sessions SET state = 'deleted', updated_at = $1 WHERE id = $2`,
+		blockerUpdatedAt,
+		id,
+	); err != nil {
+		t.Fatal(err)
+	}
+	if err := blocker.Commit(); err != nil {
+		t.Fatal(err)
+	}
+
+	select {
+	case got := <-resultCh:
+		if got.err != nil || got.deleted != 0 {
+			t.Fatalf("locked SoftDelete = (%d, %v), want (0, nil)", got.deleted, got.err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("SoftDelete did not resume after the row lock was released")
+	}
+	targetState, targetUpdatedAt := testutil.SessionRowState(t, db, id)
+	if targetState != domain.StateDeleted || !targetUpdatedAt.Equal(blockerUpdatedAt) {
+		t.Fatalf(
+			"target = (%q, %s), want (deleted, %s)",
+			targetState,
+			targetUpdatedAt,
+			blockerUpdatedAt,
+		)
+	}
+}
