diff --git a/server/internal/repository/postgres/session_delete.go b/server/internal/repository/postgres/session_delete.go
new file mode 100644
index 0000000..0017d75
--- /dev/null
+++ b/server/internal/repository/postgres/session_delete.go
@@ -0,0 +1,112 @@
+package postgres
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/jackc/pgx/v5/pgconn"
+
+	"github.com/qiffang/mnemos/server/internal/domain"
+)
+
+// SessionDeleteRepo supplies the PostgreSQL raw-session deletion methods.
+// Other SessionRepo capabilities remain unsupported by the factory adapter.
+type SessionDeleteRepo struct {
+	db *sql.DB
+}
+
+func NewSessionDeleteRepo(db *sql.DB) *SessionDeleteRepo {
+	return &SessionDeleteRepo{db: db}
+}
+
+func (r *SessionDeleteRepo) SoftDelete(ctx context.Context, id, _ string) (int64, error) {
+	tx, err := r.db.BeginTx(ctx, nil)
+	if err != nil {
+		return 0, fmt.Errorf("session soft delete begin tx: %w", err)
+	}
+	defer tx.Rollback()
+
+	var state string
+	err = tx.QueryRowContext(
+		ctx,
+		`SELECT state FROM sessions WHERE id = $1 FOR UPDATE`,
+		id,
+	).Scan(&state)
+	if err == sql.ErrNoRows {
+		return 0, domain.ErrNotFound
+	}
+	if err != nil {
+		if isUndefinedTableError(err) {
+			return 0, domain.ErrNotFound
+		}
+		return 0, fmt.Errorf("session soft delete lock row: %w", err)
+	}
+
+	if state == string(domain.StateDeleted) {
+		if err := tx.Commit(); err != nil {
+			return 0, fmt.Errorf("session soft delete commit: %w", err)
+		}
+		return 0, nil
+	}
+
+	result, err := tx.ExecContext(
+		ctx,
+		`UPDATE sessions
+		 SET state = 'deleted', updated_at = statement_timestamp()
+		 WHERE id = $1`,
+		id,
+	)
+	if err != nil {
+		return 0, fmt.Errorf("session soft delete update: %w", err)
+	}
+	deleted, err := result.RowsAffected()
+	if err != nil {
+		return 0, fmt.Errorf("session soft delete rows affected: %w", err)
+	}
+	if err := tx.Commit(); err != nil {
+		return 0, fmt.Errorf("session soft delete commit: %w", err)
+	}
+	return deleted, nil
+}
+
+func (r *SessionDeleteRepo) BulkSoftDelete(
+	ctx context.Context,
+	ids []string,
+	_ string,
+) (int64, error) {
+	if len(ids) == 0 {
+		return 0, nil
+	}
+
+	placeholders := make([]string, len(ids))
+	args := make([]any, len(ids))
+	for i, id := range ids {
+		placeholders[i] = fmt.Sprintf("$%d", i+1)
+		args[i] = id
+	}
+	result, err := r.db.ExecContext(
+		ctx,
+		`UPDATE sessions SET state = 'deleted', updated_at = clock_timestamp()
+		 WHERE id IN (`+strings.Join(placeholders, ",")+`) AND state != 'deleted'`,
+		args...,
+	)
+	if err != nil {
+		if isUndefinedTableError(err) {
+			return 0, nil
+		}
+		return 0, fmt.Errorf("session bulk soft delete: %w", err)
+	}
+	deleted, err := result.RowsAffected()
+	if err != nil {
+		return 0, fmt.Errorf("session bulk soft delete rows affected: %w", err)
+	}
+	return deleted, nil
+}
+
+func isUndefinedTableError(err error) bool {
+	var pgErr *pgconn.PgError
+	return errors.As(err, &pgErr) && pgErr.Code == "42P01"
+}
diff --git a/server/internal/repository/session_delete_integration_test.go b/server/internal/repository/session_delete_integration_test.go
new file mode 100644
