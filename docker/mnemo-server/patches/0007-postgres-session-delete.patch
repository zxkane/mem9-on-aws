+func RecreateMemoryDeleteTable(t testing.TB, db *sql.DB) {
+	t.Helper()
+	if _, err := db.Exec(`DROP TABLE IF EXISTS memories`); err != nil {
+		t.Fatalf("drop memories table: %v", err)
+	}
+	if _, err := db.Exec(`
+		CREATE TABLE memories (
+			id VARCHAR(36) PRIMARY KEY,
+			content TEXT NOT NULL,
+			source VARCHAR(100),
+			tags JSONB,
+			metadata JSONB,
+			embedding TEXT,
+			memory_type VARCHAR(20) NOT NULL DEFAULT 'pinned',
+			agent_id VARCHAR(100),
+			session_id VARCHAR(100),
+			app_id VARCHAR(100) NOT NULL DEFAULT '',
+			state VARCHAR(20) NOT NULL DEFAULT 'active',
+			version INT DEFAULT 1,
+			updated_by VARCHAR(100),
+			superseded_by VARCHAR(36),
+			created_at TIMESTAMPTZ NOT NULL DEFAULT statement_timestamp(),
+			updated_at TIMESTAMPTZ NOT NULL DEFAULT statement_timestamp()
+		)
+	`); err != nil {
+		t.Fatalf("create memories table: %v", err)
+	}
+}
+
+func InsertSessionRow(
+	t testing.TB,
+	db *sql.DB,
+	id string,
+	state domain.MemoryState,
+	updatedAt time.Time,
+) {
+	t.Helper()
+	contentHash := sha256.Sum256([]byte(id))
+	if _, err := db.Exec(`
+		INSERT INTO sessions (
+			id, session_id, app_id, role, content, content_hash, state,
+			created_at, updated_at
+		)
+		VALUES ($1, 'session-delete', 'app-delete', 'user', $2, $3, $4, $5, $5)
+	`, id, "content-"+id, hex.EncodeToString(contentHash[:]), state, updatedAt); err != nil {
+		t.Fatalf("insert session %s: %v", id, err)
+	}
+}
+
+func SessionRowState(
+	t testing.TB,
+	db *sql.DB,
+	id string,
+) (domain.MemoryState, time.Time) {
+	t.Helper()
+	var state domain.MemoryState
+	var updatedAt time.Time
+	if err := db.QueryRow(
+		`SELECT state, updated_at FROM sessions WHERE id = $1`,
+		id,
+	).Scan(&state, &updatedAt); err != nil {
+		t.Fatalf("read session %s: %v", id, err)
+	}
+	return state, updatedAt
+}
