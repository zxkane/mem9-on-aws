+package handler
+
+import (
+	"database/sql"
+	"encoding/json"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/qiffang/mnemos/server/internal/domain"
+	"github.com/qiffang/mnemos/server/internal/middleware"
+	"github.com/qiffang/mnemos/server/internal/service"
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+func handlerSessionDeleteTestDB(t *testing.T) *sql.DB {
+	t.Helper()
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	db := testutil.OpenIsolatedPostgres(t, dsn)
+	testutil.RecreateMemoryDeleteTable(t, db)
+	return db
+}
+
+func postgresSessionDeleteServer() *Server {
+	return NewServer(
+		nil,
+		nil,
+		"",
+		nil,
+		nil,
+		"",
+		false,
+		service.ModeSmart,
+		"postgres",
+		slog.Default(),
+	)
+}
+
+func postgresSessionDeleteRequest(
+	t *testing.T,
+	method string,
+	path string,
+	body any,
+	tenantID string,
+	db *sql.DB,
+) *http.Request {
+	t.Helper()
+	req := makeRequest(t, method, path, body)
+	auth := &domain.AuthInfo{
+		TenantID:  tenantID,
+		TenantDB:  db,
+		ClusterID: "cluster-" + tenantID,
+		AgentName: "authenticated-agent",
+	}
+	return req.WithContext(middleware.WithAuthContext(req.Context(), auth))
+}
+
+func TestPostgresAuthenticatedSessionDeleteFallbackAndTenantIsolation(t *testing.T) {
+	tenantADB := handlerSessionDeleteTestDB(t)
+	tenantBDB := handlerSessionDeleteTestDB(t)
+	originalUpdatedAt := time.Date(2026, 4, 5, 6, 7, 8, 0, time.UTC)
+	sharedID := "20000000-0000-4000-8000-00000000a001"
+	unrelatedID := "20000000-0000-4000-8000-00000000a002"
+	testutil.InsertSessionRow(t, tenantADB, sharedID, domain.StateActive, originalUpdatedAt)
+	testutil.InsertSessionRow(t, tenantADB, unrelatedID, domain.StateActive, originalUpdatedAt)
+	testutil.InsertSessionRow(t, tenantBDB, sharedID, domain.StateActive, originalUpdatedAt)
+
+	srv := postgresSessionDeleteServer()
+	req := postgresSessionDeleteRequest(
+		t,
+		http.MethodDelete,
+		"/v1alpha2/mem9s/memories/"+sharedID,
+		nil,
+		"tenant-a",
+		tenantADB,
+	)
+	req = withURLParam(req, "id", sharedID)
+	rr := httptest.NewRecorder()
+	srv.deleteMemory(rr, req)
+	if rr.Code != http.StatusNoContent {
+		t.Fatalf("delete status = %d, want 204: %s", rr.Code, rr.Body.String())
+	}
+
+	state, firstUpdatedAt := testutil.SessionRowState(t, tenantADB, sharedID)
+	if state != domain.StateDeleted || !firstUpdatedAt.After(originalUpdatedAt) {
+		t.Fatalf("tenant A row = (%q, %s), want deleted with newer timestamp", state, firstUpdatedAt)
+	}
+	state, updatedAt := testutil.SessionRowState(t, tenantBDB, sharedID)
+	if state != domain.StateActive || !updatedAt.Equal(originalUpdatedAt) {
+		t.Fatalf("tenant B row = (%q, %s), want unchanged active row", state, updatedAt)
+	}
+
+	repeat := postgresSessionDeleteRequest(
+		t,
+		http.MethodDelete,
+		"/v1alpha2/mem9s/memories/"+sharedID,
+		nil,
+		"tenant-a",
+		tenantADB,
+	)
+	repeat = withURLParam(repeat, "id", sharedID)
+	repeatRR := httptest.NewRecorder()
+	srv.deleteMemory(repeatRR, repeat)
+	if repeatRR.Code != http.StatusNoContent {
+		t.Fatalf("repeat status = %d, want 204: %s", repeatRR.Code, repeatRR.Body.String())
+	}
+	_, repeatedUpdatedAt := testutil.SessionRowState(t, tenantADB, sharedID)
+	if !repeatedUpdatedAt.Equal(firstUpdatedAt) {
+		t.Fatalf("repeat updated_at = %s, want unchanged %s", repeatedUpdatedAt, firstUpdatedAt)
+	}
+
+	unknownID := "20000000-0000-4000-8000-00000000a099"
+	unknown := postgresSessionDeleteRequest(
+		t,
+		http.MethodDelete,
+		"/v1alpha2/mem9s/memories/"+unknownID,
+		nil,
+		"tenant-a",
+		tenantADB,
+	)
+	unknown = withURLParam(unknown, "id", unknownID)
+	unknownRR := httptest.NewRecorder()
+	srv.deleteMemory(unknownRR, unknown)
+	if unknownRR.Code != http.StatusNotFound {
+		t.Fatalf("unknown status = %d, want 404: %s", unknownRR.Code, unknownRR.Body.String())
+	}
+	state, updatedAt = testutil.SessionRowState(t, tenantADB, unrelatedID)
+	if state != domain.StateActive || !updatedAt.Equal(originalUpdatedAt) {
+		t.Fatalf("unrelated row = (%q, %s), want unchanged active row", state, updatedAt)
+	}
+}
+
+func TestPostgresAuthenticatedMixedBatchDelete(t *testing.T) {
+	db := handlerSessionDeleteTestDB(t)
+	originalUpdatedAt := time.Date(2026, 5, 6, 7, 8, 9, 0, time.UTC)
+	memoryID := "20000000-0000-4000-8000-00000000a010"
+	activeSessionID := "20000000-0000-4000-8000-00000000a011"
+	deletedSessionID := "20000000-0000-4000-8000-00000000a012"
+	unrequestedSessionID := "20000000-0000-4000-8000-00000000a013"
+	unknownID := "20000000-0000-4000-8000-00000000a098"
+	if _, err := db.Exec(`
+		INSERT INTO memories (id, content, state, created_at, updated_at)
+		VALUES ($1, 'memory row', 'active', $2, $2)
+	`, memoryID, originalUpdatedAt); err != nil {
+		t.Fatalf("insert memory: %v", err)
+	}
+	testutil.InsertSessionRow(t, db, activeSessionID, domain.StateActive, originalUpdatedAt)
+	testutil.InsertSessionRow(t, db, deletedSessionID, domain.StateDeleted, originalUpdatedAt)
+	testutil.InsertSessionRow(t, db, unrequestedSessionID, domain.StateActive, originalUpdatedAt)
+
+	srv := postgresSessionDeleteServer()
+	req := postgresSessionDeleteRequest(
+		t,
+		http.MethodPost,
+		"/v1alpha2/mem9s/memories/batch-delete",
+		map[string]any{"ids": []string{
+			memoryID,
+			activeSessionID,
+			deletedSessionID,
+			unknownID,
+			activeSessionID,
+		}},
+		"tenant-a",
+		db,
+	)
+	rr := httptest.NewRecorder()
+	srv.batchDeleteMemories(rr, req)
+	if rr.Code != http.StatusOK {
+		t.Fatalf("batch status = %d, want 200: %s", rr.Code, rr.Body.String())
+	}
+	var response struct {
+		Deleted int64 `json:"deleted"`
+	}
+	if err := json.NewDecoder(rr.Body).Decode(&response); err != nil {
+		t.Fatal(err)
+	}
+	if response.Deleted != 2 {
+		t.Fatalf("deleted = %d, want 2", response.Deleted)
+	}
+
+	var memoryState domain.MemoryState
+	if err := db.QueryRow(
+		`SELECT state FROM memories WHERE id = $1`,
+		memoryID,
+	).Scan(&memoryState); err != nil {
+		t.Fatal(err)
+	}
+	if memoryState != domain.StateDeleted {
+		t.Fatalf("memory state = %q, want deleted", memoryState)
+	}
+	state, activeUpdatedAt := testutil.SessionRowState(t, db, activeSessionID)
+	if state != domain.StateDeleted || !activeUpdatedAt.After(originalUpdatedAt) {
+		t.Fatalf("active session = (%q, %s), want deleted with newer timestamp", state, activeUpdatedAt)
+	}
+	for _, id := range []string{deletedSessionID, unrequestedSessionID} {
+		wantState := domain.StateDeleted
+		if id == unrequestedSessionID {
+			wantState = domain.StateActive
+		}
+		state, updatedAt := testutil.SessionRowState(t, db, id)
+		if state != wantState || !updatedAt.Equal(originalUpdatedAt) {
+			t.Fatalf("%s = (%q, %s), want (%q, %s)", id, state, updatedAt, wantState, originalUpdatedAt)
+		}
+	}
+
+	repeat := postgresSessionDeleteRequest(
+		t,
+		http.MethodPost,
+		"/v1alpha2/mem9s/memories/batch-delete",
+		map[string]any{"ids": []string{memoryID, activeSessionID, unknownID}},
+		"tenant-a",
+		db,
+	)
+	repeatRR := httptest.NewRecorder()
+	srv.batchDeleteMemories(repeatRR, repeat)
+	if repeatRR.Code != http.StatusOK {
+		t.Fatalf("repeat batch status = %d, want 200: %s", repeatRR.Code, repeatRR.Body.String())
+	}
+	if err := json.NewDecoder(repeatRR.Body).Decode(&response); err != nil {
+		t.Fatal(err)
+	}
+	if response.Deleted != 0 {
+		t.Fatalf("repeat deleted = %d, want 0", response.Deleted)
+	}
+	_, repeatedUpdatedAt := testutil.SessionRowState(t, db, activeSessionID)
+	if !repeatedUpdatedAt.Equal(activeUpdatedAt) {
+		t.Fatalf("repeat batch changed active session timestamp from %s to %s", activeUpdatedAt, repeatedUpdatedAt)
+	}
+}
+
+func TestPostgresAuthenticatedDeleteWithoutSessionsTable(t *testing.T) {
+	db := handlerSessionDeleteTestDB(t)
+	if _, err := db.Exec(`DROP TABLE sessions`); err != nil {
+		t.Fatalf("drop sessions table: %v", err)
+	}
+
+	srv := postgresSessionDeleteServer()
+	unknownID := "20000000-0000-4000-8000-00000000a097"
+	single := postgresSessionDeleteRequest(
+		t,
+		http.MethodDelete,
+		"/v1alpha2/mem9s/memories/"+unknownID,
+		nil,
+		"tenant-a",
+		db,
+	)
+	single = withURLParam(single, "id", unknownID)
+	singleRR := httptest.NewRecorder()
+	srv.deleteMemory(singleRR, single)
+	if singleRR.Code != http.StatusNotFound {
+		t.Fatalf("single status = %d, want 404: %s", singleRR.Code, singleRR.Body.String())
+	}
+
+	originalUpdatedAt := time.Date(2026, 6, 7, 8, 9, 10, 0, time.UTC)
+	memoryID := "20000000-0000-4000-8000-00000000a020"
+	if _, err := db.Exec(`
+		INSERT INTO memories (id, content, state, created_at, updated_at)
+		VALUES ($1, 'memory row', 'active', $2, $2)
+	`, memoryID, originalUpdatedAt); err != nil {
+		t.Fatalf("insert memory: %v", err)
+	}
+	batch := postgresSessionDeleteRequest(
+		t,
+		http.MethodPost,
+		"/v1alpha2/mem9s/memories/batch-delete",
+		map[string]any{"ids": []string{memoryID, unknownID}},
+		"tenant-a",
+		db,
+	)
+	batchRR := httptest.NewRecorder()
+	srv.batchDeleteMemories(batchRR, batch)
+	if batchRR.Code != http.StatusOK {
+		t.Fatalf("batch status = %d, want 200: %s", batchRR.Code, batchRR.Body.String())
+	}
+	var response struct {
+		Deleted int64 `json:"deleted"`
+	}
+	if err := json.NewDecoder(batchRR.Body).Decode(&response); err != nil {
+		t.Fatal(err)
+	}
+	if response.Deleted != 1 {
+		t.Fatalf("deleted = %d, want 1", response.Deleted)
+	}
+
+	var state domain.MemoryState
+	if err := db.QueryRow(
+		`SELECT state FROM memories WHERE id = $1`,
+		memoryID,
+	).Scan(&state); err != nil {
+		t.Fatal(err)
+	}
+	if state != domain.StateDeleted {
+		t.Fatalf("memory state = %q, want deleted", state)
+	}
+}
