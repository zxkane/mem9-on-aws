+func TestSessionRepoFactoryPreservesOtherBackends(t *testing.T) {
+	if _, ok := NewSessionRepo("tidb", nil, "", false, "").(*tidb.SessionRepo); !ok {
+		t.Fatal("tidb backend no longer selects the TiDB session repository")
+	}
+	if _, ok := NewSessionRepo("", nil, "", false, "").(*tidb.SessionRepo); !ok {
+		t.Fatal("default backend no longer selects the TiDB session repository")
+	}
+
+	for _, backend := range []string{"db9", "unsupported"} {
+		repo := NewSessionRepo(backend, nil, "", false, "")
+		if _, err := repo.SoftDelete(context.Background(), "id", "agent"); !errors.Is(err, domain.ErrNotSupported) {
+			t.Fatalf("%s SoftDelete error = %v, want ErrNotSupported", backend, err)
+		}
+		if _, err := repo.BulkSoftDelete(context.Background(), []string{"id"}, "agent"); !errors.Is(err, domain.ErrNotSupported) {
+			t.Fatalf("%s BulkSoftDelete error = %v, want ErrNotSupported", backend, err)
+		}
+	}
+}
