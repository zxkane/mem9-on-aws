+func TestPostgresSessionRepoBulkSoftDeleteCountsDistinctActiveRows(t *testing.T) {
+	db := sessionDeleteTestDB(t)
+	ctx := context.Background()
+	originalUpdatedAt := time.Date(2026, 3, 4, 5, 6, 7, 0, time.UTC)
+	activeA := "10000000-0000-4000-8000-00000000a010"
+	activeB := "10000000-0000-4000-8000-00000000a011"
+	alreadyDeleted := "10000000-0000-4000-8000-00000000a012"
+	unrequested := "10000000-0000-4000-8000-00000000a013"
+	testutil.InsertSessionRow(t, db, activeA, domain.StateActive, originalUpdatedAt)
+	testutil.InsertSessionRow(t, db, activeB, domain.StateActive, originalUpdatedAt)
+	testutil.InsertSessionRow(t, db, alreadyDeleted, domain.StateDeleted, originalUpdatedAt)
+	testutil.InsertSessionRow(t, db, unrequested, domain.StateActive, originalUpdatedAt)
+
+	repo := NewSessionRepo("postgres", db, "", false, "cluster-a")
+	ids := []string{
+		activeA,
+		activeA,
+		activeB,
+		alreadyDeleted,
+		"10000000-0000-4000-8000-00000000a098",
+	}
+	deleted, err := repo.BulkSoftDelete(ctx, ids, "agent-a")
+	if err != nil {
+		t.Fatalf("BulkSoftDelete: %v", err)
+	}
+	if deleted != 2 {
+		t.Fatalf("deleted = %d, want 2", deleted)
+	}
+
+	_, activeAUpdatedAt := testutil.SessionRowState(t, db, activeA)
+	_, activeBUpdatedAt := testutil.SessionRowState(t, db, activeB)
+	for _, id := range []string{activeA, activeB} {
+		state, updatedAt := testutil.SessionRowState(t, db, id)
+		if state != domain.StateDeleted || !updatedAt.After(originalUpdatedAt) {
+			t.Fatalf("%s = (%q, %s), want deleted with newer timestamp", id, state, updatedAt)
+		}
+	}
+	for _, id := range []string{alreadyDeleted, unrequested} {
+		wantState := domain.StateDeleted
+		if id == unrequested {
+			wantState = domain.StateActive
+		}
+		state, updatedAt := testutil.SessionRowState(t, db, id)
+		if state != wantState || !updatedAt.Equal(originalUpdatedAt) {
+			t.Fatalf("%s = (%q, %s), want (%q, %s)", id, state, updatedAt, wantState, originalUpdatedAt)
+		}
+	}
+
+	deleted, err = repo.BulkSoftDelete(ctx, ids, "agent-b")
+	if err != nil || deleted != 0 {
+		t.Fatalf("repeated BulkSoftDelete = (%d, %v), want (0, nil)", deleted, err)
+	}
+	_, repeatedAUpdatedAt := testutil.SessionRowState(t, db, activeA)
+	_, repeatedBUpdatedAt := testutil.SessionRowState(t, db, activeB)
+	if !repeatedAUpdatedAt.Equal(activeAUpdatedAt) ||
+		!repeatedBUpdatedAt.Equal(activeBUpdatedAt) {
+		t.Fatal("repeated batch delete changed an already-deleted row timestamp")
+	}
+
+	deleted, err = repo.BulkSoftDelete(ctx, nil, "agent-a")
+	if err != nil || deleted != 0 {
+		t.Fatalf("empty BulkSoftDelete = (%d, %v), want (0, nil)", deleted, err)
+	}
+}
