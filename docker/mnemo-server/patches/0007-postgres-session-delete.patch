+	originalUpdatedAt := time.Date(2026, 2, 3, 4, 5, 6, 0, time.UTC)
+	testutil.InsertSessionRow(t, db, id, domain.StateActive, originalUpdatedAt)
+
+	blocker, err := db.BeginTx(ctx, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer blocker.Rollback()
+	var state string
+	if err := blocker.QueryRow(
+		`SELECT state FROM sessions WHERE id = $1 FOR UPDATE`,
+		id,
+	).Scan(&state); err != nil {
+		t.Fatal(err)
+	}
+
+	repo := NewSessionRepo("postgres", db, "", false, "cluster-a")
+	type result struct {
+		deleted int64
+		err     error
+	}
+	resultCh := make(chan result, 1)
+	go func() {
+		deleted, err := repo.BulkSoftDelete(ctx, []string{id}, "agent-a")
+		resultCh <- result{deleted: deleted, err: err}
+	}()
+	waitForSessionDeleteLock(t, db)
+
+	var blockerUpdatedAt time.Time
+	if err := blocker.QueryRow(
+		`UPDATE sessions
+		 SET tags = '["lock-holder"]', updated_at = statement_timestamp()
+		 WHERE id = $1
+		 RETURNING updated_at`,
+		id,
+	).Scan(&blockerUpdatedAt); err != nil {
+		t.Fatal(err)
+	}
+	if err := blocker.Commit(); err != nil {
+		t.Fatal(err)
+	}
+
+	select {
+	case got := <-resultCh:
+		if got.err != nil || got.deleted != 1 {
+			t.Fatalf("locked BulkSoftDelete = (%d, %v), want (1, nil)", got.deleted, got.err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("BulkSoftDelete did not resume after the row lock was released")
+	}
+	targetState, targetUpdatedAt := testutil.SessionRowState(t, db, id)
+	if targetState != domain.StateDeleted || targetUpdatedAt.Before(blockerUpdatedAt) {
+		t.Fatalf(
+			"target = (%q, %s), want deleted at or after lock-holder update %s",
+			targetState,
+			targetUpdatedAt,
+			blockerUpdatedAt,
+		)
+	}
