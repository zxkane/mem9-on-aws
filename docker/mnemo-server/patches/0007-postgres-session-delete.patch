+	deleted, err := repo.SoftDelete(context.Background(), "missing", "agent-a")
+	if !errors.Is(err, domain.ErrNotFound) || deleted != 0 {
+		t.Errorf("SoftDelete = (%d, %v), want (0, ErrNotFound)", deleted, err)
+	}
+	deleted, err = repo.BulkSoftDelete(
+		context.Background(),
+		[]string{"missing"},
+		"agent-a",
+	)
+	if err != nil || deleted != 0 {
+		t.Errorf("BulkSoftDelete = (%d, %v), want (0, nil)", deleted, err)
+	}
+}
