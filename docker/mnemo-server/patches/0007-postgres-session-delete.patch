@@ -0,0 +1,402 @@
+package repository
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/qiffang/mnemos/server/internal/domain"
+	"github.com/qiffang/mnemos/server/internal/repository/tidb"
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+func sessionDeleteTestDB(t *testing.T) *sql.DB {
+	t.Helper()
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	return testutil.OpenIsolatedPostgres(t, dsn)
+}
+
+func waitForSessionDeleteLock(t *testing.T, db *sql.DB) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for {
+		var waiting bool
+		if err := db.QueryRow(`
+			SELECT EXISTS (
+				SELECT 1
+				FROM pg_stat_activity
+				WHERE datname = current_database()
+				  AND state = 'active'
+				  AND wait_event_type = 'Lock'
+				  AND pid != pg_backend_pid()
+			)
+		`).Scan(&waiting); err != nil {
+			t.Fatalf("inspect session delete lock wait: %v", err)
+		}
+		if waiting {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("session deletion did not wait for the row lock")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+func TestPostgresSessionRepoSoftDeleteIsIdempotent(t *testing.T) {
+	db := sessionDeleteTestDB(t)
+	ctx := context.Background()
+	originalUpdatedAt := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	id := "10000000-0000-4000-8000-00000000a001"
+	testutil.InsertSessionRow(t, db, id, domain.StateActive, originalUpdatedAt)
+
+	repo := NewSessionRepo("postgres", db, "", false, "cluster-a")
+	deleted, err := repo.SoftDelete(ctx, id, "agent-a")
+	if err != nil {
+		t.Fatalf("SoftDelete: %v", err)
+	}
+	if deleted != 1 {
+		t.Fatalf("deleted = %d, want 1", deleted)
+	}
+	state, firstUpdatedAt := testutil.SessionRowState(t, db, id)
+	if state != domain.StateDeleted {
+		t.Fatalf("state = %q, want deleted", state)
+	}
+	if !firstUpdatedAt.After(originalUpdatedAt) {
+		t.Fatalf("updated_at = %s, want after %s", firstUpdatedAt, originalUpdatedAt)
+	}
+
+	deleted, err = repo.SoftDelete(ctx, id, "agent-b")
+	if err != nil {
+		t.Fatalf("repeated SoftDelete: %v", err)
+	}
+	if deleted != 0 {
+		t.Fatalf("repeated deleted = %d, want 0", deleted)
+	}
+	_, repeatedUpdatedAt := testutil.SessionRowState(t, db, id)
+	if !repeatedUpdatedAt.Equal(firstUpdatedAt) {
+		t.Fatalf("repeated updated_at = %s, want unchanged %s", repeatedUpdatedAt, firstUpdatedAt)
+	}
+
+	deleted, err = repo.SoftDelete(
+		ctx,
+		"10000000-0000-4000-8000-00000000a099",
+		"agent-a",
+	)
+	if !errors.Is(err, domain.ErrNotFound) {
+		t.Fatalf("unknown SoftDelete error = %v, want ErrNotFound", err)
+	}
+	if deleted != 0 {
+		t.Fatalf("unknown deleted = %d, want 0", deleted)
+	}
+}
+
+func TestPostgresSessionRepoSoftDeleteLocksExactRow(t *testing.T) {
+	db := sessionDeleteTestDB(t)
+	ctx := context.Background()
+	targetID := "10000000-0000-4000-8000-00000000a002"
+	otherID := "10000000-0000-4000-8000-00000000a003"
+	originalUpdatedAt := time.Date(2026, 2, 3, 4, 5, 6, 0, time.UTC)
+	testutil.InsertSessionRow(t, db, targetID, domain.StateActive, originalUpdatedAt)
+	testutil.InsertSessionRow(t, db, otherID, domain.StateActive, originalUpdatedAt)
+
+	blocker, err := db.BeginTx(ctx, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer blocker.Rollback()
+	var state string
+	if err := blocker.QueryRow(
+		`SELECT state FROM sessions WHERE id = $1 FOR UPDATE`,
+		targetID,
+	).Scan(&state); err != nil {
+		t.Fatal(err)
+	}
+
+	repo := NewSessionRepo("postgres", db, "", false, "cluster-a")
+	type result struct {
+		deleted int64
+		err     error
+	}
+	resultCh := make(chan result, 1)
+	go func() {
+		deleted, err := repo.SoftDelete(ctx, targetID, "agent-a")
+		resultCh <- result{deleted: deleted, err: err}
+	}()
+	waitForSessionDeleteLock(t, db)
+
+	otherDeleted, err := repo.SoftDelete(ctx, otherID, "agent-a")
+	if err != nil || otherDeleted != 1 {
+		t.Fatalf("unrelated SoftDelete = (%d, %v), want (1, nil)", otherDeleted, err)
+	}
+	var blockerUpdatedAt time.Time
+	if err := blocker.QueryRow(
+		`UPDATE sessions
+		 SET tags = '["lock-holder"]', updated_at = statement_timestamp()
+		 WHERE id = $1
+		 RETURNING updated_at`,
+		targetID,
+	).Scan(&blockerUpdatedAt); err != nil {
+		t.Fatal(err)
+	}
+	if err := blocker.Commit(); err != nil {
+		t.Fatal(err)
+	}
+
+	select {
+	case got := <-resultCh:
+		if got.err != nil || got.deleted != 1 {
+			t.Fatalf("locked SoftDelete = (%d, %v), want (1, nil)", got.deleted, got.err)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("SoftDelete did not resume after the row lock was released")
+	}
+	targetState, targetUpdatedAt := testutil.SessionRowState(t, db, targetID)
+	if targetState != domain.StateDeleted || targetUpdatedAt.Before(blockerUpdatedAt) {
+		t.Fatalf(
+			"target = (%q, %s), want deleted at or after lock-holder update %s",
+			targetState,
+			targetUpdatedAt,
+			blockerUpdatedAt,
+		)
+	}
+}
