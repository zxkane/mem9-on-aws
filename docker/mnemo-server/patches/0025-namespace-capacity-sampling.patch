+package postgres
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"github.com/qiffang/mnemos/server/internal/ingestqueue"
+	"github.com/qiffang/mnemos/server/internal/testutil"
+	"testing"
+	"time"
+)
+
+func TestNamespaceCapacityCompleteAndAuthorization(t *testing.T) {
+	t.Setenv("MNEMO_NAMESPACE_EXACT_VECTOR_MAX_ROWS", "100")
+	db := ingestTestDB(t)
+	r := NewIngestJobRepo(db)
+	ctx := context.Background()
+	if _, _, err := r.NamespaceVectorCapacity(ctx); !errors.Is(err, ingestqueue.ErrSamplerScopeDenied) {
+		t.Fatalf("missing identity accepted: %v", err)
+	}
+	seedSamplerAccess(t, db)
+	if _, err := db.Exec(`INSERT INTO memories(id,content,embedding,state,namespace_id,created_by_principal_id,updated_by_principal_id)
+ SELECT '97000000-0000-4000-8000-'||lpad(i::text,12,'0'),'synthetic',('[1,'||array_to_string(array_fill(0,ARRAY[1023]),',')||']')::vector,'active',$1,$2,$2 FROM generate_series(1,120)i`, testutil.TestNamespaceID, testutil.TestPrincipalID); err != nil {
+		t.Fatal(err)
+	}
+	n, max, err := r.NamespaceVectorCapacity(ctx)
+	if err != nil || n != 120 || max != 100 {
+		t.Fatalf("maximum=%d ceiling=%d err=%v", n, max, err)
+	}
+	if _, err = db.Exec(`UPDATE memories SET state='deleted' WHERE namespace_id=$1`, testutil.TestNamespaceID); err != nil {
+		t.Fatal(err)
+	}
+	n, _, err = r.NamespaceVectorCapacity(ctx)
+	if err != nil || n != 0 {
+		t.Fatalf("deleted rows counted: %d %v", n, err)
+	}
+	for _, change := range []struct{ sql, undo string }{
+		{`UPDATE memory_principals SET status='disabled' WHERE principal_id=$1`, `UPDATE memory_principals SET status='active' WHERE principal_id=$1`},
+		{`UPDATE memory_namespace_memberships SET status='revoked' WHERE principal_id=$1`, `UPDATE memory_namespace_memberships SET status='active' WHERE principal_id=$1`},
+		{`UPDATE memory_namespace_memberships SET source_type='operator' WHERE principal_id=$1`, `UPDATE memory_namespace_memberships SET source_type='service' WHERE principal_id=$1`},
+	} {
+		if _, err = db.Exec(change.sql, samplerTestPrincipalID); err != nil {
+			t.Fatal(err)
+		}
+		if _, _, err = r.NamespaceVectorCapacity(ctx); !errors.Is(err, ingestqueue.ErrSamplerScopeDenied) {
+			t.Fatalf("bad access accepted: %v", err)
+		}
+		if _, err = db.Exec(change.undo, samplerTestPrincipalID); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err = db.Exec(`UPDATE memory_namespaces SET status='disabled'`); err != nil {
+		t.Fatal(err)
+	}
+	n, _, err = r.NamespaceVectorCapacity(ctx)
+	if err != nil || n != 0 {
+		t.Fatalf("empty sample rejected: %v", err)
+	}
+	if _, err = db.Exec(`UPDATE memory_principals SET status='disabled' WHERE principal_id=$1`, samplerTestPrincipalID); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = r.NamespaceVectorCapacity(ctx); !errors.Is(err, ingestqueue.ErrSamplerScopeDenied) {
+		t.Fatal("empty namespace set bypassed principal")
+	}
+}
+
+func TestNamespaceCapacityHoldsRevocationFence(t *testing.T) {
+	db := ingestTestDB(t)
+	seedSamplerAccess(t, db)
+	r := NewIngestJobRepo(db)
+	blocker, err := db.Begin()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer blocker.Rollback()
+	if _, err = blocker.Exec(`LOCK TABLE memories IN ACCESS EXCLUSIVE MODE`); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { _, _, err := r.NamespaceVectorCapacity(ctx); done <- err }()
+	deadline := time.Now().Add(time.Second)
+	waiting := false
+	for time.Now().Before(deadline) {
+		if err = db.QueryRow(`SELECT EXISTS(SELECT 1 FROM pg_stat_activity WHERE datname=current_database()
+   AND wait_event_type='Lock' AND query LIKE 'SELECT COUNT(*) FROM memories%')`).Scan(&waiting); err != nil {
+			t.Fatal(err)
+		}
+		if waiting {
+			break
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	if !waiting {
+		t.Fatal("sampler did not reach its authorized count")
+	}
+	revokeCtx, revokeCancel := context.WithTimeout(context.Background(), 40*time.Millisecond)
+	_, err = db.ExecContext(revokeCtx, `UPDATE memory_namespace_memberships SET status='revoked' WHERE principal_id=$1`, samplerTestPrincipalID)
+	revokeCancel()
+	if err == nil {
+		t.Fatal("revocation passed the active count fence")
+	}
+	if err = blocker.Rollback(); err != nil {
+		t.Fatal(err)
+	}
+	if err = <-done; err != nil {
+		t.Fatalf("authorized sample failed: %v", err)
+	}
+	if _, err = db.Exec(`UPDATE memory_namespace_memberships SET status='revoked' WHERE principal_id=$1`, samplerTestPrincipalID); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err = r.NamespaceVectorCapacity(context.Background()); !errors.Is(err, ingestqueue.ErrSamplerScopeDenied) {
+		t.Fatal("later sample bypassed revocation")
+	}
+}
+
+func TestNamespaceCapacityRuntimePrivileges(t *testing.T) {
+	db := ingestTestDB(t)
+	seedSamplerAccess(t, db)
+	db.SetMaxOpenConns(1)
+	role := fmt.Sprintf("capacity_fixture_%d", time.Now().UnixNano())
+	if _, err := db.Exec("CREATE ROLE " + role); err != nil {
+		t.Fatal(err)
+	}
+	defer func() { db.Exec("RESET ROLE"); db.Exec("DROP OWNED BY " + role); db.Exec("DROP ROLE " + role) }()
+	grants := []string{
+		"GRANT USAGE ON SCHEMA public TO " + role,
+		"GRANT SELECT ON memories,memory_namespace_migration_state,memory_namespaces,memory_principals,memory_namespace_memberships TO " + role,
+		"GRANT UPDATE(updated_at) ON memory_namespaces TO " + role,
+		"GRANT UPDATE(last_seen_at) ON memory_principals TO " + role,
+		"GRANT UPDATE(granted_at) ON memory_namespace_memberships TO " + role,
+		"SET ROLE " + role,
+	}
+	for _, q := range grants {
+		if _, err := db.Exec(q); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if n, _, err := NewIngestJobRepo(db).NamespaceVectorCapacity(context.Background()); err != nil || n != 0 {
+		t.Fatalf("runtime privileges insufficient: %d %v", n, err)
+	}
+	if _, err := db.Exec(`UPDATE memory_namespaces SET status='disabled'`); err == nil {
+		t.Fatal("fixture can disable namespaces")
+	}
+}
+
+func TestNamespaceCapacityEnforcementAndCancellation(t *testing.T) {
+	db := ingestTestDB(t)
+	seedSamplerAccess(t, db)
+	r := NewIngestJobRepo(db)
+	if _, err := db.Exec(`UPDATE memory_namespace_migration_state SET phase='additive_ready',
+ checkpoint=NULL,legacy_namespace_id=NULL,legacy_principal_id=NULL,legacy_namespace_slug=NULL,
+ legacy_namespace_display_name=NULL,legacy_principal_key=NULL WHERE singleton_id`); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := r.NamespaceVectorCapacity(context.Background()); !errors.Is(err, ingestqueue.ErrSamplerNotEnforced) {
+		t.Fatalf("unenforced sample accepted: %v", err)
+	}
+	db.SetMaxOpenConns(1)
+	conn, err := db.Conn(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer cancel()
+	if _, _, err = r.NamespaceVectorCapacity(ctx); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("pool wait not bounded: %v", err)
+	}
+	conn.Close()
+}
diff --git a/server/internal/repository/postgres/namespace_vector_dense_test.go b/server/internal/repository/postgres/namespace_vector_dense_test.go
new file mode 100644
index 0000000..75ce45c
--- /dev/null
+++ b/server/internal/repository/postgres/namespace_vector_dense_test.go
@@ -0,0 +1,105 @@
+package postgres
+
+import (
+	"context"
+	"encoding/json"
+	"math"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/qiffang/mnemos/server/internal/domain"
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+func TestNamespaceVectorDenseFirstAndPreparedQueries(t *testing.T) {
+	if os.Getenv("MEM9_NAMESPACE_PERFORMANCE_TEST") != "1" {
+		t.Skip("MEM9_NAMESPACE_PERFORMANCE_TEST is not enabled")
+	}
+	db := ingestTestDB(t)
+	db.SetMaxOpenConns(1)
+	seedNamespaceVectorBenchmark(t, db)
+	// Dense deterministic non-zero values exercise TOAST reads that the mostly
+	// zero warm fixture compresses away. No customer vectors or content are used.
+	if _, err := db.Exec(`UPDATE memories m SET embedding=(
+  ARRAY[1::real,substring(m.id,25)::real/30000] ||
+  ARRAY(SELECT (sin((substring(m.id,25)::integer*1024+j)::double precision)/1000)::real FROM generate_series(1,1022)j)
+ )::vector`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`VACUUM ANALYZE memories`); err != nil {
+		t.Fatal(err)
+	}
+	repo := NewMemoryRepo(db, false, "", testutil.TestNamespaceScope())
+	repo.exactVectorMaxRows = namespaceBenchmarkRows
+	repo.exactVectorTimeout = 2 * time.Second
+	vec := make([]float32, 1024)
+	vec[0] = 1
+	ctx := context.Background()
+	for _, filtered := range []bool{false, true} {
+		for _, limit := range []int{10, 50} {
+			// Close the previous case's idle connection. Each K/filter case starts
+			// with a fresh physical connection, then reuses it for all eight calls.
+			db.SetMaxIdleConns(0)
+			db.SetMaxIdleConns(1)
+			filter := domain.MemoryFilter{MinScore: -1}
+			app := "namespace-benchmark"
+			if filtered {
+				filter.AppID = &app
+			}
+			var reference []domain.Memory
+			for call := 0; call < 8; call++ {
+				started := time.Now()
+				actual, err := repo.VectorSearch(ctx, vec, filter, limit)
+				elapsed := time.Since(started)
+				if err != nil {
+					t.Fatalf("filtered=%v K=%d call=%d: %v", filtered, limit, call, err)
+				}
+				if elapsed >= 2*time.Second {
+					t.Fatalf("request exceeded synthetic budget: %s", elapsed)
+				}
+				if call == 0 {
+					reference, err = baselineNamespaceVectorSearch(ctx, db, testutil.TestNamespaceScope(), vec, filter, limit)
+					if err != nil {
+						t.Fatal(err)
+					}
+				}
+				assertSameBenchmarkRows(t, reference, actual, limit)
+				for i := range actual {
+					if actual[i].Score == nil || reference[i].Score == nil || math.Abs(*actual[i].Score-*reference[i].Score) > 1e-6 {
+						t.Fatal("exact score changed")
+					}
+				}
+				t.Logf("dense vector filtered=%v top_k=%d call=%d request_ms=%d", filtered, limit, call, elapsed.Milliseconds())
+			}
+		}
+	}
+	// Verify the real pgx driver exercised prepared queries beyond initial custom
+	// planning, instead of treating repeated EXPLAIN statements as that proof.
+	var executions int64
+	if err := db.QueryRow(`SELECT COALESCE(MAX(generic_plans+custom_plans),0) FROM pg_prepared_statements
+ WHERE statement LIKE '%WITH namespace_distances AS MATERIALIZED%'`).Scan(&executions); err != nil {
+		t.Fatal(err)
+	}
+	if executions < 8 {
+		t.Fatalf("only %d prepared query executions", executions)
+	}
+	var counts int
+	start := time.Now()
+	if err := db.QueryRow(`SELECT COUNT(*) FROM memories WHERE namespace_id=$1 AND state='active' AND embedding IS NOT NULL`, testutil.TestNamespaceID).Scan(&counts); err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("dense count rows=%d count_ms=%d prepared_executions=%d", counts, time.Since(start).Milliseconds(), executions)
+	// Compact, content-free plan diagnostics; never print parameterized SQL or
+	// a full plan containing query vectors. Timing of the actual query is logged
+	// by the request path as count_ms and rank_hydrate_ms.
+	var raw []byte
+	if err := db.QueryRow(`EXPLAIN (ANALYZE,BUFFERS,FORMAT JSON) SELECT COUNT(*) FROM memories WHERE namespace_id=$1 AND state='active' AND embedding IS NOT NULL`, testutil.TestNamespaceID).Scan(&raw); err != nil {
+		t.Fatal(err)
+	}
+	var plans []map[string]any
+	if err := json.Unmarshal(raw, &plans); err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("dense count execution_ms=%v planning_ms=%v", plans[0]["Execution Time"], plans[0]["Planning Time"])
+}
