+package ingestqueue
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"log/slog"
+	"strings"
+	"testing"
+	"time"
+)
+
+type capacityTestRepo struct {
+	*fakeRepo
+	capacity func(context.Context) (int, int, error)
+}
+
+func (r *capacityTestRepo) NamespaceVectorCapacity(ctx context.Context) (int, int, error) {
+	return r.capacity(ctx)
+}
+
+type capacityFailWriter struct {
+	calls int
+	short bool
+}
+
+func (w *capacityFailWriter) Write(p []byte) (int, error) {
+	w.calls++
+	if w.short {
+		return len(p) - 1, nil
+	}
+	return 0, errors.New("private-writer-error")
+}
+
+func TestNamespaceCapacityTelemetryCompleteRecord(t *testing.T) {
+	for _, rows := range []int{0, 80, 120} {
+		var b bytes.Buffer
+		tm := NewEMFTelemetry("prod", &b, func() time.Time { return time.Unix(10, 0) }).(*emfTelemetry)
+		if err := tm.NamespaceVectorCapacity(rows, 100); err != nil {
+			t.Fatal(err)
+		}
+		var record map[string]any
+		if err := json.Unmarshal(b.Bytes(), &record); err != nil {
+			t.Fatal(err)
+		}
+		if record["NamespaceVectorUtilizationPercent"] != float64(rows) || record["NamespaceVectorCapacitySampleCompleted"] != float64(1) {
+			t.Fatalf("bad metrics: %s", b.String())
+		}
+		if len(record) != 4 || !strings.Contains(b.String(), `"Namespace":"mem9-on-aws/NamespaceVector"`) || !strings.Contains(b.String(), `"Dimensions":[["stage"]]`) {
+			t.Fatalf("unbounded record: %s", b.String())
+		}
+	}
+	for _, values := range [][2]int{{-1, 100}, {1, 0}, {1, -1}} {
+		var b bytes.Buffer
+		tm := NewEMFTelemetry("prod", &b, nil).(*emfTelemetry)
+		if tm.NamespaceVectorCapacity(values[0], values[1]) == nil || b.Len() != 0 {
+			t.Fatal("invalid metric emitted")
+		}
+	}
+	for _, short := range []bool{false, true} {
+		w := &capacityFailWriter{short: short}
+		tm := NewEMFTelemetry("prod", w, nil).(*emfTelemetry)
+		if err := tm.NamespaceVectorCapacity(80, 100); err == nil || w.calls != 1 {
+			t.Fatal("writer failure not returned in one call")
+		}
+	}
+}
+
+func TestNamespaceCapacitySampleFailureOmitsHeartbeat(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		var output, logs bytes.Buffer
+		repo := &capacityTestRepo{fakeRepo: &fakeRepo{}, capacity: func(ctx context.Context) (int, int, error) {
+			deadline, ok := ctx.Deadline()
+			if !ok || time.Until(deadline) > 10*time.Second {
+				t.Fatal("unbounded sample")
+			}
+			if fail {
+				return 90, 100, errors.New("private-namespace-and-error")
+			}
+			return 90, 100, nil
+		}}
+		cfg := DefaultWorkerConfig()
+		cfg.Telemetry = NewEMFTelemetry("prod", &output, nil)
+		w := NewWorker(repo, fakeProcessor{}, "private-tenant", "worker", cfg, slog.New(slog.NewTextHandler(&logs, nil)))
+		w.sampleNamespaceCapacity(context.Background())
+		if fail && output.Len() != 0 {
+			t.Fatal("partial sample emitted telemetry")
+		}
+		if !fail && output.Len() == 0 {
+			t.Fatal("successful sample missing")
+		}
+		if strings.Contains(output.String()+logs.String(), "private-") {
+			t.Fatal("private error or identity logged")
+		}
+	}
+}
+
+func TestNamespaceCapacityLoopCancellationAndQueueIndependence(t *testing.T) {
+	entered := make(chan struct{})
+	done := make(chan struct{})
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	repo := &capacityTestRepo{fakeRepo: &fakeRepo{}, capacity: func(ctx context.Context) (int, int, error) { close(entered); <-ctx.Done(); return 0, 0, ctx.Err() }}
+	cfg := DefaultWorkerConfig()
+	cfg.Telemetry = NewEMFTelemetry("prod", io.Discard, nil)
+	w := NewWorker(repo, fakeProcessor{}, "tenant", "worker", cfg, slog.New(slog.NewTextHandler(io.Discard, nil)))
+	go func() { w.runNamespaceCapacitySampler(ctx); close(done) }()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("sampler not started")
+	}
+	queueDone := make(chan struct{})
+	go func() { w.sampleOldestQueuedAge(ctx); close(queueDone) }()
+	select {
+	case <-queueDone:
+	case <-time.After(time.Second):
+		t.Fatal("capacity blocked queue sampling")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("sampler not canceled")
+	}
+}
