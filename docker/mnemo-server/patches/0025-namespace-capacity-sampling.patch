+package ingestqueue
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"time"
+)
+
+const namespaceCapacitySampleTimeout = 10 * time.Second
+
+// Optional capabilities keep backends without namespaces and existing telemetry
+// implementations on their original worker path.
+type namespaceCapacityRepository interface {
+	NamespaceVectorCapacity(context.Context) (rows, ceiling int, err error)
+}
+type namespaceCapacityTelemetry interface {
+	NamespaceVectorCapacity(rows, ceiling int) error
+}
+
+func (t *emfTelemetry) NamespaceVectorCapacity(rows, ceiling int) error {
+	if rows < 0 || ceiling <= 0 {
+		return errors.New("invalid namespace capacity sample")
+	}
+	record := struct {
+		Metadata    emfMetadata `json:"_aws"`
+		Stage       string      `json:"stage"`
+		Utilization float64     `json:"NamespaceVectorUtilizationPercent"`
+		Completed   int         `json:"NamespaceVectorCapacitySampleCompleted"`
+	}{
+		Metadata: emfMetadata{Timestamp: t.now().UnixMilli(), CloudWatchMetrics: []emfDirective{{
+			Namespace: "mem9-on-aws/NamespaceVector", Dimensions: [][]string{{"stage"}},
+			Metrics: []emfMetric{{Name: "NamespaceVectorUtilizationPercent", Unit: "Percent"}, {Name: "NamespaceVectorCapacitySampleCompleted", Unit: "Count"}},
+		}}}, Stage: t.stage, Utilization: float64(rows) / float64(ceiling) * 100, Completed: 1,
+	}
+	payload, err := json.Marshal(record)
+	if err != nil {
+		return err
+	}
+	payload = append(payload, '\n')
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	n, err := t.output.Write(payload)
+	if err != nil {
+		return err
+	}
+	if n != len(payload) {
+		return io.ErrShortWrite
+	}
+	return nil
+}
+
+func (w *Worker) runNamespaceCapacitySampler(ctx context.Context) {
+	// A fresh timer after each completed sample skips catch-up work. No capacity
+	// transaction can overlap the previous one, even after a stalled database.
+	for {
+		if ctx.Err() != nil {
+			return
+		}
+		w.sampleNamespaceCapacity(ctx)
+		timer := time.NewTimer(time.Minute)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return
+		case <-timer.C:
+		}
+	}
+}
+
+func (w *Worker) sampleNamespaceCapacity(ctx context.Context) {
+	repo, ok := w.repo.(namespaceCapacityRepository)
+	if !ok {
+		return
+	}
+	telemetry, ok := w.config.Telemetry.(namespaceCapacityTelemetry)
+	if !ok {
+		return
+	}
+	sampleCtx, cancel := context.WithTimeout(ctx, namespaceCapacitySampleTimeout)
+	defer cancel()
+	rows, ceiling, err := repo.NamespaceVectorCapacity(sampleCtx)
+	errorClass := "database_error"
+	if err == nil {
+		err = telemetry.NamespaceVectorCapacity(rows, ceiling)
+		errorClass = "telemetry_write_failed"
+	}
+	if err == nil || ctx.Err() != nil {
+		return
+	}
+	if errors.Is(err, ErrSamplerScopeDenied) {
+		errorClass = "scope_denied"
+	}
+	if errors.Is(err, ErrSamplerNotEnforced) {
+		errorClass = "namespace_not_enforced"
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		errorClass = "deadline"
+	}
+	w.logger.Error("namespace vector capacity sample failed", "error_class", errorClass)
+}
