new file mode 100644
index 0000000..bbc5f42
--- /dev/null
+++ b/server/internal/repository/postgres/namespace_capacity.go
@@ -0,0 +1,77 @@
+package postgres
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+
+	"github.com/qiffang/mnemos/server/internal/ingestqueue"
+)
+
+// NamespaceVectorCapacity reads metadata and counts only. Authorization locks
+// follow the existing namespace -> principal -> membership order and survive
+// through the count. Row locks require a transaction without ReadOnly=true;
+// this operation performs no DML and never provisions sampler access.
+func (r *IngestJobRepo) NamespaceVectorCapacity(ctx context.Context) (int, int, error) {
+	ceiling, _ := namespaceExactVectorConfig()
+	tx, err := r.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelRepeatableRead})
+	if err != nil {
+		return 0, 0, err
+	}
+	defer tx.Rollback()
+	var phase string
+	if err = tx.QueryRowContext(ctx, `SELECT phase FROM memory_namespace_migration_state WHERE singleton_id`).Scan(&phase); err != nil {
+		return 0, 0, err
+	}
+	if phase != "constraints_complete" {
+		return 0, 0, ingestqueue.ErrSamplerNotEnforced
+	}
+	rows, err := tx.QueryContext(ctx, `SELECT namespace_id FROM memory_namespaces WHERE status='active' ORDER BY namespace_id FOR SHARE`)
+	if err != nil {
+		return 0, 0, err
+	}
+	var namespaces []string
+	for rows.Next() {
+		var namespaceID string
+		if err = rows.Scan(&namespaceID); err != nil {
+			rows.Close()
+			return 0, 0, err
+		}
+		namespaces = append(namespaces, namespaceID)
+	}
+	err = rows.Err()
+	rows.Close()
+	if err != nil {
+		return 0, 0, err
+	}
+	var principalID string
+	if err = tx.QueryRowContext(ctx, `SELECT principal_id FROM memory_principals
+ WHERE principal_key=$1 AND principal_type='service' AND status='active' FOR SHARE`, samplerPrincipalKey()).Scan(&principalID); err != nil {
+		return 0, 0, samplerAuthorizationError(err)
+	}
+	// Validate every membership before reading any memory table. Empty namespace
+	// sets still require enforcement and the fixed active sampler principal.
+	for _, namespaceID := range namespaces {
+		var role string
+		if err = tx.QueryRowContext(ctx, `SELECT role FROM memory_namespace_memberships
+  WHERE namespace_id=$1 AND principal_id=$2 AND status='active' AND source_type='service'
+  AND role IN ('viewer','member','owner') FOR SHARE`, namespaceID, principalID).Scan(&role); err != nil {
+			return 0, 0, samplerAuthorizationError(err)
+		}
+	}
+	maximum := 0
+	for _, namespaceID := range namespaces {
+		var count int
+		if err = tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM memories
+  WHERE namespace_id=$1 AND state='active' AND embedding IS NOT NULL`, namespaceID).Scan(&count); err != nil {
+			return 0, 0, fmt.Errorf("count namespace vector rows: %w", err)
+		}
+		if count > maximum {
+			maximum = count
+		}
+	}
+	if err = tx.Commit(); err != nil {
+		return 0, 0, err
+	}
+	return maximum, ceiling, nil
+}
