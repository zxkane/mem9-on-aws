@@ -0,0 +1,69 @@
+package postgres
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"log/slog"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/qiffang/mnemos/server/internal/domain"
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+func TestNamespaceVectorDiagnosticTimeout(t *testing.T) {
+	for _, phase := range []string{"transaction_setup", "count", "rank_hydrate", "commit", "private-invalid-phase"} {
+		var b bytes.Buffer
+		original := slog.Default()
+		slog.SetDefault(slog.New(slog.NewJSONHandler(&b, nil)))
+		err := classifyNamespaceVectorPhaseError(&pgconn.PgError{Code: "57014", Message: "private-sql-content"}, phase, time.Now().Add(-2*time.Second))
+		slog.SetDefault(original)
+		if !errors.Is(err, domain.ErrNamespaceVectorTimeout) {
+			t.Fatal("lost typed timeout")
+		}
+		if strings.Count(b.String(), "\n") != 1 || strings.Contains(b.String(), "private-") {
+			t.Fatalf("bad timeout record: %s", b.String())
+		}
+		var record map[string]any
+		if err := json.Unmarshal(b.Bytes(), &record); err != nil {
+			t.Fatal(err)
+		}
+		wantPhase := phase
+		if strings.HasPrefix(phase, "private-") {
+			wantPhase = "transaction_setup"
+		}
+		if record["phase"] != wantPhase || record["msg"] != "namespace vector search" || record["result"] != "timeout" || record["elapsed_ms"].(float64) < 2000 {
+			t.Fatalf("bad phase timing: %s", b.String())
+		}
+	}
+}
+
+func TestNamespaceVectorPoolDeadlineIsNotSQLTimeout(t *testing.T) {
+	db := ingestTestDB(t)
+	db.SetMaxOpenConns(1)
+	conn, err := db.Conn(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	var output bytes.Buffer
+	original := slog.Default()
+	slog.SetDefault(slog.New(slog.NewJSONHandler(&output, nil)))
+	defer slog.SetDefault(original)
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer cancel()
+	repo := NewMemoryRepo(db, false, "", testutil.TestNamespaceScope())
+	vec := make([]float32, 1024)
+	vec[0] = 1
+	_, err = repo.VectorSearch(ctx, vec, domain.MemoryFilter{}, 10)
+	if !errors.Is(err, context.DeadlineExceeded) || errors.Is(err, domain.ErrNamespaceVectorTimeout) {
+		t.Fatalf("incorrect setup error: %v", err)
+	}
+	if output.Len() != 0 {
+		t.Fatalf("pool deadline counted as SQL timeout: %s", output.String())
+	}
+}
