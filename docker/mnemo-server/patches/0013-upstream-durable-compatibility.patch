+	"github.com/qiffang/mnemos/server/internal/service"
+)
+
+// TC-UPSTREAM-005 exercises the constructor shared by both durable worker paths.
+func TestDurableWorkerAssistantPolicy(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		t.Run(map[bool]string{false: "default user only", true: "explicit assistant opt in"}[enabled], func(t *testing.T) {
+			prompts := make(chan string, 1)
+			endpoint := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				var req struct {
+					Messages []struct {
+						Content string `json:"content"`
+					} `json:"messages"`
+				}
+				if err := json.NewDecoder(r.Body).Decode(&req); err != nil || len(req.Messages) == 0 {
+					http.Error(w, "invalid request", 400)
+					return
+				}
+				prompts <- req.Messages[0].Content
+				json.NewEncoder(w).Encode(map[string]any{"choices": []map[string]any{{"message": map[string]string{"content": `{"facts":[],"message_tags":[[],[]]}`}}}})
+			}))
+			defer endpoint.Close()
+			cfg := &config.Config{IngestMode: "smart", FactExtractionIncludeAssistant: enabled}
+			client := llm.New(llm.Config{APIKey: "local", BaseURL: endpoint.URL, Model: "test"})
+			svc := newDurableIngestService(cfg, nil, client, nil)
+			_, err := svc.ExtractPhase1(context.Background(), []service.IngestMessage{{Role: "user", Content: "Which database is configured?"}, {Role: "assistant", Content: "PostgreSQL is the configured database."}})
+			if err != nil {
+				t.Fatal(err)
+			}
+			prompt := <-prompts
+			if strings.Contains(prompt, "Extract durable facts from both user and assistant messages") != enabled {
+				t.Fatal("durable constructor did not apply the configured assistant policy")
+			}
+			if strings.Contains(prompt, "Extract facts ONLY from the user's messages") == enabled {
+				t.Fatal("user-only policy did not match configuration")
+			}
+		})
+	}
+}
