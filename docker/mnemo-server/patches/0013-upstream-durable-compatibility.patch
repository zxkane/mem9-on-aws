+// Keep the global worker and its namespace-specific replacements on the same
+// extraction policy. Production leaves assistant extraction disabled.
+func newDurableIngestService(cfg *config.Config, repo repository.MemoryRepo, client *llm.Client, embedder *embed.Embedder) *service.IngestService {
+	return service.NewIngestService(repo, client, embedder, cfg.EmbedAutoModel,
+		service.IngestMode(cfg.IngestMode), service.WithAssistantFactExtraction(cfg.FactExtractionIncludeAssistant))
+}
