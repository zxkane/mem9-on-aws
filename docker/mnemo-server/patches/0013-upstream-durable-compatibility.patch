+// Upstream provenance is not in ingest-v1: do not acknowledge work that drops it.
+func TestDurableIngestRejectsUnsupportedExternalProvenance(t *testing.T) {
+	repo := &testMemoryRepo{}
+	srv := newTestServer(repo, &testSessionRepo{}).WithDurableIngest(true)
+	req := makeRequest(t, http.MethodPost, "/memories", map[string]any{
+		"messages": []map[string]string{{"role": "user", "content": "A durable fact"}},
+		"metadata": map[string]any{"external_provenance": map[string]string{"schema": "agent9/message-source@1", "source_message_id": "source-message"}},
+	})
+	rr := httptest.NewRecorder()
+	srv.createMemory(rr, req)
+	if rr.Code != http.StatusBadRequest {
+		t.Fatalf("status=%d, want 400: %s", rr.Code, rr.Body.String())
+	}
+	if len(repo.createCalls) != 0 {
+		t.Fatal("unsupported provenance started memory work")
+	}
+}
