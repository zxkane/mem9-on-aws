+func prepareAtomicIntegrationPlan(
+	t *testing.T,
+	repo *IngestJobRepo,
+	key string,
+) (*ingestqueue.Job, ingestqueue.AtomicPlan) {
+	t.Helper()
+	input := enqueueInput("tenant-a", "session-a", key)
+	input.ID = "54000000-0000-4000-8000-" + key[:12]
+	job := enqueueJob(t, repo, input)
+	if job.State != ingestqueue.StateQueued {
+		t.Fatalf("enqueue state = %s", job.State)
+	}
+	claimed, err := repo.Claim(
+		context.Background(),
+		job.TenantID,
+		"worker-a",
+		time.Minute,
+		ingestqueue.MaxAttempts,
+	)
+	if err != nil {
+		t.Fatalf("Claim: %v", err)
+	}
+	if err := repo.StartPlanning(context.Background(), claimed.LeaseRef()); err != nil {
+		t.Fatalf("StartPlanning: %v", err)
+	}
+	plan, err := ingestqueue.FinalizePlan(ingestqueue.AtomicPlan{
+		JobID:             claimed.ID,
+		TenantID:          claimed.TenantID,
+		Revision:          1,
+		AttemptGeneration: claimed.AttemptCount,
+		Sessions: []ingestqueue.SessionUpsert{
+			{
+				ID:          "54000000-0000-4000-8000-000000000001",
+				SessionID:   "session-a",
+				AgentID:     "agent-a",
+				AppID:       "app-a",
+				Source:      "agent-a",
+				Seq:         0,
+				Role:        "user",
+				Content:     "remember atomic writes",
+				ContentType: "text",
+				ContentHash: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+			},
+		},
+		MessageTagPatches: []ingestqueue.MessageTagPatch{
+			{
+				AppID:       "app-a",
+				SessionID:   "session-a",
+				ContentHash: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+				Tags:        []string{"atomic"},
+			},
+		},
+		Actions: []ingestqueue.MemoryAction{
+			{
+				Kind:        ingestqueue.ActionAdd,
+				Content:     "first fact",
+				AppID:       "app-a",
+				AgentID:     "agent-a",
+				SessionID:   "session-a",
+				SourceOrder: 0,
+			},
+			{
+				Kind:        ingestqueue.ActionAdd,
+				Content:     "second fact",
+				AppID:       "app-a",
+				AgentID:     "agent-a",
+				SessionID:   "session-a",
+				SourceOrder: 1,
+			},
+		},
+	})
+	if err != nil {
+		t.Fatalf("FinalizePlan: %v", err)
+	}
+	if err := repo.SavePlan(context.Background(), claimed.LeaseRef(), plan); err != nil {
+		t.Fatalf("SavePlan: %v", err)
+	}
+	return claimed, plan
+}
+
+func assertAtomicMutationCounts(
+	t *testing.T,
+	repo *IngestJobRepo,
+	job *ingestqueue.Job,
+	wantSessions, wantMemories int,
+	wantState ingestqueue.State,
+) {
+	t.Helper()
+	var sessions, memories int
+	if err := repo.db.QueryRow(`SELECT count(*) FROM sessions`).Scan(&sessions); err != nil {
+		t.Fatal(err)
+	}
+	if err := repo.db.QueryRow(`SELECT count(*) FROM memories`).Scan(&memories); err != nil {
+		t.Fatal(err)
+	}
+	got, err := repo.Get(context.Background(), job.TenantID, job.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if sessions != wantSessions || memories != wantMemories || got.State != wantState {
+		t.Fatalf(
+			"sessions=%d memories=%d state=%s, want %d/%d/%s",
+			sessions,
+			memories,
+			got.State,
+			wantSessions,
+			wantMemories,
+			wantState,
+		)
+	}
+}
+
+func TestAtomicApplyCrashPointsRollbackAllMutations(t *testing.T) {
+	hooks := []string{
+		"before_apply",
+		"transaction_open",
+		"after_session_0",
+		"after_tag_0",
+		"after_action_0",
+		"after_action_1",
+		"before_job_success",
+		"before_commit",
+	}
+	for index, hook := range hooks {
+		t.Run(hook, func(t *testing.T) {
+			db := ingestTestDB(t)
+			repo := NewIngestJobRepo(db)
+			key := fmt.Sprintf("%064x", index+1)
+			job, plan := prepareAtomicIntegrationPlan(t, repo, key)
+			assertAtomicMutationCounts(t, repo, job, 0, 0, ingestqueue.StateApplying)
+
+			repo.applyHook = func(point string) error {
+				if point == hook {
+					return errors.New("injected crash")
+				}
+				return nil
+			}
+			if _, err := repo.ApplyPlan(
+				context.Background(),
+				job.LeaseRef(),
+				plan,
+			); err == nil {
+				t.Fatal("ApplyPlan unexpectedly succeeded")
+			}
+			assertAtomicMutationCounts(t, repo, job, 0, 0, ingestqueue.StateApplying)
+			var planState string
+			if err := db.QueryRow(`
+				SELECT state
+				FROM ingest_job_plans
+				WHERE tenant_id = $1 AND job_id = $2 AND plan_revision = 1`,
+				job.TenantID,
+				job.ID,
+			).Scan(&planState); err != nil {
+				t.Fatal(err)
+			}
+			if planState != "valid" {
+				t.Fatalf("plan state = %q, want valid", planState)
+			}
+		})
+	}
+}
+
+func TestAtomicApplyBackendTerminationAfterMutationRollsBack(t *testing.T) {
+	db := ingestTestDB(t)
+	repo := NewIngestJobRepo(db)
+	job, plan := prepareAtomicIntegrationPlan(
+		t,
+		repo,
+		"eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
+	)
+	repo.applyHook = func(point string) error {
+		if point != "after_action_0" {
+			return nil
+		}
+		var terminated bool
+		err := db.QueryRow(`
+			SELECT pg_terminate_backend(pid)
+			FROM pg_stat_activity
+			WHERE datname = current_database()
+			  AND pid <> pg_backend_pid()
+			  AND state = 'idle in transaction'
+			ORDER BY xact_start DESC
+			LIMIT 1`,
+		).Scan(&terminated)
+		if err != nil {
+			return fmt.Errorf("terminate apply backend: %w", err)
+		}
+		if !terminated {
+			return errors.New("apply backend was not terminated")
+		}
+		return nil
+	}
+
+	if _, err := repo.ApplyPlan(
+		context.Background(),
+		job.LeaseRef(),
+		plan,
+	); err == nil {
+		t.Fatal("ApplyPlan unexpectedly survived backend termination")
+	}
+	assertAtomicMutationCounts(t, repo, job, 0, 0, ingestqueue.StateApplying)
+	var planState string
+	if err := db.QueryRow(`
+		SELECT state
+		FROM ingest_job_plans
+		WHERE tenant_id = $1 AND job_id = $2 AND plan_revision = 1`,
+		job.TenantID,
+		job.ID,
+	).Scan(&planState); err != nil {
+		t.Fatal(err)
+	}
+	if planState != "valid" {
+		t.Fatalf("plan state = %q, want valid", planState)
+	}
+}
