+func TestIngestJobEnqueuePersistsOriginalRuntimeReservation(t *testing.T) {
+	db := ingestTestDB(t)
+	repo := NewIngestJobRepo(db)
+	input := enqueueInput(
+		"tenant-a",
+		"session-a",
+		"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+	)
+	input.RuntimeOperationID = "00000000-0000-7000-8000-000000000054"
+	input.RuntimeClusterID = "cluster-a"
+	input.RuntimeAgentName = "agent-a"
+	input.RuntimeReservationExpiresAt = time.Now().UTC().Add(30 * time.Minute).Truncate(time.Microsecond)
+	first := enqueueJob(t, repo, input)
+	if first.RuntimeOperationID != input.RuntimeOperationID ||
+		first.RuntimeClusterID != input.RuntimeClusterID ||
+		first.RuntimeAgentName != input.RuntimeAgentName ||
+		first.RuntimeReservationExpiresAt == nil ||
+		!first.RuntimeReservationExpiresAt.Equal(input.RuntimeReservationExpiresAt) ||
+		first.RuntimeFinalizationState != ingestqueue.RuntimeFinalizationReserved {
+		t.Fatalf("persisted runtime reservation = %+v", first)
+	}
+
+	duplicate := input
+	duplicate.ID = "00000000-0000-4000-8000-000000000002"
+	duplicate.RuntimeOperationID = "00000000-0000-7000-8000-000000000055"
+	got := enqueueJob(t, repo, duplicate)
+	if got.ID != first.ID || got.RuntimeOperationID != first.RuntimeOperationID {
+		t.Fatalf("duplicate replaced reservation: first=%+v duplicate=%+v", first, got)
+	}
+}
