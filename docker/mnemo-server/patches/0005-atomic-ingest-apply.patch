+	renewer, ok := w.processor.(RuntimeReservationRenewer)
+	if !ok {
+		return ErrProcessorUnavailable
+	}
+	previous := *job
+	replacement, err := renewer.RenewRuntimeReservation(ctx, job)
+	if err != nil {
+		return err
+	}
+	minimumExpiry := time.Now().UTC().Add(minimumValidity)
+	if replacement.OperationID != "" &&
+		(replacement.ExpiresAt.IsZero() ||
+			!replacement.ExpiresAt.After(minimumExpiry)) {
+		replacementJob := jobWithRuntimeReservation(job, replacement)
+		renewer.ReleaseRuntimeReservation(ctx, replacementJob)
+		return NewOutcomeError("runtime_reservation_too_short")
