+func TestIngestJobStatusTenantBindingAndFieldAllowList(t *testing.T) {
+	now := time.Date(2026, 7, 26, 12, 0, 0, 0, time.UTC)
+	completedAt := now.Add(2 * time.Minute)
+	job := &ingestqueue.Job{
+		ID:               "job-owned",
+		TenantID:         "tenant-a",
+		State:            ingestqueue.StateSucceeded,
+		AttemptCount:     2,
+		WarningClass:     ingestqueue.WarningTruncated,
+		CanonicalPayload: json.RawMessage(`{"secret_marker":"payload-leak"}`),
+		PlanPayload:      json.RawMessage(`{"secret_marker":"plan-leak"}`),
+		LeaseOwner:       "lease-owner-leak",
+		CreatedAt:        now,
+		UpdatedAt:        now.Add(time.Minute),
+		CompletedAt:      &completedAt,
+	}
+	repo := &handlerIngestRepo{
+		get: func(_ context.Context, tenantID, jobID string) (*ingestqueue.Job, error) {
+			if tenantID != "tenant-a" || jobID != job.ID {
+				return nil, sql.ErrNoRows
+			}
+			return job, nil
+		},
+	}
+	srv := newTestServer(&testMemoryRepo{}, &testSessionRepo{})
+	srv.dbBackend = "postgres"
+	srv.ingestRepoFactory = func(backend string, _ *sql.DB) ingestqueue.Repository {
+		if backend != "postgres" {
+			t.Fatalf("factory backend = %q", backend)
+		}
+		return repo
+	}
+
+	req := httptest.NewRequest(http.MethodGet, "/v1alpha2/mem9s/ingest-jobs/"+job.ID, nil)
+	req = withURLParam(req, "jobID", job.ID)
+	req = req.WithContext(middleware.WithAuthContext(req.Context(), &domain.AuthInfo{
+		TenantID: "tenant-a",
+		TenantDB: &sql.DB{},
+	}))
+	rec := httptest.NewRecorder()
+	srv.getIngestJobStatus(rec, req)
+	if rec.Code != http.StatusOK {
+		t.Fatalf("status = %d, body=%s", rec.Code, rec.Body.String())
+	}
+	body := rec.Body.String()
+	for _, forbidden := range []string{
+		"payload-leak", "plan-leak", "lease-owner-leak", "tenant-a",
+		"canonical_payload", "plan_payload", "lease_owner", "plan_hash", "plan_revision",
+		"runtime_operation_id", "runtime_cluster_id", "runtime_agent_name",
+	} {
+		if strings.Contains(body, forbidden) {
+			t.Fatalf("status leaked %q: %s", forbidden, body)
+		}
+	}
+	var response map[string]any
+	if err := json.Unmarshal(rec.Body.Bytes(), &response); err != nil {
+		t.Fatalf("decode response: %v", err)
+	}
+	for _, field := range []string{
+		"job_id", "state", "attempts", "warning_class",
+		"created_at", "updated_at", "completed_at",
+	} {
+		if _, ok := response[field]; !ok {
+			t.Fatalf("response missing %q: %v", field, response)
+		}
+	}
+}
+
+func TestIngestJobStatusUnknownOrCrossTenantIsNotFound(t *testing.T) {
+	srv := newTestServer(&testMemoryRepo{}, &testSessionRepo{})
+	srv.ingestRepoFactory = func(_ string, _ *sql.DB) ingestqueue.Repository {
+		return &handlerIngestRepo{
+			get: func(context.Context, string, string) (*ingestqueue.Job, error) {
+				return nil, sql.ErrNoRows
+			},
+		}
