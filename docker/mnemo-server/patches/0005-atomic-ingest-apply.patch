+	if _, err := db.Exec(`
+		INSERT INTO memories (id, content, app_id, state, version)
+		VALUES ($1, 'original', 'app-a', 'active', 1)`,
+		existingID,
+	); err != nil {
+		t.Fatal(err)
+	}
+	buildPlan := func(revision, expectedVersion int) ingestqueue.AtomicPlan {
+		plan, err := ingestqueue.FinalizePlan(ingestqueue.AtomicPlan{
+			JobID:             claimed.ID,
+			TenantID:          claimed.TenantID,
+			Revision:          revision,
+			AttemptGeneration: claimed.AttemptCount,
+			Actions: []ingestqueue.MemoryAction{
+				{
+					Kind:        ingestqueue.ActionAdd,
+					Content:     "new fact",
+					AppID:       "app-a",
+					SourceOrder: 0,
+				},
+				{
+					Kind:            ingestqueue.ActionUpdate,
+					TargetID:        existingID,
+					ExpectedVersion: expectedVersion,
+					Content:         "updated",
+					AppID:           "app-a",
+					SourceOrder:     1,
+				},
+			},
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return plan
+	}
+
+	first := buildPlan(1, 2)
+	if err := repo.SavePlan(context.Background(), claimed.LeaseRef(), first); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := repo.ApplyPlan(
+		context.Background(),
+		claimed.LeaseRef(),
+		first,
+	); !errors.Is(err, ingestqueue.ErrPlanConflict) {
+		t.Fatalf("conflicting apply error = %v", err)
+	}
+	var count int
+	if err := db.QueryRow(`SELECT count(*) FROM memories`).Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 1 {
+		t.Fatalf("conflicting apply committed %d memories", count)
+	}
+	var content string
+	var version int
+	if err := db.QueryRow(`
+		SELECT content, version FROM memories WHERE id = $1`,
+		existingID,
+	).Scan(&content, &version); err != nil {
+		t.Fatal(err)
+	}
+	if content != "original" || version != 1 {
+		t.Fatalf("conflicting update committed content=%q version=%d", content, version)
+	}
+
+	if err := repo.MarkPlanStale(context.Background(), claimed.LeaseRef(), first); err != nil {
+		t.Fatal(err)
+	}
+	second := buildPlan(2, 1)
+	if err := repo.SavePlan(context.Background(), claimed.LeaseRef(), second); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := repo.ApplyPlan(context.Background(), claimed.LeaseRef(), second); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.QueryRow(`
+		SELECT content, version FROM memories WHERE id = $1`,
+		existingID,
+	).Scan(&content, &version); err != nil {
+		t.Fatal(err)
+	}
+	if content != "updated" || version != 2 {
+		t.Fatalf("replanned update content=%q version=%d", content, version)
+	}
+	if err := db.QueryRow(`
+		SELECT count(*) FROM memories WHERE id IN ($1, $2)`,
+		first.Actions[0].TargetID,
+		second.Actions[0].TargetID,
+	).Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 1 {
+		t.Fatalf("revision ADD count = %d, want only the successful revision", count)
+	}
+}
+
+func TestAtomicApplyTimeoutAndDeadlockRollback(t *testing.T) {
+	tests := []struct {
+		name string
+		hook func(string) error
+	}{
+		{
+			name: "timeout",
+			hook: func(point string) error {
+				if point == "after_action_0" {
+					time.Sleep(30 * time.Millisecond)
+				}
+				return nil
+			},
+		},
+		{
+			name: "deadlock",
+			hook: func(point string) error {
+				if point == "after_action_0" {
+					return testSQLStateError{state: "40P01"}
+				}
+				return nil
+			},
+		},
+	}
+	for index, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			db := ingestTestDB(t)
+			repo := NewIngestJobRepo(db)
+			if tc.name == "timeout" {
+				repo.applyTimeout = 10 * time.Millisecond
+			}
+			job, plan := prepareAtomicIntegrationPlan(
+				t,
+				repo,
+				fmt.Sprintf("%064x", index+100),
+			)
+			repo.applyHook = tc.hook
+			if _, err := repo.ApplyPlan(
+				context.Background(),
+				job.LeaseRef(),
+				plan,
+			); err == nil {
+				t.Fatal("ApplyPlan unexpectedly succeeded")
+			}
+			assertAtomicMutationCounts(t, repo, job, 0, 0, ingestqueue.StateApplying)
+		})
+	}
+}
+
+func TestAtomicApplyAmbiguousCommitRereadsSucceededJob(t *testing.T) {
+	db := ingestTestDB(t)
+	repo := NewIngestJobRepo(db)
+	job, plan := prepareAtomicIntegrationPlan(
+		t,
+		repo,
+		"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
+	)
+	repo.applyHook = func(point string) error {
+		if point == "after_commit" {
+			return errors.New("injected lost commit response")
+		}
+		return nil
+	}
+	if _, err := repo.ApplyPlan(context.Background(), job.LeaseRef(), plan); err != nil {
+		t.Fatalf("ambiguous committed apply: %v", err)
+	}
+	assertAtomicMutationCounts(t, repo, job, 1, 2, ingestqueue.StateSucceeded)
+}
+
+func TestPersistedPlanIsReusedAfterLeaseRecovery(t *testing.T) {
+	db := ingestTestDB(t)
+	repo := NewIngestJobRepo(db)
+	job, plan := prepareAtomicIntegrationPlan(
+		t,
+		repo,
+		"dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
+	)
+	if _, err := db.Exec(`
+		UPDATE ingest_jobs
+		SET lease_expires_at = statement_timestamp() - interval '1 second'
+		WHERE tenant_id = $1 AND job_id = $2`,
+		job.TenantID,
+		job.ID,
+	); err != nil {
+		t.Fatal(err)
+	}
+	recovered, err := repo.Claim(
+		context.Background(),
+		job.TenantID,
+		"worker-b",
+		time.Minute,
+		ingestqueue.MaxAttempts,
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if recovered == nil || recovered.AttemptCount != job.AttemptCount+1 {
+		t.Fatalf("recovered job = %+v", recovered)
+	}
+	if err := repo.StartPlanning(context.Background(), recovered.LeaseRef()); err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := repo.LoadPlan(context.Background(), recovered.LeaseRef())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded == nil || loaded.Hash != plan.Hash || loaded.Revision != plan.Revision {
+		t.Fatalf("loaded plan = %+v, want revision=%d hash=%s", loaded, plan.Revision, plan.Hash)
+	}
+	if err := repo.ResumePlan(context.Background(), recovered.LeaseRef(), *loaded); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := repo.ApplyPlan(
+		context.Background(),
+		recovered.LeaseRef(),
+		*loaded,
+	); err != nil {
+		t.Fatal(err)
+	}
+	assertAtomicMutationCounts(t, repo, recovered, 1, 2, ingestqueue.StateSucceeded)
+}
