+func TestDurableProcessorSkipsRuntimeFinalizationWithoutReservation(t *testing.T) {
+	finalizer := &durableRuntimeFinalizer{}
+	processor := NewDurableProcessor(nil, nil, nil, "", finalizer, nil)
+	job := &ingestqueue.Job{ID: "job-unmetered", TenantID: "tenant-a"}
+	job.State = ingestqueue.StateSucceeded
+	if err := processor.FinalizeTerminal(context.Background(), job, nil); err != nil {
+		t.Fatal(err)
+	}
+	job.State = ingestqueue.StateDead
+	if err := processor.FinalizeTerminal(context.Background(), job, nil); err != nil {
+		t.Fatal(err)
+	}
+	if len(finalizer.leases) != 0 {
+		t.Fatalf("unreserved job finalized runtime usage: %+v", finalizer.leases)
+	}
+}
