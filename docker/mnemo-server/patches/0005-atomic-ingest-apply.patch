+func assertDurableRuntimeLease(
+	t *testing.T,
+	lease *runtimeusage.OperationLease,
+	job *ingestqueue.Job,
+) {
+	t.Helper()
+	if lease == nil ||
+		lease.OperationID != job.RuntimeOperationID ||
+		lease.Subject.TenantID != job.TenantID ||
+		lease.Subject.APIKeySubject != job.TenantID ||
+		lease.Subject.ClusterID != job.RuntimeClusterID ||
+		lease.Subject.AgentName != job.RuntimeAgentName ||
+		lease.Meter != runtimeusage.MeterMemoryWriteRequests ||
+		lease.Units != 1 ||
+		!lease.Reserved {
+		t.Fatalf("runtime lease = %+v", lease)
+	}
+}
