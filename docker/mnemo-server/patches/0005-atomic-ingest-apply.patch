+type durableRuntimeFinalizer struct {
+	successes []runtimeusage.MemoryCreateResult
+	failures  int
+	leases    []*runtimeusage.OperationLease
+}
+
+func (f *durableRuntimeFinalizer) BeforeMemoryCreate(
+	_ context.Context,
+	subject runtimeusage.Subject,
+	_ int64,
+) (*runtimeusage.OperationLease, error) {
+	return &runtimeusage.OperationLease{
+		OperationID: "replacement-operation",
+		Subject:     subject,
+		Meter:       runtimeusage.MeterMemoryWriteRequests,
+		Units:       1,
+		Reserved:    true,
+		ExpiresAt:   time.Now().UTC().Add(30 * time.Minute),
+	}, nil
+}
+
+func (f *durableRuntimeFinalizer) AfterMemoryCreateSuccess(
+	_ context.Context,
+	lease *runtimeusage.OperationLease,
+	result runtimeusage.MemoryCreateResult,
+) error {
+	f.leases = append(f.leases, lease)
+	f.successes = append(f.successes, result)
+	return nil
+}
+
+func (f *durableRuntimeFinalizer) AfterMemoryCreateFailure(
+	_ context.Context,
+	lease *runtimeusage.OperationLease,
+	_ error,
+) error {
+	f.leases = append(f.leases, lease)
+	f.failures++
+	return nil
+}
