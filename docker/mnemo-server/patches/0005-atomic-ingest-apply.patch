@@ -0,0 +1,238 @@
+package ingestqueue
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strings"
+)
+
+func FinalizePlan(input AtomicPlan) (AtomicPlan, error) {
+	plan := clonePlan(input)
+	if plan.Version == "" {
+		plan.Version = PlanVersion
+	}
+	if plan.Version != PlanVersion {
+		return AtomicPlan{}, fmt.Errorf("%w: version %q", ErrPlanInvalid, plan.Version)
+	}
+	if strings.TrimSpace(plan.JobID) == "" || strings.TrimSpace(plan.TenantID) == "" {
+		return AtomicPlan{}, fmt.Errorf("%w: job and tenant are required", ErrPlanInvalid)
+	}
+	if plan.Revision < 1 || plan.AttemptGeneration < 1 {
+		return AtomicPlan{}, fmt.Errorf("%w: revision and attempt must be positive", ErrPlanInvalid)
+	}
+	if plan.TruncatedFactCount < 0 || plan.WarningCount < 0 {
+		return AtomicPlan{}, fmt.Errorf("%w: warning counters must not be negative", ErrPlanInvalid)
+	}
+
+	sort.SliceStable(plan.Sessions, func(i, j int) bool {
+		left, right := plan.Sessions[i], plan.Sessions[j]
+		if comparison := compareStrings(
+			left.AppID, right.AppID,
+			left.SessionID, right.SessionID,
+		); comparison != 0 {
+			return comparison < 0
+		}
+		if left.Seq != right.Seq {
+			return left.Seq < right.Seq
+		}
+		return compareStrings(
+			left.ContentHash, right.ContentHash,
+			left.ID, right.ID,
+		) < 0
+	})
+	sort.SliceStable(plan.MessageTagPatches, func(i, j int) bool {
+		left, right := plan.MessageTagPatches[i], plan.MessageTagPatches[j]
+		return compareStrings(
+			left.AppID, right.AppID,
+			left.SessionID, right.SessionID,
+			left.ContentHash, right.ContentHash,
+			strings.Join(left.Tags, "\x00"), strings.Join(right.Tags, "\x00"),
+		) < 0
+	})
+	orderedActions := make([]keyedMemoryAction, len(plan.Actions))
+	for index, action := range plan.Actions {
+		action.Index = 0
+		switch action.Kind {
+		case ActionAdd:
+			action.ExpectedVersion = 0
+			action.TargetID = ""
+			if strings.TrimSpace(action.Content) == "" {
+				return AtomicPlan{}, fmt.Errorf("%w: ADD %d has empty content", ErrPlanInvalid, index)
+			}
+		case ActionUpdate:
+			if action.TargetID == "" || action.ExpectedVersion < 1 || strings.TrimSpace(action.Content) == "" {
+				return AtomicPlan{}, fmt.Errorf("%w: UPDATE %d is incomplete", ErrPlanInvalid, index)
+			}
+		case ActionDelete:
+			if action.TargetID == "" || action.ExpectedVersion < 1 {
+				return AtomicPlan{}, fmt.Errorf("%w: DELETE %d is incomplete", ErrPlanInvalid, index)
+			}
+			action.Content = ""
+			action.Embedding = nil
+			action.Tags = nil
+			action.Metadata = nil
+		default:
+			return AtomicPlan{}, fmt.Errorf("%w: unknown action %q", ErrPlanInvalid, action.Kind)
+		}
+		key, err := canonicalJSONBytes(action)
+		if err != nil {
+			return AtomicPlan{}, fmt.Errorf("%w: action %d: %v", ErrPlanInvalid, index, err)
+		}
+		orderedActions[index] = keyedMemoryAction{action: action, key: string(key)}
+	}
+	sort.SliceStable(orderedActions, func(i, j int) bool {
+		left, right := orderedActions[i], orderedActions[j]
+		if left.action.SourceOrder != right.action.SourceOrder {
+			return left.action.SourceOrder < right.action.SourceOrder
+		}
+		return left.key < right.key
+	})
+	for index := range orderedActions {
+		plan.Actions[index] = orderedActions[index].action
+	}
+
+	if excess := len(plan.Actions) - MaxMemoryActions; excess > 0 {
+		plan.Actions = plan.Actions[:MaxMemoryActions]
+		plan.WarningCount += excess
+		if plan.WarningClass == "" {
+			plan.WarningClass = "action_limit"
+		}
+	}
+	if plan.TruncatedFactCount > 0 {
+		plan.WarningCount++
+		plan.WarningClass = WarningTruncated
+	}
+
+	for index := range plan.Actions {
+		action := &plan.Actions[index]
+		action.Index = index
+		if action.Kind == ActionAdd {
+			action.TargetID = DeterministicAddID(plan.JobID, plan.Revision, index)
+		}
+	}
+
+	plan.Hash = ""
+	canonical, err := canonicalPlanBytes(plan)
+	if err != nil {
+		return AtomicPlan{}, err
+	}
+	sum := sha256.Sum256(canonical)
+	plan.Hash = hex.EncodeToString(sum[:])
+	return plan, nil
+}
+
+func ValidatePlan(plan AtomicPlan) error {
+	if plan.Hash == "" {
+		return fmt.Errorf("%w: plan hash is required", ErrPlanInvalid)
+	}
+	hash := plan.Hash
+	plan.Hash = ""
+	canonical, err := canonicalPlanBytes(plan)
+	if err != nil {
+		return err
+	}
+	sum := sha256.Sum256(canonical)
+	if !strings.EqualFold(hash, hex.EncodeToString(sum[:])) {
+		return fmt.Errorf("%w: plan hash mismatch", ErrPlanInvalid)
+	}
+	if plan.Version != PlanVersion || plan.Revision < 1 || plan.AttemptGeneration < 1 {
+		return fmt.Errorf("%w: invalid plan envelope", ErrPlanInvalid)
+	}
+	for index, action := range plan.Actions {
+		if action.Index != index {
+			return fmt.Errorf("%w: noncanonical action index", ErrPlanInvalid)
+		}
+		if action.Kind == ActionAdd &&
+			action.TargetID != DeterministicAddID(plan.JobID, plan.Revision, index) {
+			return fmt.Errorf("%w: invalid deterministic ADD id", ErrPlanInvalid)
+		}
+	}
+	return nil
+}
+
+func PlanPayload(plan AtomicPlan) (json.RawMessage, error) {
+	if err := ValidatePlan(plan); err != nil {
+		return nil, err
+	}
+	return canonicalPlanBytes(plan)
+}
+
+func DeterministicAddID(jobID string, revision, actionIndex int) string {
+	return deterministicUUID(jobID, "add", revision, actionIndex)
+}
+
+func DeterministicSessionID(jobID string, messageIndex int) string {
+	return deterministicUUID(jobID, "session", 0, messageIndex)
+}
+
+func deterministicUUID(jobID, kind string, revision, index int) string {
+	sum := sha256.Sum256([]byte(fmt.Sprintf(
+		"%s\x00%s\x00%d\x00%d",
+		jobID,
+		kind,
+		revision,
+		index,
+	)))
+	raw := sum[:16]
+	raw[6] = (raw[6] & 0x0f) | 0x80
+	raw[8] = (raw[8] & 0x3f) | 0x80
+	return fmt.Sprintf(
+		"%08x-%04x-%04x-%04x-%012x",
+		raw[0:4],
+		raw[4:6],
+		raw[6:8],
+		raw[8:10],
+		raw[10:16],
+	)
+}
+
+func canonicalPlanBytes(plan AtomicPlan) ([]byte, error) {
+	canonical, err := canonicalJSONBytes(plan)
+	if err != nil {
+		return nil, fmt.Errorf("%w: canonical plan: %v", ErrPlanInvalid, err)
+	}
+	return canonical, nil
+}
+
+func canonicalJSONBytes(value any) ([]byte, error) {
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		return nil, fmt.Errorf("marshal: %w", err)
+	}
+	decoder := json.NewDecoder(bytes.NewReader(encoded))
+	decoder.UseNumber()
+	var decoded any
+	if err := decoder.Decode(&decoded); err != nil {
+		return nil, fmt.Errorf("decode: %w", err)
+	}
+	var canonical bytes.Buffer
+	if err := writeCanonicalJSON(&canonical, decoded); err != nil {
+		return nil, fmt.Errorf("encode: %w", err)
+	}
+	return canonical.Bytes(), nil
+}
+
+type keyedMemoryAction struct {
+	action MemoryAction
+	key    string
+}
+
+func compareStrings(values ...string) int {
+	for index := 0; index+1 < len(values); index += 2 {
+		if comparison := strings.Compare(values[index], values[index+1]); comparison != 0 {
+			return comparison
+		}
+	}
+	return 0
+}
+
+func clonePlan(input AtomicPlan) AtomicPlan {
+	encoded, _ := json.Marshal(input)
+	var cloned AtomicPlan
+	_ = json.Unmarshal(encoded, &cloned)
+	return cloned
+}
