+		RuntimeClusterID:            "cluster-a",
+		RuntimeAgentName:            "agent-a",
+		RuntimeReservationExpiresAt: ptrTime(time.Now().UTC().Add(time.Minute)),
+		RuntimeFinalizationState:    RuntimeFinalizationReserved,
+	}
+	var calls []string
+	repo := &fakeRepo{
+		replace: func(
+			_ context.Context,
+			lease LeaseRef,
+			reservation RuntimeReservation,
+		) error {
+			calls = append(calls, "replace")
+			if lease != job.LeaseRef() ||
+				reservation.OperationID != "operation-new" ||
+				!reservation.ExpiresAt.Equal(expiresAt) {
+				t.Fatalf("replacement = lease:%+v reservation:%+v", lease, reservation)
+			}
+			return nil
+		},
+		applyPlan: func(context.Context, LeaseRef, AtomicPlan) (ApplyResult, error) {
+			calls = append(calls, "apply")
+			return ApplyResult{}, nil
+		},
+	}
+	processor := fakeProcessor{
+		renewReservation: func(context.Context, *Job) (RuntimeReservation, error) {
+			calls = append(calls, "renew")
+			return RuntimeReservation{
+				OperationID: "operation-new",
+				ClusterID:   "cluster-a",
+				AgentName:   "agent-a",
+				ExpiresAt:   expiresAt,
+			}, nil
+		},
+		releaseReservation: func(_ context.Context, old *Job) {
+			calls = append(calls, "release")
