+func claimTerminalFinalization(
+	ctx context.Context,
+	tx *sql.Tx,
+	tenantID string,
+	lease time.Duration,
+) (*ingestqueue.Job, error) {
+	owner := uuid.NewString()
+	job, err := scanIngestJob(tx.QueryRowContext(ctx, `
+		WITH candidate AS (
+			SELECT job_id
+			FROM ingest_jobs
+			WHERE tenant_id = $1
+			  AND state IN ('succeeded', 'dead')
+			  AND runtime_finalization_state = 'finalizing'
+			  AND (
+				lease_expires_at IS NULL
+				OR lease_expires_at <= statement_timestamp()
+			  )
+			ORDER BY completed_at, job_id
+			FOR UPDATE SKIP LOCKED
+			LIMIT 1
+		)
+		UPDATE ingest_jobs AS job
+		SET lease_owner = $2,
+			lease_expires_at = statement_timestamp()
+				+ ($3 * interval '1 microsecond'),
+			heartbeat_at = statement_timestamp(),
+			updated_at = statement_timestamp()
+		FROM candidate
+		WHERE job.tenant_id = $1 AND job.job_id = candidate.job_id
+		RETURNING `+prefixedIngestJobColumns("job"),
+		tenantID,
+		owner,
+		lease.Microseconds(),
+	))
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, nil
+	}
+	return job, err
+}
