+func TestFinalizePlanDeterministicOrderHashAndAddIDs(t *testing.T) {
+	base := AtomicPlan{
+		Version:           PlanVersion,
+		JobID:             "00000000-0000-4000-8000-000000000054",
+		TenantID:          "tenant-a",
+		Revision:          2,
+		AttemptGeneration: 1,
+		Actions: []MemoryAction{
+			{Kind: ActionUpdate, TargetID: "memory-b", ExpectedVersion: 4, Content: "updated"},
+			{Kind: ActionAdd, Content: "new-b"},
+			{Kind: ActionDelete, TargetID: "memory-a", ExpectedVersion: 2},
+			{Kind: ActionAdd, Content: "new-a"},
+		},
+	}
+
+	first, err := FinalizePlan(base)
+	if err != nil {
+		t.Fatalf("FinalizePlan(first): %v", err)
+	}
+	reordered := base
+	reordered.Actions = []MemoryAction{
+		base.Actions[3],
+		base.Actions[2],
+		base.Actions[1],
+		base.Actions[0],
+	}
+	second, err := FinalizePlan(reordered)
+	if err != nil {
+		t.Fatalf("FinalizePlan(second): %v", err)
+	}
+	if first.Hash != second.Hash {
+		t.Fatalf("hashes differ for equivalent actions: %q != %q", first.Hash, second.Hash)
+	}
+	firstJSON, _ := json.Marshal(first)
+	secondJSON, _ := json.Marshal(second)
+	if string(firstJSON) != string(secondJSON) {
+		t.Fatalf("canonical plans differ:\n%s\n%s", firstJSON, secondJSON)
+	}
+	for index, action := range first.Actions {
+		if action.Index != index {
+			t.Fatalf("action %d index = %d", index, action.Index)
+		}
+		if action.Kind == ActionAdd {
+			want := DeterministicAddID(first.JobID, first.Revision, index)
+			if action.TargetID != want {
+				t.Fatalf("ADD target = %q, want %q", action.TargetID, want)
+			}
+		}
+	}
+
+	replacement := base
+	replacement.Revision = 3
+	third, err := FinalizePlan(replacement)
+	if err != nil {
+		t.Fatalf("FinalizePlan(replacement): %v", err)
+	}
+	if third.Hash == first.Hash {
+		t.Fatal("replacement revision must have a different hash")
+	}
+	firstAdds := map[string]struct{}{}
+	for _, action := range first.Actions {
+		if action.Kind == ActionAdd {
+			firstAdds[action.TargetID] = struct{}{}
+		}
+	}
+	for _, action := range third.Actions {
+		if action.Kind != ActionAdd {
+			continue
+		}
+		if _, exists := firstAdds[action.TargetID]; exists {
+			t.Fatalf("replacement ADD id unexpectedly stable across revisions: %q", action.TargetID)
+		}
+	}
+}
+
+func TestFinalizePlanCapsActionsAndPreservesTruncationWarning(t *testing.T) {
+	actions := make([]MemoryAction, MaxMemoryActions+7)
+	for i := range actions {
+		actions[i] = MemoryAction{Kind: ActionAdd, Content: fmt.Sprintf("fact-%03d", i)}
+	}
+	plan, err := FinalizePlan(AtomicPlan{
+		Version:            PlanVersion,
+		JobID:              "00000000-0000-4000-8000-000000000054",
+		TenantID:           "tenant-a",
+		Revision:           1,
+		AttemptGeneration:  1,
+		Actions:            actions,
+		TruncatedFactCount: 17,
+	})
+	if err != nil {
+		t.Fatalf("FinalizePlan: %v", err)
+	}
+	if got := len(plan.Actions); got != MaxMemoryActions {
+		t.Fatalf("actions = %d, want %d", got, MaxMemoryActions)
+	}
+	if plan.TruncatedFactCount != 17 {
+		t.Fatalf("truncated facts = %d, want 17", plan.TruncatedFactCount)
+	}
+	if plan.WarningCount != 8 {
+		t.Fatalf("warning count = %d, want 8 (truncation + seven excess actions)", plan.WarningCount)
+	}
+	if plan.WarningClass != WarningTruncated {
+		t.Fatalf("warning class = %q, want %q", plan.WarningClass, WarningTruncated)
+	}
+}
+
+func TestValidatePlanRejectsTampering(t *testing.T) {
+	plan, err := FinalizePlan(AtomicPlan{
+		Version:           PlanVersion,
+		JobID:             "00000000-0000-4000-8000-000000000054",
+		TenantID:          "tenant-a",
+		Revision:          1,
+		AttemptGeneration: 1,
+		Actions:           []MemoryAction{{Kind: ActionAdd, Content: "stable"}},
+	})
+	if err != nil {
+		t.Fatalf("FinalizePlan: %v", err)
+	}
+	if err := ValidatePlan(plan); err != nil {
+		t.Fatalf("ValidatePlan(valid): %v", err)
+	}
+	plan.Actions[0].Content = "tampered"
+	if err := ValidatePlan(plan); err == nil {
+		t.Fatal("ValidatePlan accepted tampered payload")
+	}
+}
+
+func TestFinalizePlanUsesNumericSourceAndSessionOrder(t *testing.T) {
+	plan, err := FinalizePlan(AtomicPlan{
+		JobID:             "00000000-0000-4000-8000-000000000054",
+		TenantID:          "tenant-a",
+		Revision:          1,
+		AttemptGeneration: 1,
+		Sessions: []SessionUpsert{
+			{ID: "session-10", AppID: "app", SessionID: "session", Seq: 10},
+			{ID: "session-2", AppID: "app", SessionID: "session", Seq: 2},
+		},
+		Actions: []MemoryAction{
+			{Kind: ActionAdd, Content: "fact-10", SourceOrder: 10},
+			{Kind: ActionAdd, Content: "fact-2", SourceOrder: 2},
+		},
+	})
+	if err != nil {
+		t.Fatalf("FinalizePlan: %v", err)
+	}
+	if plan.Sessions[0].Seq != 2 || plan.Sessions[1].Seq != 10 {
+		t.Fatalf("session order = %d, %d", plan.Sessions[0].Seq, plan.Sessions[1].Seq)
+	}
+	if plan.Actions[0].SourceOrder != 2 || plan.Actions[1].SourceOrder != 10 {
+		t.Fatalf(
+			"action source order = %d, %d",
+			plan.Actions[0].SourceOrder,
+			plan.Actions[1].SourceOrder,
+		)
+	}
+}
+
+func TestFinalizePlanUsesEveryMaterializedFieldAsActionTieBreaker(t *testing.T) {
+	base := AtomicPlan{
+		JobID:             "00000000-0000-4000-8000-000000000054",
+		TenantID:          "tenant-a",
+		Revision:          1,
+		AttemptGeneration: 1,
+		Actions: []MemoryAction{
+			{
+				Kind:        ActionAdd,
+				Content:     "same content",
+				Metadata:    json.RawMessage(`{"priority":2}`),
+				Embedding:   []float32{0.2, 0.1},
+				SourceOrder: 4,
+			},
+			{
+				Kind:        ActionAdd,
+				Content:     "same content",
+				Metadata:    json.RawMessage(`{"priority":1}`),
+				Embedding:   []float32{0.1, 0.2},
+				SourceOrder: 4,
+			},
+		},
+	}
+	first, err := FinalizePlan(base)
+	if err != nil {
+		t.Fatalf("FinalizePlan(first): %v", err)
+	}
+	base.Actions[0], base.Actions[1] = base.Actions[1], base.Actions[0]
+	second, err := FinalizePlan(base)
+	if err != nil {
+		t.Fatalf("FinalizePlan(second): %v", err)
+	}
+	if first.Hash != second.Hash {
+		t.Fatalf("materialized tie-break hash differs: %q != %q", first.Hash, second.Hash)
+	}
+	firstJSON, _ := json.Marshal(first)
+	secondJSON, _ := json.Marshal(second)
+	if string(firstJSON) != string(secondJSON) {
+		t.Fatalf("materialized tie-break plans differ:\n%s\n%s", firstJSON, secondJSON)
+	}
+}
