+func TestWorkerKeepsPlanAndPostCommitOutsideApplyTransaction(t *testing.T) {
+	var transactionOpen atomic.Bool
+	var calls []string
+	job := &Job{
+		ID:           "job-boundary",
+		TenantID:     "tenant-a",
+		LeaseOwner:   "worker-a",
+		AttemptCount: 1,
+	}
+	repo := &fakeRepo{
+		applyPlan: func(
+			_ context.Context,
+			_ LeaseRef,
+			_ AtomicPlan,
+		) (ApplyResult, error) {
+			if !transactionOpen.CompareAndSwap(false, true) {
+				t.Fatal("apply transaction was already open")
+			}
+			calls = append(calls, "apply")
+			transactionOpen.Store(false)
+			return ApplyResult{}, nil
+		},
+	}
+	processor := fakeProcessor{
+		plan: func(_ context.Context, job *Job, revision int) (AtomicPlan, error) {
+			if transactionOpen.Load() {
+				t.Fatal("plan/network work ran while apply transaction was open")
+			}
+			calls = append(calls, "plan")
+			return FinalizePlan(AtomicPlan{
+				JobID:             job.ID,
+				TenantID:          job.TenantID,
+				Revision:          revision,
+				AttemptGeneration: job.AttemptCount,
+			})
+		},
+		postCommit: func(context.Context, *Job, AtomicPlan, ApplyResult) {
+			if transactionOpen.Load() {
+				t.Fatal("post-commit work ran while apply transaction was open")
+			}
+			calls = append(calls, "post_commit")
+		},
+	}
+	worker := NewWorker(
+		repo,
+		processor,
+		job.TenantID,
+		job.LeaseOwner,
+		DefaultWorkerConfig(),
+		slog.New(slog.NewTextHandler(io.Discard, nil)),
+	)
+
+	worker.process(context.Background(), job)
+
+	if got := strings.Join(calls, ","); got != "plan,apply,post_commit" {
+		t.Fatalf("worker phase order = %q", got)
+	}
+}
