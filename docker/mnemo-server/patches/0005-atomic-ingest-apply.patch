+func TestDurableProcessorRetainsFirstFiftyFactsWithWarning(t *testing.T) {
+	facts := make([]map[string]any, ingestqueue.MaxFacts+7)
+	for index := range facts {
+		facts[index] = map[string]any{
+			"text": fmt.Sprintf("fact-%03d", index),
+			"tags": []string{"durable"},
+		}
+	}
+	llmServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]any{
+			"choices": []map[string]any{
+				{"message": map[string]any{
+					"content": mustJSON(t, map[string]any{
+						"facts":        facts,
+						"message_tags": [][]string{{"durable"}},
+					}),
+				}},
+			},
+		})
+	}))
+	defer llmServer.Close()
+
+	llmClient := llm.New(llm.Config{
+		APIKey:  "test-key",
+		BaseURL: llmServer.URL,
+		Model:   "test-model",
+	})
+	processor := NewDurableProcessor(
+		NewIngestService(&memoryRepoMock{}, llmClient, nil, "auto-model", ModeSmart),
+		nil,
+		nil,
+		"",
+		nil,
+		nil,
+	)
+	plan, err := processor.Plan(context.Background(), durableTestJob(t, ModeSmart), 1)
+	if err != nil {
+		t.Fatalf("Plan: %v", err)
+	}
+	if plan.TruncatedFactCount != 7 {
+		t.Fatalf("truncated facts = %d, want 7", plan.TruncatedFactCount)
+	}
+	if plan.WarningClass != ingestqueue.WarningTruncated || plan.WarningCount != 1 {
+		t.Fatalf("warning = %q/%d", plan.WarningClass, plan.WarningCount)
+	}
+	if len(plan.Actions) != ingestqueue.MaxMemoryActions {
+		t.Fatalf("actions = %d, want %d", len(plan.Actions), ingestqueue.MaxMemoryActions)
+	}
+	for index, action := range plan.Actions {
+		want := fmt.Sprintf("fact-%03d", index)
+		if action.Content != want || action.SourceOrder != index {
+			t.Fatalf("action %d = %q order=%d, want %q", index, action.Content, action.SourceOrder, want)
+		}
+	}
+}
