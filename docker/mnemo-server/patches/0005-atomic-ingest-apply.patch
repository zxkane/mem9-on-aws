+func TestDurableProcessorFinalizesPersistedRuntimeReservation(t *testing.T) {
+	finalizer := &durableRuntimeFinalizer{}
+	processor := NewDurableProcessor(nil, nil, nil, "", finalizer, nil)
+	job := &ingestqueue.Job{
+		ID:                 "job-runtime",
+		TenantID:           "tenant-a",
+		AttemptCount:       1,
+		RuntimeOperationID: "00000000-0000-7000-8000-000000000054",
+		RuntimeClusterID:   "cluster-a",
+		RuntimeAgentName:   "agent-a",
+	}
+	plan, err := ingestqueue.FinalizePlan(ingestqueue.AtomicPlan{
+		JobID:             job.ID,
+		TenantID:          job.TenantID,
+		Revision:          1,
+		AttemptGeneration: job.AttemptCount,
+		Actions: []ingestqueue.MemoryAction{
+			{Kind: ingestqueue.ActionAdd, Content: "memory-a"},
+			{Kind: ingestqueue.ActionAdd, Content: "memory-b", SourceOrder: 1},
+		},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	job.State = ingestqueue.StateSucceeded
+	if err := processor.FinalizeTerminal(context.Background(), job, &plan); err != nil {
+		t.Fatal(err)
+	}
+	if len(finalizer.successes) != 1 || finalizer.failures != 0 {
+		t.Fatalf("success finalization = %+v failures=%d", finalizer.successes, finalizer.failures)
+	}
+	if got := finalizer.successes[0]; got.AgentName != "agent-a" ||
+		got.ObjectsAffected != 2 ||
+		fmt.Sprint(got.MemoryIDs) != fmt.Sprint([]string{
+			plan.Actions[0].TargetID,
+			plan.Actions[1].TargetID,
+		}) {
+		t.Fatalf("runtime success result = %+v", got)
+	}
+	assertDurableRuntimeLease(t, finalizer.leases[0], job)
+
+	job.State = ingestqueue.StateDead
+	job.ErrorClass = "mantle_4xx_permanent"
+	if err := processor.FinalizeTerminal(context.Background(), job, nil); err != nil {
+		t.Fatal(err)
+	}
+	if finalizer.failures != 1 {
+		t.Fatalf("failure finalizations = %d, want 1", finalizer.failures)
+	}
+	assertDurableRuntimeLease(t, finalizer.leases[1], job)
+}
