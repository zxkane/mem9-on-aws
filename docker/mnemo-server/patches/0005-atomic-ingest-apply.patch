+func TestDurableProcessorMaterializesEmbeddingInPlan(t *testing.T) {
+	embedServer := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"data":[{"embedding":[0.25,0.5,0.75]}]}`))
+	}))
+	defer embedServer.Close()
+	embedder := embed.New(embed.Config{
+		APIKey:  "local",
+		BaseURL: embedServer.URL,
+		Model:   "test-embed",
+		Dims:    3,
+	})
+	processor := NewDurableProcessor(
+		NewIngestService(&memoryRepoMock{}, nil, embedder, "", ModeRaw),
+		nil,
+		nil,
+		"",
+		nil,
+		nil,
+	)
+	plan, err := processor.Plan(context.Background(), durableTestJob(t, ModeRaw), 1)
+	if err != nil {
+		t.Fatalf("Plan: %v", err)
