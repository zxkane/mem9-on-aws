+++ b/server/internal/handler/ingest_job_status.go
@@ -0,0 +1,53 @@
+package handler
+
+import (
+	"database/sql"
+	"errors"
+	"net/http"
+	"time"
+
+	"github.com/go-chi/chi/v5"
+)
+
+type ingestJobStatusResponse struct {
+	JobID        string     `json:"job_id"`
+	State        string     `json:"state"`
+	Attempts     int        `json:"attempts"`
+	WarningClass string     `json:"warning_class,omitempty"`
+	ErrorClass   string     `json:"error_class,omitempty"`
+	CreatedAt    time.Time  `json:"created_at"`
+	UpdatedAt    time.Time  `json:"updated_at"`
+	CompletedAt  *time.Time `json:"completed_at,omitempty"`
+}
+
+func (s *Server) getIngestJobStatus(w http.ResponseWriter, r *http.Request) {
+	auth := authInfo(r)
+	jobID := chi.URLParam(r, "jobID")
+	if auth == nil || auth.IsChain() || auth.TenantID == "" || auth.TenantDB == nil || jobID == "" {
+		respondError(w, http.StatusNotFound, "ingest job not found")
+		return
+	}
+	repo := s.ingestRepoFactory(s.dbBackend, auth.TenantDB)
+	if repo == nil {
+		respondError(w, http.StatusNotFound, "ingest job not found")
+		return
+	}
+	job, err := repo.Get(r.Context(), auth.TenantID, jobID)
+	if err != nil {
+		if !errors.Is(err, sql.ErrNoRows) {
+			s.logger.Warn("ingest job status lookup failed", "operation", "status")
+		}
+		respondError(w, http.StatusNotFound, "ingest job not found")
+		return
+	}
+	respond(w, http.StatusOK, ingestJobStatusResponse{
+		JobID:        job.ID,
+		State:        string(job.State),
+		Attempts:     job.AttemptCount,
+		WarningClass: job.WarningClass,
+		ErrorClass:   job.ErrorClass,
+		CreatedAt:    job.CreatedAt,
+		UpdatedAt:    job.UpdatedAt,
+		CompletedAt:  job.CompletedAt,
+	})
+}
