index 0000000..d38bb8a
--- /dev/null
+++ b/server/internal/service/durable_ingest.go
@@ -0,0 +1,734 @@
+package service
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log/slog"
+	"strings"
+	"time"
+
+	"github.com/qiffang/mnemos/server/internal/domain"
+	"github.com/qiffang/mnemos/server/internal/ingestqueue"
+	"github.com/qiffang/mnemos/server/internal/llm"
+	"github.com/qiffang/mnemos/server/internal/metering"
+	"github.com/qiffang/mnemos/server/internal/runtimeusage"
+	"github.com/qiffang/mnemos/server/internal/webhook"
+)
+
+const durablePostCommitTimeout = 10 * time.Second
+
+type durableCanonicalEnvelope struct {
+	Version            string           `json:"version"`
+	TenantID           string           `json:"tenant_id"`
+	AgentID            string           `json:"agent_id"`
+	AppID              string           `json:"app_id"`
+	SessionID          string           `json:"session_id"`
+	Mode               IngestMode       `json:"mode"`
+	DisableSessionSave bool             `json:"disableSessionSave"`
+	Messages           []durableMessage `json:"messages"`
+	Metadata           json.RawMessage  `json:"metadata"`
+}
+
+type durableMessage struct {
+	Role    string `json:"role"`
+	Content string `json:"content"`
+	Seq     int    `json:"seq"`
+}
+
+type DurableProcessor struct {
+	ingest       *IngestService
+	metering     metering.Writer
+	webhooks     *webhook.Service
+	clusterID    string
+	runtimeUsage durableRuntimeUsageFinalizer
+	logger       *slog.Logger
+}
+
+type durableRuntimeUsageFinalizer interface {
+	BeforeMemoryCreate(
+		context.Context,
+		runtimeusage.Subject,
+		int64,
+	) (*runtimeusage.OperationLease, error)
+	AfterMemoryCreateSuccess(
+		context.Context,
+		*runtimeusage.OperationLease,
+		runtimeusage.MemoryCreateResult,
+	) error
+	AfterMemoryCreateFailure(context.Context, *runtimeusage.OperationLease, error) error
+}
+
+func (p *DurableProcessor) RenewRuntimeReservation(
+	ctx context.Context,
+	job *ingestqueue.Job,
+) (ingestqueue.RuntimeReservation, error) {
+	if p == nil || p.runtimeUsage == nil || job == nil {
+		return ingestqueue.RuntimeReservation{}, ingestqueue.ErrProcessorUnavailable
+	}
+	lease, err := p.runtimeUsage.BeforeMemoryCreate(
+		ctx,
+		durableRuntimeUsageSubject(job),
+		1,
+	)
+	if err != nil {
+		var denied *runtimeusage.QuotaDeniedError
+		if errors.As(err, &denied) {
+			return ingestqueue.RuntimeReservation{},
+				ingestqueue.NewOutcomeError("runtime_quota_denied")
+		}
+		return ingestqueue.RuntimeReservation{},
+			ingestqueue.NewOutcomeError("runtime_usage_transient")
+	}
+	if lease == nil || !lease.Reserved {
+		return ingestqueue.RuntimeReservation{}, nil
+	}
+	return ingestqueue.RuntimeReservation{
+		OperationID: lease.OperationID,
+		ClusterID:   lease.Subject.ClusterID,
+		AgentName:   lease.Subject.AgentName,
+		ExpiresAt:   lease.ExpiresAt,
+	}, nil
+}
+
+func (p *DurableProcessor) ReleaseRuntimeReservation(
+	_ context.Context,
+	job *ingestqueue.Job,
+) {
+	if p == nil || p.runtimeUsage == nil || job == nil {
+		return
+	}
+	lease := durableRuntimeUsageLease(job)
+	if lease == nil {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), durablePostCommitTimeout)
+	defer cancel()
+	_ = p.runtimeUsage.AfterMemoryCreateFailure(
+		ctx,
+		lease,
+		ingestqueue.NewOutcomeError("reservation_replaced"),
+	)
+}
+
+func NewDurableProcessor(
+	ingest *IngestService,
+	meteringWriter metering.Writer,
+	webhookService *webhook.Service,
+	clusterID string,
+	runtimeUsage durableRuntimeUsageFinalizer,
+	logger *slog.Logger,
+) *DurableProcessor {
+	if logger == nil {
+		logger = slog.Default()
+	}
+	return &DurableProcessor{
+		ingest:       ingest,
+		metering:     meteringWriter,
+		webhooks:     webhookService,
+		clusterID:    clusterID,
+		runtimeUsage: runtimeUsage,
+		logger:       logger,
+	}
+}
+
+func (p *DurableProcessor) Plan(
+	ctx context.Context,
+	job *ingestqueue.Job,
+	revision int,
+) (ingestqueue.AtomicPlan, error) {
+	if p == nil || p.ingest == nil || job == nil {
+		return ingestqueue.AtomicPlan{}, ingestqueue.ErrProcessorUnavailable
+	}
+	var envelope durableCanonicalEnvelope
+	decoder := json.NewDecoder(bytes.NewReader(job.CanonicalPayload))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&envelope); err != nil {
+		return ingestqueue.AtomicPlan{}, fmt.Errorf("%w: canonical payload", ingestqueue.ErrPlanInvalid)
+	}
+	if envelope.Version != "ingest-v1" ||
+		envelope.TenantID != job.TenantID ||
+		envelope.TenantID == "" ||
+		len(envelope.Messages) == 0 {
+		return ingestqueue.AtomicPlan{}, fmt.Errorf("%w: canonical envelope", ingestqueue.ErrPlanInvalid)
+	}
+
+	plan := ingestqueue.AtomicPlan{
+		Version:           ingestqueue.PlanVersion,
+		JobID:             job.ID,
+		TenantID:          job.TenantID,
+		Revision:          revision,
+		AttemptGeneration: job.AttemptCount,
+		Sessions:          []ingestqueue.SessionUpsert{},
+		MessageTagPatches: []ingestqueue.MessageTagPatch{},
+		Actions:           []ingestqueue.MemoryAction{},
+	}
+	sessionID := strings.TrimSpace(envelope.SessionID)
+	if sessionID == "" {
+		sessionID = "ingest-" + job.ID
+	}
+	messages := make([]IngestMessage, len(envelope.Messages))
+	for index, message := range envelope.Messages {
+		seq := message.Seq
+		messages[index] = IngestMessage{
+			Role:    message.Role,
+			Content: message.Content,
+			Seq:     &seq,
+		}
+		if envelope.DisableSessionSave {
+			continue
+		}
+		contentHash := sessionContentHash(
+			sessionID,
+			message.Role,
+			message.Content,
+			&seq,
+		)
+		plan.Sessions = append(plan.Sessions, ingestqueue.SessionUpsert{
+			ID:          ingestqueue.DeterministicSessionID(job.ID, index),
+			SessionID:   sessionID,
+			AgentID:     envelope.AgentID,
+			AppID:       envelope.AppID,
+			Source:      envelope.AgentID,
+			Seq:         seq,
+			Role:        message.Role,
+			Content:     message.Content,
+			ContentType: detectSessionContentType(message.Content),
+			ContentHash: contentHash,
+		})
+	}
+
+	mode := envelope.Mode
+	if mode == "" {
+		mode = p.ingest.mode
+	}
+	if mode == ModeRaw || p.ingest.llm == nil {
+		content := strings.TrimSpace(formatConversation(messages))
+		if content != "" {
+			content = truncateRunes(content, maxExtractionConversationRunes)
+			action := ingestqueue.MemoryAction{
+				Kind:        ingestqueue.ActionAdd,
+				Content:     content,
+				Source:      envelope.AgentID,
+				AgentID:     envelope.AgentID,
+				AppID:       envelope.AppID,
+				SessionID:   sessionID,
+				Metadata:    cloneRawJSON(envelope.Metadata),
+				UpdatedBy:   envelope.AgentID,
+				SourceOrder: 0,
+			}
+			if err := p.materializeEmbedding(ctx, &action); err != nil {
+				return ingestqueue.AtomicPlan{}, err
+			}
+			plan.Actions = append(plan.Actions, action)
+		}
+		return ingestqueue.FinalizePlan(plan)
+	}
+	if mode != ModeSmart {
+		return ingestqueue.AtomicPlan{}, &domain.ValidationError{
+			Field:   "mode",
+			Message: fmt.Sprintf("unsupported mode %q", mode),
+		}
+	}
+
+	phase1, err := p.ingest.ExtractPhase1(ctx, messages)
+	if err != nil {
+		return ingestqueue.AtomicPlan{}, fmt.Errorf("durable extraction: %w", err)
+	}
+	facts := phase1.Facts
+	if len(facts) > ingestqueue.MaxFacts {
+		plan.TruncatedFactCount = len(facts) - ingestqueue.MaxFacts
+		facts = facts[:ingestqueue.MaxFacts]
+	}
+	if !envelope.DisableSessionSave {
+		for index, message := range envelope.Messages {
+			tags := durableTagsAtIndex(phase1.MessageTags, index)
+			if len(tags) > maxTags {
+				tags = tags[:maxTags]
+			}
+			seq := message.Seq
+			plan.MessageTagPatches = append(
+				plan.MessageTagPatches,
+				ingestqueue.MessageTagPatch{
+					AppID:     envelope.AppID,
+					SessionID: sessionID,
+					ContentHash: sessionContentHash(
+						sessionID,
+						message.Role,
+						message.Content,
+						&seq,
+					),
+					Tags: append([]string(nil), tags...),
+				},
+			)
+		}
+	}
+
+	actions, warningCount, warningClass, err := p.ingest.planReconciliation(
+		ctx,
+		job.CreatedAt,
+		envelope.AgentID,
+		envelope.AppID,
+		sessionID,
+		facts,
+		envelope.Metadata,
+	)
+	if err != nil {
+		return ingestqueue.AtomicPlan{}, err
+	}
+	plan.Actions = actions
+	plan.WarningCount = warningCount
+	plan.WarningClass = warningClass
+	for index := range plan.Actions {
+		if err := p.materializeEmbedding(ctx, &plan.Actions[index]); err != nil {
+			return ingestqueue.AtomicPlan{}, err
+		}
+	}
+	return ingestqueue.FinalizePlan(plan)
+}
+
+func (p *DurableProcessor) materializeEmbedding(
+	ctx context.Context,
+	action *ingestqueue.MemoryAction,
+) error {
+	if action.Kind == ingestqueue.ActionDelete ||
+		p.ingest.autoModel != "" ||
+		p.ingest.embedder == nil {
+		return nil
+	}
+	embedding, err := p.ingest.embedder.Embed(ctx, action.Content)
+	if err != nil {
+		return fmt.Errorf("materialize durable embedding: %w", err)
+	}
+	action.Embedding = append([]float32(nil), embedding...)
+	return nil
+}
+
+func (p *DurableProcessor) PostCommit(
+	_ context.Context,
+	job *ingestqueue.Job,
+	plan ingestqueue.AtomicPlan,
+	result ingestqueue.ApplyResult,
+) {
+	if p == nil || job == nil {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), durablePostCommitTimeout)
+	defer cancel()
+	meteringOutcome := "skipped"
+	webhookOutcome := "skipped"
+	if p.metering != nil {
+		total, _, err := p.ingest.memories.CountStats(ctx)
+		if err != nil {
+			meteringOutcome = "failed"
+		} else {
+			p.metering.Record(metering.Event{
+				Category:  "mem9-api",
+				TenantID:  job.TenantID,
+				ClusterID: p.clusterID,
+				Data: map[string]any{
+					"event_type":          "ingest",
+					"active_memory_count": total,
+				},
+			})
+			meteringOutcome = "queued"
+		}
+	}
+	if p.webhooks != nil {
+		webhookOutcome = "queued"
+		for _, action := range plan.Actions {
+			var eventType string
+			var data any
+			switch action.Kind {
+			case ingestqueue.ActionAdd:
+				memory, err := p.ingest.memories.GetByID(ctx, action.TargetID)
+				if err != nil {
+					webhookOutcome = "partial"
+					continue
+				}
+				eventType = webhook.EventMemoryAdded
+				data = map[string]any{"memory": memory}
+			case ingestqueue.ActionDelete:
+				eventType = webhook.EventMemoryDeleted
+				data = map[string]any{"memory": map[string]any{
+					"id":               action.TargetID,
+					"deleted_by_agent": action.UpdatedBy,
+					"deleted_at":       time.Now().UTC(),
+				}}
+			default:
+				continue
+			}
+			if err := p.webhooks.Enqueue(
+				ctx,
+				webhook.EventScope{Type: webhook.ScopeTenant, TenantID: job.TenantID},
+				eventType,
+				data,
+			); err != nil {
+				webhookOutcome = "partial"
+			}
+		}
+	}
+	p.logger.Info("durable ingest post-commit effects",
+		"job_id", job.ID,
+		"metering_outcome", meteringOutcome,
+		"webhook_outcome", webhookOutcome,
+		"mutation_count", result.MutationCount,
+	)
+}
+
+func (p *DurableProcessor) FinalizeTerminal(
+	_ context.Context,
+	job *ingestqueue.Job,
+	plan *ingestqueue.AtomicPlan,
+) error {
+	if p == nil || job == nil {
+		return ingestqueue.ErrProcessorUnavailable
+	}
+	lease := durableRuntimeUsageLease(job)
+	if lease == nil || p.runtimeUsage == nil {
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), durablePostCommitTimeout)
+	defer cancel()
+	switch job.State {
+	case ingestqueue.StateSucceeded:
+		if plan == nil {
+			var persisted ingestqueue.AtomicPlan
+			if err := json.Unmarshal(job.PlanPayload, &persisted); err != nil {
+				return fmt.Errorf("%w: terminal plan payload", ingestqueue.ErrPlanInvalid)
+			}
+			plan = &persisted
+		}
+		if err := ingestqueue.ValidatePlan(*plan); err != nil ||
+			plan.JobID != job.ID ||
+			plan.TenantID != job.TenantID {
+			return fmt.Errorf("%w: terminal plan ownership", ingestqueue.ErrPlanInvalid)
+		}
+		memoryIDs := make([]string, 0, len(plan.Actions))
+		for _, action := range plan.Actions {
+			memoryIDs = append(memoryIDs, action.TargetID)
+		}
+		if err := p.runtimeUsage.AfterMemoryCreateSuccess(
+			ctx,
+			lease,
+			runtimeusage.MemoryCreateResult{
+				MemoryIDs:       memoryIDs,
+				AgentName:       job.RuntimeAgentName,
+				ObjectsAffected: int64(len(plan.Actions)),
+			},
+		); err != nil {
+			return err
+		}
+	case ingestqueue.StateDead:
+		if err := p.runtimeUsage.AfterMemoryCreateFailure(
+			ctx,
+			lease,
+			ingestqueue.NewOutcomeError(job.ErrorClass),
+		); err != nil {
+			return err
+		}
+	default:
+		return fmt.Errorf("%w: nonterminal runtime finalization", ingestqueue.ErrPlanInvalid)
+	}
+	p.logger.Info(
+		"durable ingest terminal effects",
+		"job_id", job.ID,
+		"state", job.State,
+		"runtime_usage_outcome", "handed_off",
+	)
+	return nil
+}
+
+func durableRuntimeUsageLease(job *ingestqueue.Job) *runtimeusage.OperationLease {
+	if job == nil || job.RuntimeOperationID == "" {
+		return nil
+	}
+	lease := &runtimeusage.OperationLease{
+		OperationID: job.RuntimeOperationID,
+		Subject:     durableRuntimeUsageSubject(job),
+		Meter:       runtimeusage.MeterMemoryWriteRequests,
+		Units:       1,
+		Reserved:    true,
+	}
+	if job.RuntimeReservationExpiresAt != nil {
+		lease.ExpiresAt = *job.RuntimeReservationExpiresAt
+	}
+	lease.OccurredAt = job.CreatedAt
+	return lease
+}
+
+func durableRuntimeUsageSubject(job *ingestqueue.Job) runtimeusage.Subject {
+	return runtimeusage.Subject{
+		TenantID:      job.TenantID,
+		ClusterID:     job.RuntimeClusterID,
+		APIKeySubject: job.TenantID,
+		AgentName:     job.RuntimeAgentName,
+	}
+}
+
+type durableReconcileEvent struct {
+	ID    string   `json:"id"`
+	Text  string   `json:"text"`
+	Event string   `json:"event"`
+	Tags  []string `json:"tags,omitempty"`
+}
+
+func (s *IngestService) planReconciliation(
+	ctx context.Context,
+	planTime time.Time,
+	agentID, appID, sessionID string,
+	facts []ExtractedFact,
+	requestMetadata json.RawMessage,
+) ([]ingestqueue.MemoryAction, int, string, error) {
+	if len(facts) == 0 {
+		return nil, 0, "", nil
+	}
+	texts := make([]string, len(facts))
+	for index, fact := range facts {
+		texts[index] = projectReconcileFactText(fact)
+	}
+	existing, err := s.gatherExistingMemories(ctx, agentID, appID, texts)
+	if err != nil {
+		return nil, 0, "", fmt.Errorf("gather durable existing memories: %w", err)
+	}
+	if len(existing) == 0 {
+		actions := make([]ingestqueue.MemoryAction, 0, len(facts))
+		for index, fact := range facts {
+			content, temporal := normalizeDurableTemporalContent(fact.Text, planTime)
+			if content == "" {
+				continue
+			}
+			metadata := SetSourceProvenanceMetadata(
+				MergeTemporalMetadata(nil, temporal),
+				fact.SourceSeqs,
+				fact.SourceTurns,
+			)
+			actions = append(actions, ingestqueue.MemoryAction{
+				Kind:        ingestqueue.ActionAdd,
+				Content:     content,
+				Source:      agentID,
+				Tags:        append([]string(nil), fact.Tags...),
+				Metadata:    mergeDurableMetadata(metadata, requestMetadata),
+				AgentID:     agentID,
+				SessionID:   sessionID,
+				AppID:       appID,
+				UpdatedBy:   agentID,
+				SourceOrder: index,
+			})
+		}
+		return actions, 0, "", nil
+	}
+
+	type memoryRef struct {
+		ID   int    `json:"id"`
+		Text string `json:"text"`
+		Age  string `json:"age,omitempty"`
+	}
+	refs := make([]memoryRef, len(existing))
+	for index, memory := range existing {
+		refs[index] = memoryRef{
+			ID:   index,
+			Text: TemporalRecallProjection(memory.Content, memory.Metadata),
+			Age:  relativeAge(memory.UpdatedAt),
+		}
+	}
+	refsJSON, _ := json.Marshal(refs)
+	factsJSON, _ := json.Marshal(texts)
+	systemPrompt := `You are a memory reconciliation engine.
+Compare new facts with existing memories and return only state changes.
+Events are ADD, UPDATE, or DELETE. Use an existing integer id for UPDATE/DELETE.
+Use id "new" for ADD. UPDATE only the same entity attribute. Never invent ids.
+Return JSON: {"memory":[{"id":"new","text":"...","event":"ADD","tags":["tag"]}]}`
+	userPrompt := fmt.Sprintf(
+		"Existing memories:\n%s\n\nNew facts:\n%s",
+		refsJSON,
+		factsJSON,
+	)
+	raw, err := s.llm.CompleteJSONWithScope(
+		ctx,
+		systemPrompt,
+		userPrompt,
+		llm.CallScope{Step: "reconciliation"},
+	)
+	if err != nil {
+		return nil, 1, "reconciliation_skipped", nil
+	}
+	type response struct {
+		Memory []durableReconcileEvent `json:"memory"`
+	}
+	parsed, err := llm.ParseJSON[response](raw)
+	if err != nil {
+		raw, retryErr := s.llm.CompleteJSONWithScope(
+			ctx,
+			systemPrompt,
+			"Return only corrected JSON.\n\n"+userPrompt,
+			llm.CallScope{Step: "reconciliation"},
+		)
+		if retryErr != nil {
+			return nil, 1, "reconciliation_skipped", nil
+		}
+		parsed, err = llm.ParseJSON[response](raw)
+		if err != nil {
+			return nil, 1, "reconciliation_skipped", nil
+		}
+	}
+
+	actions := make([]ingestqueue.MemoryAction, 0, len(parsed.Memory))
+	warnings := 0
+	for eventIndex, event := range parsed.Memory {
+		sourceOrder := durableFactOrder(event.Text, facts, eventIndex)
+		switch strings.ToUpper(event.Event) {
+		case "ADD":
+			content, temporal := normalizeDurableTemporalContent(event.Text, planTime)
+			if content == "" {
+				warnings++
+				continue
+			}
+			metadata := durableProvenanceMetadata(event.Text, facts, nil, temporal)
+			actions = append(actions, ingestqueue.MemoryAction{
+				Kind:        ingestqueue.ActionAdd,
+				Content:     content,
+				Source:      agentID,
+				Tags:        durableTags(event.Tags, nil),
+				Metadata:    mergeDurableMetadata(metadata, requestMetadata),
+				AgentID:     agentID,
+				SessionID:   sessionID,
+				AppID:       appID,
+				UpdatedBy:   agentID,
+				SourceOrder: sourceOrder,
+			})
+		case "UPDATE":
+			index := parseIntID(event.ID)
+			if index < 0 || index >= len(existing) {
+				warnings++
+				continue
+			}
+			content, temporal := normalizeDurableTemporalContent(event.Text, planTime)
+			if content == "" {
+				warnings++
+				continue
+			}
+			memory := existing[index]
+			metadata := durableProvenanceMetadata(event.Text, facts, memory.Metadata, temporal)
+			action := ingestqueue.MemoryAction{
+				Kind:        ingestqueue.ActionUpdate,
+				TargetID:    memory.ID,
+				Content:     content,
+				Source:      agentID,
+				Tags:        durableTags(event.Tags, memory.Tags),
+				Metadata:    mergeDurableMetadata(metadata, requestMetadata),
+				AgentID:     agentID,
+				SessionID:   sessionID,
+				AppID:       appID,
+				UpdatedBy:   agentID,
+				SourceOrder: sourceOrder,
+			}
+			if memory.MemoryType == domain.TypePinned {
+				action.Kind = ingestqueue.ActionAdd
+			} else {
+				action.ExpectedVersion = memory.Version
+			}
+			actions = append(actions, action)
+		case "DELETE":
+			index := parseIntID(event.ID)
+			if index < 0 || index >= len(existing) ||
+				existing[index].MemoryType == domain.TypePinned {
+				warnings++
+				continue
+			}
+			actions = append(actions, ingestqueue.MemoryAction{
+				Kind:            ingestqueue.ActionDelete,
+				TargetID:        existing[index].ID,
+				ExpectedVersion: existing[index].Version,
+				AppID:           appID,
+				UpdatedBy:       agentID,
+				SourceOrder:     sourceOrder,
+			})
+		case "NOOP", "NONE":
+		default:
+			warnings++
+		}
+	}
+	warningClass := ""
+	if warnings > 0 {
+		warningClass = "reconciliation_actions"
+	}
+	return actions, warnings, warningClass, nil
+}
+
+func durableTags(preferred, fallback []string) []string {
+	tags := preferred
+	if tags == nil {
+		tags = fallback
+	}
+	if len(tags) > maxTags {
+		tags = tags[:maxTags]
+	}
+	return append([]string(nil), tags...)
+}
+
+func durableTagsAtIndex(tags [][]string, index int) []string {
+	if index < 0 || index >= len(tags) {
+		return nil
+	}
+	return tags[index]
+}
+
+func normalizeDurableTemporalContent(
+	content string,
+	at time.Time,
+) (string, *TemporalMetadata) {
+	return NormalizeStandaloneTemporalContent(StripTemporalProjection(content), at)
+}
+
+func durableProvenanceMetadata(
+	text string,
+	facts []ExtractedFact,
+	existing json.RawMessage,
+	temporal *TemporalMetadata,
+) json.RawMessage {
+	return SetSourceProvenanceMetadata(
+		MergeTemporalMetadata(existing, temporal),
+		sourceSeqsForReconcileText(text, facts),
+		sourceTurnsForReconcileText(text, facts),
+	)
+}
+
+func durableFactOrder(text string, facts []ExtractedFact, fallback int) int {
+	normalized := strings.TrimSpace(StripTemporalProjection(text))
+	for index, fact := range facts {
+		if strings.TrimSpace(StripTemporalProjection(fact.Text)) == normalized ||
+			strings.TrimSpace(StripTemporalProjection(projectReconcileFactText(fact))) == normalized {
+			return index
+		}
+	}
+	return len(facts) + fallback
+}
+
+func mergeDurableMetadata(base, overlay json.RawMessage) json.RawMessage {
+	merged := map[string]any{}
+	decodeObject := func(raw json.RawMessage) {
+		if len(bytes.TrimSpace(raw)) == 0 {
+			return
+		}
+		var object map[string]any
+		decoder := json.NewDecoder(bytes.NewReader(raw))
+		decoder.UseNumber()
+		if decoder.Decode(&object) != nil {
+			return
+		}
+		for key, value := range object {
+			merged[key] = value
+		}
+	}
+	decodeObject(base)
+	decodeObject(overlay)
+	encoded, _ := json.Marshal(merged)
+	return encoded
+}
+
+func cloneRawJSON(raw json.RawMessage) json.RawMessage {
+	return append(json.RawMessage(nil), raw...)
+}
