+func TestDefaultServerLoggerEmitsStructuredRepositoryEvents(t *testing.T) {
+	var output bytes.Buffer
+	previous := slog.Default()
+	installDefaultServerLogger(&output)
+	t.Cleanup(func() { slog.SetDefault(previous) })
+
+	slog.Warn("namespace vector search", "result", "capacity", "rows", 101)
+	var record map[string]any
+	if err := json.Unmarshal(bytes.TrimSpace(output.Bytes()), &record); err != nil {
+		t.Fatalf("decode default logger output: %v: %s", err, output.String())
+	}
+	if record["msg"] != "namespace vector search" ||
+		record["result"] != "capacity" ||
+		record["rows"] != float64(101) {
+		t.Fatalf("unexpected structured log: %#v", record)
+	}
+}
