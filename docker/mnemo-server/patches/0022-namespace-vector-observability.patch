+func TestNamespaceVectorWarningThreshold(t *testing.T) {
+	if got := namespaceVectorWarningRows(20_000); got != 16_000 {
+		t.Fatalf("warning rows=%d", got)
+	}
+	if got := namespaceVectorWarningRows(1); got != 1 {
+		t.Fatalf("small warning rows=%d", got)
+	}
