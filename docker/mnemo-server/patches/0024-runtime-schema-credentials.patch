diff --git a/server/internal/tenant/runtime_role.go b/server/internal/tenant/runtime_role.go
new file mode 100644
index 0000000..3e77672
--- /dev/null
+++ b/server/internal/tenant/runtime_role.go
@@ -0,0 +1,63 @@
+package tenant
+
+import (
+	"context"
+	"database/sql"
+	"encoding/hex"
+	"fmt"
+)
+
+// CheckPostgresRuntimeRole validates the authenticated login on a newly opened
+// tenant pool. Tenant registry values must never silently restore owner access.
+func CheckPostgresRuntimeRole(ctx context.Context, db *sql.DB) error {
+	var allowed bool
+	err := db.QueryRowContext(ctx, `SELECT NOT (r.rolsuper OR r.rolcreatedb OR r.rolcreaterole OR r.rolreplication OR r.rolbypassrls)
+   AND NOT pg_has_role(r.oid,(SELECT datdba FROM pg_database WHERE datname=current_database()),'MEMBER')
+   AND NOT has_database_privilege(r.oid,current_database(),'CREATE')
+   AND NOT EXISTS(SELECT FROM pg_roles elevated WHERE elevated.rolname='rds_superuser' AND pg_has_role(r.oid,elevated.oid,'MEMBER'))
+   AND NOT EXISTS(SELECT FROM pg_roles elevated WHERE
+     (elevated.rolsuper OR elevated.rolcreatedb OR elevated.rolcreaterole OR elevated.rolreplication OR elevated.rolbypassrls
+       OR elevated.rolname IN ('pg_read_server_files','pg_write_server_files','pg_execute_server_program','pg_read_all_data','pg_write_all_data'))
+     AND pg_has_role(r.oid,elevated.oid,'MEMBER'))
+   AND NOT EXISTS(SELECT FROM pg_namespace n WHERE n.nspname !~ '^pg_' AND n.nspname<>'information_schema'
+     AND (pg_has_role(r.oid,n.nspowner,'MEMBER') OR has_schema_privilege(r.oid,n.oid,'CREATE')))
+   AND NOT EXISTS(SELECT FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
+     WHERE n.nspname !~ '^pg_' AND n.nspname<>'information_schema' AND pg_has_role(r.oid,c.relowner,'MEMBER'))
+   AND NOT EXISTS(SELECT FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
+     WHERE n.nspname !~ '^pg_' AND n.nspname<>'information_schema' AND pg_has_role(r.oid,p.proowner,'MEMBER'))
+   FROM pg_roles r WHERE r.rolname=session_user`).Scan(&allowed)
+	if err != nil {
+		return fmt.Errorf("inspect runtime database role: %w", err)
+	}
+	if !allowed {
+		return fmt.Errorf("runtime database role is privileged")
+	}
+	return nil
+}
+
+func VerifyRuntimeReadiness(ctx context.Context, db *sql.DB, stage, digest, tenantID string) error {
+	if err := CheckPostgresRuntimeRole(ctx, db); err != nil {
+		return err
+	}
+	if len(digest) != 64 || stage == "" || tenantID == "" {
+		return fmt.Errorf("runtime schema contract is missing")
+	}
+	if _, err := hex.DecodeString(digest); err != nil {
+		return fmt.Errorf("runtime schema contract is invalid")
+	}
+	var ready bool
+	if err := db.QueryRowContext(ctx, "SELECT mem9_runtime.ready_for($1,$2)", stage, digest).Scan(&ready); err != nil {
+		return fmt.Errorf("read runtime readiness: %w", err)
+	}
+	if !ready {
+		return fmt.Errorf("runtime schema is not ready")
+	}
+	if err := db.QueryRowContext(ctx, `SELECT EXISTS(SELECT FROM public.tenants
+    WHERE id=$1 AND db_user=session_user AND db_name=current_database() AND status='active')`, tenantID).Scan(&ready); err != nil {
+		return fmt.Errorf("inspect runtime tenant readiness: %w", err)
+	}
+	if !ready {
+		return fmt.Errorf("runtime tenant is not ready")
+	}
+	return nil
+}
diff --git a/server/internal/tenant/runtime_role_test.go b/server/internal/tenant/runtime_role_test.go
new file mode 100644
index 0000000..95b100b
--- /dev/null
+++ b/server/internal/tenant/runtime_role_test.go
@@ -0,0 +1,70 @@
+package tenant
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"net/url"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+func TestRuntimePoolRejectsPrivilegedLoginPostgres(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("PostgreSQL fixture required")
+	}
+	db := testutil.OpenIsolatedPostgres(t, dsn)
+	ctx := context.Background()
+	var database string
+	if err := db.QueryRow("SELECT current_database()").Scan(&database); err != nil {
+		t.Fatal(err)
+	}
+	role := fmt.Sprintf("runtime_pool_%d", time.Now().UnixNano())
+	if _, err := db.Exec("CREATE ROLE " + role + " LOGIN PASSWORD 'SyntheticRuntimeTestOnly'"); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { db.Exec("DROP OWNED BY " + role); db.Exec("DROP ROLE " + role) })
+	if _, err := db.Exec("GRANT CONNECT ON DATABASE " + database + " TO " + role); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec("GRANT USAGE ON SCHEMA public TO " + role); err != nil {
+		t.Fatal(err)
+	}
+	u, err := url.Parse(dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	u.Path = "/" + database
+	ownerDSN := u.String()
+	u.User = url.UserPassword(role, "SyntheticRuntimeTestOnly")
+	runtime, err := sql.Open("pgx", u.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer runtime.Close()
+	if err := CheckPostgresRuntimeRole(ctx, runtime); err != nil {
+		t.Fatalf("restricted role rejected: %v", err)
+	}
+	pool := NewPool(PoolConfig{Backend: "postgres", RequireNonOwner: true})
+	defer pool.Close()
+	if _, err := pool.Get(ctx, "restricted", u.String()); err != nil {
+		t.Fatalf("runtime pool rejected: %v", err)
+	}
+	if _, err := pool.Get(ctx, "owner", ownerDSN); err == nil {
+		t.Fatal("owner tenant pool accepted")
+	}
+	if _, err := db.Exec("GRANT CREATE ON SCHEMA public TO " + role); err != nil {
+		t.Fatal(err)
+	}
+	if err := CheckPostgresRuntimeRole(ctx, runtime); err == nil {
+		t.Fatal("schema CREATE privilege accepted")
+	}
+	pool.Remove("restricted")
+	if _, err := pool.Get(ctx, "restricted", u.String()); err == nil {
+		t.Fatal("new privileged pool accepted")
+	}
+}
