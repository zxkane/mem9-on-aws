--- /dev/null
+++ b/server/internal/config/runtime_schema_test.go
@@ -0,0 +1,32 @@
+package config
+
+import "testing"
+
+func TestRuntimeSchemaMode(t *testing.T) {
+	t.Setenv("MNEMO_DSN", "synthetic")
+	t.Setenv("MNEMO_DB_BACKEND", "postgres")
+	t.Setenv("MNEMO_NAMESPACE_REQUIRED", "1")
+	t.Setenv("MNEMO_RUNTIME_USAGE_ENABLED", "false")
+	t.Setenv("MNEMO_RUNTIME_USAGE_OUTBOX_ENABLED", "false")
+	t.Setenv("MNEMO_SCHEMA_MODE", "verify")
+	cfg, err := Load()
+	if err != nil || cfg.SchemaMode != "verify" {
+		t.Fatalf("verify mode rejected: %v", err)
+	}
+	for _, mode := range []string{"unknown", "VERIFY"} {
+		t.Setenv("MNEMO_SCHEMA_MODE", mode)
+		if _, err := Load(); err == nil {
+			t.Fatal("invalid mode accepted")
+		}
+	}
+	t.Setenv("MNEMO_SCHEMA_MODE", "verify")
+	t.Setenv("MNEMO_NAMESPACE_REQUIRED", "0")
+	if _, err := Load(); err == nil {
+		t.Fatal("verify mode without namespace enforcement accepted")
+	}
+	t.Setenv("MNEMO_NAMESPACE_REQUIRED", "1")
+	t.Setenv("MNEMO_DB_BACKEND", "tidb")
+	if _, err := Load(); err == nil {
+		t.Fatal("verify mode on unsupported backend accepted")
+	}
+}
