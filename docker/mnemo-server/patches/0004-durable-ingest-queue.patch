+func TestIngestJobBlockedWritesUsePostLockDatabaseTime(t *testing.T) {
+	const (
+		activeLease = 3 * time.Second
+		deadline    = 400 * time.Millisecond
+		lockWait    = 600 * time.Millisecond
+	)
+	for _, test := range []struct {
+		name  string
+		write func(context.Context, *IngestJobRepo, *ingestqueue.Job) error
+		field string
+	}{
+		{
+			name: "heartbeat",
+			write: func(ctx context.Context, repo *IngestJobRepo, job *ingestqueue.Job) error {
+				return repo.Heartbeat(ctx, job.LeaseRef(), deadline)
+			},
+			field: "lease_expires_at",
+		},
+		{
+			name: "retry",
+			write: func(ctx context.Context, repo *IngestJobRepo, job *ingestqueue.Job) error {
+				return repo.Fail(
+					ctx,
+					job.LeaseRef(),
+					ingestqueue.Failure{
+						State:      ingestqueue.StateRetryWait,
+						ErrorClass: "mantle_transient",
+						RetryDelay: deadline,
+					},
+				)
+			},
+			field: "available_at",
+		},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			db := ingestTestDB(t)
+			repo := NewIngestJobRepo(db)
+			input := enqueueInput("tenant-a", "session-a", "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd")
+			job := enqueueJob(t, repo, input)
+			job, err := repo.Claim(
+				context.Background(),
+				job.TenantID,
+				"worker-a",
+				activeLease,
+				ingestqueue.MaxAttempts,
+			)
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			blocker, err := db.BeginTx(context.Background(), nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer blocker.Rollback()
+			if _, err := blocker.Exec(
+				`SELECT 1 FROM ingest_jobs WHERE job_id = $1 FOR UPDATE`,
+				job.ID,
+			); err != nil {
+				t.Fatal(err)
+			}
+
+			started := make(chan struct{})
+			result := make(chan error, 1)
+			go func() {
+				close(started)
+				result <- test.write(context.Background(), repo, job)
+			}()
+			<-started
+			time.Sleep(lockWait)
+			if err := blocker.Commit(); err != nil {
+				t.Fatal(err)
+			}
+			if err := <-result; err != nil {
+				t.Fatal(err)
+			}
+			assertDatabaseDeadline(t, db, job.ID, test.field, deadline)
+		})
+	}
+}
+
+func assertDatabaseDeadline(t *testing.T, db *sql.DB, jobID, column string, want time.Duration) {
+	t.Helper()
+	var remainingSeconds float64
+	query := fmt.Sprintf(
+		`SELECT EXTRACT(EPOCH FROM (%s - statement_timestamp()))
+		 FROM ingest_jobs WHERE job_id = $1`,
+		column,
+	)
+	if err := db.QueryRow(query, jobID).Scan(&remainingSeconds); err != nil {
+		t.Fatal(err)
+	}
+	remaining := time.Duration(remainingSeconds * float64(time.Second))
+	if remaining <= want/2 || remaining > want {
+		t.Fatalf("%s remaining = %v, want (%v, %v]", column, remaining, want/2, want)
+	}
+}
