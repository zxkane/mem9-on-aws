+func TestWorkerTransientRetriesAndFifthAttemptDies(t *testing.T) {
+	for attempt := 1; attempt <= MaxAttempts; attempt++ {
+		t.Run(strconv.Itoa(attempt), func(t *testing.T) {
+			repo := &fakeRepo{}
+			repo.transition = func(context.Context, LeaseRef) error { return nil }
+			failed := make(chan Failure, 1)
+			repo.fail = func(_ context.Context, lease LeaseRef, failure Failure) error {
+				if lease.Generation != attempt {
+					t.Fatalf("failure generation = %d, want %d", lease.Generation, attempt)
+				}
+				failed <- failure
+				return nil
+			}
+			claimed := false
+			repo.claim = func(context.Context, string, string, time.Duration, int) (*Job, error) {
+				if claimed {
+					return nil, nil
+				}
+				claimed = true
+				return &Job{ID: "job", TenantID: "tenant", LeaseOwner: "owner", AttemptCount: attempt}, nil
+			}
+			processor := fakeProcessor{
+				plan: func(context.Context, *Job) (Plan, error) {
+					return Plan{}, NewOutcomeError("mantle_transient")
+				},
+				apply: func(context.Context, *Job, json.RawMessage) (int, error) { return 0, nil },
+			}
+			cfg := DefaultWorkerConfig()
+			cfg.Enabled = true
+			cfg.PollInterval = time.Millisecond
+			cfg.Random = func() float64 { return 1 }
+			ctx, cancel := context.WithCancel(context.Background())
+			worker := NewWorker(repo, processor, "tenant", "owner", cfg, slog.New(slog.NewTextHandler(io.Discard, nil)))
+			go worker.Run(ctx)
+			got := <-failed
+			cancel()
+			if attempt < MaxAttempts {
+				if got.State != StateRetryWait || got.RetryDelay <= 0 {
+					t.Fatalf("attempt %d failure = %+v, want retry_wait", attempt, got)
+				}
+			} else if got.State != StateDead {
+				t.Fatalf("attempt 5 failure = %+v, want dead", got)
+			}
+		})
+	}
+}
+
+func TestWorkerShutdownCancelsWithoutAcknowledging(t *testing.T) {
+	repo := &fakeRepo{}
+	repo.transition = func(context.Context, LeaseRef) error { return nil }
+	var failureCalls atomic.Int32
+	repo.fail = func(context.Context, LeaseRef, Failure) error {
+		failureCalls.Add(1)
+		return nil
+	}
+	var claimed atomic.Bool
+	repo.claim = func(context.Context, string, string, time.Duration, int) (*Job, error) {
+		if claimed.Swap(true) {
+			return nil, nil
+		}
+		return &Job{ID: "job", TenantID: "tenant", LeaseOwner: "owner", AttemptCount: 1}, nil
+	}
+	started := make(chan struct{})
+	canceled := make(chan struct{})
+	processor := fakeProcessor{
+		plan: func(ctx context.Context, _ *Job) (Plan, error) {
+			close(started)
+			<-ctx.Done()
+			close(canceled)
+			return Plan{}, ctx.Err()
+		},
+		apply: func(context.Context, *Job, json.RawMessage) (int, error) { return 0, nil },
+	}
+	cfg := DefaultWorkerConfig()
+	cfg.Enabled = true
+	cfg.PollInterval = time.Millisecond
+	ctx, cancel := context.WithCancel(context.Background())
+	worker := NewWorker(repo, processor, "tenant", "owner", cfg, slog.New(slog.NewTextHandler(io.Discard, nil)))
+	done := make(chan error, 1)
+	go func() { done <- worker.Run(ctx) }()
+	<-started
+	cancel()
+	<-canceled
+	<-done
+	if failureCalls.Load() != 0 {
+		t.Fatal("shutdown must not acknowledge or fail unfinished work")
+	}
+}
