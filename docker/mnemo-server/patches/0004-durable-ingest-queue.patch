+func TestIngestJobSameOwnerRecoveryFencesStaleAttempt(t *testing.T) {
+	db := ingestTestDB(t)
+	repo := NewIngestJobRepo(db)
+	job := enqueueJob(t, repo, enqueueInput("tenant-a", "session-a", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"))
+	first, err := repo.Claim(context.Background(), job.TenantID, "shared-owner", time.Minute, ingestqueue.MaxAttempts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`UPDATE ingest_jobs SET lease_expires_at = statement_timestamp() - interval '1 second' WHERE job_id = $1`, job.ID); err != nil {
+		t.Fatal(err)
+	}
+	recovered, err := repo.Claim(context.Background(), job.TenantID, "shared-owner", time.Minute, ingestqueue.MaxAttempts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if recovered == nil || recovered.AttemptCount != first.AttemptCount+1 {
+		t.Fatalf("recovered job = %+v", recovered)
+	}
+	if err := repo.Heartbeat(context.Background(), first.LeaseRef(), time.Minute); !errors.Is(err, ingestqueue.ErrLeaseLost) {
+		t.Fatalf("stale attempt heartbeat = %v, want ErrLeaseLost", err)
+	}
+	if err := repo.StartPlanning(context.Background(), first.LeaseRef()); !errors.Is(err, ingestqueue.ErrLeaseLost) {
+		t.Fatalf("stale attempt transition = %v, want ErrLeaseLost", err)
+	}
+	if err := repo.StartPlanning(context.Background(), recovered.LeaseRef()); err != nil {
+		t.Fatalf("recovered attempt transition: %v", err)
+	}
+	if err := repo.SavePlan(
+		context.Background(),
+		first.LeaseRef(),
+		[]byte(`{"ops":[]}`),
+		0,
+	); !errors.Is(err, ingestqueue.ErrLeaseLost) {
+		t.Fatalf("stale attempt plan write = %v, want ErrLeaseLost", err)
+	}
+	if err := repo.SavePlan(
+		context.Background(),
+		recovered.LeaseRef(),
+		[]byte(`{"ops":[]}`),
+		0,
+	); err != nil {
+		t.Fatalf("recovered attempt plan write: %v", err)
+	}
+	if err := repo.Fail(
+		context.Background(),
+		first.LeaseRef(),
+		ingestqueue.Failure{State: ingestqueue.StateDead, ErrorClass: "stale"},
+	); !errors.Is(err, ingestqueue.ErrLeaseLost) {
+		t.Fatalf("stale attempt failure write = %v, want ErrLeaseLost", err)
+	}
+	if err := repo.Succeed(
+		context.Background(),
+		first.LeaseRef(),
+		0,
+	); !errors.Is(err, ingestqueue.ErrLeaseLost) {
+		t.Fatalf("stale attempt terminal write = %v, want ErrLeaseLost", err)
+	}
+	if err := repo.Succeed(
+		context.Background(),
+		recovered.LeaseRef(),
+		0,
+	); err != nil {
+		t.Fatalf("recovered attempt terminal write: %v", err)
+	}
+}
