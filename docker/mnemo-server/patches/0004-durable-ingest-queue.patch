index 0000000..5c5b8f8
--- /dev/null
+++ b/server/internal/ingestqueue/worker.go
@@ -0,0 +1,344 @@
+package ingestqueue
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"log/slog"
+	"math"
+	"math/rand/v2"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/qiffang/mnemos/server/internal/llm"
+)
+
+const failureWriteTimeout = 5 * time.Second
+const maxWorkerConcurrency = 2
+
+var processSemaphore = make(chan struct{}, maxWorkerConcurrency)
+
+type WorkerConfig struct {
+	Enabled      bool
+	Concurrency  int
+	Lease        time.Duration
+	Heartbeat    time.Duration
+	JobTimeout   time.Duration
+	PollInterval time.Duration
+	Random       func() float64
+}
+
+func DefaultWorkerConfig() WorkerConfig {
+	return WorkerConfig{
+		Enabled:      false,
+		Concurrency:  2,
+		Lease:        90 * time.Second,
+		Heartbeat:    30 * time.Second,
+		JobTimeout:   10 * time.Minute,
+		PollInterval: time.Second,
+		Random:       rand.Float64,
+	}
+}
+
+type Worker struct {
+	repo      Repository
+	processor Processor
+	tenantID  string
+	owner     string
+	config    WorkerConfig
+	logger    *slog.Logger
+}
+
+func NewWorker(repo Repository, processor Processor, tenantID, owner string, config WorkerConfig, logger *slog.Logger) *Worker {
+	defaults := DefaultWorkerConfig()
+	if config.Concurrency <= 0 {
+		config.Concurrency = defaults.Concurrency
+	}
+	if config.Concurrency > maxWorkerConcurrency {
+		config.Concurrency = maxWorkerConcurrency
+	}
+	if config.Lease <= 0 {
+		config.Lease = defaults.Lease
+	}
+	if config.Heartbeat <= 0 {
+		config.Heartbeat = defaults.Heartbeat
+	}
+	if config.JobTimeout <= 0 {
+		config.JobTimeout = defaults.JobTimeout
+	}
+	if config.PollInterval <= 0 {
+		config.PollInterval = defaults.PollInterval
+	}
+	if config.Random == nil {
+		config.Random = defaults.Random
+	}
+	if logger == nil {
+		logger = slog.Default()
+	}
+	return &Worker{
+		repo:      repo,
+		processor: processor,
+		tenantID:  tenantID,
+		owner:     owner,
+		config:    config,
+		logger:    logger,
+	}
+}
+
+func (w *Worker) Run(ctx context.Context) error {
+	if !w.config.Enabled {
+		return nil
+	}
+	if w.processor == nil {
+		return ErrProcessorUnavailable
+	}
+
+	workerCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	workerSemaphore := make(chan struct{}, w.config.Concurrency)
+	var active sync.WaitGroup
+	defer active.Wait()
+
+	for {
+		select {
+		case <-workerCtx.Done():
+			return nil
+		case workerSemaphore <- struct{}{}:
+		}
+		select {
+		case <-workerCtx.Done():
+			<-workerSemaphore
+			return nil
+		case processSemaphore <- struct{}{}:
+		}
+
+		job, err := w.repo.Claim(workerCtx, w.tenantID, w.owner, w.config.Lease, MaxAttempts)
+		if err != nil {
+			<-processSemaphore
+			<-workerSemaphore
+			w.logger.Error("durable ingest claim failed", "operation", "claim")
+			if !waitForWorker(workerCtx, w.config.PollInterval) {
+				return nil
+			}
+			continue
+		}
+		if job == nil {
+			<-processSemaphore
+			<-workerSemaphore
+			if !waitForWorker(workerCtx, w.config.PollInterval) {
+				return nil
+			}
+			continue
+		}
+
+		active.Add(1)
+		go func() {
+			defer active.Done()
+			defer func() {
+				<-processSemaphore
+				<-workerSemaphore
+			}()
+			w.process(workerCtx, job)
+		}()
+	}
+}
+
+func waitForWorker(ctx context.Context, duration time.Duration) bool {
+	timer := time.NewTimer(duration)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return false
+	case <-timer.C:
+		return true
+	}
+}
+
+func (w *Worker) process(ctx context.Context, job *Job) {
+	jobCtx, cancel := context.WithTimeout(ctx, w.config.JobTimeout)
+	lease := job.LeaseRef()
+	var leaseLost atomic.Bool
+	heartbeatDone := make(chan struct{})
+	go w.heartbeat(jobCtx, cancel, lease, &leaseLost, heartbeatDone)
+	defer func() {
+		cancel()
+		<-heartbeatDone
+	}()
+
+	if err := w.repo.StartPlanning(jobCtx, lease); err != nil {
+		return
+	}
+	plan, err := w.processor.Plan(jobCtx, job)
+	if err != nil {
+		w.fail(ctx, lease, err, leaseLost.Load())
+		return
+	}
+	if err := w.repo.SavePlan(
+		jobCtx,
+		lease,
+		plan.Payload,
+		plan.Warnings,
+	); err != nil {
+		return
+	}
+	applyWarnings, err := w.processor.Apply(jobCtx, job, json.RawMessage(plan.Payload))
+	if err != nil {
+		w.fail(ctx, lease, err, leaseLost.Load())
+		return
+	}
+	if err := w.repo.Succeed(
+		jobCtx,
+		lease,
+		applyWarnings,
+	); err != nil {
+		return
+	}
+	w.logger.Info("durable ingest job completed",
+		"job_id", job.ID,
+		"state", StateSucceeded,
+		"attempt", job.AttemptCount,
+	)
+}
+
+func (w *Worker) heartbeat(
+	ctx context.Context,
+	cancel context.CancelFunc,
+	lease LeaseRef,
+	leaseLost *atomic.Bool,
+	done chan<- struct{},
+) {
+	defer close(done)
+	ticker := time.NewTicker(w.config.Heartbeat)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			if err := w.repo.Heartbeat(
+				ctx,
+				lease,
+				w.config.Lease,
+			); err != nil {
+				leaseLost.Store(true)
+				cancel()
+				return
+			}
+		}
+	}
+}
+
+func (w *Worker) fail(parent context.Context, lease LeaseRef, err error, leaseLost bool) {
+	if parent.Err() != nil || leaseLost {
+		return
+	}
+	classification := ClassifyError(err)
+	failure := Failure{
+		State:      StateDead,
+		ErrorClass: classification.Class,
+	}
+	if classification.Transient && lease.Generation < MaxAttempts {
+		failure.State = StateRetryWait
+		failure.RetryDelay = FullJitterBackoff(lease.Generation, w.config.Random())
+	}
+	writeCtx, cancel := context.WithTimeout(parent, failureWriteTimeout)
+	defer cancel()
+	if err := w.repo.Fail(
+		writeCtx,
+		lease,
+		failure,
+	); err != nil {
+		return
+	}
+	w.logger.Info("durable ingest job failed",
+		"job_id", lease.JobID,
+		"state", failure.State,
+		"attempt", lease.Generation,
+		"error_class", failure.ErrorClass,
+	)
+}
+
+func FullJitterBackoff(attempt int, random float64) time.Duration {
+	if attempt < 1 {
+		attempt = 1
+	}
+	if random < 0 {
+		random = 0
+	}
+	if random > 1 {
+		random = 1
+	}
+	exponent := min(attempt-1, 6)
+	capDuration := 5 * time.Second * time.Duration(1<<exponent)
+	if capDuration > 5*time.Minute {
+		capDuration = 5 * time.Minute
+	}
+	return time.Duration(math.Round(float64(capDuration) * random))
+}
+
+type OutcomeError struct {
+	class string
+}
+
+func NewOutcomeError(class string) error {
+	return &OutcomeError{class: class}
+}
+
+func (e *OutcomeError) Error() string {
+	return "durable ingest processor outcome"
+}
+
+type ErrorClassification struct {
+	Class     string
+	Transient bool
+}
+
+func ClassifyError(err error) ErrorClassification {
+	if errors.Is(err, context.DeadlineExceeded) {
+		return ErrorClassification{Class: "deadline", Transient: true}
+	}
+	var httpError *llm.HTTPStatusError
+	if errors.As(err, &httpError) {
+		return classifyProxyHTTPError(httpError)
+	}
+	var outcome *OutcomeError
+	if errors.As(err, &outcome) {
+		switch outcome.class {
+		case "proxy_validation_permanent", "mantle_4xx_permanent":
+			return ErrorClassification{Class: outcome.class}
+		case "mantle_transient", "deadline":
+			return ErrorClassification{Class: outcome.class, Transient: true}
+		}
+	}
+	return ErrorClassification{Class: "permanent_unknown"}
+}
+
+func classifyProxyHTTPError(err *llm.HTTPStatusError) ErrorClassification {
+	code := proxyErrorCode(err.Body)
+	switch code {
+	case "request_too_large", "invalid_json", "invalid_chat_completions_request", "invalid_max_tokens":
+		return ErrorClassification{Class: "proxy_validation_permanent"}
+	case "upstream_timeout":
+		return ErrorClassification{Class: "deadline", Transient: true}
+	}
+	if err.Code == 408 || err.Code == 429 || err.Code >= 500 {
+		return ErrorClassification{Class: "mantle_transient", Transient: true}
+	}
+	if err.Code >= 400 && err.Code < 500 {
+		return ErrorClassification{Class: "mantle_4xx_permanent"}
+	}
+	return ErrorClassification{Class: "permanent_unknown"}
+}
+
+func proxyErrorCode(body string) string {
+	var envelope struct {
+		Error struct {
+			Code string `json:"code"`
+		} `json:"error"`
+	}
+	if json.Unmarshal([]byte(body), &envelope) != nil {
+		return ""
+	}
+	return envelope.Error.Code
+}
