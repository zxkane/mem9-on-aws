+			job, err := s.enqueueDurableIngest(r.Context(), auth, ingestReq)
+			if err != nil {
+				if errors.Is(err, domain.ErrValidation) {
+					s.handleError(r.Context(), w, err)
+					return
+				}
+				s.logger.Error("durable ingest enqueue failed", "operation", "enqueue")
+				respondError(w, http.StatusServiceUnavailable, "durable ingest enqueue failed")
+				return
+			}
+			respond(w, http.StatusAccepted, map[string]string{
+				"job_id": job.ID,
+				"state":  string(job.State),
+			})
+			return
+		}
+
 		if req.Sync {
 			syncCtx, cancel := context.WithTimeout(r.Context(), syncIngestTimeout)
 			defer cancel()
@@ -515,6 +536,56 @@ func (s *Server) createMemory(w http.ResponseWriter, r *http.Request) {
 	}
 }
 
+func (s *Server) enqueueDurableIngest(ctx context.Context, auth *domain.AuthInfo, req service.IngestRequest) (*ingestqueue.Job, error) {
+	mode := req.Mode
+	if mode == "" {
+		mode = s.ingestMode
+	}
+	if mode != service.ModeSmart && mode != service.ModeRaw {
+		return nil, &domain.ValidationError{Field: "mode", Message: fmt.Sprintf("unsupported mode %q", mode)}
+	}
+	messages := make([]ingestqueue.Message, len(req.Messages))
+	for i, message := range req.Messages {
+		messages[i] = ingestqueue.Message{
+			Role:    message.Role,
+			Content: message.Content,
+			Seq:     message.Seq,
+		}
+	}
+	envelope, err := ingestqueue.Canonicalize(ingestqueue.CanonicalInput{
+		TenantID:           auth.TenantID,
+		AgentID:            req.AgentID,
+		AppID:              req.AppID,
+		SessionID:          req.SessionID,
+		Mode:               string(mode),
+		DisableSessionSave: req.DisableSessionSave,
+		Messages:           messages,
+		Metadata:           req.Metadata,
+	})
+	if err != nil {
+		return nil, &domain.ValidationError{Field: "metadata", Message: "metadata must contain finite JSON values"}
+	}
+	repo := s.ingestRepoFactory(s.dbBackend, auth.TenantDB)
+	if repo == nil {
+		return nil, errors.New("durable ingest requires PostgreSQL")
+	}
+	job, err := repo.Enqueue(ctx, ingestqueue.EnqueueInput{
+		ID:                 uuid.NewString(),
+		TenantID:           auth.TenantID,
+		IdempotencyKey:     envelope.IdempotencyKey,
+		CanonicalPayload:   envelope.Payload,
+		AgentID:            req.AgentID,
+		AppID:              req.AppID,
+		SessionID:          req.SessionID,
+		Mode:               string(mode),
+		DisableSessionSave: req.DisableSessionSave,
+	})
+	if err != nil {
+		return nil, err
+	}
+	return job, nil
+}
+
