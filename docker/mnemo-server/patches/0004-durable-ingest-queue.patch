+func TestIngestJobLeaseDecisionsIgnoreProcessClockSkew(t *testing.T) {
+	db := ingestTestDB(t)
+	repo := NewIngestJobRepo(db)
+	job := enqueueJob(t, repo, enqueueInput("tenant-a", "session-a", "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"))
+	const lease = 500 * time.Millisecond
+	claimed, err := repo.Claim(context.Background(), job.TenantID, "worker-a", lease, ingestqueue.MaxAttempts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if claimed == nil {
+		t.Fatal("initial claim returned nil")
+	}
+	assertDatabaseDeadline(t, db, job.ID, "lease_expires_at", lease)
+
+	if err := repo.Heartbeat(
+		context.Background(),
+		claimed.LeaseRef(),
+		lease,
+	); err != nil {
+		t.Fatal(err)
+	}
+	assertDatabaseDeadline(t, db, job.ID, "lease_expires_at", lease)
+
+	if err := repo.Fail(
+		context.Background(),
+		claimed.LeaseRef(),
+		ingestqueue.Failure{
+			State:      ingestqueue.StateRetryWait,
+			ErrorClass: "mantle_transient",
+			RetryDelay: lease,
+		},
+	); err != nil {
+		t.Fatal(err)
+	}
+	assertDatabaseDeadline(t, db, job.ID, "available_at", lease)
+
+	if recovered, err := repo.Claim(context.Background(), job.TenantID, "worker-b", lease, ingestqueue.MaxAttempts); err != nil || recovered != nil {
+		t.Fatalf("database-future retry became immediately eligible: job=%+v err=%v", recovered, err)
+	}
+}
