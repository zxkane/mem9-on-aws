+	second.ID = "00000000-0000-4000-8000-000000000002"
+	cross := enqueueInput("tenant-a", "session-b", "3333333333333333333333333333333333333333333333333333333333333333")
+	cross.ID = "00000000-0000-4000-8000-000000000003"
+	enqueueJob(t, repo, first)
+	time.Sleep(time.Millisecond)
+	enqueueJob(t, repo, second)
+	enqueueJob(t, repo, cross)
+
+	var wg sync.WaitGroup
+	claims := make(chan *ingestqueue.Job, 8)
+	for i := range 8 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			job, err := repo.Claim(context.Background(), "tenant-a", fmt.Sprintf("worker-%d", i), time.Minute, ingestqueue.MaxAttempts)
+			if err != nil {
+				t.Errorf("Claim: %v", err)
+				return
+			}
+			if job != nil {
+				claims <- job
+			}
+		}()
+	}
+	wg.Wait()
+	close(claims)
+	got := map[string]*ingestqueue.Job{}
+	for job := range claims {
+		if _, duplicate := got[job.ID]; duplicate {
+			t.Fatalf("job %s double claimed", job.ID)
+		}
+		got[job.ID] = job
+	}
+	if len(got) != 2 || got[first.ID] == nil || got[cross.ID] == nil || got[second.ID] != nil {
+		t.Fatalf("claims = %#v, want session heads only", got)
+	}
+
+	head := got[first.ID]
+	if err := repo.StartPlanning(context.Background(), head.LeaseRef()); err != nil {
+		t.Fatal(err)
+	}
+	if err := repo.SavePlan(context.Background(), head.LeaseRef(), []byte(`{"ops":[]}`), 2); err != nil {
+		t.Fatal(err)
+	}
+	if err := repo.Succeed(context.Background(), head.LeaseRef(), 3); err != nil {
+		t.Fatal(err)
+	}
+	next, err := repo.Claim(context.Background(), "tenant-a", "worker-next", time.Minute, ingestqueue.MaxAttempts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if next == nil || next.ID != second.ID {
+		t.Fatalf("next claim after succeeded = %+v", next)
+	}
+
+	crossHead := got[cross.ID]
+	if err := repo.Fail(context.Background(), crossHead.LeaseRef(), ingestqueue.Failure{
+		State:      ingestqueue.StateDead,
+		ErrorClass: "poison",
+	}); err != nil {
+		t.Fatal(err)
+	}
+	var state string
+	if err := db.QueryRow(`SELECT state FROM ingest_jobs WHERE job_id = $1`, crossHead.ID).Scan(&state); err != nil {
+		t.Fatal(err)
+	}
+	if state != string(ingestqueue.StateDead) {
+		t.Fatalf("poison state = %q", state)
+	}
+}
