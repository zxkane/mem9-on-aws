+package ingestqueue
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"time"
+)
+
+type State string
+
+const (
+	StateQueued     State = "queued"
+	StateProcessing State = "processing"
+	StatePlanning   State = "planning"
+	StateApplying   State = "applying"
+	StateRetryWait  State = "retry_wait"
+	StateSucceeded  State = "succeeded"
+	StateDead       State = "dead"
+
+	MaxAttempts = 5
+)
+
+var (
+	ErrLeaseLost            = errors.New("ingest job lease lost")
+	ErrProcessorUnavailable = errors.New("durable ingest processor unavailable")
+)
+
+type Message struct {
+	Role    string
+	Content string
+	Seq     *int
+}
+
+type CanonicalInput struct {
+	TenantID           string
+	AgentID            string
+	AppID              string
+	SessionID          string
+	Mode               string
+	DisableSessionSave bool
+	Messages           []Message
+	Metadata           json.RawMessage
+}
+
+type CanonicalEnvelope struct {
+	Payload        []byte
+	IdempotencyKey string
+}
+
+type EnqueueInput struct {
+	ID                 string
+	TenantID           string
+	IdempotencyKey     string
+	CanonicalPayload   json.RawMessage
+	AgentID            string
+	AppID              string
+	SessionID          string
+	Mode               string
+	DisableSessionSave bool
+}
+
+type Job struct {
+	ID                 string
+	TenantID           string
+	IdempotencyKey     string
+	CanonicalPayload   json.RawMessage
+	AgentID            string
+	AppID              string
+	SessionID          string
+	Mode               string
+	DisableSessionSave bool
+	State              State
+	AttemptCount       int
+	AvailableAt        time.Time
+	LeaseOwner         string
+	LeaseExpiresAt     *time.Time
+	HeartbeatAt        *time.Time
+	PlanPayload        json.RawMessage
+	PlanWarningCount   int
+	ApplyWarningCount  int
+	WarningCount       int
+	ErrorClass         string
+	CreatedAt          time.Time
+	UpdatedAt          time.Time
+	CompletedAt        *time.Time
+}
+
+type LeaseRef struct {
+	TenantID   string
+	JobID      string
+	Owner      string
+	Generation int
+}
+
+func (j *Job) LeaseRef() LeaseRef {
+	return LeaseRef{
+		TenantID:   j.TenantID,
+		JobID:      j.ID,
+		Owner:      j.LeaseOwner,
+		Generation: j.AttemptCount,
+	}
+}
+
+type Failure struct {
+	State      State
+	ErrorClass string
+	RetryDelay time.Duration
+}
+
+type Plan struct {
+	Payload  json.RawMessage
+	Warnings int
+}
+
+type Processor interface {
+	Plan(context.Context, *Job) (Plan, error)
+	Apply(context.Context, *Job, json.RawMessage) (int, error)
+}
+
+type Repository interface {
+	Enqueue(context.Context, EnqueueInput) (*Job, error)
+	Get(context.Context, string, string) (*Job, error)
+	Claim(context.Context, string, string, time.Duration, int) (*Job, error)
+	StartPlanning(context.Context, LeaseRef) error
+	SavePlan(context.Context, LeaseRef, json.RawMessage, int) error
+	Succeed(context.Context, LeaseRef, int) error
+	Fail(context.Context, LeaseRef, Failure) error
+	Heartbeat(context.Context, LeaseRef, time.Duration) error
+}
