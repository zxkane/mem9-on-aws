+
+func TestDurableIngestPostgresCommitAndDedupIntegration(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	db, err := sql.Open("pgx", dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if _, err := db.Exec(`TRUNCATE ingest_jobs`); err != nil {
+		t.Fatal(err)
+	}
+
+	srv := newTestServer(&testMemoryRepo{}, &testSessionRepo{}).WithDurableIngest(true)
+	srv.dbBackend = "postgres"
+	body := map[string]any{
+		"messages":   []map[string]string{{"role": "user", "content": "hello"}},
+		"appId":      "business-app",
+		"session_id": "session-a",
+	}
+	var firstID string
+	for range 2 {
+		req := durableRequest(t, "tenant-a", db, body)
+		rr := httptest.NewRecorder()
+		srv.createMemory(rr, req)
+		if rr.Code != http.StatusAccepted {
+			t.Fatalf("status = %d: %s", rr.Code, rr.Body.String())
+		}
+		var response map[string]string
+		if err := json.NewDecoder(rr.Body).Decode(&response); err != nil {
+			t.Fatal(err)
+		}
+		if firstID == "" {
+			firstID = response["job_id"]
+		} else if response["job_id"] != firstID {
+			t.Fatalf("duplicate ids = %q and %q", firstID, response["job_id"])
+		}
+		var committed int
+		if err := db.QueryRow(`SELECT count(*) FROM ingest_jobs WHERE job_id = $1`, response["job_id"]).Scan(&committed); err != nil {
+			t.Fatal(err)
+		}
+		if committed != 1 {
+			t.Fatalf("202 returned before commit: rows = %d", committed)
+		}
+	}
+
+	body["messages"] = []map[string]string{{"role": "user", "content": "different"}}
+	rr := httptest.NewRecorder()
+	srv.createMemory(rr, durableRequest(t, "tenant-a", db, body))
+	if rr.Code != http.StatusAccepted {
+		t.Fatalf("different request status = %d: %s", rr.Code, rr.Body.String())
+	}
+	var count int
+	if err := db.QueryRow(`SELECT count(*) FROM ingest_jobs`).Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 2 {
+		t.Fatalf("semantically different requests produced %d rows, want 2", count)
+	}
+}
