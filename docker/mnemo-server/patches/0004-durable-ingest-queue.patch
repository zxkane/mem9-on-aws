+	`, later.ID, later.TenantID, later.IdempotencyKey, []byte(later.CanonicalPayload),
+		later.AgentID, later.AppID, later.SessionID, later.Mode, later.DisableSessionSave); err != nil {
+		t.Fatal(err)
+	}
+
+	type claimResult struct {
+		job *ingestqueue.Job
+		err error
+	}
+	result := make(chan claimResult, 1)
+	go func() {
+		job, err := repo.Claim(context.Background(), "tenant-a", "worker-a", time.Minute, ingestqueue.MaxAttempts)
+		result <- claimResult{job: job, err: err}
+	}()
+
+	var claimed claimResult
+	select {
+	case claimed = <-result:
+	case <-time.After(100 * time.Millisecond):
+		if err := earlierTx.Commit(); err != nil {
+			t.Fatal(err)
+		}
+		claimed = <-result
+	}
+	if err := earlierTx.Commit(); err != nil && !errors.Is(err, sql.ErrTxDone) {
+		t.Fatal(err)
+	}
+	if claimed.err != nil {
+		t.Fatal(claimed.err)
+	}
+	if claimed.job == nil || claimed.job.ID != earlier.ID {
+		t.Fatalf("claim during delayed enqueue = %+v, want earlier job %s", claimed.job, earlier.ID)
+	}
+
+	var earlierState, laterState string
+	if err := db.QueryRow(`SELECT state FROM ingest_jobs WHERE job_id = $1`, earlier.ID).Scan(&earlierState); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.QueryRow(`SELECT state FROM ingest_jobs WHERE job_id = $1`, later.ID).Scan(&laterState); err != nil {
+		t.Fatal(err)
+	}
+	if earlierState != string(ingestqueue.StateProcessing) || laterState != string(ingestqueue.StateQueued) {
+		t.Fatalf("states after delayed enqueue = earlier:%s later:%s", earlierState, laterState)
+	}
+}
