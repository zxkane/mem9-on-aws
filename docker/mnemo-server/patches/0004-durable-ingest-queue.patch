+func TestDurableIngestDuplicateReturnsCurrentJobState(t *testing.T) {
+	srv := newTestServer(&testMemoryRepo{}, &testSessionRepo{}).WithDurableIngest(true)
+	var mu sync.Mutex
+	var inputs []ingestqueue.EnqueueInput
+	srv.ingestRepoFactory = func(string, *sql.DB) ingestqueue.Repository {
+		return &handlerIngestRepo{
+			enqueue: func(_ context.Context, input ingestqueue.EnqueueInput) (*ingestqueue.Job, error) {
+				mu.Lock()
+				inputs = append(inputs, input)
+				mu.Unlock()
+				return &ingestqueue.Job{ID: "same-job", TenantID: input.TenantID, State: ingestqueue.StateRetryWait}, nil
+			},
+		}
+	}
+	body := map[string]any{
+		"messages": []map[string]any{
+			{"role": "user", "content": "hello"},
+			{"role": "assistant", "content": "world", "seq": 7},
+		},
+		"metadata": map[string]any{"z": 1, "a": map[string]any{"b": 2, "a": 1}},
+	}
+	var hashes []string
+	for range 2 {
+		req := durableRequest(t, "tenant-a", nil, body)
+		rr := httptest.NewRecorder()
+		srv.createMemory(rr, req)
+		if rr.Code != http.StatusAccepted {
+			t.Fatalf("status = %d: %s", rr.Code, rr.Body.String())
+		}
+		var response map[string]string
+		if err := json.NewDecoder(rr.Body).Decode(&response); err != nil {
+			t.Fatal(err)
+		}
+		if response["job_id"] != "same-job" || response["state"] != "retry_wait" {
+			t.Fatalf("response = %#v", response)
+		}
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	for _, input := range inputs {
+		hashes = append(hashes, input.IdempotencyKey)
+		if input.Mode != "smart" || input.DisableSessionSave {
+			t.Fatalf("defaults not applied: %+v", input)
+		}
+		if string(input.CanonicalPayload) == "" {
+			t.Fatal("canonical payload missing")
+		}
+	}
+	if len(hashes) != 2 || hashes[0] != hashes[1] {
+		t.Fatalf("duplicate hashes = %#v", hashes)
+	}
+}
+
+func TestDurableIngestExcludesTransportAndCredentialFieldsFromHash(t *testing.T) {
+	srv := newTestServer(&testMemoryRepo{}, &testSessionRepo{}).WithDurableIngest(true)
+	var hashes []string
+	var payloads []string
+	srv.ingestRepoFactory = func(string, *sql.DB) ingestqueue.Repository {
+		return &handlerIngestRepo{
+			enqueue: func(_ context.Context, input ingestqueue.EnqueueInput) (*ingestqueue.Job, error) {
+				hashes = append(hashes, input.IdempotencyKey)
+				payloads = append(payloads, string(input.CanonicalPayload))
+				return &ingestqueue.Job{ID: "job", TenantID: input.TenantID, State: ingestqueue.StateQueued}, nil
+			},
+		}
+	}
+	for _, fields := range []map[string]any{
+		{"api_key": "transport-value-a", "request_id": "request-a"},
+		{"api_key": "transport-value-b", "request_id": "request-b"},
+	} {
+		fields["messages"] = []map[string]string{{"role": "user", "content": "hello"}}
+		rr := httptest.NewRecorder()
+		srv.createMemory(rr, durableRequest(t, "tenant-a", nil, fields))
+		if rr.Code != http.StatusAccepted {
+			t.Fatalf("status = %d: %s", rr.Code, rr.Body.String())
+		}
+	}
+	if len(hashes) != 2 || hashes[0] != hashes[1] {
+		t.Fatalf("transport-only fields changed hashes: %#v", hashes)
+	}
+	for _, payload := range payloads {
+		if strings.Contains(payload, "transport-value") || strings.Contains(payload, "request-") {
+			t.Fatalf("canonical payload retained a transport field: %s", payload)
+		}
+	}
+}
+
+func TestDurableIngestStripsInjectedContextBeforeHashing(t *testing.T) {
+	srv := newTestServer(&testMemoryRepo{}, &testSessionRepo{}).WithDurableIngest(true)
+	var hashes []string
+	var payloads []string
+	srv.ingestRepoFactory = func(string, *sql.DB) ingestqueue.Repository {
+		return &handlerIngestRepo{
+			enqueue: func(_ context.Context, input ingestqueue.EnqueueInput) (*ingestqueue.Job, error) {
+				hashes = append(hashes, input.IdempotencyKey)
+				payloads = append(payloads, string(input.CanonicalPayload))
+				return &ingestqueue.Job{ID: "job", TenantID: input.TenantID, State: ingestqueue.StateQueued}, nil
+			},
+		}
+	}
+	for _, injected := range []string{"private-memory-a", "private-memory-b"} {
+		body := map[string]any{
+			"messages": []map[string]string{{
+				"role":    "user",
+				"content": "keep <relevant-memories>" + injected + "</relevant-memories> text",
+			}},
+		}
+		rr := httptest.NewRecorder()
+		srv.createMemory(rr, durableRequest(t, "tenant-a", nil, body))
+		if rr.Code != http.StatusAccepted {
+			t.Fatalf("status = %d: %s", rr.Code, rr.Body.String())
+		}
+	}
+	if len(hashes) != 2 || hashes[0] != hashes[1] {
+		t.Fatalf("injected context changed hashes: %#v", hashes)
+	}
+	for _, payload := range payloads {
+		if strings.Contains(payload, "private-memory") || !strings.Contains(payload, `"content":"keep  text"`) {
+			t.Fatalf("canonical payload was not sanitized: %s", payload)
+		}
+	}
+}
