+
+type handlerIngestRepo struct {
+	ingestqueue.Repository
+	enqueue func(context.Context, ingestqueue.EnqueueInput) (*ingestqueue.Job, error)
+}
+
+func (r *handlerIngestRepo) Enqueue(ctx context.Context, input ingestqueue.EnqueueInput) (*ingestqueue.Job, error) {
+	return r.enqueue(ctx, input)
+}
+
+func durableRequest(t *testing.T, tenant string, db *sql.DB, body map[string]any) *http.Request {
+	t.Helper()
+	req := makeRequest(t, http.MethodPost, "/memories", body)
+	auth := &domain.AuthInfo{
+		TenantID:  tenant,
+		TenantDB:  db,
+		AgentName: "authenticated-agent",
+	}
+	return req.WithContext(middleware.WithAuthContext(req.Context(), auth))
+}
+
+func TestDurableIngestWaitsForEnqueueCommitBefore202(t *testing.T) {
+	srv := newTestServer(&testMemoryRepo{}, &testSessionRepo{}).WithDurableIngest(true)
+	started := make(chan struct{})
+	release := make(chan struct{})
+	repo := &handlerIngestRepo{
+		enqueue: func(_ context.Context, input ingestqueue.EnqueueInput) (*ingestqueue.Job, error) {
+			close(started)
+			<-release
+			if input.TenantID != "tenant-a" || input.AgentID != "authenticated-agent" ||
+				input.AppID != "business-app" || input.SessionID != "session-a" {
+				t.Fatalf("enqueue scope = %+v", input)
+			}
+			return &ingestqueue.Job{
+				ID:       "job-committed",
+				TenantID: input.TenantID,
+				State:    ingestqueue.StateQueued,
+			}, nil
+		},
+	}
+	srv.ingestRepoFactory = func(backend string, db *sql.DB) ingestqueue.Repository {
+		if db != nil {
+			t.Fatal("test request should pass its resolved nil TenantDB")
+		}
+		return repo
+	}
+	req := durableRequest(t, "tenant-a", nil, map[string]any{
+		"messages":   []map[string]any{{"role": "user", "content": "SECRET-MEMORY"}},
+		"appId":      "business-app",
+		"session_id": "session-a",
+	})
+	rr := httptest.NewRecorder()
+	done := make(chan struct{})
+	go func() {
+		srv.createMemory(rr, req)
+		close(done)
+	}()
+	<-started
+	select {
+	case <-done:
+		t.Fatal("handler returned 202 before enqueue/commit completed")
+	case <-time.After(40 * time.Millisecond):
+	}
+	close(release)
+	<-done
+	if rr.Code != http.StatusAccepted {
+		t.Fatalf("status = %d: %s", rr.Code, rr.Body.String())
+	}
+	var response map[string]string
+	if err := json.NewDecoder(rr.Body).Decode(&response); err != nil {
+		t.Fatal(err)
+	}
+	if response["job_id"] != "job-committed" || response["state"] != "queued" {
+		t.Fatalf("response = %#v", response)
+	}
+	if _, exists := response["status"]; exists {
+		t.Fatalf("durable response leaked legacy status: %#v", response)
+	}
+}
+
+func TestDurableIngestEnqueueFailureIsNon2xx(t *testing.T) {
+	srv := newTestServer(&testMemoryRepo{}, &testSessionRepo{}).WithDurableIngest(true)
+	srv.ingestRepoFactory = func(string, *sql.DB) ingestqueue.Repository {
+		return &handlerIngestRepo{
+			enqueue: func(context.Context, ingestqueue.EnqueueInput) (*ingestqueue.Job, error) {
+				return nil, errors.New("database commit failed")
+			},
+		}
+	}
+	req := durableRequest(t, "tenant-a", nil, map[string]any{
+		"messages": []map[string]string{{"role": "user", "content": "hello"}},
+	})
+	rr := httptest.NewRecorder()
+	srv.createMemory(rr, req)
+	if rr.Code < 400 {
+		t.Fatalf("enqueue failure returned %d: %s", rr.Code, rr.Body.String())
+	}
+	if body := rr.Body.String(); body == "" || body == "database commit failed" {
+		t.Fatalf("unexpected error body %q", body)
+	}
+}
