+				errs <- err
+				return
+			}
+			ids <- job.ID
+		}()
+	}
+	wg.Wait()
+	close(ids)
+	close(errs)
+	for err := range errs {
+		t.Errorf("concurrent Enqueue: %v", err)
+	}
+	var first string
+	for id := range ids {
