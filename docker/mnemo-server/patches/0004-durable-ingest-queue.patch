diff --git a/server/internal/ingestqueue/canonical.go b/server/internal/ingestqueue/canonical.go
new file mode 100644
index 0000000..d7bf17f
--- /dev/null
+++ b/server/internal/ingestqueue/canonical.go
@@ -0,0 +1,191 @@
+package ingestqueue
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+func Canonicalize(input CanonicalInput) (CanonicalEnvelope, error) {
+	if strings.TrimSpace(input.TenantID) == "" {
+		return CanonicalEnvelope{}, fmt.Errorf("tenant_id is required")
+	}
+	if input.Mode == "" {
+		input.Mode = "smart"
+	}
+
+	metadata, err := decodeMetadata(input.Metadata)
+	if err != nil {
+		return CanonicalEnvelope{}, fmt.Errorf("metadata: %w", err)
+	}
+	messages := make([]any, len(input.Messages))
+	for i, message := range input.Messages {
+		seq := i
+		if message.Seq != nil {
+			seq = *message.Seq
+		}
+		messages[i] = map[string]any{
+			"role":    message.Role,
+			"content": message.Content,
+			"seq":     json.Number(strconv.Itoa(seq)),
+		}
+	}
+
+	envelope := map[string]any{
+		"version":            "ingest-v1",
+		"tenant_id":          input.TenantID,
+		"agent_id":           input.AgentID,
+		"app_id":             input.AppID,
+		"session_id":         input.SessionID,
+		"mode":               input.Mode,
+		"disableSessionSave": input.DisableSessionSave,
+		"messages":           messages,
+		"metadata":           metadata,
+	}
+	var payload bytes.Buffer
+	if err := writeCanonicalJSON(&payload, envelope); err != nil {
+		return CanonicalEnvelope{}, err
+	}
+	sum := sha256.Sum256(payload.Bytes())
+	return CanonicalEnvelope{
+		Payload:        payload.Bytes(),
+		IdempotencyKey: hex.EncodeToString(sum[:]),
+	}, nil
+}
+
+func decodeMetadata(raw json.RawMessage) (any, error) {
+	if len(bytes.TrimSpace(raw)) == 0 {
+		return map[string]any{}, nil
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.UseNumber()
+	var value any
+	if err := decoder.Decode(&value); err != nil {
+		return nil, err
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); !errorsIsEOF(err) {
+		if err == nil {
+			return nil, fmt.Errorf("multiple JSON values")
+		}
+		return nil, err
+	}
+	return value, nil
+}
+
+func errorsIsEOF(err error) bool {
+	return err == io.EOF
+}
+
+func writeCanonicalJSON(dst *bytes.Buffer, value any) error {
+	switch typed := value.(type) {
+	case nil:
+		dst.WriteString("null")
+	case bool:
+		if typed {
+			dst.WriteString("true")
+		} else {
+			dst.WriteString("false")
+		}
+	case string:
+		encoded, _ := json.Marshal(typed)
+		dst.Write(encoded)
+	case json.Number:
+		normalized, err := normalizeJSONNumber(typed.String())
+		if err != nil {
+			return err
+		}
+		dst.WriteString(normalized)
+	case []any:
+		dst.WriteByte('[')
+		for i, item := range typed {
+			if i > 0 {
+				dst.WriteByte(',')
+			}
+			if err := writeCanonicalJSON(dst, item); err != nil {
+				return err
+			}
+		}
+		dst.WriteByte(']')
+	case map[string]any:
+		keys := make([]string, 0, len(typed))
+		for key := range typed {
+			keys = append(keys, key)
+		}
+		sort.Strings(keys)
+		dst.WriteByte('{')
+		for i, key := range keys {
+			if i > 0 {
+				dst.WriteByte(',')
+			}
+			encoded, _ := json.Marshal(key)
+			dst.Write(encoded)
+			dst.WriteByte(':')
+			if err := writeCanonicalJSON(dst, typed[key]); err != nil {
+				return err
+			}
+		}
+		dst.WriteByte('}')
+	default:
+		return fmt.Errorf("unsupported canonical JSON type %T", value)
+	}
+	return nil
+}
+
+func normalizeJSONNumber(raw string) (string, error) {
+	value, err := strconv.ParseFloat(raw, 64)
+	if err != nil || math.IsInf(value, 0) || math.IsNaN(value) {
+		return "", fmt.Errorf("number %q is not finite JSON", raw)
+	}
+
+	negative := strings.HasPrefix(raw, "-")
+	unsigned := strings.TrimPrefix(raw, "-")
+	mantissa := unsigned
+	exponent := 0
+	if index := strings.IndexAny(unsigned, "eE"); index >= 0 {
+		mantissa = unsigned[:index]
+		exponent, err = strconv.Atoi(unsigned[index+1:])
+		if err != nil {
+			return "", fmt.Errorf("number %q has an invalid exponent", raw)
+		}
+	}
+	fractionDigits := 0
+	if point := strings.IndexByte(mantissa, '.'); point >= 0 {
+		fractionDigits = len(mantissa) - point - 1
+		mantissa = mantissa[:point] + mantissa[point+1:]
+	}
+	digits := strings.TrimLeft(mantissa, "0")
+	if digits == "" {
+		return "0", nil
+	}
+	if value == 0 {
+		return "", fmt.Errorf("number %q is outside the finite JSON range", raw)
+	}
+	exponent -= fractionDigits
+	for strings.HasSuffix(digits, "0") {
+		digits = strings.TrimSuffix(digits, "0")
+		exponent++
+	}
+
+	decimalPoint := len(digits) + exponent
+	var normalized string
+	switch {
+	case decimalPoint <= 0:
+		normalized = "0." + strings.Repeat("0", -decimalPoint) + digits
+	case decimalPoint >= len(digits):
+		normalized = digits + strings.Repeat("0", decimalPoint-len(digits))
+	default:
+		normalized = digits[:decimalPoint] + "." + digits[decimalPoint:]
+	}
+	if negative {
+		return "-" + normalized, nil
+	}
+	return normalized, nil
+}
