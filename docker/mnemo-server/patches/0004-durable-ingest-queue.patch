+package postgres
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/qiffang/mnemos/server/internal/ingestqueue"
+)
+
+const ingestJobColumns = `
+	job_id, tenant_id, idempotency_key, canonical_payload,
+	agent_id, app_id, session_id, mode, disable_session_save,
+	state, attempt_count, available_at, lease_owner, lease_expires_at,
+	heartbeat_at, plan_payload, plan_warning_count, apply_warning_count,
+	warning_count, error_class, created_at, updated_at, completed_at`
+
+type IngestJobRepo struct {
+	db *sql.DB
+}
+
+type ingestJobScope struct {
+	tenantID  string
+	agentID   string
+	appID     string
+	sessionID string
+}
+
+func NewIngestJobRepo(db *sql.DB) *IngestJobRepo {
+	return &IngestJobRepo{db: db}
+}
+
+func (r *IngestJobRepo) Enqueue(ctx context.Context, input ingestqueue.EnqueueInput) (*ingestqueue.Job, error) {
+	tx, err := r.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})
+	if err != nil {
+		return nil, fmt.Errorf("begin ingest enqueue: %w", err)
+	}
+	defer tx.Rollback()
+
+	scope := ingestJobScope{
+		tenantID:  input.TenantID,
+		agentID:   input.AgentID,
+		appID:     input.AppID,
+		sessionID: input.SessionID,
+	}
+	if err := lockIngestJobScope(ctx, tx, scope); err != nil {
+		return nil, fmt.Errorf("lock ingest enqueue scope: %w", err)
+	}
+
+	row := tx.QueryRowContext(ctx, `
+		INSERT INTO ingest_jobs (
+			job_id, tenant_id, idempotency_key, canonical_payload,
+			agent_id, app_id, session_id, mode, disable_session_save,
+			available_at, created_at, updated_at
+		)
+		VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9,
+			statement_timestamp(), statement_timestamp(), statement_timestamp())
+		ON CONFLICT (tenant_id, idempotency_key) DO NOTHING
+		RETURNING `+ingestJobColumns,
+		input.ID,
+		input.TenantID,
+		input.IdempotencyKey,
+		[]byte(input.CanonicalPayload),
+		input.AgentID,
+		input.AppID,
+		input.SessionID,
+		input.Mode,
+		input.DisableSessionSave,
+	)
+	job, err := scanIngestJob(row)
+	if errors.Is(err, sql.ErrNoRows) {
+		job, err = scanIngestJob(tx.QueryRowContext(ctx, `
+			SELECT `+ingestJobColumns+`
+			FROM ingest_jobs
+			WHERE tenant_id = $1 AND idempotency_key = $2`,
+			input.TenantID,
+			input.IdempotencyKey,
+		))
+	}
+	if err != nil {
+		return nil, fmt.Errorf("enqueue ingest job: %w", err)
+	}
+	if err := tx.Commit(); err != nil {
+		return nil, fmt.Errorf("commit ingest enqueue: %w", err)
+	}
+	return job, nil
+}
+
+func (r *IngestJobRepo) Get(ctx context.Context, tenantID, jobID string) (*ingestqueue.Job, error) {
+	job, err := scanIngestJob(r.db.QueryRowContext(ctx, `
+		SELECT `+ingestJobColumns+`
+		FROM ingest_jobs
+		WHERE tenant_id = $1 AND job_id = $2`,
+		tenantID,
+		jobID,
+	))
+	if err != nil {
+		return nil, fmt.Errorf("get ingest job: %w", err)
+	}
+	return job, nil
+}
+
+func (r *IngestJobRepo) Claim(
+	ctx context.Context,
+	tenantID string,
+	owner string,
+	lease time.Duration,
+	maxAttempts int,
+) (*ingestqueue.Job, error) {
+	if lease <= 0 {
+		return nil, errors.New("ingest lease must be positive")
+	}
+	if maxAttempts <= 0 {
+		return nil, errors.New("ingest max attempts must be positive")
+	}
+	tx, err := r.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})
+	if err != nil {
+		return nil, fmt.Errorf("begin ingest claim: %w", err)
+	}
+	defer tx.Rollback()
+
+	// The first statement reserves visible work with SKIP LOCKED. After the
+	// scope lock, the loop reads a fresh snapshot that includes delayed enqueues.
+	scope, err := selectClaimableIngestJobScope(ctx, tx, tenantID)
+	if errors.Is(err, sql.ErrNoRows) {
+		if err := tx.Commit(); err != nil {
+			return nil, fmt.Errorf("commit empty ingest claim: %w", err)
+		}
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("select ingest claim scope: %w", err)
+	}
+	if err := lockIngestJobScope(ctx, tx, scope); err != nil {
+		return nil, fmt.Errorf("lock ingest claim scope: %w", err)
+	}
+
+	for {
+		var (
+			jobID        string
+			attemptCount int
+			eligible     bool
+		)
+		err := tx.QueryRowContext(ctx, `
+			SELECT job_id,
+				attempt_count,
+				CASE
+					WHEN state IN ('queued', 'retry_wait')
+						THEN available_at <= statement_timestamp()
+					WHEN state IN ('processing', 'planning', 'applying')
+						THEN lease_expires_at IS NULL
+							OR lease_expires_at <= statement_timestamp()
+					ELSE FALSE
+				END
+			FROM ingest_jobs
+			WHERE tenant_id = $1
+			  AND agent_id = $2
+			  AND app_id = $3
+			  AND session_id = $4
+			  AND state NOT IN ('succeeded', 'dead')
+			ORDER BY created_at, job_id
+			FOR UPDATE
+			LIMIT 1`,
+			scope.tenantID,
+			scope.agentID,
+			scope.appID,
+			scope.sessionID,
+		).Scan(&jobID, &attemptCount, &eligible)
+		if errors.Is(err, sql.ErrNoRows) {
+			if err := tx.Commit(); err != nil {
+				return nil, fmt.Errorf("commit empty ingest claim: %w", err)
+			}
+			return nil, nil
+		}
+		if err != nil {
+			return nil, fmt.Errorf("select ingest scope head: %w", err)
+		}
+		if !eligible {
+			if err := tx.Commit(); err != nil {
+				return nil, fmt.Errorf("commit blocked ingest claim: %w", err)
+			}
+			return nil, nil
+		}
+
+		if attemptCount >= maxAttempts {
+			if _, err := tx.ExecContext(ctx, `
+				UPDATE ingest_jobs
+				SET state = 'dead',
+					error_class = 'attempts_exhausted',
+					lease_owner = NULL,
+					lease_expires_at = NULL,
+					heartbeat_at = statement_timestamp(),
+					completed_at = statement_timestamp(),
+					updated_at = statement_timestamp()
+				WHERE tenant_id = $1 AND job_id = $2`,
+				tenantID,
+				jobID,
+			); err != nil {
+				return nil, fmt.Errorf("expire exhausted ingest job: %w", err)
+			}
+			continue
+		}
+
+		job, err := scanIngestJob(tx.QueryRowContext(ctx, `
+			UPDATE ingest_jobs AS job
+			SET state = 'processing',
+				attempt_count = job.attempt_count + 1,
+				lease_owner = $3,
+				lease_expires_at = statement_timestamp()
+					+ ($4 * interval '1 microsecond'),
+				heartbeat_at = statement_timestamp(),
+				plan_payload = NULL,
+				plan_warning_count = 0,
+				apply_warning_count = 0,
+				warning_count = 0,
+				error_class = NULL,
+				completed_at = NULL,
+				updated_at = statement_timestamp()
+			WHERE job.tenant_id = $1 AND job.job_id = $2
+			RETURNING `+prefixedIngestJobColumns("job"),
+			tenantID,
+			jobID,
+			owner,
+			lease.Microseconds(),
+		))
+		if err != nil {
+			return nil, fmt.Errorf("claim ingest job: %w", err)
+		}
+		if err := tx.Commit(); err != nil {
+			return nil, fmt.Errorf("commit ingest claim: %w", err)
+		}
+		return job, nil
+	}
+}
+
+func selectClaimableIngestJobScope(ctx context.Context, tx *sql.Tx, tenantID string) (ingestJobScope, error) {
+	var scope ingestJobScope
+	err := tx.QueryRowContext(ctx, `
+		SELECT j.tenant_id, j.agent_id, j.app_id, j.session_id
+		FROM ingest_jobs AS j
+		WHERE j.tenant_id = $1
+		  AND (
+			(j.state IN ('queued', 'retry_wait')
+			 AND j.available_at <= statement_timestamp())
+			OR
+			(j.state IN ('processing', 'planning', 'applying')
+			 AND (j.lease_expires_at IS NULL
+				OR j.lease_expires_at <= statement_timestamp()))
+		  )
+		  AND NOT EXISTS (
+			SELECT 1
+			FROM ingest_jobs AS earlier
+			WHERE earlier.tenant_id = j.tenant_id
+			  AND earlier.agent_id = j.agent_id
+			  AND earlier.app_id = j.app_id
+			  AND earlier.session_id = j.session_id
+			  AND earlier.state NOT IN ('succeeded', 'dead')
+			  AND (
+				earlier.created_at < j.created_at
+				OR (earlier.created_at = j.created_at AND earlier.job_id < j.job_id)
+			  )
+		  )
+		ORDER BY j.available_at, j.created_at, j.job_id
+		FOR UPDATE OF j SKIP LOCKED
+		LIMIT 1`,
+		tenantID,
+	).Scan(&scope.tenantID, &scope.agentID, &scope.appID, &scope.sessionID)
+	return scope, err
+}
+
+func lockIngestJobScope(ctx context.Context, tx *sql.Tx, scope ingestJobScope) error {
+	_, err := tx.ExecContext(ctx, `
+		SELECT pg_advisory_xact_lock(
+			hashtextextended($1::text,
+				hashtextextended($2::text,
+					hashtextextended($3::text,
+						hashtextextended($4::text, 0)))))`,
+		scope.tenantID,
+		scope.agentID,
+		scope.appID,
+		scope.sessionID,
+	)
+	return err
+}
+
+func (r *IngestJobRepo) StartPlanning(ctx context.Context, lease ingestqueue.LeaseRef) error {
+	return r.ownedTransition(ctx, lease, `
+		UPDATE ingest_jobs
+		SET state = 'planning', updated_at = statement_timestamp()
+		WHERE tenant_id = $1 AND job_id = $2 AND lease_owner = $3
+		  AND attempt_count = $4
+		  AND state = 'processing'
+		  AND lease_expires_at > statement_timestamp()`)
+}
+
+func (r *IngestJobRepo) SavePlan(
+	ctx context.Context,
+	lease ingestqueue.LeaseRef,
+	plan json.RawMessage,
+	warnings int,
+) error {
+	return r.ownedTransition(ctx, lease, `
+		UPDATE ingest_jobs
+		SET state = 'applying',
+			plan_payload = $5,
+			plan_warning_count = $6,
+			warning_count = $6,
+			updated_at = statement_timestamp()
+		WHERE tenant_id = $1 AND job_id = $2 AND lease_owner = $3
+		  AND attempt_count = $4
+		  AND state = 'planning'
+		  AND lease_expires_at > statement_timestamp()`,
+		[]byte(plan),
+		warnings,
+	)
+}
+
+func (r *IngestJobRepo) Succeed(
+	ctx context.Context,
+	lease ingestqueue.LeaseRef,
+	warnings int,
+) error {
+	return r.ownedTransition(ctx, lease, `
+		UPDATE ingest_jobs
+		SET state = 'succeeded',
+			apply_warning_count = $5,
+			warning_count = plan_warning_count + $5,
+			error_class = NULL,
+			lease_owner = NULL,
+			lease_expires_at = NULL,
+			heartbeat_at = statement_timestamp(),
+			completed_at = statement_timestamp(),
+			updated_at = statement_timestamp()
+		WHERE tenant_id = $1 AND job_id = $2 AND lease_owner = $3
+		  AND attempt_count = $4
+		  AND state = 'applying'
+		  AND lease_expires_at > statement_timestamp()`,
+		warnings,
+	)
+}
+
+func (r *IngestJobRepo) Fail(
+	ctx context.Context,
+	lease ingestqueue.LeaseRef,
+	failure ingestqueue.Failure,
+) error {
+	if failure.State != ingestqueue.StateRetryWait && failure.State != ingestqueue.StateDead {
+		return fmt.Errorf("invalid ingest failure state %q", failure.State)
+	}
+	if failure.RetryDelay < 0 {
+		return errors.New("ingest retry delay must not be negative")
+	}
+	return r.ownedTransition(ctx, lease, `
+		UPDATE ingest_jobs
+		SET state = $5::varchar,
+			available_at = statement_timestamp()
+				+ ($6 * interval '1 microsecond'),
+			error_class = $7,
+			lease_owner = NULL,
+			lease_expires_at = NULL,
+			heartbeat_at = statement_timestamp(),
+			completed_at = CASE WHEN $5::varchar = 'dead'
+				THEN statement_timestamp() ELSE NULL END,
+			updated_at = statement_timestamp()
+		WHERE tenant_id = $1 AND job_id = $2 AND lease_owner = $3
+		  AND attempt_count = $4
+		  AND state IN ('processing', 'planning', 'applying')
+		  AND lease_expires_at > statement_timestamp()`,
+		string(failure.State),
+		failure.RetryDelay.Microseconds(),
+		failure.ErrorClass,
+	)
+}
+
+func (r *IngestJobRepo) Heartbeat(
+	ctx context.Context,
+	leaseRef ingestqueue.LeaseRef,
+	lease time.Duration,
+) error {
+	if lease <= 0 {
+		return errors.New("ingest lease must be positive")
+	}
+	return r.ownedTransition(ctx, leaseRef, `
+		UPDATE ingest_jobs
+		SET lease_expires_at = statement_timestamp()
+				+ ($5 * interval '1 microsecond'),
+			heartbeat_at = statement_timestamp(),
+			updated_at = statement_timestamp()
+		WHERE tenant_id = $1 AND job_id = $2 AND lease_owner = $3
+		  AND attempt_count = $4
+		  AND state IN ('processing', 'planning', 'applying')
+		  AND lease_expires_at > statement_timestamp()`,
+		lease.Microseconds(),
+	)
+}
+
+func (r *IngestJobRepo) ownedTransition(
+	ctx context.Context,
+	lease ingestqueue.LeaseRef,
+	query string,
+	args ...any,
+) error {
+	tx, err := r.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})
+	if err != nil {
+		return fmt.Errorf("begin ingest update: %w", err)
+	}
+	defer tx.Rollback()
+
+	var locked int
+	err = tx.QueryRowContext(ctx, `
+		SELECT 1
+		FROM ingest_jobs
+		WHERE tenant_id = $1 AND job_id = $2 AND lease_owner = $3
+		  AND attempt_count = $4
+		  AND state IN ('processing', 'planning', 'applying')
+		  AND lease_expires_at > clock_timestamp()
+		FOR UPDATE`,
+		lease.TenantID,
+		lease.JobID,
+		lease.Owner,
+		lease.Generation,
+	).Scan(&locked)
+	if errors.Is(err, sql.ErrNoRows) {
+		return ingestqueue.ErrLeaseLost
+	}
+	if err != nil {
+		return fmt.Errorf("lock ingest job update: %w", err)
+	}
+
+	queryArgs := []any{
+		lease.TenantID,
+		lease.JobID,
+		lease.Owner,
+		lease.Generation,
+	}
+	queryArgs = append(queryArgs, args...)
+	result, err := tx.ExecContext(ctx, query, queryArgs...)
+	if err != nil {
+		return fmt.Errorf("update ingest job: %w", err)
+	}
+	updated, err := result.RowsAffected()
+	if err != nil {
+		return fmt.Errorf("read ingest update result: %w", err)
+	}
+	if updated != 1 {
+		return ingestqueue.ErrLeaseLost
+	}
+	if err := tx.Commit(); err != nil {
+		return fmt.Errorf("commit ingest update: %w", err)
+	}
+	return nil
+}
+
+type rowScanner interface {
+	Scan(...any) error
+}
+
+func scanIngestJob(row rowScanner) (*ingestqueue.Job, error) {
+	var (
+		job            ingestqueue.Job
+		state          string
+		leaseOwner     sql.NullString
+		leaseExpiresAt sql.NullTime
+		heartbeatAt    sql.NullTime
+		planPayload    []byte
+		errorClass     sql.NullString
+		completedAt    sql.NullTime
+	)
+	if err := row.Scan(
+		&job.ID,
+		&job.TenantID,
+		&job.IdempotencyKey,
+		&job.CanonicalPayload,
+		&job.AgentID,
+		&job.AppID,
+		&job.SessionID,
+		&job.Mode,
+		&job.DisableSessionSave,
+		&state,
+		&job.AttemptCount,
+		&job.AvailableAt,
+		&leaseOwner,
+		&leaseExpiresAt,
+		&heartbeatAt,
+		&planPayload,
+		&job.PlanWarningCount,
+		&job.ApplyWarningCount,
+		&job.WarningCount,
+		&errorClass,
+		&job.CreatedAt,
+		&job.UpdatedAt,
+		&completedAt,
+	); err != nil {
+		return nil, err
+	}
+	job.State = ingestqueue.State(state)
+	job.LeaseOwner = leaseOwner.String
+	job.ErrorClass = errorClass.String
+	job.PlanPayload = json.RawMessage(planPayload)
+	if leaseExpiresAt.Valid {
+		job.LeaseExpiresAt = &leaseExpiresAt.Time
+	}
+	if heartbeatAt.Valid {
+		job.HeartbeatAt = &heartbeatAt.Time
+	}
+	if completedAt.Valid {
+		job.CompletedAt = &completedAt.Time
+	}
+	return &job, nil
+}
+
+func prefixedIngestJobColumns(prefix string) string {
+	columns := []string{
+		"job_id", "tenant_id", "idempotency_key", "canonical_payload",
+		"agent_id", "app_id", "session_id", "mode", "disable_session_save",
+		"state", "attempt_count", "available_at", "lease_owner", "lease_expires_at",
+		"heartbeat_at", "plan_payload", "plan_warning_count", "apply_warning_count",
+		"warning_count", "error_class", "created_at", "updated_at", "completed_at",
+	}
+	for i := range columns {
+		columns[i] = prefix + "." + columns[i]
+	}
+	return strings.Join(columns, ", ")
+}
