new file mode 100644
index 0000000..23062bb
--- /dev/null
+++ b/server/internal/ingestqueue/canonical_test.go
@@ -0,0 +1,171 @@
+package ingestqueue
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func intPtr(v int) *int { return &v }
+
+func canonicalInput() CanonicalInput {
+	return CanonicalInput{
+		TenantID:           "tenant-a",
+		AgentID:            "agent-a",
+		AppID:              "app-a",
+		SessionID:          "session-a",
+		Mode:               "smart",
+		DisableSessionSave: true,
+		Messages: []Message{
+			{Role: "user", Content: "first"},
+			{Role: "assistant", Content: "second", Seq: intPtr(9)},
+		},
+		Metadata: json.RawMessage(`{"z":1.0,"nested":{"b":2e0,"a":1},"items":[{"b":2,"a":1},3]}`),
+	}
+}
+
+func mustCanonical(t *testing.T, input CanonicalInput) CanonicalEnvelope {
+	t.Helper()
+	got, err := Canonicalize(input)
+	if err != nil {
+		t.Fatalf("Canonicalize: %v", err)
+	}
+	return got
+}
+
+func TestCanonicalizeStableOrderingNumbersAndDefaults(t *testing.T) {
+	first := canonicalInput()
+	second := first
+	second.Metadata = json.RawMessage(`{"items":[{"a":1.00,"b":2.0},3.0],"nested":{"a":1e0,"b":2},"z":1}`)
+
+	a := mustCanonical(t, first)
+	b := mustCanonical(t, second)
+	if !bytes.Equal(a.Payload, b.Payload) || a.IdempotencyKey != b.IdempotencyKey {
+		t.Fatalf("semantic metadata did not canonicalize identically:\n%s\n%s", a.Payload, b.Payload)
+	}
+	want := `"messages":[{"content":"first","role":"user","seq":0},{"content":"second","role":"assistant","seq":9}]`
+	if !strings.Contains(string(a.Payload), want) {
+		t.Fatalf("payload missing ordered/defaulted messages: %s", a.Payload)
+	}
+	for _, field := range []string{
+		`"version":"ingest-v1"`,
+		`"tenant_id":"tenant-a"`,
+		`"app_id":"app-a"`,
+		`"disableSessionSave":true`,
+		`"metadata":{"items":[{"a":1,"b":2},3],"nested":{"a":1,"b":2},"z":1}`,
+	} {
+		if !strings.Contains(string(a.Payload), field) {
+			t.Fatalf("payload missing %s: %s", field, a.Payload)
+		}
+	}
+}
+
+func TestCanonicalizeSemanticFieldsAffectHash(t *testing.T) {
+	base := canonicalInput()
+	baseHash := mustCanonical(t, base).IdempotencyKey
+	cases := map[string]func(*CanonicalInput){
+		"tenant": func(v *CanonicalInput) { v.TenantID = "tenant-b" },
+		"agent":  func(v *CanonicalInput) { v.AgentID = "agent-b" },
+		"app":    func(v *CanonicalInput) { v.AppID = "app-b" },
+		"session": func(v *CanonicalInput) {
+			v.SessionID = "session-b"
+		},
+		"mode": func(v *CanonicalInput) { v.Mode = "raw" },
+		"disableSessionSave": func(v *CanonicalInput) {
+			v.DisableSessionSave = false
+		},
+		"message order": func(v *CanonicalInput) {
+			v.Messages[0], v.Messages[1] = v.Messages[1], v.Messages[0]
+		},
+		"message content": func(v *CanonicalInput) { v.Messages[0].Content = "changed" },
+	}
+	for name, mutate := range cases {
+		t.Run(name, func(t *testing.T) {
+			input := canonicalInput()
+			mutate(&input)
+			if got := mustCanonical(t, input).IdempotencyKey; got == baseHash {
+				t.Fatalf("hash unchanged for %s", name)
+			}
+		})
+	}
+}
+
+func TestCanonicalizeExcludesTransportAndCredentialsByConstruction(t *testing.T) {
+	input := canonicalInput()
+	got := mustCanonical(t, input)
+	for _, forbidden := range []string{
+		"api_key", "authorization", "credential", "request_id", "transport", "sync",
+	} {
+		if strings.Contains(strings.ToLower(string(got.Payload)), forbidden) {
+			t.Fatalf("canonical payload contains transport/auth field %q: %s", forbidden, got.Payload)
+		}
+	}
+}
+
+func TestCanonicalizeRejectsInvalidNumbersAndMissingScope(t *testing.T) {
+	for _, raw := range []string{
+		`{"n":NaN}`,
+		`{"n":Infinity}`,
+		`{"n":1e10000}`,
+		`{"n":1e-1000000000}`,
+		`{"n":01}`,
+	} {
+		input := canonicalInput()
+		input.Metadata = json.RawMessage(raw)
+		if _, err := Canonicalize(input); err == nil {
+			t.Fatalf("Canonicalize metadata %q succeeded, want error", raw)
+		}
+	}
+
+	input := canonicalInput()
+	input.TenantID = ""
+	if _, err := Canonicalize(input); err == nil {
+		t.Fatal("Canonicalize accepted empty authenticated tenant")
+	}
+}
+
+func TestCanonicalizeMetadataArrayOrderIsSignificant(t *testing.T) {
+	a := canonicalInput()
+	a.Metadata = json.RawMessage(`{"items":[1,2,3]}`)
+	b := a
+	b.Metadata = json.RawMessage(`{"items":[3,2,1]}`)
+	if mustCanonical(t, a).IdempotencyKey == mustCanonical(t, b).IdempotencyKey {
+		t.Fatal("array reordering must change the hash")
+	}
+}
+
+func TestCanonicalizeExplicitDefaults(t *testing.T) {
+	got := mustCanonical(t, CanonicalInput{
+		TenantID: "tenant-a",
+		Messages: []Message{{Role: "user", Content: "hello"}},
+	})
+	for _, field := range []string{
+		`"agent_id":""`,
+		`"app_id":""`,
+		`"session_id":""`,
+		`"mode":"smart"`,
+		`"disableSessionSave":false`,
+		`"metadata":{}`,
+		`"seq":0`,
+	} {
+		if !strings.Contains(string(got.Payload), field) {
+			t.Fatalf("defaulted payload missing %s: %s", field, got.Payload)
+		}
+	}
+}
+
+func TestCanonicalizePreservesDistinctLargeIntegers(t *testing.T) {
+	first := canonicalInput()
+	first.Metadata = json.RawMessage(`{"n":9007199254740992}`)
+	second := canonicalInput()
+	second.Metadata = json.RawMessage(`{"n":9007199254740993}`)
+	a := mustCanonical(t, first)
+	b := mustCanonical(t, second)
+	if a.IdempotencyKey == b.IdempotencyKey {
+		t.Fatal("distinct integers above the IEEE-754 exact range collided")
+	}
+	if !strings.Contains(string(b.Payload), `"n":9007199254740993`) {
+		t.Fatalf("large integer lost precision: %s", b.Payload)
+	}
+}
