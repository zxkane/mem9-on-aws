+)
+
+func workerTestRepo(t *testing.T) (*postgres.IngestJobRepo, *sql.DB) {
+	t.Helper()
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	db, err := sql.Open("pgx", dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`TRUNCATE ingest_jobs`); err != nil {
+		db.Close()
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { db.Close() })
+	return postgres.NewIngestJobRepo(db), db
+}
+
+func workerEnqueue(t *testing.T, repo *postgres.IngestJobRepo, index int, session string) *ingestqueue.Job {
+	t.Helper()
+	key := fmt.Sprintf("%064d", index)
+	job, err := repo.Enqueue(context.Background(), ingestqueue.EnqueueInput{
+		ID:               fmt.Sprintf("10000000-0000-4000-8000-%012d", index),
+		TenantID:         "tenant-worker",
+		IdempotencyKey:   key,
+		CanonicalPayload: []byte(`{"version":"ingest-v1"}`),
+		AgentID:          "agent",
+		AppID:            "app",
+		SessionID:        session,
+		Mode:             "smart",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return job
+}
+
+type integrationProcessor struct {
+	plan  func(context.Context, *ingestqueue.Job) (ingestqueue.Plan, error)
+	apply func(context.Context, *ingestqueue.Job, json.RawMessage) (int, error)
+}
+
+func (p integrationProcessor) Plan(ctx context.Context, job *ingestqueue.Job) (ingestqueue.Plan, error) {
+	return p.plan(ctx, job)
+}
+func (p integrationProcessor) Apply(ctx context.Context, job *ingestqueue.Job, plan json.RawMessage) (int, error) {
+	return p.apply(ctx, job, plan)
+}
+
+func TestPostgresWorkerCrossSessionCapAndShutdownRecovery(t *testing.T) {
+	repo, db := workerTestRepo(t)
+	workerEnqueue(t, repo, 1, "session-a")
+	time.Sleep(time.Millisecond)
+	workerEnqueue(t, repo, 2, "session-a")
+	workerEnqueue(t, repo, 3, "session-b")
+	workerEnqueue(t, repo, 4, "session-c")
+
+	var active atomic.Int32
+	var maxActive atomic.Int32
+	var mu sync.Mutex
+	started := map[string]int{}
+	release := make(chan struct{})
+	processor := integrationProcessor{
+		plan: func(ctx context.Context, job *ingestqueue.Job) (ingestqueue.Plan, error) {
+			n := active.Add(1)
+			defer active.Add(-1)
+			for {
+				old := maxActive.Load()
+				if n <= old || maxActive.CompareAndSwap(old, n) {
+					break
+				}
+			}
+			mu.Lock()
+			started[job.SessionID]++
+			mu.Unlock()
+			select {
+			case <-release:
+				return ingestqueue.Plan{Payload: json.RawMessage(`{"ops":[]}`)}, nil
+			case <-ctx.Done():
+				return ingestqueue.Plan{}, ctx.Err()
+			}
+		},
+		apply: func(context.Context, *ingestqueue.Job, json.RawMessage) (int, error) { return 0, nil },
+	}
+	cfg := ingestqueue.DefaultWorkerConfig()
+	cfg.Enabled = true
+	cfg.PollInterval = 5 * time.Millisecond
+	cfg.Lease = 150 * time.Millisecond
+	cfg.Heartbeat = 30 * time.Millisecond
+	ctx, cancel := context.WithCancel(context.Background())
+	workers := []*ingestqueue.Worker{
+		ingestqueue.NewWorker(repo, processor, "tenant-worker", "worker-a", cfg, slog.New(slog.NewTextHandler(io.Discard, nil))),
+		ingestqueue.NewWorker(repo, processor, "tenant-worker", "worker-b", cfg, slog.New(slog.NewTextHandler(io.Discard, nil))),
+	}
+	done := make(chan error, len(workers))
+	for _, worker := range workers {
+		go func(worker *ingestqueue.Worker) { done <- worker.Run(ctx) }(worker)
+	}
+
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		mu.Lock()
+		count := len(started)
+		sessionACount := started["session-a"]
+		mu.Unlock()
+		if count == 2 {
+			if sessionACount != 1 {
+				t.Fatalf("same-session follower started concurrently: %#v", started)
+			}
+			break
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	if got := maxActive.Load(); got != 2 {
+		t.Fatalf("max active = %d, want 2", got)
+	}
+
+	cancel()
+	for range workers {
+		<-done
+	}
+	close(release)
+	var processing int
+	if err := db.QueryRow(`SELECT count(*) FROM ingest_jobs WHERE state IN ('processing','planning','applying')`).Scan(&processing); err != nil {
+		t.Fatal(err)
+	}
+	if processing != 2 {
+		t.Fatalf("shutdown acknowledged active jobs: processing=%d", processing)
+	}
+
+	if _, err := db.Exec(`UPDATE ingest_jobs SET lease_expires_at = NOW() - interval '1 second' WHERE state IN ('processing','planning','applying')`); err != nil {
+		t.Fatal(err)
+	}
+	recovered := make(chan string, 2)
+	recoveryProcessor := integrationProcessor{
+		plan: func(_ context.Context, job *ingestqueue.Job) (ingestqueue.Plan, error) {
+			recovered <- job.ID
+			return ingestqueue.Plan{Payload: json.RawMessage(`{"ops":[]}`)}, nil
+		},
+		apply: func(context.Context, *ingestqueue.Job, json.RawMessage) (int, error) { return 0, nil },
+	}
+	recoveryCtx, recoveryCancel := context.WithCancel(context.Background())
+	recovery := ingestqueue.NewWorker(repo, recoveryProcessor, "tenant-worker", "worker-b", cfg, slog.New(slog.NewTextHandler(io.Discard, nil)))
+	recoveryDone := make(chan error, 1)
+	go func() { recoveryDone <- recovery.Run(recoveryCtx) }()
+	select {
+	case <-recovered:
+	case <-time.After(time.Second):
+		t.Fatal("expired shutdown job was not recovered")
+	}
+	recoveryCancel()
+	<-recoveryDone
+}
+
+func TestPostgresWorkerFiveAttemptExhaustionUnblocksFollower(t *testing.T) {
+	testPostgresWorkerDeadHeadUnblocksFollower(
+		t,
+		10,
+		ingestqueue.NewOutcomeError("mantle_transient"),
+		ingestqueue.MaxAttempts,
+	)
+}
+
+func TestPostgresWorkerPermanentFailureUnblocksFollower(t *testing.T) {
+	testPostgresWorkerDeadHeadUnblocksFollower(
+		t,
+		20,
+		ingestqueue.NewOutcomeError("proxy_validation_permanent"),
+		1,
+	)
+}
+
+func testPostgresWorkerDeadHeadUnblocksFollower(t *testing.T, index int, processorError error, expectedAttempts int) {
+	t.Helper()
+	repo, db := workerTestRepo(t)
+	head := workerEnqueue(t, repo, index, "session-a")
+	time.Sleep(time.Millisecond)
+	follower := workerEnqueue(t, repo, index+1, "session-a")
+
+	processor := integrationProcessor{
+		plan: func(_ context.Context, job *ingestqueue.Job) (ingestqueue.Plan, error) {
+			if job.ID == head.ID {
+				return ingestqueue.Plan{}, processorError
+			}
+			return ingestqueue.Plan{Payload: json.RawMessage(`{"ops":[]}`)}, nil
+		},
+		apply: func(context.Context, *ingestqueue.Job, json.RawMessage) (int, error) { return 0, nil },
+	}
+	cfg := ingestqueue.DefaultWorkerConfig()
+	cfg.Enabled = true
+	cfg.PollInterval = time.Millisecond
+	cfg.Random = func() float64 { return 0 }
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	worker := ingestqueue.NewWorker(repo, processor, "tenant-worker", "worker-exhaustion", cfg, slog.New(slog.NewTextHandler(io.Discard, nil)))
+	go func() { done <- worker.Run(ctx) }()
+
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		var headState, followerState string
+		var attempts int
+		err := db.QueryRow(`SELECT state, attempt_count FROM ingest_jobs WHERE job_id = $1`, head.ID).Scan(&headState, &attempts)
+		if err != nil {
+			t.Fatal(err)
+		}
+		err = db.QueryRow(`SELECT state FROM ingest_jobs WHERE job_id = $1`, follower.ID).Scan(&followerState)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if headState == string(ingestqueue.StateDead) && attempts == expectedAttempts &&
+			followerState == string(ingestqueue.StateSucceeded) {
+			cancel()
+			<-done
+			return
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	cancel()
+	<-done
+	t.Fatalf("dead head did not unblock follower after %d attempt(s)", expectedAttempts)
+}
