+package config
+
+import "testing"
+
+func TestDurableIngestDefaultsDisabled(t *testing.T) {
+	t.Setenv("MNEMO_DSN", "test-dsn")
+	t.Setenv("MNEMO_DURABLE_INGEST_ENABLED", "")
+	cfg, err := Load()
+	if err != nil {
+		t.Fatalf("Load: %v", err)
+	}
+	if cfg.DurableIngestEnabled {
+		t.Fatal("durable ingest must default disabled")
+	}
+
+	t.Setenv("MNEMO_DURABLE_INGEST_ENABLED", "true")
+	cfg, err = Load()
+	if err != nil {
+		t.Fatalf("Load enabled: %v", err)
+	}
+	if !cfg.DurableIngestEnabled {
+		t.Fatal("explicit durable ingest flag was not enabled")
+	}
+}
