+type fakeRepo struct {
+	Repository
+	claimCalls atomic.Int32
+	claim      func(context.Context, string, string, time.Duration, int) (*Job, error)
+	transition func(context.Context, LeaseRef) error
+	savePlan   func(context.Context, LeaseRef, json.RawMessage, int) error
+	succeed    func(context.Context, LeaseRef, int) error
+	fail       func(context.Context, LeaseRef, Failure) error
+	heartbeat  func(context.Context, LeaseRef, time.Duration) error
+}
+
+func (r *fakeRepo) Claim(ctx context.Context, tenant, owner string, lease time.Duration, max int) (*Job, error) {
+	r.claimCalls.Add(1)
+	if r.claim == nil {
+		return nil, nil
+	}
+	return r.claim(ctx, tenant, owner, lease, max)
+}
+func (r *fakeRepo) StartPlanning(ctx context.Context, lease LeaseRef) error {
+	return r.transition(ctx, lease)
+}
+func (r *fakeRepo) SavePlan(
+	ctx context.Context,
+	lease LeaseRef,
+	plan json.RawMessage,
+	warnings int,
+) error {
+	return r.savePlan(ctx, lease, plan, warnings)
+}
+func (r *fakeRepo) Succeed(ctx context.Context, lease LeaseRef, warnings int) error {
+	return r.succeed(ctx, lease, warnings)
+}
+func (r *fakeRepo) Fail(ctx context.Context, lease LeaseRef, failure Failure) error {
+	return r.fail(ctx, lease, failure)
+}
+func (r *fakeRepo) Heartbeat(
+	ctx context.Context,
+	leaseRef LeaseRef,
+	lease time.Duration,
+) error {
+	if r.heartbeat == nil {
+		return nil
+	}
+	return r.heartbeat(ctx, leaseRef, lease)
+}
+
+type fakeProcessor struct {
+	plan  func(context.Context, *Job) (Plan, error)
+	apply func(context.Context, *Job, json.RawMessage) (int, error)
+}
+
+func (p fakeProcessor) Plan(ctx context.Context, job *Job) (Plan, error) {
+	return p.plan(ctx, job)
+}
+func (p fakeProcessor) Apply(ctx context.Context, job *Job, plan json.RawMessage) (int, error) {
+	return p.apply(ctx, job, plan)
+}
+
+func TestDefaultWorkerConfigAndRetryBoundaries(t *testing.T) {
+	cfg := DefaultWorkerConfig()
+	if cfg.Enabled {
+		t.Fatal("worker must default disabled")
+	}
+	if cfg.Concurrency != 2 || cfg.Lease != 90*time.Second ||
+		cfg.Heartbeat != 30*time.Second || cfg.JobTimeout != 10*time.Minute {
+		t.Fatalf("unexpected defaults: %+v", cfg)
+	}
+	cases := []struct {
+		attempt int
+		random  float64
+		want    time.Duration
+	}{
+		{1, 0, 0},
+		{1, 1, 5 * time.Second},
+		{2, 1, 10 * time.Second},
+		{7, 1, 5 * time.Minute},
+		{99, 1, 5 * time.Minute},
+	}
+	for _, tc := range cases {
+		if got := FullJitterBackoff(tc.attempt, tc.random); got != tc.want {
+			t.Fatalf("attempt %d random %v: got %v want %v", tc.attempt, tc.random, got, tc.want)
+		}
+	}
+
+	cfg.Concurrency = 9
+	worker := NewWorker(&fakeRepo{}, fakeProcessor{}, "tenant", "owner", cfg, nil)
+	if worker.config.Concurrency != 2 {
+		t.Fatalf("worker concurrency = %d, want hard cap 2", worker.config.Concurrency)
+	}
+}
+
+func TestClassifyProxyOutcomesAndAttemptLimit(t *testing.T) {
+	for _, class := range []string{"proxy_validation_permanent", "mantle_4xx_permanent"} {
+		if got := ClassifyError(NewOutcomeError(class)); got.Transient {
+			t.Fatalf("%s classified transient", class)
+		}
+	}
+	for _, class := range []string{"mantle_transient", "deadline"} {
+		if got := ClassifyError(NewOutcomeError(class)); !got.Transient {
+			t.Fatalf("%s classified permanent", class)
+		}
+	}
+	if MaxAttempts != 5 {
+		t.Fatalf("MaxAttempts = %d, want 5", MaxAttempts)
+	}
+	if got := ClassifyError(errors.New("SECRET unknown failure")); got.Transient {
+		t.Fatal("unknown errors must fail closed as permanent")
+	}
+
+	proxyCases := []struct {
+		name      string
+		err       error
+		class     string
+		transient bool
+	}{
+		{
+			name:  "proxy validation",
+			err:   &llm.HTTPStatusError{Code: 400, Body: `{"error":{"code":"invalid_max_tokens"}}`},
+			class: "proxy_validation_permanent",
+		},
+		{
+			name:  "permanent provider response",
+			err:   &llm.HTTPStatusError{Code: 422, Body: `{"error":{"code":"provider_error"}}`},
+			class: "mantle_4xx_permanent",
+		},
+		{
+			name:      "retryable provider response",
+			err:       &llm.HTTPStatusError{Code: 503, Body: `{}`},
+			class:     "mantle_transient",
+			transient: true,
+		},
+		{
+			name:      "proxy deadline",
+			err:       &llm.HTTPStatusError{Code: 504, Body: `{"error":{"code":"upstream_timeout"}}`},
+			class:     "deadline",
+			transient: true,
+		},
+	}
+	for _, tc := range proxyCases {
+		t.Run(tc.name, func(t *testing.T) {
+			got := ClassifyError(tc.err)
+			if got.Class != tc.class || got.Transient != tc.transient {
+				t.Fatalf("classification = %+v, want %s transient=%v", got, tc.class, tc.transient)
+			}
+		})
+	}
+}
+
+func TestDisabledWorkerAndNilProcessorNeverClaim(t *testing.T) {
+	repo := &fakeRepo{}
+	cfg := DefaultWorkerConfig()
+	worker := NewWorker(repo, nil, "tenant-secret", "owner", cfg, slog.New(slog.NewTextHandler(io.Discard, nil)))
+	if err := worker.Run(context.Background()); err != nil {
+		t.Fatalf("disabled Run: %v", err)
+	}
+	if repo.claimCalls.Load() != 0 {
+		t.Fatalf("disabled worker made %d claims", repo.claimCalls.Load())
+	}
+
+	cfg.Enabled = true
+	worker = NewWorker(repo, nil, "tenant-secret", "owner", cfg, slog.New(slog.NewTextHandler(io.Discard, nil)))
+	if !errors.Is(worker.Run(context.Background()), ErrProcessorUnavailable) {
+		t.Fatal("enabled worker without atomic processor must fail before claiming")
+	}
+	if repo.claimCalls.Load() != 0 {
+		t.Fatalf("processor-less worker made %d claims", repo.claimCalls.Load())
+	}
+}
+
+func TestWorkerPersistsPlanAndSuccessWithOwner(t *testing.T) {
+	var mu sync.Mutex
+	var calls []string
+	claimed := false
+	repo := &fakeRepo{}
+	repo.claim = func(_ context.Context, tenant, owner string, _ time.Duration, _ int) (*Job, error) {
+		mu.Lock()
+		defer mu.Unlock()
+		if claimed {
+			return nil, nil
+		}
+		claimed = true
+		if tenant != "tenant-a" || owner != "worker-a" {
+			t.Fatalf("claim scope = %q/%q", tenant, owner)
+		}
+		return &Job{ID: "job-a", TenantID: tenant, LeaseOwner: owner, AttemptCount: 1}, nil
+	}
+	repo.transition = func(_ context.Context, lease LeaseRef) error {
+		mu.Lock()
+		defer mu.Unlock()
+		calls = append(calls, "planning:"+lease.TenantID+":"+lease.JobID+":"+lease.Owner+":"+strconv.Itoa(lease.Generation))
+		return nil
+	}
+	repo.savePlan = func(
+		_ context.Context,
+		lease LeaseRef,
+		plan json.RawMessage,
+		warnings int,
+	) error {
+		mu.Lock()
+		defer mu.Unlock()
+		calls = append(calls, "plan:"+string(plan))
+		if lease.TenantID != "tenant-a" || lease.JobID != "job-a" || lease.Owner != "worker-a" ||
+			lease.Generation != 1 || warnings != 2 {
+			t.Fatal("SavePlan lost scope/owner/generation/warnings")
+		}
+		return nil
+	}
+	done := make(chan struct{})
+	repo.succeed = func(_ context.Context, lease LeaseRef, warnings int) error {
+		mu.Lock()
+		calls = append(calls, "succeeded")
+		mu.Unlock()
+		if lease.TenantID != "tenant-a" || lease.JobID != "job-a" || lease.Owner != "worker-a" ||
+			lease.Generation != 1 || warnings != 3 {
+			t.Fatal("Succeed lost scope/owner/generation/warnings")
+		}
+		close(done)
+		return nil
+	}
+	processor := fakeProcessor{
+		plan: func(context.Context, *Job) (Plan, error) {
+			return Plan{Payload: json.RawMessage(`{"b":2,"a":1}`), Warnings: 2}, nil
+		},
+		apply: func(context.Context, *Job, json.RawMessage) (int, error) { return 3, nil },
+	}
+	cfg := DefaultWorkerConfig()
+	cfg.Enabled = true
+	cfg.PollInterval = time.Millisecond
+	ctx, cancel := context.WithCancel(context.Background())
+	worker := NewWorker(repo, processor, "tenant-a", "worker-a", cfg, slog.New(slog.NewTextHandler(io.Discard, nil)))
+	runDone := make(chan error, 1)
+	go func() { runDone <- worker.Run(ctx) }()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("worker did not complete")
+	}
+	cancel()
+	<-runDone
+	mu.Lock()
+	defer mu.Unlock()
+	if len(calls) != 3 || calls[0] != "planning:tenant-a:job-a:worker-a:1" || calls[2] != "succeeded" {
+		t.Fatalf("state calls = %#v", calls)
+	}
+}
