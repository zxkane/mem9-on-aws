+				)
+				if err != nil {
+					if !writeNamespaceAuthError(w, err) {
+						writeError(w, http.StatusForbidden, "memory namespace authorization failed")
+					}
+					return
+				}
+				info.Namespace = scope
+			}
 			if agentID := r.Header.Get(AgentIDHeader); agentID != "" {
 				info.AgentName = agentID
 			}
diff --git a/server/internal/middleware/namespace_auth.go b/server/internal/middleware/namespace_auth.go
new file mode 100644
index 0000000000000000000000000000000000000000..5f9086051b796ea9e253f7ec69fe524bc768f6e8
--- /dev/null
+++ b/server/internal/middleware/namespace_auth.go
@@ -0,0 +1,456 @@
+package middleware
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"regexp"
+	"slices"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+
+	"github.com/qiffang/mnemos/server/internal/domain"
+)
+
+const (
+	TransportHeader       = "X-Mem9-Transport"
+	maxTransportBodyBytes = 1 << 20
+	maxTransportGroups    = 32
+)
+
+var hex64Pattern = regexp.MustCompile(`^[0-9a-f]{64}$`)
+
+type namespaceAuthError struct {
+	status int
+	msg    string
+	err    error
+}
+
+func (e *namespaceAuthError) Error() string {
+	if e.err != nil {
+		return e.err.Error()
+	}
+	return e.msg
+}
+
+func (e *namespaceAuthError) Unwrap() error { return e.err }
+
+type transportEnvelope struct {
+	Version       int      `json:"v"`
+	KeyID         string   `json:"kid"`
+	Issuer        string   `json:"issuer"`
+	IssuedAt      int64    `json:"issued_at"`
+	ExpiresAt     int64    `json:"expires_at"`
+	Method        string   `json:"method"`
+	Path          string   `json:"path"`
+	BodyHash      string   `json:"body_hash"`
+	PrincipalKey  string   `json:"principal_key"`
+	PrincipalType string   `json:"principal_type"`
+	ClientKey     string   `json:"client_key"`
+	GroupKeys     []string `json:"group_keys"`
+}
+
+type NamespaceAuthorizer struct {
+	issuer string
+	keys   map[string][]byte
+	now    func() time.Time
+}
+
+func NewNamespaceAuthorizer(issuer, rawKeys string) (*NamespaceAuthorizer, error) {
+	if strings.TrimSpace(issuer) == "" {
+		return nil, errors.New("MNEMO_TRANSPORT_ISSUER is required")
+	}
+	var encoded map[string]string
+	if err := json.Unmarshal([]byte(rawKeys), &encoded); err != nil {
+		return nil, fmt.Errorf("parse MNEMO_TRANSPORT_SIGNING_KEYS: %w", err)
+	}
+	keys := make(map[string][]byte, len(encoded))
+	for _, kid := range []string{"current", "previous"} {
+		value := encoded[kid]
+		if value == "" {
+			continue
+		}
+		key, err := base64.RawURLEncoding.DecodeString(value)
+		if err != nil || len(key) < 32 {
+			return nil, fmt.Errorf("transport signing key %s is invalid", kid)
+		}
+		keys[kid] = key
+	}
+	if len(keys["current"]) == 0 {
+		return nil, errors.New("transport signing key current is required")
+	}
+	return &NamespaceAuthorizer{
+		issuer: issuer,
+		keys:   keys,
+		now:    time.Now,
+	}, nil
+}
+
+func (a *NamespaceAuthorizer) Authorize(
+	ctx context.Context,
+	db *sql.DB,
+	tenantID string,
+	r *http.Request,
+) (*domain.NamespaceScope, error) {
+	identity, err := a.verifyRequest(r)
+	if err != nil {
+		return nil, &namespaceAuthError{
+			status: http.StatusForbidden,
+			msg:    "memory namespace authorization failed",
+			err:    err,
+		}
+	}
+	scope, err := a.resolveScope(ctx, db, tenantID, identity)
+	if err != nil {
+		return nil, err
+	}
+	if scope.Role == "viewer" && r.Method != http.MethodGet && r.Method != http.MethodHead {
+		return nil, &namespaceAuthError{
+			status: http.StatusForbidden,
+			msg:    "memory namespace role denied",
+		}
+	}
+	return scope, nil
+}
+
+func (a *NamespaceAuthorizer) verifyRequest(r *http.Request) (transportEnvelope, error) {
+	var identity transportEnvelope
+	raw := strings.TrimSpace(r.Header.Get(TransportHeader))
+	parts := strings.Split(raw, ".")
+	if len(parts) != 2 {
+		return identity, errors.New("transport envelope is malformed")
+	}
+	payload, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil {
+		return identity, errors.New("transport envelope payload is malformed")
+	}
+	if err := json.Unmarshal(payload, &identity); err != nil {
+		return identity, errors.New("transport envelope payload is malformed")
+	}
+	key := a.keys[identity.KeyID]
+	if len(key) == 0 {
+		return identity, errors.New("transport envelope key is unknown")
+	}
+	macBytes, err := hex.DecodeString(parts[1])
+	if err != nil || len(macBytes) != sha256.Size {
+		return identity, errors.New("transport envelope signature is malformed")
+	}
+	expected := hmac.New(sha256.New, key)
+	_, _ = expected.Write(payload)
+	if !hmac.Equal(macBytes, expected.Sum(nil)) {
+		return identity, errors.New("transport envelope signature mismatch")
+	}
+
+	body := []byte{}
+	if r.Body != nil {
+		body, err = io.ReadAll(io.LimitReader(r.Body, maxTransportBodyBytes+1))
+		if err != nil {
+			return identity, errors.New("read transport request body")
+		}
+		if len(body) > maxTransportBodyBytes {
+			return identity, errors.New("transport request body is too large")
+		}
+		r.Body = io.NopCloser(strings.NewReader(string(body)))
+	}
+	bodyDigest := sha256.Sum256(body)
+	now := a.now().Unix()
+	if identity.Version != 1 ||
+		identity.Issuer != a.issuer ||
+		identity.Method != strings.ToUpper(r.Method) ||
+		identity.Path != r.URL.RequestURI() ||
+		identity.BodyHash != hex.EncodeToString(bodyDigest[:]) ||
+		!hex64Pattern.MatchString(identity.PrincipalKey) ||
+		!hex64Pattern.MatchString(identity.ClientKey) ||
+		(identity.PrincipalType != "human" && identity.PrincipalType != "m2m") ||
+		identity.ExpiresAt < now ||
+		identity.IssuedAt > now+5 ||
+		identity.ExpiresAt-identity.IssuedAt != 30 {
+		return identity, errors.New("transport envelope request binding is invalid")
+	}
+	if len(identity.GroupKeys) > maxTransportGroups ||
+		!slices.IsSorted(identity.GroupKeys) {
+		return identity, errors.New("transport group keys are invalid")
+	}
+	seen := make(map[string]struct{}, len(identity.GroupKeys))
+	for _, key := range identity.GroupKeys {
+		if !hex64Pattern.MatchString(key) {
+			return identity, errors.New("transport group key is invalid")
+		}
+		if _, exists := seen[key]; exists {
+			return identity, errors.New("transport group keys are duplicated")
+		}
+		seen[key] = struct{}{}
+	}
+	if identity.PrincipalType == "m2m" && len(identity.GroupKeys) != 0 {
+		return identity, errors.New("m2m transport cannot carry group keys")
+	}
+	return identity, nil
+}
+
+func (a *NamespaceAuthorizer) resolveScope(
+	ctx context.Context,
+	db *sql.DB,
+	tenantID string,
+	identity transportEnvelope,
+) (*domain.NamespaceScope, error) {
+	tx, err := db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelReadCommitted})
+	if err != nil {
+		return nil, &namespaceAuthError{status: http.StatusServiceUnavailable, msg: "namespace authorization unavailable", err: err}
+	}
+	defer tx.Rollback()
+
+	if _, err := tx.ExecContext(ctx, `SELECT pg_advisory_xact_lock(hashtext($1))`, identity.PrincipalKey); err != nil {
+		return nil, &namespaceAuthError{status: http.StatusServiceUnavailable, msg: "namespace authorization unavailable", err: err}
+	}
+
+	var scope *domain.NamespaceScope
+	switch identity.PrincipalType {
+	case "human":
+		scope, err = resolveHumanScope(ctx, tx, tenantID, identity)
+	case "m2m":
+		scope, err = resolveM2MScope(ctx, tx, tenantID, identity)
+	default:
+		err = errors.New("unsupported principal type")
+	}
+	if err != nil {
+		return nil, err
+	}
+	if err := tx.Commit(); err != nil {
+		return nil, &namespaceAuthError{status: http.StatusServiceUnavailable, msg: "namespace authorization unavailable", err: err}
+	}
+	return scope, nil
+}
+
+type groupBinding struct {
+	groupKey    string
+	namespaceID string
+	defaultRole string
+	jitEnabled  bool
+}
+
+func resolveHumanScope(
+	ctx context.Context,
+	tx *sql.Tx,
+	tenantID string,
+	identity transportEnvelope,
+) (*domain.NamespaceScope, error) {
+	if len(identity.GroupKeys) == 0 {
+		return nil, &namespaceAuthError{status: http.StatusForbidden, msg: "namespace membership required"}
+	}
+	placeholders := make([]string, len(identity.GroupKeys))
+	args := make([]any, len(identity.GroupKeys))
+	for i, key := range identity.GroupKeys {
+		placeholders[i] = fmt.Sprintf("$%d", i+1)
+		args[i] = key
+	}
+	rows, err := tx.QueryContext(ctx, `
+		SELECT binding.group_key, binding.namespace_id,
+		       binding.default_role, binding.jit_enabled
+		FROM memory_cognito_group_bindings AS binding
+		JOIN memory_namespaces AS namespace
+		  ON namespace.namespace_id = binding.namespace_id
+		WHERE binding.status = 'active'
+		  AND namespace.status = 'active'
+		  AND binding.group_key IN (`+strings.Join(placeholders, ",")+`)`,
+		args...,
+	)
+	if err != nil {
+		return nil, &namespaceAuthError{status: http.StatusServiceUnavailable, msg: "namespace authorization unavailable", err: err}
+	}
+	defer rows.Close()
+	var bindings []groupBinding
+	for rows.Next() {
+		var binding groupBinding
+		if err := rows.Scan(&binding.groupKey, &binding.namespaceID, &binding.defaultRole, &binding.jitEnabled); err != nil {
+			return nil, &namespaceAuthError{status: http.StatusServiceUnavailable, msg: "namespace authorization unavailable", err: err}
+		}
+		bindings = append(bindings, binding)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, &namespaceAuthError{status: http.StatusServiceUnavailable, msg: "namespace authorization unavailable", err: err}
+	}
+	if len(bindings) == 0 {
+		return nil, &namespaceAuthError{status: http.StatusForbidden, msg: "namespace membership required"}
+	}
+	if len(bindings) != 1 {
+		return nil, &namespaceAuthError{status: http.StatusConflict, msg: "ambiguous memory namespace"}
+	}
+	binding := bindings[0]
+
+	principalID, err := upsertPrincipal(ctx, tx, identity.PrincipalKey, "human")
+	if err != nil {
+		return nil, err
+	}
+	var role, status string
+	err = tx.QueryRowContext(ctx, `
+		SELECT role, status
+		FROM memory_namespace_memberships
+		WHERE namespace_id = $1 AND principal_id = $2
+		FOR UPDATE`,
+		binding.namespaceID,
+		principalID,
+	).Scan(&role, &status)
+	switch {
+	case err == nil && status == "active":
+	case err == nil:
+		return nil, &namespaceAuthError{status: http.StatusForbidden, msg: "namespace membership revoked"}
+	case !errors.Is(err, sql.ErrNoRows):
+		return nil, &namespaceAuthError{status: http.StatusServiceUnavailable, msg: "namespace authorization unavailable", err: err}
+	case !binding.jitEnabled:
+		return nil, &namespaceAuthError{status: http.StatusForbidden, msg: "namespace membership required"}
+	default:
+		var other int
+		if err := tx.QueryRowContext(ctx, `
+			SELECT COUNT(*)
+			FROM memory_namespace_memberships
+			WHERE principal_id = $1 AND status = 'active'`,
+			principalID,
+		).Scan(&other); err != nil {
+			return nil, &namespaceAuthError{status: http.StatusServiceUnavailable, msg: "namespace authorization unavailable", err: err}
+		}
+		if other != 0 {
+			return nil, &namespaceAuthError{status: http.StatusConflict, msg: "namespace membership conflict"}
+		}
+		role = binding.defaultRole
+		if _, err := tx.ExecContext(ctx, `
+			INSERT INTO memory_namespace_memberships (
+				namespace_id, principal_id, role, status,
+				source_type, source_key, granted_at
+			) VALUES ($1, $2, $3, 'active', 'cognito_group', $4, NOW())`,
+			binding.namespaceID,
+			principalID,
+			role,
+			binding.groupKey,
+		); err != nil {
+			return nil, &namespaceAuthError{status: http.StatusServiceUnavailable, msg: "namespace authorization unavailable", err: err}
+		}
+	}
+	var activeCount int
+	if err := tx.QueryRowContext(ctx, `
+		SELECT COUNT(*)
+		FROM memory_namespace_memberships
+		WHERE principal_id = $1 AND status = 'active'`,
+		principalID,
+	).Scan(&activeCount); err != nil {
+		return nil, &namespaceAuthError{status: http.StatusServiceUnavailable, msg: "namespace authorization unavailable", err: err}
+	}
+	if activeCount != 1 {
+		return nil, &namespaceAuthError{status: http.StatusConflict, msg: "namespace membership conflict"}
+	}
+	return &domain.NamespaceScope{
+		TenantID: tenantID, NamespaceID: binding.namespaceID,
+		PrincipalID: principalID, PrincipalType: "human", Role: role,
+	}, nil
+}
+
+func upsertPrincipal(
+	ctx context.Context,
+	tx *sql.Tx,
+	principalKey string,
+	principalType string,
+) (string, error) {
+	var principalID, storedType, status string
+	err := tx.QueryRowContext(ctx, `
+		INSERT INTO memory_principals (
+			principal_id, principal_key, principal_type,
+			status, created_at, last_seen_at
+		) VALUES ($1, $2, $3, 'active', NOW(), NOW())
+		ON CONFLICT (principal_key) DO UPDATE
+		SET last_seen_at = NOW()
+		RETURNING principal_id, principal_type, status`,
+		uuid.NewString(),
+		principalKey,
+		principalType,
+	).Scan(&principalID, &storedType, &status)
+	if err != nil {
+		return "", &namespaceAuthError{status: http.StatusServiceUnavailable, msg: "namespace authorization unavailable", err: err}
+	}
+	if storedType != principalType || status != "active" {
+		return "", &namespaceAuthError{status: http.StatusForbidden, msg: "memory principal denied"}
+	}
+	return principalID, nil
+}
+
+func resolveM2MScope(
+	ctx context.Context,
+	tx *sql.Tx,
+	tenantID string,
+	identity transportEnvelope,
+) (*domain.NamespaceScope, error) {
+	var principalID, principalType, principalStatus string
+	var namespaceID, namespaceStatus, bindingStatus string
+	var bindingRole, membershipRole, membershipStatus string
+	err := tx.QueryRowContext(ctx, `
+		SELECT principal.principal_id, principal.principal_type,
+		       principal.status, binding.namespace_id, binding.role,
+		       binding.status, namespace.status, membership.role,
+		       membership.status
+		FROM memory_m2m_namespace_bindings AS binding
+		JOIN memory_principals AS principal
+		  ON principal.principal_id = binding.principal_id
+		JOIN memory_namespaces AS namespace
+		  ON namespace.namespace_id = binding.namespace_id
+		JOIN memory_namespace_memberships AS membership
+		  ON membership.namespace_id = binding.namespace_id
+		 AND membership.principal_id = binding.principal_id
+		WHERE binding.client_key = $1
+		  AND principal.principal_key = $2
+		FOR UPDATE`,
+		identity.ClientKey,
+		identity.PrincipalKey,
+	).Scan(
+		&principalID,
+		&principalType,
+		&principalStatus,
+		&namespaceID,
+		&bindingRole,
+		&bindingStatus,
+		&namespaceStatus,
+		&membershipRole,
+		&membershipStatus,
+	)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, &namespaceAuthError{status: http.StatusForbidden, msg: "namespace membership required"}
+	}
+	if err != nil {
+		return nil, &namespaceAuthError{status: http.StatusServiceUnavailable, msg: "namespace authorization unavailable", err: err}
+	}
+	if principalType != "m2m" ||
+		principalStatus != "active" ||
+		bindingStatus != "active" ||
+		namespaceStatus != "active" ||
+		membershipStatus != "active" ||
+		membershipRole != bindingRole {
+		return nil, &namespaceAuthError{status: http.StatusForbidden, msg: "namespace membership denied"}
+	}
+	if _, err := tx.ExecContext(ctx, `
+		UPDATE memory_principals SET last_seen_at = NOW()
+		WHERE principal_id = $1`,
+		principalID,
+	); err != nil {
+		return nil, &namespaceAuthError{status: http.StatusServiceUnavailable, msg: "namespace authorization unavailable", err: err}
+	}
+	return &domain.NamespaceScope{
+		TenantID: tenantID, NamespaceID: namespaceID,
+		PrincipalID: principalID, PrincipalType: "m2m", Role: membershipRole,
+	}, nil
+}
+
+func writeNamespaceAuthError(w http.ResponseWriter, err error) bool {
+	var authErr *namespaceAuthError
+	if !errors.As(err, &authErr) {
+		return false
+	}
+	writeError(w, authErr.status, authErr.msg)
+	return true
+}
diff --git a/server/internal/middleware/namespace_auth_test.go b/server/internal/middleware/namespace_auth_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..fa6131f9ef929332ed0f8f26969c421f5518f9ff
--- /dev/null
+++ b/server/internal/middleware/namespace_auth_test.go
@@ -0,0 +1,309 @@
+package middleware
+
+import (
+	"bytes"
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+func testNamespaceAuthorizer(t *testing.T) (*NamespaceAuthorizer, []byte) {
+	t.Helper()
+	key := bytes.Repeat([]byte{7}, 32)
+	raw, err := json.Marshal(map[string]string{
+		"current": base64.RawURLEncoding.EncodeToString(key),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	authorizer, err := NewNamespaceAuthorizer("gateway-target", string(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	authorizer.now = func() time.Time { return time.Unix(1_787_875_200, 0) }
+	return authorizer, key
+}
+
+func signedTransport(t *testing.T, key []byte, payload transportEnvelope) string {
+	t.Helper()
+	raw, err := json.Marshal(payload)
+	if err != nil {
+		t.Fatal(err)
+	}
+	mac := hmac.New(sha256.New, key)
+	_, _ = mac.Write(raw)
+	return base64.RawURLEncoding.EncodeToString(raw) + "." +
+		hex.EncodeToString(mac.Sum(nil))
+}
+
+func TestNamespaceTransportRejectsTamperedBody(t *testing.T) {
+	authorizer, key := testNamespaceAuthorizer(t)
+	body := []byte(`{"content":"team fact"}`)
+	digest := sha256.Sum256(body)
+	payload := transportEnvelope{
+		Version: 1, KeyID: "current", Issuer: "gateway-target",
+		IssuedAt: 1_787_875_200, ExpiresAt: 1_787_875_230,
+		Method: http.MethodPost, Path: "/v1alpha2/mem9s/memories",
+		BodyHash:     hex.EncodeToString(digest[:]),
+		PrincipalKey: bytesToHex(1), PrincipalType: "human",
+		ClientKey: bytesToHex(2), GroupKeys: []string{bytesToHex(3)},
+	}
+	req := httptest.NewRequest(
+		http.MethodPost,
+		payload.Path,
+		bytes.NewBufferString(`{"content":"changed"}`),
+	)
+	req.Header.Set(TransportHeader, signedTransport(t, key, payload))
+	if _, err := authorizer.verifyRequest(req); err == nil {
+		t.Fatal("tampered body was accepted")
+	}
+}
+
+func TestNamespaceTransportAcceptsCurrentAndPreviousKeys(t *testing.T) {
+	current := bytes.Repeat([]byte{7}, 32)
+	previous := bytes.Repeat([]byte{8}, 32)
+	raw, _ := json.Marshal(map[string]string{
+		"current":  base64.RawURLEncoding.EncodeToString(current),
+		"previous": base64.RawURLEncoding.EncodeToString(previous),
+	})
+	authorizer, err := NewNamespaceAuthorizer("gateway-target", string(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	authorizer.now = func() time.Time { return time.Unix(1_787_875_200, 0) }
+	for kid, key := range map[string][]byte{"current": current, "previous": previous} {
+		digest := sha256.Sum256(nil)
+		payload := transportEnvelope{
+			Version: 1, KeyID: kid, Issuer: "gateway-target",
+			IssuedAt: 1_787_875_200, ExpiresAt: 1_787_875_230,
+			Method: http.MethodGet, Path: "/v1alpha2/mem9s/memories?q=x",
+			BodyHash:     hex.EncodeToString(digest[:]),
+			PrincipalKey: bytesToHex(1), PrincipalType: "m2m",
+			ClientKey: bytesToHex(2), GroupKeys: []string{},
+		}
+		req := httptest.NewRequest(http.MethodGet, payload.Path, nil)
+		req.Header.Set(TransportHeader, signedTransport(t, key, payload))
+		if _, err := authorizer.verifyRequest(req); err != nil {
+			t.Fatalf("%s key rejected: %v", kid, err)
+		}
+	}
+}
+
+func namespaceRequest(
+	t *testing.T,
+	key []byte,
+	method string,
+	path string,
+	body []byte,
+	principalKey string,
+	principalType string,
+	clientKey string,
+	groupKeys []string,
+) *http.Request {
+	t.Helper()
+	digest := sha256.Sum256(body)
+	payload := transportEnvelope{
+		Version: 1, KeyID: "current", Issuer: "gateway-target",
+		IssuedAt: 1_787_875_200, ExpiresAt: 1_787_875_230,
+		Method: method, Path: path,
+		BodyHash:      hex.EncodeToString(digest[:]),
+		PrincipalKey:  principalKey,
+		PrincipalType: principalType,
+		ClientKey:     clientKey,
+		GroupKeys:     groupKeys,
+	}
+	req := httptest.NewRequest(method, path, bytes.NewReader(body))
+	req.Header.Set(TransportHeader, signedTransport(t, key, payload))
+	return req
+}
+
+func TestNamespaceAuthorizerPostgresHumanAndM2MResolution(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	db := testutil.OpenIsolatedPostgres(t, dsn)
+	authorizer, key := testNamespaceAuthorizer(t)
+	groupA := bytesToHex(3)
+	groupB := bytesToHex(4)
+	if _, err := db.Exec(`
+		INSERT INTO memory_cognito_group_bindings (
+			group_key, namespace_id, default_role, jit_enabled, status
+		) VALUES
+			($1, $2, 'member', TRUE, 'active'),
+			($3, $4, 'member', TRUE, 'active')`,
+		groupA,
+		testutil.TestNamespaceID,
+		groupB,
+		testutil.TestOtherNamespaceID,
+	); err != nil {
+		t.Fatal(err)
+	}
+
+	humanKey := bytesToHex(5)
+	humanRequest := func(method string, groups []string) *http.Request {
+		return namespaceRequest(
+			t,
+			key,
+			method,
+			"/v1alpha2/mem9s/memories",
+			nil,
+			humanKey,
+			"human",
+			bytesToHex(9),
+			groups,
+		)
+	}
+	scope, err := authorizer.Authorize(
+		context.Background(),
+		db,
+		"tenant-a",
+		humanRequest(http.MethodGet, []string{groupA}),
+	)
+	if err != nil {
+		t.Fatalf("JIT authorize: %v", err)
+	}
+	if scope.NamespaceID != testutil.TestNamespaceID ||
+		scope.PrincipalType != "human" ||
+		scope.Role != "member" {
+		t.Fatalf("JIT scope = %+v", scope)
+	}
+	firstPrincipalID := scope.PrincipalID
+	scope, err = authorizer.Authorize(
+		context.Background(),
+		db,
+		"tenant-a",
+		humanRequest(http.MethodGet, []string{groupA}),
+	)
+	if err != nil || scope.PrincipalID != firstPrincipalID {
+		t.Fatalf("repeat JIT scope = (%+v, %v)", scope, err)
+	}
+	var memberships int
+	if err := db.QueryRow(`
+		SELECT count(*)
+		FROM memory_namespace_memberships
+		WHERE principal_id = $1
+		  AND namespace_id = $2
+		  AND source_type = 'cognito_group'
+		  AND source_key = $3`,
+		firstPrincipalID,
+		testutil.TestNamespaceID,
+		groupA,
+	).Scan(&memberships); err != nil {
+		t.Fatal(err)
+	}
+	if memberships != 1 {
+		t.Fatalf("JIT memberships = %d, want 1", memberships)
+	}
+
+	if _, err := db.Exec(`
+		UPDATE memory_namespace_memberships
+		SET role = 'viewer'
+		WHERE namespace_id = $1 AND principal_id = $2`,
+		testutil.TestNamespaceID,
+		firstPrincipalID,
+	); err != nil {
+		t.Fatal(err)
+	}
+	_, err = authorizer.Authorize(
+		context.Background(),
+		db,
+		"tenant-a",
+		humanRequest(http.MethodPost, []string{groupA}),
+	)
+	var roleDenied *namespaceAuthError
+	if !errors.As(err, &roleDenied) ||
+		roleDenied.status != http.StatusForbidden {
+		t.Fatalf("viewer write error = %v, want forbidden", err)
+	}
+
+	_, err = authorizer.Authorize(
+		context.Background(),
+		db,
+		"tenant-a",
+		namespaceRequest(
+			t,
+			key,
+			http.MethodGet,
+			"/v1alpha2/mem9s/memories",
+			nil,
+			bytesToHex(6),
+			"human",
+			bytesToHex(9),
+			[]string{groupA, groupB},
+		),
+	)
+	var ambiguous *namespaceAuthError
+	if !errors.As(err, &ambiguous) ||
+		ambiguous.status != http.StatusConflict {
+		t.Fatalf("ambiguous group error = %v, want conflict", err)
+	}
+
+	const m2mPrincipalID = "94000000-0000-4000-8000-000000000001"
+	m2mPrincipalKey := bytesToHex(7)
+	m2mClientKey := bytesToHex(8)
+	if _, err := db.Exec(`
+		INSERT INTO memory_principals (
+			principal_id, principal_key, principal_type, status
+		) VALUES ($1, $2, 'm2m', 'active');
+	`, m2mPrincipalID, m2mPrincipalKey); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`
+		INSERT INTO memory_namespace_memberships (
+			namespace_id, principal_id, role, status, source_type, source_key
+		) VALUES ($1, $2, 'member', 'active', 'm2m_binding', $3)`,
+		testutil.TestOtherNamespaceID,
+		m2mPrincipalID,
+		m2mClientKey,
+	); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`
+		INSERT INTO memory_m2m_namespace_bindings (
+			client_key, principal_id, namespace_id, role, status
+		) VALUES ($1, $2, $3, 'member', 'active')`,
+		m2mClientKey,
+		m2mPrincipalID,
+		testutil.TestOtherNamespaceID,
+	); err != nil {
+		t.Fatal(err)
+	}
+	m2mScope, err := authorizer.Authorize(
+		context.Background(),
+		db,
+		"tenant-a",
+		namespaceRequest(
+			t,
+			key,
+			http.MethodGet,
+			"/v1alpha2/mem9s/memories",
+			nil,
+			m2mPrincipalKey,
+			"m2m",
+			m2mClientKey,
+			nil,
+		),
+	)
+	if err != nil ||
+		m2mScope.NamespaceID != testutil.TestOtherNamespaceID ||
+		m2mScope.PrincipalID != m2mPrincipalID ||
+		m2mScope.PrincipalType != "m2m" {
+		t.Fatalf("M2M scope = (%+v, %v)", m2mScope, err)
+	}
+}
+
+func bytesToHex(value byte) string {
+	return hex.EncodeToString(bytes.Repeat([]byte{value}, 32))
+}
