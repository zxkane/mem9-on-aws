+func TestPostgresIngestIdempotencyAndLeaseAreNamespaceScoped(t *testing.T) {
+	db := ingestTestDB(t)
+	repo := NewIngestJobRepo(db)
+	const key = "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
+
+	inputA := enqueueInput("tenant-a", "session-a", key)
+	inputA.ID = "92000000-0000-4000-8000-000000000001"
+	jobA := enqueueJob(t, repo, inputA)
+
+	inputB := enqueueInput("tenant-a", "session-a", key)
+	inputB.ID = "92000000-0000-4000-8000-000000000002"
+	inputB.NamespaceID = testutil.TestOtherNamespaceID
+	inputB.PrincipalID = testutil.TestOtherPrincipalID
+	jobB := enqueueJob(t, repo, inputB)
+
+	if jobA.ID == jobB.ID {
+		t.Fatal("cross-namespace idempotency reused a job")
+	}
+	var count int
+	if err := db.QueryRow(`
+		SELECT count(*)
+		FROM ingest_jobs
+		WHERE tenant_id = $1 AND idempotency_key = $2`,
+		"tenant-a",
+		key,
+	).Scan(&count); err != nil {
+		t.Fatal(err)
+	}
+	if count != 2 {
+		t.Fatalf("cross-namespace idempotency rows = %d, want 2", count)
+	}
+	if _, err := repo.Get(
+		context.Background(),
+		jobA.TenantID,
+		jobB.NamespaceID,
