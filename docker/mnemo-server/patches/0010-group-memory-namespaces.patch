+func (r *MemoryRepo) exactNamespaceVectorSearch(
+	ctx context.Context,
+	conds []string,
+	filterArgs []any,
+	queryVec []float32,
+	limit int,
+) ([]domain.Memory, error) {
+	tx, err := r.db.BeginTx(ctx, &sql.TxOptions{
+		Isolation: sql.LevelRepeatableRead,
+		ReadOnly:  true,
+	})
+	if err != nil {
+		return nil, fmt.Errorf("begin exact namespace vector search: %w", err)
+	}
+	defer tx.Rollback()
+
+	timeout := r.exactVectorTimeout
+	if timeout <= 0 {
+		timeout = 2 * time.Second
+	}
+	if _, err := tx.ExecContext(
+		ctx,
+		`SELECT set_config('statement_timeout', $1, true)`,
+		strconv.FormatInt(timeout.Milliseconds(), 10),
+	); err != nil {
+		return nil, classifyNamespaceVectorError(err)
+	}
+	if _, err := tx.ExecContext(ctx, `SET LOCAL enable_indexscan = off`); err != nil {
+		return nil, classifyNamespaceVectorError(err)
+	}
+	if _, err := tx.ExecContext(ctx, `SET LOCAL enable_bitmapscan = off`); err != nil {
+		return nil, classifyNamespaceVectorError(err)
+	}
+
+	var rowsInNamespace int
+	if err := tx.QueryRowContext(ctx, `
+		SELECT COUNT(*)
+		FROM memories
+		WHERE namespace_id = $1
+		  AND state = 'active'
+		  AND embedding IS NOT NULL`,
+		r.namespaceID,
+	).Scan(&rowsInNamespace); err != nil {
+		return nil, classifyNamespaceVectorError(err)
+	}
+	maxRows := r.exactVectorMaxRows
+	if maxRows <= 0 {
+		maxRows = 10000
+	}
+	if rowsInNamespace > maxRows {
+		return nil, fmt.Errorf(
+			"%w: namespace row count exceeds %d",
+			domain.ErrNamespaceVectorCapacity,
+			maxRows,
+		)
+	}
+
+	vecParamIdx := len(filterArgs) + 1
+	limitParamIdx := vecParamIdx + 1
+	query := fmt.Sprintf(`
+		WITH namespace_memories AS MATERIALIZED (
+			SELECT %s
+			FROM memories
+			WHERE %s
+		)
+		SELECT %s, embedding <=> $%d AS distance
+		FROM namespace_memories
+		ORDER BY embedding <=> $%d
+		LIMIT $%d`,
+		allColumns,
+		strings.Join(conds, " AND "),
+		allColumns,
+		vecParamIdx,
+		vecParamIdx,
+		limitParamIdx,
+	)
+	args := make([]any, 0, len(filterArgs)+2)
+	args = append(args, filterArgs...)
+	args = append(args, pgvector.NewVector(queryVec), limit)
+	rows, err := tx.QueryContext(ctx, query, args...)
+	if err != nil {
+		return nil, classifyNamespaceVectorError(err)
+	}
+	var memories []domain.Memory
+	for rows.Next() {
+		memory, scanErr := scanMemoryRowsWithDistance(rows)
+		if scanErr != nil {
+			rows.Close()
+			return nil, scanErr
+		}
+		memories = append(memories, *memory)
+	}
+	if err := rows.Err(); err != nil {
+		rows.Close()
+		return nil, classifyNamespaceVectorError(err)
+	}
+	if err := rows.Close(); err != nil {
+		return nil, err
+	}
+	if err := tx.Commit(); err != nil {
+		return nil, classifyNamespaceVectorError(err)
+	}
+	return memories, nil
+}
+
+func classifyNamespaceVectorError(err error) error {
+	var pgErr *pgconn.PgError
+	if errors.As(err, &pgErr) && pgErr.Code == "57014" {
+		return fmt.Errorf("%w: exact vector statement timed out", domain.ErrNamespaceVectorTimeout)
+	}
+	return err
+}
+
+func namespaceExactVectorConfig() (int, time.Duration) {
+	maxRows := 10000
+	if raw := strings.TrimSpace(os.Getenv("MNEMO_NAMESPACE_EXACT_VECTOR_MAX_ROWS")); raw != "" {
+		if parsed, err := strconv.Atoi(raw); err == nil && parsed > 0 {
+			maxRows = parsed
+		}
+	}
+	timeout := 2 * time.Second
+	if raw := strings.TrimSpace(os.Getenv("MNEMO_NAMESPACE_EXACT_VECTOR_TIMEOUT")); raw != "" {
+		if parsed, err := time.ParseDuration(raw); err == nil && parsed > 0 {
+			timeout = parsed
+		}
+	}
+	return maxRows, timeout
+}
