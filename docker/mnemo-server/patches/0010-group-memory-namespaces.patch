+func validateNamespaceStartup(
+	ctx context.Context,
+	db *sql.DB,
+	required bool,
+) error {
+	var phase string
+	if err := db.QueryRowContext(ctx, `
+		SELECT phase
+		FROM memory_namespace_migration_state
+		WHERE singleton_id`).Scan(&phase); err != nil {
+		return fmt.Errorf("read namespace migration phase: %w", err)
+	}
+	if !required {
+		if phase != "additive_ready" {
+			return fmt.Errorf(
+				"namespace compatibility mode cannot start in phase %q",
+				phase,
+			)
+		}
+		return nil
+	}
+	if phase != "constraints_complete" {
+		return fmt.Errorf("unsupported namespace migration phase %q", phase)
+	}
+	var unassigned int
+	if err := db.QueryRowContext(ctx, `
+		SELECT
+			(SELECT COUNT(*) FROM memories WHERE namespace_id IS NULL)
+		  + (SELECT COUNT(*) FROM sessions
+		     WHERE namespace_id IS NULL OR principal_id IS NULL)
+		  + (SELECT COUNT(*) FROM ingest_jobs
+		     WHERE namespace_id IS NULL OR principal_id IS NULL)
+		  + (SELECT COUNT(*) FROM ingest_job_plans
+		     WHERE namespace_id IS NULL OR principal_id IS NULL)
+		  + (SELECT COUNT(*) FROM upload_tasks
+		     WHERE namespace_id IS NULL)`).Scan(&unassigned); err != nil {
+		return fmt.Errorf("verify namespace assignments: %w", err)
+	}
+	if unassigned != 0 {
+		return fmt.Errorf("namespace migration has %d unassigned rows", unassigned)
+	}
+	return nil
+}
