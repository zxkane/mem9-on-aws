+func waitForPostgresLockWait(t *testing.T, db *sql.DB, pid int) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		var waiting bool
+		err := db.QueryRow(`
+			SELECT COALESCE(wait_event_type = 'Lock', FALSE)
+			FROM pg_stat_activity
+			WHERE pid = $1`,
+			pid,
+		).Scan(&waiting)
+		if err == nil && waiting {
+			return
+		}
+		if err != nil && !errors.Is(err, sql.ErrNoRows) {
+			t.Fatalf("inspect revoke lock wait: %v", err)
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatalf("revoke backend %d did not wait for the apply job lock", pid)
+}
