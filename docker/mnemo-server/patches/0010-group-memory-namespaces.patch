+// TC-GROUPNS-122/128: emergency revoke and atomic apply have one legal order.
+func TestEmergencyRevokeLinearizesAgainstAtomicApply(t *testing.T) {
+	t.Run("apply commits before revoke", func(t *testing.T) {
+		db := ingestTestDB(t)
+		repo := NewIngestJobRepo(db)
+		job, plan := prepareAtomicIntegrationPlan(
+			t,
+			repo,
+			"1280000000000000000000000000000000000000000000000000000000000001",
+		)
+
+		applyPaused := make(chan struct{})
+		releaseApply := make(chan struct{})
+		repo.applyHook = func(point string) error {
+			if point == "after_action_0" {
+				close(applyPaused)
+				<-releaseApply
+			}
+			return nil
+		}
+		applyDone := make(chan error, 1)
+		go func() {
+			_, err := repo.ApplyPlan(context.Background(), job.LeaseRef(), plan)
+			applyDone <- err
+		}()
+		select {
+		case <-applyPaused:
+		case <-time.After(2 * time.Second):
+			t.Fatal("apply did not reach the injected pause")
+		}
+
+		revokePID := make(chan int, 1)
+		revokeDone := make(chan error, 1)
+		go func() {
+			tx, err := db.BeginTx(context.Background(), nil)
+			if err != nil {
+				revokeDone <- err
+				return
+			}
+			defer tx.Rollback()
+			var pid int
+			if err := tx.QueryRow(`SELECT pg_backend_pid()`).Scan(&pid); err != nil {
+				revokeDone <- err
+				return
+			}
+			if _, err := tx.Exec(`
+				UPDATE memory_namespace_memberships
+				SET status = 'revoked', revoked_at = statement_timestamp()
+				WHERE principal_id = $1 AND status = 'active'`,
+				job.PrincipalID,
+			); err != nil {
+				revokeDone <- err
+				return
+			}
+			if _, err := tx.Exec(`
+				UPDATE memory_principals
+				SET status = 'disabled'
+				WHERE principal_id = $1`,
+				job.PrincipalID,
+			); err != nil {
+				revokeDone <- err
+				return
+			}
+			revokePID <- pid
+			result, err := tx.Exec(`
+				UPDATE ingest_jobs
+				SET state = 'dead',
+					error_class = 'principal_emergency_revoked',
+					lease_owner = NULL,
+					lease_expires_at = NULL,
+					completed_at = statement_timestamp(),
+					updated_at = statement_timestamp()
+				WHERE principal_id = $1
+				  AND state NOT IN ('succeeded', 'dead')`,
+				job.PrincipalID,
+			)
+			if err != nil {
+				revokeDone <- err
+				return
+			}
+			affected, err := result.RowsAffected()
+			if err != nil {
+				revokeDone <- err
+				return
+			}
+			if affected != 0 {
+				revokeDone <- fmt.Errorf(
+					"revoke changed %d jobs after apply committed",
+					affected,
+				)
+				return
+			}
+			revokeDone <- tx.Commit()
+		}()
+
+		var pid int
+		select {
+		case pid = <-revokePID:
+		case err := <-revokeDone:
+			t.Fatalf("revoke failed before lock wait: %v", err)
+		case <-time.After(2 * time.Second):
+			t.Fatal("revoke did not reach the job update")
+		}
+		waitForPostgresLockWait(t, db, pid)
+		close(releaseApply)
+
+		if err := <-applyDone; err != nil {
+			t.Fatalf("apply-first result: %v", err)
+		}
+		if err := <-revokeDone; err != nil {
+			t.Fatalf("apply-first revoke: %v", err)
+		}
+		assertAtomicMutationCounts(
+			t,
+			repo,
+			job,
+			1,
+			2,
+			ingestqueue.StateSucceeded,
+		)
+		var principalStatus, membershipStatus string
+		if err := db.QueryRow(`
+			SELECT principal.status, membership.status
+			FROM memory_principals AS principal
+			JOIN memory_namespace_memberships AS membership
+			  ON membership.principal_id = principal.principal_id
+			WHERE principal.principal_id = $1
+			  AND membership.namespace_id = $2`,
+			job.PrincipalID,
+			job.NamespaceID,
+		).Scan(&principalStatus, &membershipStatus); err != nil {
+			t.Fatal(err)
+		}
+		if principalStatus != "disabled" || membershipStatus != "revoked" {
+			t.Fatalf(
+				"principal=%s membership=%s, want disabled/revoked",
+				principalStatus,
+				membershipStatus,
+			)
+		}
+	})
+
+	t.Run("revoke commits before apply", func(t *testing.T) {
+		db := ingestTestDB(t)
+		repo := NewIngestJobRepo(db)
+		job, plan := prepareAtomicIntegrationPlan(
+			t,
+			repo,
+			"1280000000000000000000000000000000000000000000000000000000000002",
+		)
+		tx, err := db.BeginTx(context.Background(), nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer tx.Rollback()
+		if _, err := tx.Exec(`
+			UPDATE memory_namespace_memberships
+			SET status = 'revoked', revoked_at = statement_timestamp()
+			WHERE principal_id = $1 AND status = 'active'`,
+			job.PrincipalID,
+		); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := tx.Exec(`
+			UPDATE memory_principals
+			SET status = 'disabled'
+			WHERE principal_id = $1`,
+			job.PrincipalID,
+		); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := tx.Exec(`
+			UPDATE ingest_jobs
+			SET state = 'dead',
+				error_class = 'principal_emergency_revoked',
+				lease_owner = NULL,
+				lease_expires_at = NULL,
+				completed_at = statement_timestamp(),
+				updated_at = statement_timestamp()
+			WHERE principal_id = $1
+			  AND state NOT IN ('succeeded', 'dead')`,
+			job.PrincipalID,
+		); err != nil {
+			t.Fatal(err)
+		}
+		if err := tx.Commit(); err != nil {
+			t.Fatal(err)
+		}
