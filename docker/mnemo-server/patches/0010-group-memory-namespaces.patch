new file mode 100644
index 0000000000000000000000000000000000000000..3c218d27de47c49f6d7a36ae1088045de2b57e2a
--- /dev/null
+++ b/server/cmd/mnemo-server/namespace_startup_integration_test.go
@@ -0,0 +1,100 @@
+package main
+
+import (
+	"context"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/qiffang/mnemos/server/internal/testutil"
+)
+
+func TestValidateNamespaceStartupPostgres(t *testing.T) {
+	dsn := os.Getenv("MNEMO_TEST_POSTGRES_DSN")
+	if dsn == "" {
+		t.Skip("MNEMO_TEST_POSTGRES_DSN is not set")
+	}
+	db := testutil.OpenIsolatedPostgres(t, dsn)
+	if err := validateNamespaceStartup(context.Background(), db, true); err != nil {
+		t.Fatalf("completed schema rejected: %v", err)
+	}
+	if err := validateNamespaceStartup(context.Background(), db, false); err == nil ||
+		!strings.Contains(err.Error(), "compatibility mode cannot start") {
+		t.Fatalf("compatibility mode completed-phase error = %v", err)
+	}
+	if _, err := db.Exec(`
+		UPDATE memory_namespace_migration_state
+		SET phase = 'frozen', legacy_namespace_id = NULL, legacy_principal_id = NULL, legacy_namespace_slug = NULL, legacy_namespace_display_name = NULL, legacy_principal_key = NULL
+		WHERE singleton_id`); err != nil {
+		t.Fatal(err)
+	}
+	if err := validateNamespaceStartup(context.Background(), db, true); err == nil ||
+		!strings.Contains(err.Error(), "unsupported namespace migration phase") {
+		t.Fatalf("frozen phase error = %v", err)
+	}
+	if _, err := db.Exec(`
+		UPDATE memory_namespace_migration_state
+		SET phase = 'application_ready', legacy_namespace_id = '60000000-0000-4000-8000-000000000201', legacy_principal_id = '70000000-0000-4000-8000-000000000201', legacy_namespace_slug = 'integration-team', legacy_namespace_display_name = 'Integration Team', legacy_principal_key = repeat('d', 64)
+		WHERE singleton_id`); err != nil {
+		t.Fatal(err)
+	}
+	if err := validateNamespaceStartup(context.Background(), db, true); err == nil ||
+		!strings.Contains(err.Error(), "unsupported namespace migration phase") {
+		t.Fatalf("application-ready phase error = %v", err)
+	}
+	if _, err := db.Exec(`
+		UPDATE memory_namespace_migration_state
+		SET phase = 'constraints_complete'
+		WHERE singleton_id`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`
+		ALTER TABLE sessions ALTER COLUMN principal_id DROP NOT NULL`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`
+		INSERT INTO sessions (
+			id, session_id, app_id, role, content, content_hash, namespace_id
+		) VALUES (
+			'95000000-0000-4000-8000-000000000001',
+			'session', 'app', 'user', 'content', repeat('c', 64), $1
+		)`,
+		testutil.TestNamespaceID,
+	); err != nil {
+		t.Fatal(err)
+	}
+	if err := validateNamespaceStartup(context.Background(), db, true); err == nil ||
+		!strings.Contains(err.Error(), "1 unassigned rows") {
+		t.Fatalf("unassigned session error = %v", err)
+	}
+	if _, err := db.Exec(`DELETE FROM sessions`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`
+		ALTER TABLE upload_tasks ALTER COLUMN namespace_id DROP NOT NULL`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.Exec(`
+		INSERT INTO upload_tasks (
+			task_id, tenant_id, file_name, file_path, file_type, status
+		) VALUES (
+			'95000000-0000-4000-8000-000000000002',
+			'tenant-a', 'test.txt', '/tmp/test.txt', 'txt', 'completed'
+		)`); err != nil {
+		t.Fatal(err)
+	}
+	if err := validateNamespaceStartup(context.Background(), db, true); err == nil ||
+		!strings.Contains(err.Error(), "1 unassigned rows") {
+		t.Fatalf("unassigned upload error = %v", err)
+	}
+
+	if _, err := db.Exec(`
+		UPDATE memory_namespace_migration_state
+		SET phase = 'additive_ready', legacy_namespace_id = NULL, legacy_principal_id = NULL, legacy_namespace_slug = NULL, legacy_namespace_display_name = NULL, legacy_principal_key = NULL
+		WHERE singleton_id`); err != nil {
+		t.Fatal(err)
+	}
+	if err := validateNamespaceStartup(context.Background(), db, false); err != nil {
+		t.Fatalf("additive compatibility phase rejected: %v", err)
+	}
+}
