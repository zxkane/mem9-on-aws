+func TestPostgresMemoryRepoNamespaceIsolation(t *testing.T) {
+	db := ingestTestDB(t)
+	scopeA := testutil.TestNamespaceScope()
+	scopeB := domain.NamespaceScope{
+		NamespaceID:   testutil.TestOtherNamespaceID,
+		PrincipalID:   testutil.TestOtherPrincipalID,
+		PrincipalType: "service",
+		Role:          "owner",
+	}
+	repoA := NewMemoryRepo(db, true, "", scopeA)
+	repoB := NewMemoryRepo(db, true, "", scopeB)
+
+	embeddingA := make([]float32, 1024)
+	embeddingA[0] = 1
+	embeddingB := make([]float32, 1024)
+	embeddingB[1] = 1
+	memoryA := &domain.Memory{
+		ID:         "91000000-0000-4000-8000-000000000001",
+		Content:    "shared keyword from team A",
+		MemoryType: domain.TypePinned,
+		AppID:      "app",
+		State:      domain.StateActive,
+		Version:    1,
+		Embedding:  embeddingA,
+	}
+	memoryB := &domain.Memory{
+		ID:         "91000000-0000-4000-8000-000000000002",
+		Content:    "shared keyword from team B",
+		MemoryType: domain.TypePinned,
+		AppID:      "app",
+		State:      domain.StateActive,
+		Version:    1,
+		Embedding:  embeddingB,
+	}
+	if err := repoA.Create(context.Background(), memoryA); err != nil {
+		t.Fatalf("create namespace A memory: %v", err)
+	}
+	if err := repoB.Create(context.Background(), memoryB); err != nil {
+		t.Fatalf("create namespace B memory: %v", err)
+	}
+
+	for _, tc := range []struct {
+		name      string
+		repo      *MemoryRepo
+		ownID     string
+		foreignID string
+	}{
+		{"namespace A", repoA, memoryA.ID, memoryB.ID},
+		{"namespace B", repoB, memoryB.ID, memoryA.ID},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if _, err := tc.repo.GetByID(context.Background(), tc.ownID); err != nil {
+				t.Fatalf("read own memory: %v", err)
+			}
+			if _, err := tc.repo.GetByID(context.Background(), tc.foreignID); !errors.Is(
+				err,
+				domain.ErrNotFound,
+			) {
+				t.Fatalf("cross-namespace read error = %v, want ErrNotFound", err)
+			}
+			count, err := tc.repo.Count(context.Background())
+			if err != nil || count != 1 {
+				t.Fatalf("namespace count = (%d, %v), want (1, nil)", count, err)
+			}
+			results, err := tc.repo.KeywordSearch(
+				context.Background(),
+				"shared keyword",
+				domain.MemoryFilter{},
+				10,
+			)
+			if err != nil || len(results) != 1 || results[0].ID != tc.ownID {
+				t.Fatalf("namespace keyword results = (%+v, %v)", results, err)
+			}
+		})
+	}
+
+	vectorResults, err := repoA.VectorSearch(
+		context.Background(),
+		embeddingA,
+		domain.MemoryFilter{MinScore: -1},
+		10,
+	)
+	if err != nil || len(vectorResults) != 1 || vectorResults[0].ID != memoryA.ID {
+		t.Fatalf("namespace vector results = (%+v, %v)", vectorResults, err)
+	}
+	if _, err := repoA.SoftDelete(
+		context.Background(),
+		memoryB.ID,
+		"operator",
+	); !errors.Is(err, domain.ErrNotFound) {
+		t.Fatalf("cross-namespace delete error = %v, want ErrNotFound", err)
+	}
+	if _, err := repoB.GetByID(context.Background(), memoryB.ID); err != nil {
+		t.Fatalf("cross-namespace delete changed foreign memory: %v", err)
+	}
+
+	var namespaceA, principalA, namespaceB, principalB string
+	if err := db.QueryRow(`
+		SELECT namespace_id, created_by_principal_id
+		FROM memories
+		WHERE id = $1`,
+		memoryA.ID,
+	).Scan(&namespaceA, &principalA); err != nil {
+		t.Fatal(err)
+	}
+	if err := db.QueryRow(`
+		SELECT namespace_id, created_by_principal_id
+		FROM memories
+		WHERE id = $1`,
+		memoryB.ID,
+	).Scan(&namespaceB, &principalB); err != nil {
+		t.Fatal(err)
+	}
+	if namespaceA != scopeA.NamespaceID || principalA != scopeA.PrincipalID ||
+		namespaceB != scopeB.NamespaceID || principalB != scopeB.PrincipalID {
+		t.Fatalf(
+			"audit ownership A=%s/%s B=%s/%s",
+			namespaceA,
+			principalA,
+			namespaceB,
+			principalB,
+		)
+	}
+}
