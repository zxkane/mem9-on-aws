+		if _, err := repo.ApplyPlan(
+			context.Background(),
+			job.LeaseRef(),
+			plan,
+		); !errors.Is(err, ingestqueue.ErrLeaseLost) {
+			t.Fatalf("revoke-first apply error = %v, want lease lost", err)
+		}
+		assertAtomicMutationCounts(t, repo, job, 0, 0, ingestqueue.StateDead)
+	})
+}
