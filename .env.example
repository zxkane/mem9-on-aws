# Copy to `.env` (gitignored) and fill in for the out-of-band bootstrap scripts
# in scripts/deploy-*.sh. These scripts source the repo-root .env if present.
#
#   cp .env.example .env  && $EDITOR .env

# The AWS CLI profile the deploy scripts assume when calling AWS. Must have
# permission to create the GitHub Actions IAM role, the ECR repositories, and the
# Bedrock Mantle Project in the target account.
AWS_PROFILE=your-aws-profile

# --- Optional overrides (defaults are sensible; leave unset to use them) ---
# The GitHub Actions IAM role CFN stack is pinned to us-west-2 (IAM is global;
# keeping the stack in one region avoids cross-region name collisions).
# AWS_REGION=us-west-2
# ECR repositories + Bedrock Mantle Project live in the app region (Tokyo).
# ECR_REGION=ap-northeast-1
# Required only while adopting or updating the registry scanning singleton.
# Set true only after the account owner pauses every other registry-config writer.
# ECR_SCAN_EXCLUSIVE_WRITER_ACK=false
# PROJECT_REGION=ap-northeast-1
# CloudFormation stack names (override only if you run multiple copies).
# STACK_NAME=
